{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "WatchPairing": {
    "PairingCodeLifetime": "00:10:00",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "MaximumPairingAttempts": 5,
    "PairingRequestLifetime": "00:03:00",
    "ApproveUrlTemplate": "gymplanner://watch/approve?request={requestId}"
  },
  "AllowedHosts": "*"
}
