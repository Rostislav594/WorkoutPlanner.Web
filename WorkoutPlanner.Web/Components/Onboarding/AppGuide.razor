@using System.Globalization
@implements IAsyncDisposable
@inject Application.Abstractions.IOnboardingService Guide
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<AppGuide> Logger

@if (Guide.IsActive && Guide.CurrentStep is { } step)
{
    <div class="app-guide @(step.DisplayMode == GuideDisplayMode.PageOverview ? "guide-overview" : null)"
         role="dialog"
         aria-modal="true"
         aria-label="Интерактивное знакомство с приложением"
         tabindex="-1"
         @onkeydown="HandleKeyDown">

        @if (_target is null)
        {
            <div class="guide-shade guide-shade-full"></div>
        }
        else
        {
            <div class="guide-shade guide-shade-top" style="height:@Px(_target.Y)"></div>
            <div class="guide-shade guide-shade-bottom" style="top:@Px(_target.Y + _target.Height)"></div>
            <div class="guide-shade guide-shade-left"
                 style="top:@Px(_target.Y);width:@Px(_target.X);height:@Px(_target.Height)"></div>
            <div class="guide-shade guide-shade-right"
                 style="top:@Px(_target.Y);left:@Px(_target.X + _target.Width);height:@Px(_target.Height)"></div>
            <div class="guide-spotlight"
                 style="left:@Px(_target.X);top:@Px(_target.Y);width:@Px(_target.Width);height:@Px(_target.Height)"></div>
        }

        @if (!step.AllowTargetInteraction)
        {
            <div class="guide-interaction-blocker" aria-hidden="true"></div>
        }

        <section class="guide-coach @CoachClass(step)"
                 style="@CoachStyle"
                 aria-live="polite">
            <img class="guide-character"
                 src="@step.CharacterImage"
                 alt="Персонаж-помощник" />

            <div class="guide-bubble">
                <button class="guide-skip"
                        type="button"
                        disabled="@Guide.IsBusy"
                        @onclick="Guide.PauseAsync">
                    Закрыть и продолжить позже
                </button>

                <p class="guide-section">@SectionName(step.Section)</p>
                <p class="guide-message">@step.Message</p>

                @if (!string.IsNullOrWhiteSpace(Guide.ErrorMessage))
                {
                    <div class="guide-error" role="alert">
                        <span>@Guide.ErrorMessage</span>
                        <button type="button" @onclick="Guide.RetryCurrentStep">Повторить</button>
                    </div>
                }

                <div class="guide-progress"
                     aria-label="Шаг @Guide.SectionStepNumber из @Guide.SectionStepCount">
                    @Guide.SectionStepNumber из @Guide.SectionStepCount
                </div>

                @if (step.Choices.Count > 0)
                {
                    <div class="guide-choices">
                        @foreach (var choice in step.Choices)
                        {
                            <button class="guide-choice"
                                    type="button"
                                    disabled="@Guide.IsBusy"
                                    @onclick="() => SelectChoiceAsync(choice.Id)">
                                @choice.Text
                            </button>
                        }
                    </div>
                }
                else
                {
                    @if (step.ExpectedActionId is not null)
                    {
                        <p class="guide-action-hint">Выполни подсвеченное действие, чтобы продолжить.</p>
                    }

                    <div class="guide-actions">
                        <button class="guide-button guide-button-secondary"
                                type="button"
                                disabled="@(!Guide.CanGoBack || Guide.IsBusy)"
                                @onclick="Guide.PreviousAsync">
                            Назад
                        </button>

                        @if (step.ExpectedActionId is null)
                        {
                            <button class="guide-button guide-button-primary"
                                    type="button"
                                    disabled="@Guide.IsBusy"
                                    @ref="_primaryButton"
                                    @onclick="Guide.NextAsync">
                                @step.PrimaryButtonText
                            </button>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
}

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppGuide>? _dotNetReference;
    private GuideTargetRect? _target;
    private ElementReference _primaryButton;
    private int _preparedRevision = -1;
    private int _observedRevision = -1;
    private int _preparationId;
    private CancellationTokenSource? _preparationCancellation;
    private bool _focusPending;
    private bool _disposed;

    private string CoachStyle => _target is null
        ? string.Empty
        : $"left:{Px(_target.CoachLeft)};top:{Px(_target.CoachTop)}";

    protected override void OnInitialized()
    {
        Guide.StateChanged += OnGuideStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/appGuide.js");
            _dotNetReference = DotNetObjectReference.Create(this);

            if (IsHomeRoute())
            {
                try
                {
                    await Guide.TryStartAutomaticallyAsync();
                }
                catch (Exception exception)
                {
                    Logger.LogError(exception, "Failed to start the app guide automatically.");
                    await _module.InvokeVoidAsync("stop");
                }
            }
        }

        if (!Guide.IsActive || Guide.CurrentStep is null || _module is null)
            return;

        if (_focusPending)
        {
            _focusPending = false;
            await FocusPrimaryButtonAsync();
        }

        if (_preparedRevision != Guide.Revision)
        {
            _preparedRevision = Guide.Revision;
            await PrepareCurrentStepAsync();
        }
    }

    private async Task PrepareCurrentStepAsync()
    {
        var step = Guide.CurrentStep;
        var preparationId = _preparationId;

        if (step is null || _module is null || _dotNetReference is null)
            return;

        _target = null;
        await _module.InvokeVoidAsync("prepare");

        if (!IsCurrentPreparation(preparationId))
            return;

        await InvokeAsync(StateHasChanged);

        var cancellationToken = _preparationCancellation?.Token ?? CancellationToken.None;
        string route;
        try
        {
            route = step.ResolveRouteAsync is null
                ? step.Route
                : await step.ResolveRouteAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }

        if (!IsCurrentPreparation(preparationId))
            return;

        if (!IsCurrentRoute(route))
        {
            Navigation.NavigateTo(route);
            return;
        }

        if (step.BeforeShowAsync is not null)
        {
            try
            {
                await step.BeforeShowAsync(cancellationToken);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }
        }

        if (!IsCurrentPreparation(preparationId))
            return;

        if (step.DisplayMode == GuideDisplayMode.PageOverview || string.IsNullOrWhiteSpace(step.Target))
        {
            await _module.InvokeVoidAsync("showOverview", _dotNetReference, preparationId);
            CompletePreparation();
            return;
        }

        var revision = Guide.Revision;
        var target = await _module.InvokeAsync<GuideTargetRect?>(
            "showTarget",
            step.Target,
            step.Placement.ToString().ToLowerInvariant(),
            step.AllowTargetInteraction,
            _dotNetReference,
            preparationId);

        if (!Guide.IsActive || revision != Guide.Revision || preparationId != _preparationId)
            return;

        if (target is null)
        {
            Logger.LogWarning("App guide target {Target} was not found for step {StepId} on route {Route}.", step.Target, step.Id, route);
            await Guide.HandleUnavailableStepAsync();
            return;
        }

        _target = target;
        CompletePreparation();
    }

    [JSInvokable]
    public Task OnTargetChanged(GuideTargetRect target, int preparationId)
    {
        if (!IsCurrentPreparation(preparationId) || _disposed)
            return Task.CompletedTask;

        _target = target;
        return InvokeAsync(StateHasChanged);
    }

    private Task SelectChoiceAsync(string choiceId) => Guide.SelectChoiceAsync(choiceId);

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        var step = Guide.CurrentStep;
        if (step is null || Guide.IsBusy)
            return;

        if (args.Key == "Escape")
            await Guide.PauseAsync();
        else if (args.Key == "ArrowLeft" && Guide.CanGoBack)
            await Guide.PreviousAsync();
        else if (args.Key == "ArrowRight" && step.Choices.Count == 0 && step.ExpectedActionId is null)
            await Guide.NextAsync();
    }

    private void OnGuideStateChanged()
    {
        if (_observedRevision != Guide.Revision)
        {
            _observedRevision = Guide.Revision;
            _preparedRevision = -1;
            BeginPreparationSequence();
        }

        _ = InvokeAsync(async () =>
        {
            if (!Guide.IsActive && _module is not null)
            {
                _target = null;
                await _module.InvokeVoidAsync("stop");
            }

            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _preparedRevision = -1;
        BeginPreparationSequence();

        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            if (!Guide.IsActive && IsHomeRoute())
                await Guide.TryStartAutomaticallyAsync();
        });
    }

    private void CompletePreparation()
    {
        _focusPending = Guide.CurrentStep?.ExpectedActionId is null;
        _ = InvokeAsync(StateHasChanged);
    }

    private bool IsCurrentPreparation(int preparationId) =>
        Guide.IsActive && preparationId == _preparationId &&
        _preparationCancellation?.IsCancellationRequested != true;

    private void BeginPreparationSequence()
    {
        _preparationId++;
        _preparationCancellation?.Cancel();
        _preparationCancellation?.Dispose();
        _preparationCancellation = new CancellationTokenSource();
    }

    private async Task FocusPrimaryButtonAsync()
    {
        if (_module is null)
            return;

        try { await _module.InvokeVoidAsync("focusFirstControl"); }
        catch (JSDisconnectedException) { }
    }

    private bool IsHomeRoute() => string.IsNullOrWhiteSpace(Navigation.ToBaseRelativePath(Navigation.Uri));

    private bool IsCurrentRoute(string route)
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        return string.Equals(current, route.Trim('/'), StringComparison.OrdinalIgnoreCase);
    }

    private static string CoachClass(GuideStep step) =>
        step.DisplayMode == GuideDisplayMode.PageOverview
            ? $"guide-coach-overview guide-placement-{step.Placement.ToString().ToLowerInvariant()}"
            : string.Empty;

    private static string SectionName(GuideSection section) =>
        section == GuideSection.Navigation ? "Экскурсия по приложению" : "Первая тренировка";

    private static string Px(double value) => $"{value.ToString("0.##", CultureInfo.InvariantCulture)}px";

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _preparationCancellation?.Cancel();
        _preparationCancellation?.Dispose();
        Guide.StateChanged -= OnGuideStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }

        _dotNetReference?.Dispose();
    }

    public sealed class GuideTargetRect
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
        public double CoachLeft { get; set; }
        public double CoachTop { get; set; }
    }
}
