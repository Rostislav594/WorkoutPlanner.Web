@inherits LayoutComponentBase
@inject IAppText Text

<a class="admin-skip-link" href="#admin-main">@Text["Admin_SkipToContent"]</a>

<div class="admin-shell">
    <aside class="admin-navigation">
        <a class="admin-navigation__brand" href="/admin" aria-label="@Text["Admin_BrandHome"]">
            <span class="material-symbols-rounded" aria-hidden="true">admin_panel_settings</span>
            <span>
                <strong>GPlanner</strong>
                <small>@Text["Admin_PanelLabel"]</small>
            </span>
        </a>

        <nav class="admin-navigation__links" aria-label="@Text["Admin_Sections"]">
            <AdminNavigationLinks @rendermode="InteractiveServer" />
        </nav>

        <div class="admin-navigation__footer">
            <a href="/account/logout">
                <span class="material-symbols-rounded" aria-hidden="true">logout</span>
                <span>@Text["Admin_SignOut"]</span>
            </a>
        </div>
    </aside>

    <main id="admin-main" class="admin-shell__main" tabindex="-1">
        @Body
    </main>
</div>
