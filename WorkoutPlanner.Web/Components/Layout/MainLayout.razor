@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<ProfileGate />

<NavMenu Visible="@IsHomePage" />

@if (ShowHomeButton)
{
    <nav class="layout-page-actions" aria-label="Навигация страницы">
        @if (IsWorkoutDetailsPage)
        {
            <a class="page-nav-button" href="workouts">К тренировкам</a>
        }
        <a class="home-nav-button"
           href="@NavigationButtonHref">
            @NavigationButtonText
        </a>
    </nav>
}

<div class="page-transition" @key="CurrentPageKey">
    @Body
</div>

<WorkoutPlanner.Web.Components.Onboarding.AppGuide @rendermode='InteractiveServer' />

@code {
    string CurrentPagePath =>
        Navigation.ToBaseRelativePath(Navigation.Uri);

    bool IsHomePage =>
        string.IsNullOrWhiteSpace(CurrentPagePath);

    bool IsAccountPage =>
        CurrentPagePath.StartsWith("account/", StringComparison.OrdinalIgnoreCase);

    bool ShowHomeButton =>
        !string.IsNullOrWhiteSpace(CurrentPagePath) &&
        !IsAccountPage;

    bool IsProgressDetailsPage =>
        CurrentPagePath.Equals("progress/workouts", StringComparison.OrdinalIgnoreCase) ||
        CurrentPagePath.Equals("progress/exercises", StringComparison.OrdinalIgnoreCase);

    bool IsWorkoutDetailsPage =>
        CurrentPagePath.StartsWith("workout/", StringComparison.OrdinalIgnoreCase);

    string NavigationButtonHref =>
        IsProgressDetailsPage
            ? "progress"
            : "";

    string NavigationButtonText =>
        IsProgressDetailsPage
            ? "Назад"
            : "На главную";

    string CurrentPageKey => CurrentPagePath;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    void OnLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
