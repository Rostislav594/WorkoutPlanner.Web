@rendermode InteractiveServer

@if (!Visible)
{
    return;
}
<div class="menu-button" @onclick="ToggleMenu">
    ☰
</div>

@if (isOpen)
{
    <div class="overlay" @onclick="CloseMenu"></div>
}

<div class="side-menu @(isOpen ? "open" : "")">

    <div class="nav-brand">

        <img src="images/Emblem.png"
             class="nav-logo"
             alt="GPlanner" />

        <span class="nav-brand-title">
            GPlanner
        </span>

    </div>

    <AuthorizeView>
        <Authorized>
            <nav class="side-menu-links" aria-label="Главное меню">
                <a class="menu-auth-link" href="/profile" @onclick="CloseMenu">
                    Профиль
                </a>
            </nav>
        </Authorized>
    </AuthorizeView>

</div>

@code
{
    [Parameter]
    public bool Visible { get; set; } = true;

    bool isOpen;

    void ToggleMenu()
    {
        isOpen = !isOpen;
    }

    void CloseMenu()
    {
        isOpen = false;
    }
}