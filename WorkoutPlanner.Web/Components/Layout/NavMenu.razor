@rendermode InteractiveServer

@if (!Visible)
{
    return;
}
<div class="menu-button" @onclick="ToggleMenu">
    ☰
</div>

@if (isOpen)
{
    <div class="overlay" @onclick="CloseMenu"></div>
}

<div class="side-menu @(isOpen ? "open" : "")">

    <div class="menu-header">
        <div class="logo-icon"></div>
        <div class="app-title">
            GPlanner
        </div>
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="menu-account">
                <div class="menu-account-email">
                    @context.User.Identity?.Name
                </div>

                <a class="menu-auth-link" href="/account/logout">
                    Выйти
                </a>
            </div>
        </Authorized>
    </AuthorizeView>

</div>

@code
{
    [Parameter]
    public bool Visible { get; set; } = true;

    bool isOpen;

    void ToggleMenu()
    {
        isOpen = !isOpen;
    }

    void CloseMenu()
    {
        isOpen = false;
    }
}
