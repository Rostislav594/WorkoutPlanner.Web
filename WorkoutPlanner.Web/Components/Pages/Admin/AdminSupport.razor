@page "/admin/support"
@rendermode InteractiveServer
@using WorkoutPlanner.Web.Application.Abstractions
@using WorkoutPlanner.Web.Application.Contracts
@using WorkoutPlanner.Web.Models
@inject IAdminSupportService Support

<PageTitle>Support — GPlanner Admin</PageTitle>

<div class="admin-page">
    <AdminPageHeader Title="Support" Description="Основной рабочий интерфейс технической поддержки GPlanner." />
    <div class="admin-toolbar" role="search">
        <div class="admin-field"><label for="support-search">TicketNumber, пользователь или email</label><input id="support-search" class="admin-input" @bind="_search" @bind:event="oninput" placeholder="Поиск обращений" /></div>
        <div class="admin-field admin-field--compact"><label for="support-status">Статус</label><select id="support-status" class="admin-input" @bind="_status"><option value="">Все статусы</option>@foreach (var status in Enum.GetValues<SupportTicketStatus>()) { <option value="@status">@StatusLabel(status)</option> }</select></div>
        <button class="admin-button admin-button--primary" type="button" @onclick="SearchAsync" disabled="@_isLoading"><span class="material-symbols-rounded" aria-hidden="true">search</span>Применить</button>
    </div>

    @if (_isLoading) { <section class="admin-state" role="status"><h2>Загружаем обращения</h2></section> }
    else if (_error is not null) { <section class="admin-state" role="alert"><h2>Support недоступен</h2><p>@_error</p><button class="admin-button admin-button--secondary" @onclick="LoadAsync">Повторить</button></section> }
    else if (_result is null || _result.Items.Count == 0) { <section class="admin-state"><h2>Обращений не найдено</h2><p>Очередь пуста или обращения не соответствуют фильтрам.</p></section> }
    else
    {
        <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Обращение</th><th>Пользователь</th><th>Создано</th><th>Обновлено</th><th>Статус</th><th>Скриншот</th></tr></thead><tbody>
            @foreach (var ticket in _result.Items)
            {
                <tr><td><a href="@($"/admin/support/{ticket.Id}")"><span class="admin-table__primary">@ticket.TicketNumber</span><span class="admin-table__secondary">@ticket.Preview</span></a></td><td><span class="admin-table__primary">@ticket.DisplayName</span><span class="admin-table__secondary">@ticket.Email</span></td><td>@FormatDate(ticket.CreatedAtUtc)</td><td>@FormatDate(ticket.UpdatedAtUtc)</td><td><span class="admin-status @StatusClass(ticket.Status)">@StatusLabel(ticket.Status)</span></td><td>@(ticket.HasScreenshot ? "Есть" : "—")</td></tr>
            }
        </tbody></table></div>
        <div class="admin-pagination"><span>Всего: @_result.TotalCount · страница @_result.Page из @TotalPages</span><div class="admin-pagination__buttons"><button class="admin-button admin-button--secondary" disabled="@(_page <= 1)" @onclick="PreviousAsync">Назад</button><button class="admin-button admin-button--secondary" disabled="@(_page >= TotalPages)" @onclick="NextAsync">Вперёд</button></div></div>
    }
</div>

@code {
    private const int PageSize = 25; private AdminPagedResult<AdminSupportListItem>? _result; private string _search = string.Empty; private string _status = string.Empty; private string? _error; private int _page = 1; private bool _isLoading = true;
    private int TotalPages => _result is null ? 1 : Math.Max(1, (int)Math.Ceiling(_result.TotalCount / (double)PageSize));
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task SearchAsync() { _page = 1; await LoadAsync(); }
    private async Task PreviousAsync() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextAsync() { if (_page < TotalPages) { _page++; await LoadAsync(); } }
    private async Task LoadAsync() { _isLoading = true; _error = null; try { SupportTicketStatus? parsed = Enum.TryParse<SupportTicketStatus>(_status, out var value) ? value : null; _result = await Support.GetPageAsync(new(_search, parsed, _page, PageSize)); } catch { _error = "Список обращений временно недоступен."; } finally { _isLoading = false; } }
    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("dd.MM.yyyy, HH:mm");
    internal static string StatusLabel(SupportTicketStatus status) => status switch { SupportTicketStatus.New => "New", SupportTicketStatus.InProgress => "In progress", SupportTicketStatus.WaitingForUser => "Waiting for user", SupportTicketStatus.Resolved => "Resolved", _ => "Closed" };
    internal static string StatusClass(SupportTicketStatus status) => status switch { SupportTicketStatus.New => "admin-status--warning", SupportTicketStatus.InProgress => "admin-status--success", SupportTicketStatus.WaitingForUser => "admin-status--warning", SupportTicketStatus.Resolved => "admin-status--success", _ => string.Empty };
}
