@page "/admin/support"
@rendermode InteractiveServer
@using WorkoutPlanner.Web.Application.Abstractions
@using WorkoutPlanner.Web.Application.Contracts
@using WorkoutPlanner.Web.Models
@inject IAdminSupportService Support
@inject IAppText Text
@inject IAdminAttentionService Attention
@inject ILogger<AdminSupport> Logger

<PageTitle>@Text.Format("Admin_PageTitle", Text["Admin_Nav_Support"])</PageTitle>

<div class="admin-page">
    <AdminPageHeader Title="@Text["Admin_Nav_Support"]" />
    <div class="admin-toolbar" role="search">
        <div class="admin-field"><label for="support-search">@Text["Admin_Support_SearchLabel"]</label><input id="support-search" class="admin-input" @bind="_search" @bind:event="oninput" placeholder="@Text["Admin_Support_SearchPlaceholder"]" /></div>
        <div class="admin-field admin-field--compact"><label for="support-status">@Text["Admin_Column_Status"]</label><select id="support-status" class="admin-input" @bind="_status"><option value="">@Text["Admin_Support_AllStatuses"]</option>@foreach (var status in Enum.GetValues<SupportTicketStatus>()) { <option value="@status">@StatusLabel(Text, status)</option> }</select></div>
        <button class="admin-button admin-button--primary" type="button" @onclick="SearchAsync" disabled="@_isLoading"><span class="material-symbols-rounded" aria-hidden="true">search</span>@Text["Admin_Apply"]</button>
    </div>

    @if (_isLoading) { <section class="admin-state" role="status"><h2>@Text["Admin_Support_Loading"]</h2></section> }
    else if (_error is not null) { <section class="admin-state" role="alert"><h2>@Text["Admin_Support_Unavailable"]</h2><p>@_error</p><button class="admin-button admin-button--secondary" @onclick="LoadAsync">@Text["Common_Retry"]</button></section> }
    else if (_result is null || _result.Items.Count == 0) { <section class="admin-state"><h2>@Text["Admin_Support_NotFound"]</h2><p>@Text["Admin_Support_NotFoundHint"]</p></section> }
    else
    {
        <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>@Text["Admin_Column_Ticket"]</th><th>@Text["Admin_Column_User"]</th><th>@Text["Admin_Column_Created"]</th><th>@Text["Admin_Column_Updated"]</th><th>@Text["Admin_Column_Status"]</th><th>@Text["Admin_Column_Screenshot"]</th></tr></thead><tbody>
            @foreach (var ticket in _result.Items)
            {
                <tr class="@(IsNew(ticket) ? "support-row--new" : null)"><td><a href="@($"/admin/support/{ticket.Id}")"><span class="admin-table__primary">@ticket.TicketNumber@if (IsNew(ticket)) { <span class="support-new-badge">@Text["Admin_Support_NewBadge"]</span> }</span><span class="admin-table__secondary">@ticket.Preview</span></a></td><td><a href="@($"/admin/users/{Uri.EscapeDataString(ticket.UserId)}")" title="@Text["Admin_Ticket_OpenUser"]"><span class="admin-table__primary">@ticket.DisplayName</span><span class="admin-table__secondary">@ticket.Email</span></a></td><td>@FormatDate(ticket.CreatedAtUtc)</td><td>@FormatDate(ticket.UpdatedAtUtc)</td><td><span class="admin-status @StatusClass(ticket.Status)">@StatusLabel(Text, ticket.Status)</span></td><td>@(ticket.HasScreenshot ? Text["Admin_Yes"] : "—")</td></tr>
            }
        </tbody></table></div>
        <div class="admin-pagination"><span>@Text.Format("Admin_TotalPage", _result.TotalCount, _result.Page, TotalPages)</span><div class="admin-pagination__buttons"><button class="admin-button admin-button--secondary" disabled="@(_page <= 1)" @onclick="PreviousAsync">@Text["Common_Back"]</button><button class="admin-button admin-button--secondary" disabled="@(_page >= TotalPages)" @onclick="NextAsync">@Text["Admin_Next"]</button></div></div>
    }
</div>

@code {
    private const int PageSize = 25; private AdminPagedResult<AdminSupportListItem>? _result; private string _search = string.Empty; private string _status = string.Empty; private string? _error; private int _page = 1; private bool _isLoading = true;
    private int TotalPages => _result is null ? 1 : Math.Max(1, (int)Math.Ceiling(_result.TotalCount / (double)PageSize));

    // Прошлый заход в раздел: всё, что появилось после него, помечается «Новое»
    // до конца этого визита.
    private DateTime? _previousView;

    private bool IsNew(AdminSupportListItem ticket) =>
        _previousView is { } since &&
        (ticket.CreatedAtUtc > since || ticket.LastUserMessageAtUtc > since);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await MarkSectionViewedAsync();
    }

    // Раздел открыт — его подсветка в меню и на главной гаснет.
    private async Task MarkSectionViewedAsync()
    {
        try { _previousView = await Attention.MarkViewedAsync(WorkoutPlanner.Web.Models.AdminSection.Support); }
        catch (Exception exception) { Logger.LogWarning(exception, "Admin section view could not be saved."); }
    }
    private async Task SearchAsync() { _page = 1; await LoadAsync(); }
    private async Task PreviousAsync() { if (_page > 1) { _page--; await LoadAsync(); } }
    private async Task NextAsync() { if (_page < TotalPages) { _page++; await LoadAsync(); } }
    private async Task LoadAsync() { _isLoading = true; _error = null; try { SupportTicketStatus? parsed = Enum.TryParse<SupportTicketStatus>(_status, out var value) ? value : null; _result = await Support.GetPageAsync(new(_search, parsed, _page, PageSize)); } catch { _error = Text["Admin_Support_ListUnavailable"]; } finally { _isLoading = false; } }
    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("dd.MM.yyyy, HH:mm");
    internal static string StatusLabel(IAppText text, SupportTicketStatus status) => status switch { SupportTicketStatus.New => text["Admin_TicketStatus_New"], SupportTicketStatus.InProgress => text["Admin_TicketStatus_InProgress"], SupportTicketStatus.WaitingForUser => text["Admin_TicketStatus_WaitingForUser"], SupportTicketStatus.Resolved => text["Admin_TicketStatus_Resolved"], _ => text["Admin_TicketStatus_Closed"] };
    internal static string StatusClass(SupportTicketStatus status) => status switch { SupportTicketStatus.New => "admin-status--warning", SupportTicketStatus.InProgress => "admin-status--success", SupportTicketStatus.WaitingForUser => "admin-status--warning", SupportTicketStatus.Resolved => "admin-status--success", _ => string.Empty };
}
