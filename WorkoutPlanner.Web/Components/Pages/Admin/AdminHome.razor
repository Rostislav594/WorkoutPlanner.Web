@page "/admin"
@rendermode InteractiveServer
@using WorkoutPlanner.Web.Application.Abstractions
@using WorkoutPlanner.Web.Application.Contracts
@inject IAdminDashboardService Dashboard
@inject IAppText Text

<PageTitle>Dashboard — GPlanner Admin</PageTitle>

<div class="admin-page admin-dashboard">
    <AdminPageHeader Title="Dashboard"
                     Description="@Text["Admin_Dashboard_Description"]" />

    @if (_isLoading)
    {
        <section class="admin-state" role="status" aria-live="polite">
            <span class="material-symbols-rounded" aria-hidden="true">progress_activity</span>
            <h2>@Text["Admin_Dashboard_Loading"]</h2>
            <p>@Text["Admin_Dashboard_LoadingHint"]</p>
        </section>
    }
    else if (_snapshot is null)
    {
        <section class="admin-state" role="alert">
            <span class="material-symbols-rounded" aria-hidden="true">error</span>
            <h2>@Text["Admin_Dashboard_LoadFailed"]</h2>
            <p>@_error</p>
            <button class="admin-button admin-button--secondary" type="button" @onclick="LoadAsync">@Text["Common_Retry"]</button>
        </section>
    }
    else
    {
        <section class="dashboard-section" aria-labelledby="users-metrics-title">
            <div class="dashboard-section__heading">
                <div><h2 id="users-metrics-title">@Text["Admin_Dashboard_UsersTitle"]</h2><p>@Text["Admin_Dashboard_UsersHint"]</p></div>
                <a href="/admin/users">@Text["Admin_Dashboard_OpenUsers"] <span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></a>
            </div>
            <div class="metric-grid metric-grid--users">
                <MetricCard Label="@Text["Admin_Metric_TotalUsers"]" Value="@_snapshot.TotalUsers" Icon="group" Featured="true" />
                <MetricCard Label="@Text["Admin_Metric_New24"]" Value="@_snapshot.NewUsers24Hours" />
                <MetricCard Label="@Text["Admin_Metric_New7"]" Value="@_snapshot.NewUsers7Days" />
                <MetricCard Label="@Text["Admin_Metric_New30"]" Value="@_snapshot.NewUsers30Days" />
                <MetricCard Label="@Text["Admin_Metric_Active24"]" Value="@_snapshot.ActiveUsers24Hours" Tone="success" />
                <MetricCard Label="@Text["Admin_Metric_Active7"]" Value="@_snapshot.ActiveUsers7Days" Tone="success" />
                <MetricCard Label="@Text["Admin_Metric_Active30"]" Value="@_snapshot.ActiveUsers30Days" Tone="success" />
                <MetricCard Label="@Text["Admin_Metric_Inactive30"]" Value="@_snapshot.InactiveUsersOver30Days" Tone="muted" />
            </div>
        </section>

        <section class="dashboard-section" aria-labelledby="product-metrics-title">
            <div class="dashboard-section__heading"><div><h2 id="product-metrics-title">@Text["Admin_Dashboard_ProductTitle"]</h2><p>@Text["Admin_Dashboard_ProductHint"]</p></div></div>
            <div class="metric-grid">
                <MetricCard Label="@Text["Admin_Metric_Workouts24"]" Value="@_snapshot.CompletedWorkouts24Hours" Icon="fitness_center" />
                <MetricCard Label="@Text["Admin_Metric_Workouts7"]" Value="@_snapshot.CompletedWorkouts7Days" />
                <MetricCard Label="@Text["Admin_Metric_Workouts30"]" Value="@_snapshot.CompletedWorkouts30Days" />
                <MetricCard Label="@Text["Admin_Metric_OpenTickets"]" Value="@_snapshot.OpenSupportTickets" Icon="support_agent" Tone="warning" />
                <MetricCard Label="@Text["Admin_Metric_NewTickets"]" Value="@_snapshot.NewSupportTickets" Tone="warning" />
                <MetricCard Label="@Text["Admin_Metric_BackendErrors"]"
                            Value="@(_snapshot.BackendErrors24Hours?.ToString() ?? "—")"
                            Note="@(_snapshot.BackendErrors24Hours.HasValue ? null : Text["Admin_Metric_NotWired"])"
                            Tone="@(_snapshot.BackendErrors24Hours > 0 ? "danger" : "muted")" />
            </div>
        </section>
    }
</div>

@code {
    private AdminDashboardSnapshot? _snapshot;
    private bool _isLoading = true;
    private string _error = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _snapshot = null;
        try
        {
            _snapshot = await Dashboard.GetAsync();
        }
        catch
        {
            _error = Text["Admin_StatsUnavailable"];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
