@page "/admin"
@rendermode InteractiveServer
@using WorkoutPlanner.Web.Application.Abstractions
@using WorkoutPlanner.Web.Application.Contracts
@implements IDisposable
@inject IAdminDashboardService Dashboard
@inject IAdminAttentionService Attention
@inject ILogger<AdminHome> Logger
@inject IAppText Text

<PageTitle>@Text.Format("Admin_PageTitle", Text["Admin_Nav_Dashboard"])</PageTitle>

<div class="admin-page admin-dashboard">
    <AdminPageHeader Title="@Text["Admin_Nav_Dashboard"]" />

    @if (_isLoading)
    {
        <section class="admin-state" role="status" aria-live="polite">
            <span class="material-symbols-rounded" aria-hidden="true">progress_activity</span>
            <h2>@Text["Admin_Dashboard_Loading"]</h2>
            <p>@Text["Admin_Dashboard_LoadingHint"]</p>
        </section>
    }
    else if (_snapshot is null)
    {
        <section class="admin-state" role="alert">
            <span class="material-symbols-rounded" aria-hidden="true">error</span>
            <h2>@Text["Admin_Dashboard_LoadFailed"]</h2>
            <p>@_error</p>
            <button class="admin-button admin-button--secondary" type="button" @onclick="LoadAsync">@Text["Common_Retry"]</button>
        </section>
    }
    else
    {
        <section class="dashboard-section" aria-labelledby="users-metrics-title">
            <div class="dashboard-section__heading">
                <div><h2 id="users-metrics-title">@Text["Admin_Dashboard_UsersTitle"]</h2></div>
                <a href="/admin/users">@Text["Admin_Dashboard_OpenUsers"] <span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></a>
            </div>
            <div class="metric-grid">
                <MetricCard Label="@Text["Admin_Metric_TotalUsers"]" Value="@_snapshot.TotalUsers" Icon="group" Featured="true"
                            Attention="@(NewUsers > 0 ? "users" : null)" Note="@(NewUsers > 0 ? Text.Format("Admin_Attention_NewUsers", NewUsers) : null)" />
            </div>
        </section>

        <section class="dashboard-section" aria-labelledby="support-metrics-title">
            <div class="dashboard-section__heading"><div><h2 id="support-metrics-title">@Text["Admin_Dashboard_SupportTitle"]</h2></div></div>
            <div class="metric-grid">
                <MetricCard Label="@Text["Admin_Metric_OpenTickets"]" Value="@_snapshot.OpenSupportTickets" Icon="support_agent" Tone="warning" />
                <MetricCard Label="@Text["Admin_Metric_NewTickets"]" Value="@_snapshot.NewSupportTickets" Tone="warning"
                            Attention="@(_snapshot.NewSupportTickets > 0 ? "support" : null)" />
            </div>
        </section>

        <section class="dashboard-section" aria-labelledby="trends-title">
            <div class="dashboard-section__heading"><div><h2 id="trends-title">@Text["Admin_Dashboard_TrendsTitle"]</h2></div></div>
            <div class="dashboard-charts">
                <DailyBarChart Title="@Text["Admin_Chart_Registrations"]" Days="_snapshot.Registrations" />
                <DailyBarChart Title="@Text["Admin_Chart_ActiveUsers"]" Days="_snapshot.ActiveUsers" Tone="activity" ShowToday="true" />
            </div>
        </section>
    }
</div>

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(20);
    private readonly CancellationTokenSource _disposal = new();
    private AdminDashboardSnapshot? _snapshot;
    private AdminAttentionSnapshot? _attention;
    private bool _isLoading = true;
    private string _error = string.Empty;

    private int NewUsers => _attention?.NewUsers ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await RefreshAttentionAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Цифры и подсветка обновляются сами, пока главная страница открыта.
        if (firstRender && RendererInfo.IsInteractive)
            _ = PollAsync(_disposal.Token);
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _snapshot = null;
        try
        {
            _snapshot = await Dashboard.GetAsync();
        }
        catch
        {
            _error = Text["Admin_StatsUnavailable"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
                await InvokeAsync(RefreshQuietlyAsync);
        }
        catch (OperationCanceledException)
        {
            // Страница закрыта — опрос остановлен.
        }
    }

    /// <summary>Обновляет цифры без экрана загрузки; при сбое оставляет прежние.</summary>
    private async Task RefreshQuietlyAsync()
    {
        if (_disposal.IsCancellationRequested)
            return;

        try
        {
            _snapshot = await Dashboard.GetAsync(_disposal.Token);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogWarning(exception, "Admin dashboard refresh failed.");
        }

        await RefreshAttentionAsync();
        StateHasChanged();
    }

    private async Task RefreshAttentionAsync()
    {
        try
        {
            _attention = await Attention.GetAsync(_disposal.Token);
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            // Подсветка — вспомогательная: без неё главная страница всё равно работает.
            Logger.LogWarning(exception, "Admin attention snapshot could not be loaded.");
        }
    }

    // Только отменяем: запрос к базе может ещё держать этот токен.
    public void Dispose() => _disposal.Cancel();
}
