@page "/admin/users/{UserId}"
@rendermode InteractiveServer
@using WorkoutPlanner.Web.Application.Abstractions
@using WorkoutPlanner.Web.Application.Contracts
@inject IAdminUserService Users
@inject IAppText Text

<PageTitle>User — GPlanner Admin</PageTitle>

<div class="admin-page">
    <a class="admin-back-link" href="/admin/users"><span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>Users</a>
    <AdminPageHeader Title="@Text["Admin_UserCard_Title"]" Description="@Text["Admin_UserCard_Description"]" />

    @if (_isLoading) { <section class="admin-state" role="status"><h2>@Text["Admin_UserCard_Loading"]</h2></section> }
    else if (_user is null) { <section class="admin-state" role="alert"><h2>@Text["Admin_UserCard_NotFound"]</h2><p>@_error</p></section> }
    else
    {
        <section class="admin-detail-grid">
            <article class="admin-panel"><div class="admin-panel__heading"><div><h2>@_user.DisplayName</h2><p>@_user.Email</p></div><span class="admin-status @StatusClass(_user.ActivityStatus)">@_user.ActivityStatus</span></div>
                <dl class="admin-definition-list">
                    <div><dt>UserId</dt><dd>@_user.UserId</dd></div>
                    <div><dt>@Text["Admin_Column_Registered"]</dt><dd>@FormatDate(_user.RegisteredAtUtc)</dd></div>
                    <div><dt>@Text["Admin_Column_LastSeen"]</dt><dd>@FormatDate(_user.LastSeenAtUtc)</dd></div>
                    <div><dt>@Text["Admin_Field_Platform"]</dt><dd>@(_user.Platform ?? Text["Admin_NoData"])</dd></div>
                    <div><dt>@Text["Admin_Field_AppVersion"]</dt><dd>@(_user.AppVersion ?? Text["Admin_NoData"])</dd></div>
                    <div><dt>@Text["Admin_Field_Os"]</dt><dd>@(_user.OsVersion ?? Text["Admin_NoData"])</dd></div>
                    <div><dt>@Text["Admin_Field_Device"]</dt><dd>@(_user.DeviceModel ?? Text["Admin_NoData"])</dd></div>
                </dl>
            </article>
            <article class="admin-panel"><div class="admin-panel__heading"><div><h2>@Text["Admin_UserCard_Diagnostics"]</h2><p>@Text["Admin_UserCard_DiagnosticsHint"]</p></div></div>
                <dl class="admin-definition-list">
                    <div><dt>@Text["Admin_Field_CompletedWorkouts"]</dt><dd>@_user.WorkoutCount</dd></div>
                    <div><dt>@Text["Admin_Field_SupportTickets"]</dt><dd>@_user.SupportTicketCount</dd></div>
                    <div><dt>@Text["Admin_Field_MobileSessions"]</dt><dd>@_user.ActiveMobileSessionCount</dd></div>
                    <div><dt>@Text["Admin_Field_EmailConfirmed"]</dt><dd>@YesNo(_user.EmailConfirmed)</dd></div>
                    <div><dt>2FA</dt><dd>@YesNo(_user.TwoFactorEnabled)</dd></div>
                    <div><dt>@Text["Admin_Field_LockoutUntil"]</dt><dd>@(_user.LockoutEnd?.ToLocalTime().ToString("dd.MM.yyyy, HH:mm") ?? Text["Common_No"])</dd></div>
                </dl>
            </article>
        </section>
    }
</div>

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
    private WorkoutPlanner.Web.Application.Contracts.AdminUserDetail? _user; private bool _isLoading = true; private string _error = string.Empty;
    protected override async Task OnParametersSetAsync() { _isLoading = true; try { _user = await Users.GetAsync(UserId); } catch { _error = Text["Admin_UserCard_Unavailable"]; } finally { _isLoading = false; } }
    private string FormatDate(DateTime? value) =>
        value?.ToLocalTime().ToString("dd.MM.yyyy, HH:mm") ?? Text["Admin_NoData"];
    private string YesNo(bool value) => value ? Text["Common_Yes"] : Text["Common_No"];
    private static string StatusClass(AdminUserActivityStatus status) => status switch { AdminUserActivityStatus.Active => "admin-status--success", AdminUserActivityStatus.Dormant => "admin-status--warning", AdminUserActivityStatus.Inactive => "admin-status--danger", _ => string.Empty };
}
