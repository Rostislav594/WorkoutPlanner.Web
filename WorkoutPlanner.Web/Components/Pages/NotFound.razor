@page "/not-found"
@layout MainLayout
@attribute [AllowAnonymous]
@inject IAppText Text

<PageTitle>@Text["Web_NotFound_PageTitle"]</PageTitle>

<main class="not-found-page">
    <section>
        <span class="material-symbols-rounded" aria-hidden="true">explore_off</span>
        <h1>@Text["Web_NotFound"]</h1>
        <p>@Text["Web_NotFound_Body"]</p>
        <a href="/admin">@Text["Web_NotFound_Back"]</a>
    </section>
</main>