@page "/profile"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Identity
@using WorkoutPlanner.Api.Contracts
@using WorkoutPlanner.Web.Application.Abstractions
@using WorkoutPlanner.Web.Application.Contracts
@using WorkoutPlanner.Web.Services.Auth
@using WorkoutPlanner.Web.Services.WearOs
@inject IProfileService ProfileService
@inject IAccountService AccountService
@inject IWelcomeGuideStateService WelcomeGuideState
@inject CurrentUserService CurrentUserService
@inject WatchPairingService WatchPairingService
@inject ILogger<Profile> Logger
@inject NavigationManager Navigation

<div class="profile-page">
    <div class="profile-help">
        <HelpButton Topic="HelpContentCatalog.ProfileWeb" />
    </div>
    <div class="profile-shell">
        <main class="profile-main">
            @if (ActiveSection == ProfileSection.Profile)
            {
                <section class="profile-panel">
                    <div class="profile-heading">
                        <p class="profile-kicker">Профиль пользователя</p>
                        <h1>@FullName</h1>
                        <p>@Email</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ProfileMessage))
                    {
                        <div class="profile-success">@ProfileMessage</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(ProfileError))
                    {
                        <div class="auth-error">@ProfileError</div>
                    }

                    <EditForm Model="ProfileInputModel" OnValidSubmit="SaveProfileAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="validation-summary" />

                        <div class="profile-form-grid">
                            <div class="field">
                                <label>Email</label>
                                <input class="auth-input" value="@Email" readonly />
                            </div>

                            <div class="field">
                                <label>Имя</label>
                                <InputText class="auth-input" @bind-Value="ProfileInputModel.FirstName" />
                                <ValidationMessage For="@(() => ProfileInputModel.FirstName)" />
                            </div>

                            <div class="field">
                                <label>Фамилия</label>
                                <InputText class="auth-input" @bind-Value="ProfileInputModel.LastName" />
                                <ValidationMessage For="@(() => ProfileInputModel.LastName)" />
                            </div>

                            <div class="field">
                                <label>Дата рождения</label>
                                <InputDate class="auth-input" @bind-Value="ProfileInputModel.BirthDate" />
                                <ValidationMessage For="@(() => ProfileInputModel.BirthDate)" />
                            </div>

                            <div class="field">
                                <label>Пол</label>
                                <InputSelect class="auth-input" @bind-Value="ProfileInputModel.Gender">
                                    <option value="">Выберите</option>
                                    <option value="Мужской">Мужской</option>
                                    <option value="Женский">Женский</option>
                                    <option value="Не указывать">Не указывать</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => ProfileInputModel.Gender)" />
                            </div>
                        </div>

                        <button class="finish-button auth-button profile-primary-action" type="submit">
                            Сохранить изменения
                        </button>

                        <hr class="profile-divider" />

                        <div class="profile-danger-zone">

                            <button class="profile-danger-action"
                                    type="button"
                                    @onclick="ShowDeleteDialog">
                                Удалить аккаунт
                            </button>

                        </div>
                    </EditForm>
                </section>
            }

            @if (ActiveSection == ProfileSection.Security)
            {
                <section class="profile-panel profile-actions-panel">
                    <div class="profile-heading">
                        <p class="profile-kicker">Безопасность</p>
                        <h1>Настройки безопасности</h1>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(PasswordMessage))
                    {
                        <div class="profile-success">@PasswordMessage</div>
                    }

                    @if (PasswordErrors.Any())
                    {
                        <div class="validation-summary">
                            @foreach (var error in PasswordErrors)
                            {
                                <div>@error</div>
                            }
                        </div>
                    }

                    <EditForm Model="PasswordInputModel" OnValidSubmit="ChangePasswordAsync">
                        <DataAnnotationsValidator />

                        <div class="profile-form-grid">
                            <div class="field">
                                <label>Текущий пароль</label>
                                <InputText class="auth-input" type="password" @bind-Value="PasswordInputModel.CurrentPassword" />
                                <ValidationMessage For="@(() => PasswordInputModel.CurrentPassword)" />
                            </div>

                            <div class="field">
                                <label>Новый пароль</label>
                                <InputText class="auth-input" type="password" @bind-Value="PasswordInputModel.NewPassword" />
                                <ValidationMessage For="@(() => PasswordInputModel.NewPassword)" />
                            </div>

                            <div class="field">
                                <label>Подтверждение нового пароля</label>
                                <InputText class="auth-input" type="password" @bind-Value="PasswordInputModel.ConfirmPassword" />
                                <ValidationMessage For="@(() => PasswordInputModel.ConfirmPassword)" />
                            </div>
                        </div>

                        <button class="profile-secondary-action" type="submit">
                            Изменить пароль
                        </button>
                    </EditForm>

                </section>
            }

            @if (ActiveSection == ProfileSection.Training)
            {
                <section class="profile-panel">
                    <div class="profile-heading">

                        <h1>Настройки тренировок</h1>
                        <p>Краткое знакомство с основными возможностями приложения.</p>
                    </div>

                    <button class="profile-secondary-action"
                            type="button"
                            @onclick="RestartGuideAsync">
                        Повторить знакомство
                    </button>

                </section>
            }

            @if (ActiveSection == ProfileSection.Watches)
            {
                <section class="profile-panel">
                    <div class="profile-heading profile-heading-row">
                        <div>
                            <p class="profile-kicker">Wear OS</p>
                            <h1>Подключённые часы</h1>
                            <p>Подключайте часы и управляйте их доступом к вашему аккаунту.</p>
                        </div>
                        <button class="watch-refresh-action"
                                type="button"
                                disabled="@IsLoadingWatchDevices"
                                aria-busy="@IsLoadingWatchDevices"
                                @onclick="LoadWatchDevicesAsync">
                            @(IsLoadingWatchDevices ? "Обновляем…" : "Обновить список")
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(WatchSuccessMessage))
                    {
                        <div class="profile-success" role="status">@WatchSuccessMessage</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(WatchActionError))
                    {
                        <div class="watch-pairing-error" role="alert">@WatchActionError</div>
                    }

                    <div class="watch-management-grid">
                    <div class="watch-pairing-card">
                        <h2>Подключить новые часы</h2>

                        @if (!string.IsNullOrWhiteSpace(PairingCodeError))
                        {
                            <div class="watch-pairing-error" role="alert">
                                @PairingCodeError
                            </div>
                        }

                        @if (PairingCode is not null)
                        {
                            <div class="watch-pairing-success" role="status">
                                <p class="watch-pairing-status">Код готов</p>
                                <output class="watch-pairing-code"
                                        aria-label="Код подключения часов: @FormatCodeForSpeech(PairingCode.Code)">
                                    @PairingCode.Code
                                </output>
                                <p class="watch-pairing-instruction">
                                    Введите этот код на часах.
                                </p>
                                <p class="watch-pairing-expiry">
                                    Код действует до
                                    <time datetime="@PairingCode.ExpiresAtUtc.ToString("O")">
                                        @FormatExpiry(PairingCode.ExpiresAtUtc) UTC
                                    </time>.
                                </p>
                            </div>
                        }
                        else
                        {
                            <p class="watch-pairing-description">
                                Код состоит из шести цифр и действует ограниченное время.
                                Новый код отменит ранее созданный.
                            </p>
                        }

                        <button class="watch-pairing-action"
                                type="button"
                                disabled="@IsCreatingPairingCode"
                                aria-busy="@IsCreatingPairingCode"
                                @onclick="CreatePairingCodeAsync">
                            @(IsCreatingPairingCode
                                ? "Создаём код…"
                                : PairingCode is null
                                    ? "Создать код"
                                    : "Создать новый код")
                        </button>
                    </div>

                    <div class="watch-devices-panel" aria-busy="@IsLoadingWatchDevices">
                        <div class="watch-devices-heading">
                            <div>
                                <h2>Ваши устройства</h2>
                                @if (WatchDevicesLoaded)
                                {
                                    <p>@ActiveWatchDevices.Count активных</p>
                                }
                            </div>
                            @if (ActiveWatchDevices.Count > 0)
                            {
                                <button class="watch-revoke-all-action"
                                        type="button"
                                        disabled="@IsManagingWatches"
                                        @onclick="ConfirmRevokeAllWatches">
                                    Отключить все
                                </button>
                            }
                        </div>

                        @if (IsLoadingWatchDevices && !WatchDevicesLoaded)
                        {
                            <div class="watch-devices-state" role="status">
                                Загружаем подключённые часы…
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(WatchDevicesError))
                        {
                            <div class="watch-devices-state watch-devices-state-error" role="alert">
                                <p>@WatchDevicesError</p>
                                <button class="watch-inline-action" type="button" @onclick="LoadWatchDevicesAsync">
                                    Повторить
                                </button>
                            </div>
                        }
                        else if (ActiveWatchDevices.Count == 0)
                        {
                            <div class="watch-devices-state">
                                <h3>Нет подключённых часов</h3>
                                <p>Создайте код и введите его в приложении на часах.</p>
                            </div>
                        }
                        else
                        {
                            <div class="watch-device-list">
                                @foreach (var device in ActiveWatchDevices)
                                {
                                    <article class="watch-device-card">
                                        <div class="watch-device-title-row">
                                            <div class="watch-device-title">
                                                @if (EditingWatchDeviceId == device.DeviceId)
                                                {
                                                    <label for="watch-name-@device.Id">Название устройства</label>
                                                    <input id="watch-name-@device.Id"
                                                           class="watch-device-name-input"
                                                           maxlength="120"
                                                           disabled="@(ManagingWatchDeviceId == device.DeviceId)"
                                                           @bind="EditingWatchDisplayName"
                                                           @bind:event="oninput" />
                                                    @if (!string.IsNullOrWhiteSpace(RenameValidationError))
                                                    {
                                                        <span class="watch-device-validation" role="alert">
                                                            @RenameValidationError
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <h3>@device.DisplayName</h3>
                                                }
                                            </div>
                                            <span class="watch-device-status watch-device-status-active">Подключены</span>
                                        </div>

                                        <dl class="watch-device-details">
                                            <div>
                                                <dt>Модель</dt>
                                                <dd>@(device.DeviceModel ?? "Не указана")</dd>
                                            </div>
                                            <div>
                                                <dt>Подключены</dt>
                                                <dd><time datetime="@device.CreatedAtUtc.ToString("O")">@FormatDeviceDate(device.CreatedAtUtc)</time></dd>
                                            </div>
                                            <div>
                                                <dt>Последняя активность</dt>
                                                <dd>
                                                    @if (device.LastSeenAtUtc is { } lastSeenAtUtc)
                                                    {
                                                        <time datetime="@lastSeenAtUtc.ToString("O")">@FormatDeviceDate(lastSeenAtUtc)</time>
                                                    }
                                                    else
                                                    {
                                                        <span>Ещё не было</span>
                                                    }
                                                </dd>
                                            </div>
                                        </dl>

                                        <div class="watch-device-actions">
                                            @if (EditingWatchDeviceId == device.DeviceId)
                                            {
                                                <button class="watch-inline-action watch-inline-action-primary"
                                                        type="button"
                                                        disabled="@(ManagingWatchDeviceId == device.DeviceId || string.IsNullOrWhiteSpace(EditingWatchDisplayName))"
                                                        aria-busy="@(ManagingWatchDeviceId == device.DeviceId)"
                                                        @onclick="() => RenameWatchDeviceAsync(device)">
                                                    @(ManagingWatchDeviceId == device.DeviceId ? "Сохраняем…" : "Сохранить")
                                                </button>
                                                <button class="watch-inline-action"
                                                        type="button"
                                                        disabled="@(ManagingWatchDeviceId == device.DeviceId)"
                                                        @onclick="CancelWatchRename">
                                                    Отмена
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="watch-inline-action"
                                                        type="button"
                                                        disabled="@IsManagingWatches"
                                                        @onclick="() => BeginWatchRename(device)">
                                                    Переименовать
                                                </button>
                                                <button class="watch-inline-action watch-inline-action-danger"
                                                        type="button"
                                                        disabled="@IsManagingWatches"
                                                        @onclick="() => ConfirmRevokeWatch(device)">
                                                    Отключить
                                                </button>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        }

                        @if (RevokedWatchDevices.Count > 0)
                        {
                            <details class="watch-revoked-devices">
                                <summary>Отключённые устройства (@RevokedWatchDevices.Count)</summary>
                                <div class="watch-revoked-list">
                                    @foreach (var device in RevokedWatchDevices)
                                    {
                                        <div class="watch-revoked-device">
                                            <div>
                                                <strong>@device.DisplayName</strong>
                                                <span>@(device.DeviceModel ?? "Модель не указана")</span>
                                            </div>
                                            <span class="watch-device-status">Отключены</span>
                                        </div>
                                    }
                                </div>
                            </details>
                        }
                    </div>
                    </div>
                </section>
            }
        </main>

        <aside class="profile-sidebar" aria-label="Разделы профиля">
            <button class="profile-tab @(ActiveSection == ProfileSection.Profile ? "active" : "")"
                    type="button"
                    @onclick="() => SelectSectionAsync(ProfileSection.Profile)">
                Профиль
            </button>

            <button class="profile-tab @(ActiveSection == ProfileSection.Security ? "active" : "")"
                    type="button"
                    @onclick="() => SelectSectionAsync(ProfileSection.Security)">
                Настройки безопасности
            </button>

            <button class="profile-tab @(ActiveSection == ProfileSection.Training ? "active" : "")"
                    type="button"
                    @onclick="() => SelectSectionAsync(ProfileSection.Training)">
                Настройки тренировок
            </button>

            <button class="profile-tab @(ActiveSection == ProfileSection.Watches ? "active" : "")"
                    type="button"
                    @onclick="() => SelectSectionAsync(ProfileSection.Watches)">
                Часы
            </button>
        </aside>
    </div>
</div>

@if (ShowDeleteConfirmation)
{
    <div class="modal-overlay">

        <div class="modal-window">

            <h2>⚠️ Удаление аккаунта</h2>

            <p>
                Вы действительно хотите удалить аккаунт?
            </p>

            <p style="opacity:.8">
                Будут удалены профиль, история тренировок,
                прогресс и все пользовательские данные.
            </p>

            <div class="history-buttons">

                <button class="secondary-button"
                        @onclick="CloseDeleteDialog">
                    Отмена
                </button>

                <button class="danger-button"
                        @onclick="DeleteAccountAsync">
                    Удалить
                </button>

            </div>

        </div>

    </div>
}

@if (ShowWatchRevokeConfirmation)
{
    <div class="modal-overlay">
        <div class="modal-window watch-confirmation-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="watch-revoke-title">
            <h2 id="watch-revoke-title">
                @(RevokeAllWatchesRequested ? "Отключить все часы?" : "Отключить часы?")
            </h2>
            <p>
                @if (RevokeAllWatchesRequested)
                {
                    <span>Все подключённые часы потеряют доступ к аккаунту. Для повторного подключения потребуется новый код.</span>
                }
                else
                {
                    <span>Устройство «@WatchPendingRevocation?.DisplayName» потеряет доступ к аккаунту. Для повторного подключения потребуется новый код.</span>
                }
            </p>
            <div class="watch-confirmation-actions">
                <button class="secondary-button"
                        type="button"
                        disabled="@IsManagingWatches"
                        @onclick="CloseWatchRevokeConfirmation">
                    Отмена
                </button>
                <button class="danger-button"
                        type="button"
                        disabled="@IsManagingWatches"
                        aria-busy="@IsManagingWatches"
                        @onclick="RevokeConfirmedWatchesAsync">
                    @(IsManagingWatches ? "Отключаем…" : "Отключить")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private UserProfile? CurrentProfile { get; set; }

    private ProfileInput ProfileInputModel { get; } = new();

    private PasswordInput PasswordInputModel { get; } = new();

    private List<string> PasswordErrors { get; } = new();

    private string Email => CurrentProfile?.Email ?? string.Empty;

    private string FullName => string.Join(" ", new[]
    {
        ProfileInputModel.FirstName,
        ProfileInputModel.LastName
    }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private string? ProfileMessage { get; set; }

    private string? ProfileError { get; set; }

    private string? PasswordMessage { get; set; }

    private CreateWatchPairingCodeResponse? PairingCode { get; set; }

    private string? PairingCodeError { get; set; }

    private bool IsCreatingPairingCode { get; set; }

    private IReadOnlyList<WatchDeviceResponse> WatchDevices { get; set; } = [];

    private IReadOnlyList<WatchDeviceResponse> ActiveWatchDevices =>
        WatchDevices.Where(x => !x.IsRevoked).ToList();

    private IReadOnlyList<WatchDeviceResponse> RevokedWatchDevices =>
        WatchDevices.Where(x => x.IsRevoked).ToList();

    private bool WatchDevicesLoaded { get; set; }

    private bool IsLoadingWatchDevices { get; set; }

    private string? WatchDevicesError { get; set; }

    private string? WatchActionError { get; set; }

    private string? WatchSuccessMessage { get; set; }

    private string? EditingWatchDeviceId { get; set; }

    private string EditingWatchDisplayName { get; set; } = string.Empty;

    private string? RenameValidationError { get; set; }

    private string? ManagingWatchDeviceId { get; set; }

    private WatchDeviceResponse? WatchPendingRevocation { get; set; }

    private bool RevokeAllWatchesRequested { get; set; }

    private bool IsRevokingWatches { get; set; }

    private bool IsManagingWatches =>
        ManagingWatchDeviceId is not null || IsRevokingWatches;

    private bool ShowWatchRevokeConfirmation =>
        WatchPendingRevocation is not null || RevokeAllWatchesRequested;

    private readonly CancellationTokenSource pairingCodeCancellation = new();

    private bool ShowDeleteConfirmation;

    private ProfileSection ActiveSection { get; set; } = ProfileSection.Profile;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        CurrentProfile = await ProfileService.GetCurrentProfileAsync();

        if (CurrentProfile is null)
        {
            Navigation.NavigateTo("/profile/setup");
            return;
        }

        ProfileInputModel.FirstName = CurrentProfile.FirstName;
        ProfileInputModel.LastName = CurrentProfile.LastName;
        ProfileInputModel.BirthDate = CurrentProfile.BirthDate;
        ProfileInputModel.Gender = CurrentProfile.Gender;
    }

    private async Task SaveProfileAsync()
    {
        ProfileMessage = null;
        ProfileError = null;

        if (CurrentProfile is null)
        {
            ProfileError = "Профиль не найден.";
            return;
        }

        var updated = await ProfileService.UpdateCurrentProfileAsync(
            new ProfileUpdateRequest(
                ProfileInputModel.FirstName,
                ProfileInputModel.LastName,
                ProfileInputModel.BirthDate,
                ProfileInputModel.Gender));
        if (!updated)
        {
            ProfileError = "Профиль не найден.";
            return;
        }
        await LoadAsync();

        ProfileMessage = "Данные профиля сохранены.";
    }

    private async Task ChangePasswordAsync()
    {
        PasswordErrors.Clear();
        PasswordMessage = null;

        var result = await AccountService.ChangePasswordAsync(
            new PasswordChangeRequest(
                PasswordInputModel.CurrentPassword,
                PasswordInputModel.NewPassword));

        if (!result.Succeeded)
        {
            PasswordErrors.AddRange(result.Errors);

            return;
        }

        PasswordInputModel.CurrentPassword = string.Empty;
        PasswordInputModel.NewPassword = string.Empty;
        PasswordInputModel.ConfirmPassword = string.Empty;
        PasswordMessage = "Пароль изменен.";
    }

    private async Task RestartGuideAsync()
    {
        await WelcomeGuideState.ResetAsync();
        Navigation.NavigateTo("/welcome-guide");
    }

    private async Task CreatePairingCodeAsync()
    {
        if (IsCreatingPairingCode)
            return;

        IsCreatingPairingCode = true;
        PairingCodeError = null;

        try
        {
            var userId = await CurrentUserService.GetRequiredUserIdAsync();
            PairingCode = await WatchPairingService.CreateCodeAsync(
                userId,
                pairingCodeCancellation.Token);
        }
        catch (OperationCanceledException) when (pairingCodeCancellation.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to create a watch pairing code.");
            PairingCodeError = "Не удалось создать код подключения. Попробуйте ещё раз.";
        }
        finally
        {
            IsCreatingPairingCode = false;
        }
    }

    private async Task SelectSectionAsync(ProfileSection section)
    {
        ActiveSection = section;
        if (section == ProfileSection.Watches && !WatchDevicesLoaded)
            await LoadWatchDevicesAsync();
    }

    private async Task LoadWatchDevicesAsync()
    {
        if (IsLoadingWatchDevices)
            return;

        IsLoadingWatchDevices = true;
        WatchDevicesError = null;
        try
        {
            var userId = await CurrentUserService.GetRequiredUserIdAsync();
            WatchDevices = await WatchPairingService.GetDevicesAsync(
                userId,
                pairingCodeCancellation.Token);
            WatchDevicesLoaded = true;
        }
        catch (OperationCanceledException) when (pairingCodeCancellation.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load watch devices.");
            WatchDevicesError = "Не удалось загрузить список часов. Попробуйте ещё раз.";
        }
        finally
        {
            IsLoadingWatchDevices = false;
        }
    }

    private void BeginWatchRename(WatchDeviceResponse device)
    {
        WatchActionError = null;
        WatchSuccessMessage = null;
        RenameValidationError = null;
        EditingWatchDeviceId = device.DeviceId;
        EditingWatchDisplayName = device.DisplayName;
    }

    private void CancelWatchRename()
    {
        EditingWatchDeviceId = null;
        EditingWatchDisplayName = string.Empty;
        RenameValidationError = null;
    }

    private async Task RenameWatchDeviceAsync(WatchDeviceResponse device)
    {
        if (ManagingWatchDeviceId is not null)
            return;

        var displayName = EditingWatchDisplayName.Trim();
        if (displayName.Length is 0 or > 120)
        {
            RenameValidationError = "Введите название длиной от 1 до 120 символов.";
            return;
        }

        ManagingWatchDeviceId = device.DeviceId;
        WatchActionError = null;
        WatchSuccessMessage = null;
        RenameValidationError = null;
        try
        {
            var userId = await CurrentUserService.GetRequiredUserIdAsync();
            var renamed = await WatchPairingService.RenameAsync(
                userId,
                device.DeviceId,
                displayName,
                pairingCodeCancellation.Token);
            if (renamed is null)
            {
                WatchActionError = "Часы уже отключены или больше недоступны.";
                await LoadWatchDevicesAsync();
                return;
            }

            WatchDevices = WatchDevices
                .Select(x => x.DeviceId == renamed.DeviceId ? renamed : x)
                .ToList();
            CancelWatchRename();
            WatchSuccessMessage = "Название часов сохранено.";
        }
        catch (OperationCanceledException) when (pairingCodeCancellation.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to rename watch device {WatchDeviceId}.", device.Id);
            WatchActionError = "Не удалось переименовать часы. Попробуйте ещё раз.";
        }
        finally
        {
            ManagingWatchDeviceId = null;
        }
    }

    private void ConfirmRevokeWatch(WatchDeviceResponse device)
    {
        WatchActionError = null;
        WatchSuccessMessage = null;
        WatchPendingRevocation = device;
        RevokeAllWatchesRequested = false;
    }

    private void ConfirmRevokeAllWatches()
    {
        WatchActionError = null;
        WatchSuccessMessage = null;
        WatchPendingRevocation = null;
        RevokeAllWatchesRequested = true;
    }

    private void CloseWatchRevokeConfirmation()
    {
        if (IsRevokingWatches)
            return;

        WatchPendingRevocation = null;
        RevokeAllWatchesRequested = false;
    }

    private async Task RevokeConfirmedWatchesAsync()
    {
        if (IsRevokingWatches)
            return;

        var revokeAll = RevokeAllWatchesRequested;
        var device = WatchPendingRevocation;
        IsRevokingWatches = true;
        ManagingWatchDeviceId = device?.DeviceId;
        WatchActionError = null;
        try
        {
            var userId = await CurrentUserService.GetRequiredUserIdAsync();
            if (revokeAll)
            {
                await WatchPairingService.RevokeAllAsync(
                    userId,
                    pairingCodeCancellation.Token);
                WatchSuccessMessage = "Все часы отключены.";
            }
            else if (device is not null)
            {
                var revoked = await WatchPairingService.RevokeAsync(
                    userId,
                    device.DeviceId,
                    pairingCodeCancellation.Token);
                WatchSuccessMessage = revoked
                    ? $"Часы «{device.DisplayName}» отключены."
                    : "Часы уже были отключены.";
            }

            WatchPendingRevocation = null;
            RevokeAllWatchesRequested = false;
            await LoadWatchDevicesAsync();
        }
        catch (OperationCanceledException) when (pairingCodeCancellation.IsCancellationRequested)
        {
            return;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to revoke watch access.");
            WatchActionError = "Не удалось отключить часы. Попробуйте ещё раз.";
        }
        finally
        {
            ManagingWatchDeviceId = null;
            IsRevokingWatches = false;
        }
    }

    private static string FormatExpiry(DateTime expiresAtUtc) =>
        expiresAtUtc.ToUniversalTime().ToString("dd.MM.yyyy, HH:mm");

    private static string FormatDeviceDate(DateTime utcDate) =>
        DateTime.SpecifyKind(utcDate, DateTimeKind.Utc)
            .ToLocalTime()
            .ToString("dd.MM.yyyy, HH:mm");

    private static string FormatCodeForSpeech(string code) =>
        string.Join(' ', code.ToCharArray());

    private void ShowDeleteDialog()
    {
        ShowDeleteConfirmation = true;
    }

    private void CloseDeleteDialog()
    {
        ShowDeleteConfirmation = false;
    }

    private async Task DeleteAccountAsync()
    {
        ShowDeleteConfirmation = false;

        try
        {
            var result = await AccountService.DeleteCurrentAccountAsync();

            if (!result.Succeeded)
            {
                ProfileError = "Не удалось удалить аккаунт. Попробуйте ещё раз.";
                return;
            }

            CurrentProfile = null;
            await AccountService.SignOutAsync();
            Navigation.NavigateTo("/account/register", forceLoad: true);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to delete the current account.");
            ProfileError = "Не удалось удалить аккаунт. Попробуйте ещё раз.";
        }
    }

    private sealed class ProfileInput
    {
        [Required(ErrorMessage = "Введите имя.")]
        [MaxLength(80, ErrorMessage = "Имя слишком длинное.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Введите фамилию.")]
        [MaxLength(80, ErrorMessage = "Фамилия слишком длинная.")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Укажите дату рождения.")]
        public DateTime? BirthDate { get; set; }

        [Required(ErrorMessage = "Выберите пол.")]
        public string Gender { get; set; } = string.Empty;
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessage = "Введите текущий пароль.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Введите новый пароль.")]
        [MinLength(6, ErrorMessage = "Пароль должен быть не короче 6 символов.")]
        public string NewPassword { get; set; } = string.Empty;

        [Compare(nameof(NewPassword), ErrorMessage = "Пароли не совпадают.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private static string TranslateIdentityError(IdentityError error)
    {
        return error.Code switch
        {
            "PasswordMismatch" => "Текущий пароль указан неверно.",
            "PasswordTooShort" => "Пароль слишком короткий.",
            "PasswordRequiresDigit" => "Пароль должен содержать хотя бы одну цифру.",
            "PasswordRequiresLower" => "Пароль должен содержать хотя бы одну строчную латинскую букву.",
            "PasswordRequiresUpper" => "Пароль должен содержать хотя бы одну заглавную латинскую букву.",
            "PasswordRequiresNonAlphanumeric" => "Пароль должен содержать хотя бы один специальный символ.",
            _ => error.Description
        };
    }

