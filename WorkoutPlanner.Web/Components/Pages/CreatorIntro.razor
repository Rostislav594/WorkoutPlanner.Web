@page "/creator-intro"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager Navigation

<WorkoutPlanner.UI.Components.CreatorIntro IsBusy="_isBusy" OnCompleted="ContinueAsync" />

@code {
    private bool _isBusy;

    private Task ContinueAsync()
    {
        if (_isBusy)
            return Task.CompletedTask;

        _isBusy = true;
        Navigation.NavigateTo("/profile/setup", replace: true);
        return Task.CompletedTask;
    }
}
