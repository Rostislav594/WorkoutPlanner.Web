@page "/calendar"
@rendermode InteractiveServer

@using WorkoutPlanner.Web.Models
@using WorkoutPlanner.Web.Services

@inject TrainingPlanService TrainingPlanService
@inject WorkoutDayService WorkoutDayService

<div class="page-content calendar-page">
    <h1 style="text-align:center;">
       Календарь
    </h1>

    @if (SelectedCalendarDay != null)
{
    <div class="modal-overlay"
         @onclick="CloseCalendarWindow">

        <div class="modal-window"
             @onclick:stopPropagation="true">

                <div class="calendar-modal-header">

                    <h2>
                        📅 @SelectedCalendarDay.Value.ToString("dd.MM.yyyy")
                    </h2>

                    @if (SelectedWorkoutDay != null)
                    {
                        <button class="danger-button small-delete-button"
                                @onclick="DeleteWorkoutDay">
                            🗑
                        </button>
                    }

                </div>

                @if (SelectedWorkoutDay != null)
                {
                    var plan =
                        TrainingPlans.FirstOrDefault(
                            p => p.Id ==
                            SelectedWorkoutDay.TrainingPlanId);

                    <p>
                        Тренировка:
                    </p>

                    <h3>
                        @plan?.WorkoutName
                    </h3>
                }
                else
                {
                    @if (CanAssignWorkout)
                    {
                        <p>
                            Тренировка не назначена
                        </p>
                    }
                    else
                    {
                        <p>
                            Этот день уже прошёл.
                            Назначить тренировку невозможно.
                        </p>
                    }

                    <div class="modal-actions">

                        @if (CanAssignWorkout)
                        {
                            <button class="secondary-button"
                                    @onclick="OpenWorkoutPicker">
                                Назначить тренировку
                            </button>
                        }

                        <button class="secondary-button"
                                @onclick="CloseCalendarWindow">
                            Закрыть
                        </button>

                    </div>

                    @if (ShowWorkoutSelector)
                    {
                        <div class="mt-3">

                            <select class="form-select"
                                    @bind="SelectedPlanId">

                                <option value="0">
                                    Выберите тренировку
                                </option>

                                @foreach (var plan in TrainingPlans)
                                {
                                    <option value="@plan.Id">
                                        @plan.WorkoutName
                                    </option>
                                }

                            </select>

                            <button class="workout-select-button mt-3"
                                    disabled="@(SelectedPlanId == 0)"
                                    @onclick="AssignSelectedWorkout">
                                ✅ Назначить
                            </button>

                        </div>
                    }

                    @if (ShowWorkoutPicker)
                    {
                        <div class="modal-overlay"
                             @onclick="CloseWorkoutPicker">

                            <div class="modal-window"
                                 @onclick:stopPropagation="true">

                                <div class="workout-picker-grid">

                                    @foreach (var plan in TrainingPlans)
                                    {
                                        <div class="workout-picker-card"
                                             @onclick="() => AssignWorkoutFromPicker(plan.Id)">

                                            <div class="workout-picker-name">
                                                @plan.WorkoutName
                                            </div>

                                        </div>
                                    }

                                </div>

                                <div class="workout-picker-footer">
                                    <button class="secondary-button"
                                            @onclick="CloseWorkoutPicker">
                                        Отмена
                                    </button>
                                </div>

                            </div>

                        </div>
                    }
                }
            
        </div>

    </div>
}
    <hr />

    <div class="month-header">

        <button class="month-button"
                @onclick="PreviousMonth">
            ◀
        </button>

        <h2 class="month-title">
            @CurrentMonth.ToString("MMMM yyyy")
        </h2>

        <button class="month-button"
                @onclick="NextMonth">
            ▶
        </button>

    </div>

        <div class="weekdays">
            <div>Пн</div>
            <div>Вт</div>
            <div>Ср</div>
            <div>Чт</div>
            <div>Пт</div>
            <div>Сб</div>
            <div>Вс</div>
        </div>
        
    @{
        var firstDay =
            new DateTime(
                CurrentMonth.Year,
                CurrentMonth.Month,
                1);

        int startOffset =
            ((int)firstDay.DayOfWeek + 6) % 7;
    }

        <div class="calendar-grid">
        @for (int i = 0; i < startOffset; i++)
        {
            <div class="calendar-empty"></div>
        }

        @for (int i = 1; i <= DateTime.DaysInMonth(
                CurrentMonth.Year,
                CurrentMonth.Month); i++)
        {
            var currentDate =
                new DateTime(
                    CurrentMonth.Year,
                    CurrentMonth.Month,
                    i);

            var workout =
                WorkoutDays.FirstOrDefault(x =>
                    x.Date.Date == currentDate.Date);


            <div class="calendar-day
                @(workout != null ? "has-workout" : "")
                @(currentDate.Date == DateTime.Today ? "today-day" : "")
                @(SelectedCalendarDay == currentDate ? "selected-day" : "")"
                 @onclick="() => OpenDay(currentDate)">

                <div>
                    @i
                </div>

                @if (workout != null)
                {
                    var plan =
                        TrainingPlans.FirstOrDefault(
                            p => p.Id == workout.TrainingPlanId);

                    var markerClass =
                        plan?.WorkoutName switch
                        {
                            "Верх 1" => "marker-upper1",
                            "Низ 1" => "marker-lower1",
                            "Верх 2" => "marker-upper2",
                            "Низ 2" => "marker-lower2",
                            _ => ""
                        };

                    <div class="calendar-marker @markerClass">

                        @if (workout.IsCompleted)
                        {
                            <span>✅ </span>
                        }

                        <span class="calendar-marker-full">
                            @plan?.WorkoutName
                        </span>

                        <span class="calendar-marker-short">
                            @GetWorkoutShortName(plan?.WorkoutName)
                        </span>

                    </div>
                }

            </div>
        }

        </div>
    
</div>

@code
{
        DateTime SelectedDate = DateTime.Today;
        DateTime CurrentMonth = DateTime.Today;

    List<TrainingPlan> TrainingPlans = new();
    List<WorkoutDay> WorkoutDays = new();

    protected override async Task OnInitializedAsync()
    {
        TrainingPlans =
            await TrainingPlanService
                .GetTrainingPlansAsync();

        WorkoutDays =
            await WorkoutDayService
                .GetDaysAsync();
    }

    async Task AssignWorkout(int planId)
    {
        await WorkoutDayService.SaveDayAsync(
            SelectedDate,
            planId);

        WorkoutDays =
            await WorkoutDayService
                .GetDaysAsync();
    }

    async Task AssignWorkoutFromDialog(int planId)
    {
        if (SelectedCalendarDay == null)
            return;

        await WorkoutDayService.SaveDayAsync(
            SelectedCalendarDay.Value,
            planId);

        WorkoutDays =
            await WorkoutDayService.GetDaysAsync();

        SelectedWorkoutDay =
            WorkoutDays.FirstOrDefault(x =>
                x.Date.Date == SelectedCalendarDay.Value.Date);

        ShowWorkoutSelector = false;
    }

    async Task AssignWorkoutFromPicker(int planId)
    {
        if (SelectedCalendarDay == null)
            return;

        if (!CanAssignWorkout)
            return;

        await WorkoutDayService.SaveDayAsync(
            SelectedCalendarDay.Value,
            planId);

        WorkoutDays =
            await WorkoutDayService.GetDaysAsync();

        CloseWorkoutPicker();
        CloseCalendarWindow();
    }

    async Task AssignSelectedWorkout()
    {
        if (SelectedPlanId == 0 ||
            SelectedCalendarDay == null)
            return;

        if (!CanAssignWorkout)
            return;

        await WorkoutDayService.SaveDayAsync(
            SelectedCalendarDay.Value,
            SelectedPlanId);

        WorkoutDays =
            await WorkoutDayService.GetDaysAsync();

        SelectedWorkoutDay =
            WorkoutDays.FirstOrDefault(x =>
                x.Date.Date == SelectedCalendarDay.Value.Date);

        ShowWorkoutSelector = false;
        SelectedPlanId = 0;

        CloseCalendarWindow();
    }

    DateTime? SelectedCalendarDay;
    WorkoutDay? SelectedWorkoutDay;

    void OpenDay(DateTime date)
    {
        SelectedDate = date;

        SelectedCalendarDay = date;

        SelectedWorkoutDay =
            WorkoutDays.FirstOrDefault(x =>
                x.Date.Date == date.Date);
    }
    void CloseCalendarWindow()
    {
        SelectedCalendarDay = null;
        SelectedWorkoutDay = null;

        ShowWorkoutPicker = false;
    }
    async Task DeleteWorkoutDay()
    {
        if (SelectedWorkoutDay == null)
            return;

        await WorkoutDayService.DeleteDayAsync(
            SelectedWorkoutDay.Id);

        WorkoutDays =
            await WorkoutDayService.GetDaysAsync();

        CloseCalendarWindow();
    }
    void PreviousMonth()
    {
        CurrentMonth =
            CurrentMonth.AddMonths(-1);
    }

    void NextMonth()
    {
        CurrentMonth =
            CurrentMonth.AddMonths(1);
    }

    string GetWorkoutShortName(string? workoutName)
    {
        return workoutName switch
        {
            "Верх 1" => "В1",
            "Низ 1" => "Н1",
            "Верх 2" => "В2",
            "Низ 2" => "Н2",
            _ => workoutName ?? ""
        };
    }

    void OpenWorkoutPicker()
    {
        ShowWorkoutPicker = true;
    }

    void CloseWorkoutPicker()
    {
        ShowWorkoutPicker = false;
    }

    bool ShowWorkoutSelector = false;
    bool ShowWorkoutPicker = false;
    private bool CanAssignWorkout =>
    SelectedCalendarDay != null &&
    SelectedCalendarDay.Value.Date >= DateTime.Today;
    int SelectedPlanId = 0;
}
