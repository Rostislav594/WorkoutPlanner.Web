    const string GrowthLabel = "📈 Рост";
    const string WorkoutCountLabel = "📅 Тренировок";
    const string NoDataText = "\u0414\u0430\u043D\u043D\u044B\u0445 \u043F\u043E\u043A\u0430 \u043D\u0435\u0442";
    const string CloseButtonText = "\u0417\u0430\u043A\u0440\u044B\u0442\u044C";
    const string ChartSubtitle = "\u0414\u0438\u043D\u0430\u043C\u0438\u043A\u0430 \u0440\u043E\u0441\u0442\u0430 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0433\u043E \u0438\u043D\u0434\u0435\u043A\u0441\u0430";
    const string ClearProgressButton = "\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441";
    const string BestGrowthLabel = "🎯 Лучший результат";
    const string ClearDialogTitle = "\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u0435\u0441\u044C \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441?";
    const string ClearDialogText = "\u0412\u0441\u0435 \u0433\u0440\u0430\u0444\u0438\u043A\u0438 \u0431\u0443\u0434\u0443\u0442 \u043E\u0447\u0438\u0449\u0435\u043D\u044B.";
    const string DeleteButtonText = "\u0423\u0434\u0430\u043B\u0438\u0442\u044C";
    const string CancelButtonText = "\u041E\u0442\u043C\u0435\u043D\u0430";
    // ======================================================


    // ======================================================
    // State
            decimal ChartAxisMin = 0;
            decimal ChartAxisMax = 5;
            decimal ExerciseGrowth => BestGrowth;
            decimal ExerciseBest => 18;
            string? SelectedExercise;
            string? SelectedExerciseWorkout;
            string? SelectedWorkout;
            string? SelectedWorkoutMenu;
            string? SelectedExerciseForReset;
            string? WorkoutToClear;
            string ToastMessage = "";
            int ExerciseCount => CurrentChartData.Count;
            int ChartRenderKey = 0;
            int SelectedTab = 0;
            bool ShowClearProgressDialog = false;
            bool ShowExerciseResetDialog;
            bool ShowToast;

            decimal CurrentGrowth =>
            CurrentChartData.Any()
                ? CurrentChartData.Last().Percent
                : 0;

            decimal BestGrowth =>
                CurrentChartData.Any()
                    ? CurrentChartData.Max(x => x.Percent)
                    : 0;

            string GrowthColorClass =>
            LastTrend > 0
                ? "green"
                : LastTrend < 0
                    ? "red"
                    : "neutral";

            decimal LastTrend
            {
                get
                {
                    if (CurrentChartData.Count < 2)
                        return 0;

                    return Math.Round(
                        CurrentChartData[^1].Percent -
                        CurrentChartData[^2].Percent,
                        2);
                }
            }
    // ======================================================


    // ======================================================
    // Collections
        List<ProgressSnapshot> WorkoutHistory = new();
        List<ProgressChartPoint> CurrentChartData = new();
        List<string> WorkoutExercises = new();

        List<WorkoutCardItem> WorkoutCards =
            [
                new() { Name = "Верх 1" },
                new() { Name = "Низ 1" },
                new() { Name = "Верх 2" },
                new() { Name = "Низ 2" }
            ];

            List<ExerciseCardItem> ExerciseCards =
            [
                new() { Name = "Жим лёжа" },
                new() { Name = "Тяга штанги" },
                new() { Name = "Жим сидя" },
                new() { Name = "Подтягивания" },
                new() { Name = "Подъём на бицепс" },
                new() { Name = "Французский жим" }
            ];

    // ======================================================


    // ======================================================
    // Chart
        ApexChartOptions<ProgressChartPoint> ChartOptions =
                BuildChartOptions(0, 5);

        async Task OpenProgress(
                string workoutName)
        {
            SelectedWorkout = workoutName;

            WorkoutHistory =
                await ProgressService
                    .GetWorkoutProgressAsync(
                        workoutName);

            CurrentChartData.Clear();

            if (!WorkoutHistory.Any())
            {
                ResetChartScale();
                return;
            }

            var baseScore =
                WorkoutHistory.First().Score;

            foreach (var item in WorkoutHistory)
            {
                var percent =
                    baseScore <= 0
                        ? 0
                        : ((item.Score - baseScore)
                        / baseScore) * 100;

                CurrentChartData.Add(
                    new ProgressChartPoint
                    {
                        Label =
                            item.Date.ToString("dd.MM"),

                        Percent =
                            Math.Round(
                                (decimal)percent,
                                2)
                    });
            }

            UpdateChartScale();
        }
        void CloseProgress()
        {
            SelectedWorkout = null;

            WorkoutHistory.Clear();

            CurrentChartData.Clear();

            ResetChartScale();
        }

        void UpdateChartScale()
        {
            if (!CurrentChartData.Any())
            {
                ResetChartScale();
                return;
            }

            var minPercent =
                CurrentChartData.Min(x => x.Percent);

            var maxPercent =
                CurrentChartData.Max(x => x.Percent);

            ChartAxisMin =
                minPercent < 0
                    ? -GetNiceAxisLimit(Math.Abs(minPercent) * 1.25m)
                    : 0;

            ChartAxisMax =
                maxPercent > 0
                    ? GetNiceAxisLimit(maxPercent * 1.25m)
                    : 5;

            if (ChartAxisMax < 3 && maxPercent > 0)
            {
                ChartAxisMax = 3;
            }

            ChartOptions =
             BuildChartOptions(
            ChartAxisMin,
            ChartAxisMax);

            ChartRenderKey++;
        }

        async Task ClearProgress()
        {
            if (!string.IsNullOrEmpty(WorkoutToClear))
            {
                await ProgressService
                    .ClearWorkoutProgressAsync(WorkoutToClear);

                if (SelectedWorkout == WorkoutToClear)
                {
                    WorkoutHistory.Clear();
                    CurrentChartData.Clear();
                }
            }

            CloseClearDialog();
            await ShowSuccessToast("История успешно удалена.");
            StateHasChanged();
        }
        async Task ShowSuccessToast(string message)
        {
            ToastMessage = message;
            ShowToast = true;

            StateHasChanged();

            await Task.Delay(2500);

            ShowToast = false;

            StateHasChanged();
        }


    async Task OpenExerciseList(string workoutName)
    {
        SelectedExerciseWorkout = workoutName;

        WorkoutExercises =
            await ProgressService.GetWorkoutExercisesAsync(workoutName);
    }

        async Task OpenExerciseProgress(string exerciseName)
{
    if (string.IsNullOrWhiteSpace(SelectedExerciseWorkout))
        return;

    SelectedExercise = exerciseName;

    CurrentChartData =
        await ProgressService.GetExerciseChartAsync(
            SelectedExerciseWorkout,
            exerciseName);

    UpdateChartScale();
}
        static ApexChartOptions<ProgressChartPoint> BuildChartOptions(
            decimal min,
            decimal max)
        {
            return new()
            {
                Chart = new Chart
                {
                    Type = ChartType.Line,

                    Toolbar = new Toolbar
                    {
                        Show = false
                    },

                    Zoom = new Zoom
                    {
                        Enabled = false
                    }
                },

            
                Colors = new List<string>
                {
                    "#3fb950"
                },
                DataLabels = new DataLabels
                {
                    Enabled = true,
                    OffsetY = -14,
                    Formatter = @"function(value) {
                        if (value === null || value === undefined) {
                            return '';
                        }

                        const rounded = Math.round(value * 100) / 100;
                        const text = Number.isInteger(rounded)
                            ? rounded.toFixed(0)
                            : rounded.toString();

                        return text + '%';
                    }",

                    Background = new DataLabelsBackground
                    {
                        Enabled = false
                    },

                    Style = new DataLabelsStyle
                    {
                        FontSize = "14px",
                        FontWeight = "700",
                        Colors = new List<string>
                        {
                            "#5cff6d"
                        }
                    }
                },

                Stroke = new Stroke
                {
                    Show = true,
                    Curve = Curve.Straight,
                    Width = 4
                },

                Fill = new Fill
                {
                    Type = FillType.Solid,
                    Opacity = 1
                },

                Markers = new Markers
                {
                    Size = 6,
                    StrokeWidth = 2,
                    StrokeColors = new List<string>
                    {
                        "#ffffff"
                    }
                },

                Yaxis = new List<YAxis>
    {
        new()
        {
            Min = (double)min,
            Max = (double)max,

            Labels = new YAxisLabels
            {
                Formatter =
                    @"function(value) {
                        return value + '%';
                    }",

                Style = new AxisLabelStyle
                {
                    Colors = new List<string>
                    {
                        "#d0d0d0"
                    }
                }
            }

    }
    },
                Tooltip = new Tooltip
                {
                    Enabled = false
                },
                Xaxis = new XAxis
                {
                    Labels = new XAxisLabels
                    {
                        Style = new AxisLabelStyle
                        {
                            Colors = new List<string>
                {
                    "#d0d0d0"
                }
                        }
                    }
                },

                Grid = new Grid
                {
                    BorderColor = "#202020"
                }
            };
        }
    // ======================================================


    // ======================================================
    // Workout Progress
    // ======================================================


    // ======================================================
    // Exercise Progress
    // ======================================================


    // ======================================================
    // Statistics
        static Annotations BuildPointAnnotations(
            IReadOnlyList<ProgressChartPoint>? points)
        {
            return new()
            {
                Points = points?
                    .Select(point =>
                        new AnnotationsPoint
                        {
                            X = point.Label,
                            Y = (double)point.Percent,

                            Marker = new AnnotationMarker
                            {
                                Size = 0
                            },

                            Label = new Label
                            {
                                Text = FormatPercent(point.Percent),
                                OffsetY = -18,
                                BorderColor = "transparent",

                                Style = new Style
                                {
                                    Background = "transparent",
                                    Color = "#5cff6d",
                                    FontSize = "14px",
                                    FontWeight = "700"
                                }
                            }
                        })
                    .ToList()
            };
        }

        static string FormatPercent(decimal value)
        {
            var rounded =
                Math.Round(value, 2);

            return $"{rounded:0.##}%";
        }
        static decimal GetNiceAxisLimit(decimal value)
        {
            if (value <= 0)
            {
                return 1;
            }

            var magnitude =
                (decimal)Math.Pow(
                    10,
                    Math.Floor(
                        Math.Log10((double)value)));

            var normalized =
                value / magnitude;

            var niceNormalized =
                normalized <= 1 ? 1 :
                normalized <= 2 ? 2 :
                normalized <= 3 ? 3 :
                normalized <= 5 ? 5 :
                10;

            return niceNormalized * magnitude;
        }
