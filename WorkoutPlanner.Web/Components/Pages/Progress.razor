@page "/progress"
@rendermode InteractiveServer

@using WorkoutPlanner.Web.Models
@using WorkoutPlanner.Web.Services

@inject ProgressService ProgressService

<div class="page-content">

    <!-- ===== Заголовок страницы ===== -->

    <h1 style="text-align:center;">
        @PageTitle
    </h1>

    <!-- ===== Переключатель вкладок ===== -->

    <div class="progress-tabs">

        <button class="tab-button @(SelectedTab == 0 ? "active" : "")"
                @onclick="() =>
                            {
                                SelectedWorkoutMenu = null;
                                SelectedTab = 0;
                            }">
            @ExercisesTab
        </button>

        <button class="tab-button @(SelectedTab == 1 ? "active" : "")"
                @onclick="() =>
                            {
                                SelectedWorkoutMenu = null;
                                SelectedTab = 1;
                            }">
            @WorkoutsTab
        </button>

    </div>

    <!-- ===== Вкладка "Упражнения" ===== -->
    @if (SelectedTab == 0)
    {
        <div class="progress-workouts">

            @foreach (var workout in WorkoutCards)
            {
                <WorkoutProgressCard Title="@workout.Name"
                                     OnClick="() => OpenExerciseList(workout.Name)" />
            }

        </div>
    }

    @if (SelectedExerciseWorkout != null)
    {
        <div class="modal-overlay"
             @onclick="CloseExerciseList">

            <div class="modal-window"
                 @onclick:stopPropagation="true">

                <h2>
                    @SelectedExerciseWorkout
                </h2>

                @if (!WorkoutExercises.Any())
                {
                    <p>@NoDataText</p>
                }
                else
                {
                    @foreach (var exercise in WorkoutExercises)
                    {
                    <div class="progress-card">

                        <div class="progress-card-header">

                            <div class="progress-card-title"
                                 @onclick="() => OpenExerciseProgress(exercise)">

                                📈 @exercise

                            </div>

                            <button class="card-menu-button"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => ShowExerciseReset(exercise)">

                                ⋮

                            </button>

                        </div>

                    </div>
                    }
                }

            </div>

        </div>
    }

    @if (SelectedExercise != null)
    {
        <ExerciseProgressDialog ExerciseName="@SelectedExercise"
                                ChartData="@CurrentChartData"
                                ChartOptions="@ChartOptions"
                                ChartRenderKey="@ChartRenderKey"
                                ExerciseGrowth="@ExerciseGrowth"
                                ExerciseCount="@ExerciseCount"
                                LastTrend="@LastTrend"
                                GrowthColorClass="@GrowthColorClass"
                                ChartSubtitle="@ChartSubtitle"
                                ChartSeriesName="@ChartSeriesName"
                                SinglePointNote="@SinglePointNote"
                                NoDataText="@NoDataText"
                                CloseButtonText="@CloseButtonText"
                                OnClose="CloseExerciseProgress" />
    }
    @if (ShowExerciseResetDialog)
    {
        <div class="modal-overlay"
             @onclick="CloseExerciseReset">

            <div class="modal-window"
                 @onclick:stopPropagation="true">

                <h2>
                    @SelectedExerciseForReset
                </h2>

                <p>
                    Здесь позже будет сброс прогресса упражнения.
                </p>

               <div class="dialog-buttons">

                <button class="secondary-button"
                        @onclick="CloseExerciseReset">
                    @CancelButtonText
                </button>

                <button class="danger-button"
                        @onclick="ResetExerciseProgress">
                    @DeleteButtonText
                </button>

</div>

            </div>

        </div>

        async Task ResetExerciseProgress()
        {
            ShowExerciseResetDialog = false;

            if (SelectedExerciseWorkout != null &&
            SelectedExerciseForReset != null)
            {
                await ProgressService.ClearExerciseProgressAsync(
                    SelectedExerciseWorkout!,
                    SelectedExerciseForReset!);

                WorkoutExercises =
                    await ProgressService.GetWorkoutExercisesAsync(
                        SelectedExerciseWorkout!);

                if (SelectedExercise == SelectedExerciseForReset)
                {
                    CloseExerciseProgress();
                }

                await ShowSuccessToast(
                    "История упражнения успешно удалена.");
            }

            SelectedExerciseForReset = null;
        }
    }


    <!-- ===== Вкладка "Тренирорвки" ===== -->
    @if (SelectedTab == 1)
    {
        <div class="progress-workouts">

            @foreach (var workout in WorkoutCards)
            {
                <div class="progress-card-wrapper">

                    <WorkoutProgressCard Title="@workout.Name"
                                         OnClick="@(() => OpenProgress(workout.Name))"
                                         OnMenuClick="@(() => OpenWorkoutMenu(workout.Name))" />

                    @if (SelectedWorkoutMenu == workout.Name)
                    {
                        <div class="context-menu">

                            <button class="context-item"
                                    @onclick="OpenWorkoutClearDialog">

                                🗑 Оистить историю

                            </button>

                        </div>
                    }

                </div>
            }

        </div>
    }

    @if (SelectedWorkout != null)
    {
        <WorkoutProgressDialog WorkoutName="@SelectedWorkout"
                               WorkoutHistory="@WorkoutHistory"
                               ChartData="@CurrentChartData"
                               ChartOptions="@ChartOptions"
                               ChartRenderKey="@ChartRenderKey"
                               BestGrowth="@BestGrowth"
                               LastTrend="@LastTrend"
                               GrowthColorClass="@GrowthColorClass"
                               ChartSubtitle="@ChartSubtitle"
                               ChartSeriesName="@ChartSeriesName"
                               SinglePointNote="@SinglePointNote"
                               NoDataText="@NoDataText"
                               CloseButtonText="@CloseButtonText"
                               OnClose="CloseProgress" />
    }
    
        @if (ShowClearProgressDialog)
        {
            <div class="modal-overlay">

                <div class="modal-window">

                <h2>
                    Очистить историю тренировки?
                </h2>

                <p>
                    Будет удалена вся история тренировки
                    <strong>@WorkoutToClear</strong>.
                </p>

                <p style="margin-top:10px;color:#999;">
                    Это действие нельзя отменить.
                </p>

                    <div class="dialog-buttons">

                        <button class="secondary-button"
                                @onclick="CloseClearDialog">
                            @CancelButtonText
                        </button>

                        <button class="danger-button"
                                @onclick="ClearProgress">
                            @DeleteButtonText
                        </button>

                    </div>

                </div>

            </div>
    }

    @if (ShowToast)
    {
        <div class="toast-success">

            ✅ @ToastMessage

        </div>
    }
</div>

@code
{
    // ======================================================
    // Services
