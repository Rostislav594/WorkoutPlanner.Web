@page "/progress"
@rendermode InteractiveServer

@inject NavigationManager Navigation

<div class="page-content">

    <h1 style="text-align:center;">
        Прогресс
    </h1>

    <div class="progress-menu">

        <div class="progress-menu-card"
             @onclick='() => Navigation.NavigateTo("/progress/exercises")'>

            <div class="progress-menu-icon">
                💪
            </div>

            <div class="progress-menu-title">
                Упражнения
            </div>

            <div class="progress-menu-description">
                Просмотр прогресса по каждому упражнению
            </div>

        </div>

        <div class="progress-menu-card"
             @onclick='() => Navigation.NavigateTo("/progress/workouts")'>

            <div class="progress-menu-icon">
                📈
            </div>

            <div class="progress-menu-title">
                Тренировки
            </div>

            <div class="progress-menu-description">
                Общий прогресс тренировок
            </div>

        </div>

    </div>

</div>
