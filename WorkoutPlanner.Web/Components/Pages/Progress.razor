@page "/progress"
@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject IAppText Text

<div class="page-content">

    <div class="page-title-row">
        <h1 class="progress-title">@Text["Progress_Title"]</h1>
        <HelpButton Topic="HelpContentCatalog.Progress" />
    </div>

    <div class="progress-menu">

        <div class="progress-menu-card"
             @onclick='() => Navigation.NavigateTo("/progress/exercises")'>

            <img src="images/progress-exercises.png"
                 class="progress-menu-image"
                 alt="@Text["Progress_Exercises"]" />

            <div class="progress-menu-title">
                @Text["Progress_Exercises"]
            </div>

        </div>

        <div class="progress-menu-card"
             @onclick='() => Navigation.NavigateTo("/progress/workouts")'>

            <img src="images/progress-workouts.png"
                 class="progress-menu-image"
                 alt="@Text["Progress_Workouts"]" />

            <div class="progress-menu-title">
                @Text["Progress_Workouts"]
            </div>
        </div>

    </div>

</div>
