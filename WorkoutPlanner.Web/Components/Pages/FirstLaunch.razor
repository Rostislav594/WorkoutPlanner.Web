@page "/firstlaunch"
@rendermode InteractiveServer
@attribute [Authorize]
@inject WorkoutPlanner.Web.Application.Abstractions.IWelcomeGuideStateService WelcomeGuideState
@inject NavigationManager Navigation

<FinalWelcome IsBusy="_isBusy" ErrorMessage="@_error" OnCompleted="CompleteAsync" />

@code {
    private bool _isBusy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (await WelcomeGuideState.IsCompletedAsync())
            Navigation.NavigateTo("/", replace: true);
    }

    private async Task CompleteAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        try
        {
            await WelcomeGuideState.CompleteAsync();
            Navigation.NavigateTo("/", replace: true);
        }
        catch
        {
            _error = "Не удалось сохранить завершение знакомства. Попробуйте ещё раз.";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
