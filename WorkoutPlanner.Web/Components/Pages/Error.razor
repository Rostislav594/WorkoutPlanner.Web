@page "/Error"
@using System.Diagnostics
@inject IAppText Text

<PageTitle>@Text["Web_Error_PageTitle"]</PageTitle>

<h1 class="text-danger">@Text["Web_Error_Title"]</h1>
<h2 class="text-danger">@Text["Web_Error_Message"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Text["Web_Error_RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Text["Web_Error_DevTitle"]</h3>
<p>@Text["Web_Error_DevHint"]</p>
<p>@Text["Web_Error_DevWarning"]</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
