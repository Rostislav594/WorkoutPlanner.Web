@page "/profile/setup"
@rendermode InteractiveServer
@using WorkoutPlanner.Web.Application.Abstractions
@using WorkoutPlanner.Web.Application.Contracts
@inject IProfileService ProfileService
@inject NavigationManager Navigation
@inject IAppText Text

<div class="profile-page">
    <section class="profile-panel profile-setup-panel">
        <div class="profile-heading">
            <p class="profile-kicker">@Text["ProfileSetup_Kicker"]</p>
            <h1>@Text["ProfileSetup_Title"]</h1>
            <p>@Text["ProfileSetup_Subtitle"]</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="auth-error">@Message</div>
        }

        <EditForm Model="InputModel" OnValidSubmit="SaveProfileAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="profile-form-grid">
                <div class="field">
                    <label>@Text["Common_FirstName"]</label>
                    <InputText class="auth-input" @bind-Value="InputModel.FirstName" />
                    <LocalizedValidationMessage For="@(() => InputModel.FirstName)" />
                </div>

                <div class="field">
                    <label>@Text["Common_LastName"]</label>
                    <InputText class="auth-input" @bind-Value="InputModel.LastName" />
                    <LocalizedValidationMessage For="@(() => InputModel.LastName)" />
                </div>

                <div class="field">
                    <label>@Text["Common_BirthDate"]</label>
                    <InputDate class="auth-input" @bind-Value="InputModel.BirthDate" />
                    <LocalizedValidationMessage For="@(() => InputModel.BirthDate)" />
                </div>

                <div class="field">
                    <label>@Text["Common_Gender"]</label>
                    <InputSelect class="auth-input" @bind-Value="InputModel.Gender">
                        <option value="">@Text["Common_Choose"]</option>
                        <option value="Мужской">@Text["Gender_Male"]</option>
                        <option value="Женский">@Text["Gender_Female"]</option>
                        <option value="Не указывать">@Text["Gender_Unspecified"]</option>
                    </InputSelect>
                    <LocalizedValidationMessage For="@(() => InputModel.Gender)" />
                </div>
            </div>

            <button class="finish-button auth-button profile-primary-action" type="submit">
                @Text["ProfileSetup_Save"]
            </button>
        </EditForm>
    </section>
</div>

@code {
    private ProfileInput InputModel { get; } = new();

    private string? Message { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var hasProfile = await ProfileService.CurrentUserHasProfileAsync();

        if (hasProfile)
        {
            Navigation.NavigateTo("/profile");
        }
    }

    private async Task SaveProfileAsync()
    {
        var created = await ProfileService.CreateCurrentProfileAsync(
            new ProfileUpdateRequest(
                InputModel.FirstName,
                InputModel.LastName,
                InputModel.BirthDate,
                InputModel.Gender));

        if (!created)
        {
            Navigation.NavigateTo("/profile");
            return;
        }

        Navigation.NavigateTo("/firstlaunch", true);
    }

    private sealed class ProfileInput
    {
        // В атрибутах лежат ключи ресурсов: их печатает LocalizedValidationMessage.
        [Required(ErrorMessage = "Validation_FirstNameRequired")]
        [MaxLength(80, ErrorMessage = "Validation_FirstNameTooLong")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Validation_LastNameRequired")]
        [MaxLength(80, ErrorMessage = "Validation_LastNameTooLong")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Validation_BirthDateRequired")]
        public DateTime? BirthDate { get; set; }

        [Required(ErrorMessage = "Validation_GenderRequired")]
        public string Gender { get; set; } = string.Empty;
    }
}
