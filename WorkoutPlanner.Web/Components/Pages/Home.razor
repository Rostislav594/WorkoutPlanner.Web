@page "/"

<div class="home-container page-content">

    <section class="desktop-panel">

        <div class="desktop-layout">

            <div class="shortcut-column shortcut-column-left"
                 aria-label="Основные разделы">

                <a class="shortcut-tile fade-in"
                   style="animation-delay:.10s"
                   href="today">

                    <span class="material-symbols-rounded shortcut-icon">
                        home
                    </span>

                    <span class="shortcut-title">Сегодня</span>

                </a>

                <a class="shortcut-tile fade-in"
                   style="animation-delay:.20s"
                   href="calendar">

                    <span class="material-symbols-rounded shortcut-icon">
                        calendar_month
                    </span>

                    <span class="shortcut-title">Календарь</span>

                </a>

                <a class="shortcut-tile fade-in"
                   style="animation-delay:.30s"
                   href="workouts">

                    <span class="material-symbols-rounded shortcut-icon">
                        exercise
                    </span>

                    <span class="shortcut-title">Тренировки</span>

                </a>

            </div>

            <img src="images/logo.png" data-guide="home-welcome"
                 class="logo fade-in"
                 style="animation-delay:0s"
                 alt="Workout Planner" />

            <div class="shortcut-column shortcut-column-right"
                 aria-label="Дополнительные разделы">

                <a class="shortcut-tile fade-in"
                   style="animation-delay:.20s"
                   href="history">

                    <span class="material-symbols-rounded shortcut-icon">
                        history
                    </span>

                    <span class="shortcut-title">История</span>

                </a>

                <a class="shortcut-tile fade-in"
                   style="animation-delay:.30s"
                   href="progress">

                    <span class="material-symbols-rounded shortcut-icon">
                        monitoring
                    </span>

                    <span class="shortcut-title">Прогресс</span>

                </a>

            </div>

        </div>

    </section>

</div>
