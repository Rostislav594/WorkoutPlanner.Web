@page "/today"
@rendermode InteractiveServer

@using WorkoutPlanner.Web.Application.Contracts
@using WorkoutPlanner.Web.Application.Abstractions
@using WorkoutPlanner.Web.Services
@using Microsoft.JSInterop

@inject ITodayWorkoutService TodayWorkoutService
@inject IExerciseService ExerciseService
@inject IActiveWorkoutService ActiveWorkoutService
@inject IWorkoutCompletionService WorkoutCompletionService
@inject IJSRuntime JS
@inject ILogger<Today> Logger

<div class="page-content">

    <div class="today-header">

        <div class="page-title-row">
            <h1 class="today-title">Сегодня</h1>
            <HelpButton Topic="HelpContentCatalog.TodayWeb" />
        </div>

        <div class="today-date">
            @DateTime.Now.ToString("dd MMMM, dddd")
        </div>

        @if (TodayWorkout != null)
        {
            <div class="workout-chip">

                <span class="material-symbols-rounded">
                    event_available
                </span>

                <span>@TodayWorkout.WorkoutName</span>

            </div>
        }

    </div>

    @if (TodayWorkout == null)
    {
        <div class="no-workout-container">

            <div class="no-workout-text">
                На сегодня тренировка не назначена.
            </div>

            <div class="no-workout-image">
                <img src="images/character-shrug.png"
                     class="no-workout-character"
                     alt="Нет тренировки" />
            </div>

        </div>
    }
    else
    {
        <div class="progress-section">

            <div class="progress-text">
                Выполнено @CompletedExercises из @Exercises.Count
            </div>

            <div class="progress-bar">
                <div class="progress-fill"
                     style="width:@ProgressPercent%">
                </div>
            </div>

        </div>

        @foreach (var exercise in Exercises)
        {
            <div class="exercise-card @(exercise.IsCompleted ? "exercise-completed" : "")">

                <div class="exercise-header">
                    <h3>@exercise.Name</h3>
                </div>

                <div class="sets-block">

                    @foreach (var set in exercise.Sets.OrderBy(x => x.SetNumber))
                    {
                        <label>

                             <input type="checkbox"
                                   checked="@set.Completed"
                                   disabled="@SavingSetIds.Contains(set.Id)"
                                   @onchange="async e => await SetCompleted(set, (bool)e.Value!)" />

                            <span class="set-text">
                                @set.Weight кг × @set.Repetitions
                            </span>

                        </label>
                    }

                </div>

                <div class="exercise-footer">

                    <span class="status-badge"
                          style="color:@exercise.StatusColor">
                        @(exercise.Status switch
                        {
                            ExerciseStatus.Easy => "😊 Легко",
                            ExerciseStatus.Medium => "😐 Средне",
                            ExerciseStatus.Hard => "🥵 Тяжело",
                            ExerciseStatus.Max => "🤯 Предел",
                            _ => "Не оценено"
                        })
                    </span>

                    <button class="status-button" @onclick="() => OpenStatusWindow(exercise)"
                            >
                        ⚡
                    </button>

                </div>

            </div>
        }

        <button class="finish-button" @onclick="FinishWorkout">
            Завершить тренировку
        </button>
    }
   
    @if (StatusExercise != null)
    {
        <div class="modal-overlay"
             @onclick="CloseStatusWindow">

            <div class="modal-window"
                 @onclick:stopPropagation="true">

                <h3>Оцените выполнение</h3>

                    <div class="status-option"
                         style="cursor:pointer"
                         @onclick="() => SetStatus(ExerciseStatus.Easy)">

                        <div class="status-title">
                            😊 Легко
                        </div>

                        <div class="status-description">
                            Большой запас сил
                        </div>

                    </div>

                    <div class="status-option"
                         style="cursor:pointer"
                         @onclick="() => SetStatus(ExerciseStatus.Medium)">
                        <div class="status-title">
                            😐 Средне
                        </div>
                        <div class="status-description">
                            Ещё были силы
                        </div>
                    </div>

                    <div class="status-option"
                         style="cursor:pointer"
                         @onclick="() => SetStatus(ExerciseStatus.Hard)">
                        <div class="status-title">
                            🥵 Тяжело
                        </div>
                        <div class="status-description">
                            Последние повторы дались тяжело
                        </div>
                    </div>

                    <div class="status-option"
                         style="cursor:pointer"
                         @onclick="() => SetStatus(ExerciseStatus.Max)">
                        <div class="status-title">
                            🤯 Предел
                        </div>
                        <div class="status-description">
                            Почти отказ
                        </div>
                    </div>
                    <button class="secondary-button"
                            @onclick="CloseStatusWindow">
                        ❌ Отмена
                    </button>

            </div>

        </div>
    
}
</div>
@if (ShowStatusWarning)
{
    <div class="modal-overlay">

        <div class="modal-window">

            <h2>⚠️ Не все упражнения оценены</h2>

            <p>
                Пожалуйста, оцените все упражнения
                перед завершением тренировки.
            </p>

            <button class="secondary-button"
                    @onclick="CloseWarning">
                Понятно
            </button>

        </div>

    </div>
}
@if (ShowWorkoutCompleted)
{
    <div class="modal-overlay">

        <div class="modal-window workout-completed-window">

            <div class="completed-icon">
                🏆
            </div>

            <h2>
                Тренировка завершена!
            </h2>

            <div class="completed-workout-name">
                @TodayWorkout?.WorkoutName
            </div>

            <div class="completed-stats">

                <div class="completed-stat">
                    ✅ Упражнений:
                    <b>@Exercises.Count</b>
                </div>

                <div class="completed-stat">
                    📈 Прогресс сохранён
                </div>

                <div class="completed-stat">
                    📚 История обновлена
                </div>

            </div>

            <div class="completed-message">
                Отличная работа 💪
            </div>

            <button class="secondary-button"
                    @onclick="CloseCompletedWindow">
                Закрыть
            </button>

        </div>

    </div>
}

@code
{
    Exercise? StatusExercise;
    bool ShowWorkoutCompleted = false;
    bool ShowStatusWarning = false;
    TrainingPlan? TodayWorkout;
    List<Exercise> Exercises = new();
    HashSet<int> SavingSetIds = [];

    protected override async Task OnInitializedAsync()
    {
        TodayWorkout =
            await TodayWorkoutService
                .GetTodayWorkoutAsync();

        if (TodayWorkout != null)
        {
            Exercises =
                await ExerciseService
                    .GetExercisesAsync(
                        TodayWorkout.WorkoutName);
        }
    }

    void OpenStatusWindow(Exercise exercise)
    {
        StatusExercise = exercise;
    }

    void CloseStatusWindow()
    {
        StatusExercise = null;
    }

    async Task SetStatus(ExerciseStatus status)
    {
        if (StatusExercise == null)
            return;

        StatusExercise.Status = status;

        await ExerciseService.UpdateExerciseAsync(StatusExercise);

        StatusExercise = null;

    }

    async Task FinishWorkout()
    {
        if (TodayWorkout == null)
            return;
        if (Exercises.Any(x =>
        x.Status == ExerciseStatus.NotCompleted))
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Оцените все упражнения перед завершением тренировки");

            return;
        }
        foreach (var exercise in Exercises)
        {
            await ExerciseService.UpdateExerciseAsync(exercise);
        }

        var result = await WorkoutCompletionService.CompleteTodayAsync();
        if (!result.Succeeded)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Не удалось завершить тренировку. Обновите страницу и попробуйте снова.");
            return;
        }

        ShowWorkoutCompleted = true;

    }
    void CloseCompletedWindow()
    {
        ShowWorkoutCompleted = false;

        TodayWorkout = null;

        Exercises.Clear();
    }

    async Task SetCompleted(
    ExerciseTemplateSet set,
    bool value)
    {
        if (!SavingSetIds.Add(set.Id))
            return;

        var previousValue = set.Completed;
        set.Completed = value;

        try
        {
            var result = await ActiveWorkoutService.UpdateSetAsync(
                set.Id,
                new UpdateWorkoutSet(
                    set.Weight,
                    set.Repetitions,
                    set.Completed,
                    set.Version));
            if (!result.Succeeded)
            {
                set.Completed = previousValue;
                await JS.InvokeVoidAsync(
                    "alert",
                    "Не удалось сохранить подход. Обновите страницу и попробуйте снова.");
            }
            else
            {
                set.Version = result.Set!.Version;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Could not update active workout set {SetId}.",
                set.Id);
            set.Completed = previousValue;
            await JS.InvokeVoidAsync(
                "alert",
                "Не удалось сохранить подход. Обновите страницу и попробуйте снова.");
        }
        finally
        {
            SavingSetIds.Remove(set.Id);
        }

    }

    void CloseWarning()
    {
        ShowStatusWarning = false;
    }

    int CompletedExercises =>
    Exercises.Count(x => x.IsCompleted);

    double ProgressPercent =>
        Exercises.Count == 0
            ? 0
            : CompletedExercises * 100.0 / Exercises.Count;

}
