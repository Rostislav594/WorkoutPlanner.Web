@page "/today"
@rendermode InteractiveServer
@implements IDisposable

@using WorkoutPlanner.Web.Application.Contracts
@using WorkoutPlanner.Web.Application.Abstractions
@using WorkoutPlanner.Web.Services
@using WorkoutPlanner.Web.Services.Auth
@using Microsoft.JSInterop

@inject IAppText Text
@inject ITodayWorkoutService TodayWorkoutService
@inject IExerciseService ExerciseService
@inject IActiveWorkoutService ActiveWorkoutService
@inject IWorkoutCompletionService WorkoutCompletionService
@inject IWorkoutRealtimeNotifier WorkoutRealtimeNotifier
@inject CurrentUserService CurrentUserService
@inject IJSRuntime JS
@inject ILogger<Today> Logger

<div class="page-content">

    <div class="today-header">

        <div class="page-title-row">
            <h1 class="today-title">@Text["Nav_Today"]</h1>
            <HelpButton Topic="HelpContentCatalog.TodayWeb" />
        </div>

        <div class="today-date">
            @DateTime.Now.ToString("dd MMMM, dddd")
        </div>

        @if (TodayWorkout != null)
        {
            <div class="workout-chip">

                <span class="material-symbols-rounded">
                    event_available
                </span>

                <span>@TodayWorkout.WorkoutName</span>

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(LiveUpdateMessage))
        {
            <span class="visually-hidden" role="status" aria-atomic="true">
                @LiveUpdateMessage
            </span>
        }

    </div>

    @if (TodayWorkout == null)
    {
        <div class="no-workout-container">

            <div class="no-workout-text">
                @Text["Web_Today_NoWorkout"]
            </div>

            <div class="no-workout-image">
                <img src="images/character-shrug.png"
                     class="no-workout-character"
                     alt="@Text["Web_Today_NoWorkoutAlt"]" />
            </div>

        </div>
    }
    else
    {
        <div class="progress-section">

            <div class="progress-text">
                @Text.Format("Web_Today_Completed", CompletedExercises, Exercises.Count)
            </div>

            <div class="progress-bar">
                <div class="progress-fill"
                     style="width:@ProgressPercent%">
                </div>
            </div>

        </div>

        @foreach (var exercise in Exercises)
        {
            <div class="exercise-card @(exercise.IsCompleted ? "exercise-completed" : "")">

                <div class="exercise-header">
                    <h3>@exercise.Name</h3>
                </div>

                <div class="sets-block">

                    @foreach (var set in exercise.Sets.OrderBy(x => x.SetNumber))
                    {
                        <label>

                             <input type="checkbox"
                                   checked="@set.Completed"
                                   disabled="@(SavingRating || SavingSetIds.Contains(set.Id))"
                                   @onchange="async e => await SetCompleted(set, (bool)e.Value!)" />

                            <span class="set-text">
                                @set.Weight @Text["Common_Kg"] × @set.Repetitions
                            </span>

                        </label>
                    }

                </div>

                <div class="exercise-effort-footer">
                    <ExerciseEffortRating Value="@exercise.Status.ToString()"
                                          ValueChanged="value => SetStatusAsync(exercise, value)"
                                          Disabled="@(SavingRating || SavingSetIds.Count > 0)" />
                    @if (RatingErrorExerciseId == exercise.Id)
                    {
                        <p role="alert">@Text["Web_Details_SaveFailed"]</p>
                    }
                </div>

            </div>
        }

        <button class="finish-button" disabled="@SavingRating" @onclick="FinishWorkout">
            @Text["Today_FinishWorkout"]
        </button>
    }
   
</div>
@if (ShowStatusWarning)
{
    <div class="modal-overlay">

        <div class="modal-window">

            <h2>@Text["Web_Today_NotRatedTitle"]</h2>

            <p>
                @Text["Web_Today_NotRatedBody"]
            </p>

            <button class="secondary-button"
                    @onclick="CloseWarning">
                @Text["Web_Ok"]
            </button>

        </div>

    </div>
}
@if (ShowWorkoutCompleted)
{
    <div class="modal-overlay">

        <div class="modal-window workout-completed-window">

            <div class="completed-icon">
                🏆
            </div>

            <h2>
                @Text["Web_Today_Finished"]
            </h2>

            <div class="completed-workout-name">
                @TodayWorkout?.WorkoutName
            </div>

            <div class="completed-stats">

                <div class="completed-stat">
                    @Text["Web_Today_ExercisesLabel"]
                    <b>@Exercises.Count</b>
                </div>

                <div class="completed-stat">
                    @Text["Web_Today_ProgressSaved"]
                </div>

                <div class="completed-stat">
                    @Text["Web_Today_HistoryUpdated"]
                </div>

            </div>

            <div class="completed-message">
                @Text["Web_Today_GreatJob"]
            </div>

            <button class="secondary-button"
                    @onclick="CloseCompletedWindow">
                @Text["Common_Close"]
            </button>

        </div>

    </div>
}

@code
{
    bool SavingRating;
    int? RatingErrorExerciseId;
    bool ShowWorkoutCompleted = false;
    bool ShowStatusWarning = false;
    TrainingPlan? TodayWorkout;
    List<Exercise> Exercises = new();
    HashSet<int> SavingSetIds = [];
    IDisposable? RealtimeSubscription;
    IDisposable? RealtimeFinishedSubscription;
    string? LiveUpdateMessage;
    bool IsDisposed;

    protected override async Task OnInitializedAsync()
    {
        var userId = await CurrentUserService.GetRequiredUserIdAsync();
        RealtimeSubscription = WorkoutRealtimeNotifier.Subscribe(
            userId,
            HandleWorkoutSetUpdatedAsync);
        RealtimeFinishedSubscription = WorkoutRealtimeNotifier.SubscribeWorkoutFinished(
            userId,
            HandleWorkoutFinishedAsync);

        TodayWorkout =
            await TodayWorkoutService
                .GetTodayWorkoutAsync();

        if (TodayWorkout != null)
        {
            Exercises =
                await ExerciseService
                    .GetExercisesAsync(
                        TodayWorkout.WorkoutName);
        }
    }

    private Task HandleWorkoutSetUpdatedAsync(
        WorkoutSetUpdatedNotification notification) =>
        InvokeAsync(() =>
        {
            if (IsDisposed)
                return;

            var exercise = Exercises.FirstOrDefault(x =>
                x.Sets.Any(set => set.Id == notification.Set.SetId));
            var set = exercise?.Sets.FirstOrDefault(x =>
                x.Id == notification.Set.SetId);
            if (set is null || set.Version >= notification.Set.Version)
                return;

            set.SetNumber = notification.Set.SetNumber;
            set.Weight = notification.Set.Weight;
            set.Repetitions = notification.Set.Repetitions;
            set.Completed = notification.Set.Completed;
            set.IsWarmup = notification.Set.IsWarmup;
            set.Version = notification.Set.Version;
            LiveUpdateMessage =
                Text.Format("Web_Today_SetUpdatedFromWatch", set.SetNumber, exercise!.Name);
            StateHasChanged();
        });

    private Task HandleWorkoutFinishedAsync(
        WorkoutFinishedNotification notification) =>
        InvokeAsync(() =>
        {
            if (IsDisposed || TodayWorkout is null)
                return;

            ShowWorkoutCompleted = true;
            LiveUpdateMessage = Text["Web_Today_FinishedFromWatch"];
            StateHasChanged();
        });

    public void Dispose()
    {
        IsDisposed = true;
        RealtimeSubscription?.Dispose();
        RealtimeFinishedSubscription?.Dispose();
    }

    async Task SetStatusAsync(Exercise exercise, string value)
    {
        if (SavingRating || SavingSetIds.Count > 0 || !Enum.TryParse<ExerciseStatus>(value, out var status)) return;
        SavingRating = true;
        RatingErrorExerciseId = null;
        var previous = exercise.Status;
        try
        {
            exercise.Status = status;
            await ExerciseService.UpdateExerciseAsync(exercise);
        }
        catch (Exception exception)
        {
            exercise.Status = previous;
            RatingErrorExerciseId = exercise.Id;
            Logger.LogError(exception, "Could not save exercise rating.");
        }
        finally { SavingRating = false; }
    }

    async Task FinishWorkout()
    {
        if (TodayWorkout == null || SavingRating)
            return;
        if (Exercises.Any(x =>
        x.Status == ExerciseStatus.NotCompleted))
        {
            await JS.InvokeVoidAsync(
                "alert",
                Text["Web_Today_RateAllFirst"]);

            return;
        }
        foreach (var exercise in Exercises)
        {
            await ExerciseService.UpdateExerciseAsync(exercise);
        }

        var result = await WorkoutCompletionService.CompleteTodayAsync();
        if (!result.Succeeded)
        {
            await JS.InvokeVoidAsync(
                "alert",
                Text["Web_Today_FinishFailed"]);
            return;
        }

        ShowWorkoutCompleted = true;

    }
    void CloseCompletedWindow()
    {
        ShowWorkoutCompleted = false;

        TodayWorkout = null;

        Exercises.Clear();
    }

    async Task SetCompleted(
    ExerciseTemplateSet set,
    bool value)
    {
        if (!SavingSetIds.Add(set.Id))
            return;

        var previousValue = set.Completed;
        set.Completed = value;

        try
        {
            var result = await ActiveWorkoutService.UpdateSetAsync(
                set.Id,
                new UpdateWorkoutSet(
                    set.Weight,
                    set.Repetitions,
                    set.Completed,
                    set.Version));
            if (!result.Succeeded)
            {
                set.Completed = previousValue;
                await JS.InvokeVoidAsync(
                    "alert",
                    Text["Web_Today_SaveSetFailed"]);
            }
            else
            {
                set.Version = result.Set!.Version;
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Could not update active workout set {SetId}.",
                set.Id);
            set.Completed = previousValue;
            await JS.InvokeVoidAsync(
                "alert",
                Text["Web_Today_SaveSetFailed"]);
        }
        finally
        {
            SavingSetIds.Remove(set.Id);
        }

    }

    void CloseWarning()
    {
        ShowStatusWarning = false;
    }

    int CompletedExercises =>
    Exercises.Count(x => x.IsCompleted);

    double ProgressPercent =>
        Exercises.Count == 0
            ? 0
            : CompletedExercises * 100.0 / Exercises.Count;

}
