@page "/history"
@rendermode InteractiveServer

@using WorkoutPlanner.Web.Models
@using WorkoutPlanner.Web.Services
@using System.Text.Json

@inject HistoryService HistoryService
@inject WorkoutPlanner.Web.Services.Onboarding.AppGuideService Guide

<div class="page-content">
    <h1 style="text-align:center;" data-guide="workout-journal">
    История  
 </h1>

    @if (HistoryItems.Count == 0)
    {
        <div class="history-empty">

            <img src="images/history-empty.png"
                 class="history-empty-image"
                 alt="История пуста" />

        </div>
    }
else
{
    @foreach (var item in HistoryItems)
    {
        <div class="history-card"
             data-guide="@(IsTutorialHistory(item) ? "practice-history-card" : null)"
             @onclick="() => OpenHistoryAsync(item)">

            <div class="history-title">
                @item.WorkoutName
            </div>

            <div class="history-date">
                @item.Date.ToString("dd.MM.yyyy HH:mm")
            </div>

        </div>
    }
}
@if (SelectedHistory != null)
{
    <div class="modal-overlay"
         @onclick="CloseWindow">

        <div class="modal-window"
             @onclick:stopPropagation="true">

            <div class="history-modal-header">

                <h2>
                    @SelectedHistory.WorkoutName
                </h2>

                <div class="history-popup-date">
                    @SelectedHistory.Date.ToString("dd.MM.yyyy HH:mm")
                </div>

            </div>

            <div class="history-details">

                    @{
                        var history =
                            JsonSerializer.Deserialize<WorkoutHistoryDetails>(
                                SelectedHistory.Details);

                        if (history != null)
                        {
                            foreach (var exercise in history.Exercises)
                            {
                                <div class="history-exercise">

                                    <div class="history-exercise-name">
                                        @exercise.Name
                                    </div>

                                    <div class="history-exercise-status"
                                         style="color:@exercise.StatusColor">
                                        @exercise.StatusText
                                    </div>

                                    <div class="history-sets">

                                        @foreach (var set in exercise.Sets.OrderBy(x => x.SetNumber))
                                        {
                                            <label>

                                                <input type="checkbox"
                                                       checked="@set.Completed"
                                                       disabled />

                                                @set.Weight кг × @set.Repetitions

                                            </label>
                                        }

                                    </div>

                                </div>
                            }
                        }
                    }

            </div>

            <div class="history-buttons">

                <button class="danger-button"
                        @onclick="DeleteHistory">
                     Удалить
                </button>

                <button class="secondary-button"
                        @onclick="CloseWindow">
                    Закрыть
                </button>

            </div>

        </div>
    </div>
    }
</div>

@code
{
    List<WorkoutHistory> HistoryItems = new();

    WorkoutHistory? SelectedHistory;

    int? TutorialHistoryId => HistoryItems
        .FirstOrDefault(x =>
            x.WorkoutName ==
            WorkoutPlanner.Web.Services.Onboarding.AppGuidePracticeService.TutorialWorkoutName)
        ?.Id;

    protected override async Task OnInitializedAsync()
    {
        await LoadHistory();
    }

    async Task LoadHistory()
    {
        HistoryItems =
            await HistoryService
                .GetHistoryAsync();
    }

    async Task OpenHistoryAsync(
        WorkoutHistory history)
    {
        SelectedHistory = history;

        if (IsTutorialHistory(history))
            await Guide.NotifyActionAsync("practice-history-opened");
    }

    bool IsTutorialHistory(WorkoutHistory history) =>
        TutorialHistoryId == history.Id;

    void CloseWindow()
    {
        SelectedHistory = null;
    }

    async Task DeleteHistory()
    {
        if (SelectedHistory == null)
            return;

        await HistoryService
            .DeleteHistoryAsync(
                SelectedHistory.Id);

        SelectedHistory = null;

        await LoadHistory();
    }

}
