@page "/account/register"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject WorkoutPlanner.Web.Application.Abstractions.IStarterPlanService StarterPlanService
@inject ILoggerFactory LoggerFactory
@inject WorkoutPlanner.Web.Services.Activity.UserActivityService UserActivity
@inject TimeProvider TimeProvider
@inject NavigationManager Navigation
@inject IAppText Text

<div class="auth-page">

    <div class="auth-card">

        <div class="login-logo-container">

            <img src="images/Emblem.png"
                 alt="GPlanner"
                 class="login-logo" />

            <h1>@Text["Register_Title"]</h1>

            <div class="title-line"></div>

        </div>

        <EditForm Model="InputModel"
                  FormName="register"
                  OnValidSubmit="RegisterUser">

            <DataAnnotationsValidator />

            @if (Errors.Any())
            {
                <div class="validation-summary">

                    @foreach (var error in Errors)
                    {
                        <div>@error</div>
                    }

                </div>
            }

            <div class="field">

                <label>Email</label>

                <InputText class="auth-input"
                           @bind-Value="InputModel.Email"
                           autocomplete="username" />

                <LocalizedValidationMessage For="@(() => InputModel.Email)" />

            </div>

            <div class="field">

                <label>@Text["Common_Password"]</label>

                <InputText class="auth-input"
                           type="password"
                           @bind-Value="InputModel.Password"
                           autocomplete="new-password" />

                <LocalizedValidationMessage For="@(() => InputModel.Password)" />

            </div>

            <div class="field">

                <label>@Text["Web_Register_ConfirmPassword"]</label>

                <InputText class="auth-input"
                           type="password"
                           @bind-Value="InputModel.ConfirmPassword"
                           autocomplete="new-password" />

                <LocalizedValidationMessage For="@(() => InputModel.ConfirmPassword)" />

            </div>

            <button class="finish-button auth-button"
                    type="submit">

                @Text["Register_Submit"]

            </button>

        </EditForm>

        <div class="auth-footer">

            @Text["Register_HaveAccount"]

            <a href="/account/login">
                @Text["Register_SignIn"]
            </a>

        </div>

    </div>

</div>

@code {
    [SupplyParameterFromForm(Name = "InputModel")]
    private RegisterInput? Input { get; set; }

    private List<string> Errors { get; } = new();

    private RegisterInput InputModel => Input ??= new();

    private async Task RegisterUser()
    {
        Errors.Clear();

        var user = new IdentityUser
        {
            UserName = InputModel.Email,
            Email = InputModel.Email
        };

        var result = await UserManager.CreateAsync(user, InputModel.Password);

        if (!result.Succeeded)
        {
            foreach (var error in result.Errors)
            {
                var message = TranslateIdentityError(error);

                if (!Errors.Contains(message))
                {
                    Errors.Add(message);
                }
            }

            return;
        }

        try
        {
            await UserActivity.EnsureRegisteredAsync(
                user.Id,
                TimeProvider.GetUtcNow().UtcDateTime);
            await StarterPlanService.CreateForUserAsync(user.Id);
        }
        catch (Exception exception)
        {
            var logger = LoggerFactory.CreateLogger("Registration");
            logger.LogError(
                exception,
                "Failed to create starter plans for user {UserId}.",
                user.Id);

            var cleanupResult = await UserManager.DeleteAsync(user);

            if (!cleanupResult.Succeeded)
            {
                logger.LogCritical(
                    "Failed to roll back user {UserId} after starter plan provisioning failed.",
                    user.Id);
            }

            Errors.Add(Text["Web_Register_Failed"]);
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: false);
        Navigation.NavigateTo("/creator-intro", forceLoad: true);
    }

    private sealed class RegisterInput
    {
        // В атрибутах лежат ключи ресурсов: их печатает LocalizedValidationMessage.
        [Required(ErrorMessage = "Validation_EmailRequired")]
        [EmailAddress(ErrorMessage = "Validation_EmailInvalid")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Validation_PasswordRequired")]
        [MinLength(6, ErrorMessage = "Validation_PasswordMinLength")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Validation_PasswordsDoNotMatch")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private string TranslateIdentityError(IdentityError error)
    {
        return error.Code switch
        {
            "DuplicateEmail" or "DuplicateUserName"
                => Text["Password_DuplicateEmail"],

            "PasswordRequiresDigit"
                => Text["Password_RequiresDigit"],

            "PasswordRequiresLower"
                => Text["Password_RequiresLower"],

            "PasswordRequiresUpper"
                => Text["Password_RequiresUpper"],

            "PasswordRequiresNonAlphanumeric"
                => Text["Password_RequiresNonAlphanumeric"],

            "PasswordTooShort"
                => Text["Password_TooShort"],

            _ => error.Description
        };
    }
}
