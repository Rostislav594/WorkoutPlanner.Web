@page "/account/login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject WorkoutPlanner.Web.Services.Activity.UserActivityService UserActivity
@inject NavigationManager Navigation
@inject IAppText Text

<div class="auth-page">

    @* Шестерёнка и название парят над карточкой прямо на фоне с пылью. *@
    <div class="login-hero">

        <span class="login-gear material-symbols-rounded" aria-hidden="true">settings</span>

        @* Название входа в админку — фирменное, не переводится. *@
        <h1>Moderator</h1>

        <div class="title-line"></div>

    </div>

    <div class="auth-card">

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="auth-error">
                @ErrorMessage
            </div>
        }

        <EditForm Model="InputModel"
                  FormName="login"
                  OnValidSubmit="LoginUser">

            <DataAnnotationsValidator />

            <ValidationSummary class="validation-summary" />

            <div class="field">

                <label>Email</label>

                <InputText class="auth-input"
                           @bind-Value="InputModel.Email"
                           autocomplete="username" />

            </div>

            <div class="field">

                <label>@Text["Common_Password"]</label>

                <InputText class="auth-input"
                           type="password"
                           @bind-Value="InputModel.Password"
                           autocomplete="current-password" />

            </div>

            <button class="finish-button auth-button"
                    type="submit">

                @Text["Login_Submit"]

            </button>

        </EditForm>

    </div>

</div>

@code {
    [SupplyParameterFromForm(Name = "InputModel")]
    private LoginInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? ErrorMessage { get; set; }

    private LoginInput InputModel => Input ??= new();

    private async Task LoginUser()
    {
        var result = await SignInManager.PasswordSignInAsync(
            InputModel.Email,
            InputModel.Password,
            InputModel.RememberMe,
            // Как в API для телефона: после серии неверных паролей вход
            // временно закрывается, чтобы пароль админа нельзя было подобрать.
            lockoutOnFailure: true);

        if (result.Succeeded)
        {
            var user = await UserManager.FindByEmailAsync(InputModel.Email.Trim());
            if (user is not null)
            {
                await UserActivity.RecordSeenAsync(
                    user.Id,
                    WorkoutPlanner.Web.Services.Activity.UserActivityMetadata.Web);
            }
            Navigation.NavigateTo(GetReturnUrl(), forceLoad: true);
            return;
        }

        ErrorMessage = result.IsLockedOut
            ? Text["Web_Login_LockedOut"]
            : Text["Web_Login_InvalidCredentials"];
    }

    private string GetReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl))
            return "/admin";

        if (ReturnUrl.StartsWith("//") || ReturnUrl.Contains('\\'))
            return "/admin";

        return ReturnUrl.StartsWith('/')
            ? ReturnUrl
            : $"/{ReturnUrl}";
    }

    private sealed class LoginInput
    {
        // В атрибутах лежат ключи ресурсов: их печатает LocalizedValidationMessage.
        [Required(ErrorMessage = "Validation_EmailRequired")]
        [EmailAddress(ErrorMessage = "Validation_EmailInvalid")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Validation_PasswordRequired")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
