<div class="help-overlay" @onclick="CloseAsync">
    <span class="help-focus-sentinel" tabindex="0" @onfocus="FocusCloseAsync"></span>
    <section class="help-dialog"
             id="context-help-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="context-help-title"
             aria-describedby="context-help-introduction"
             tabindex="-1"
             @onkeydown="HandleKeyDown"
             @onclick:stopPropagation="true">
        <header class="help-dialog__header">
            <div>
                <p>Помощь по текущей странице</p>
                <h2 id="context-help-title">@Topic.Title</h2>
            </div>
            <button type="button" aria-label="Закрыть руководство" @ref="_closeButton" @onclick="CloseAsync"><span class="material-symbols-rounded" aria-hidden="true">close</span></button>
        </header>

        <div class="help-dialog__intro">
            <span class="help-dialog__intro-icon" aria-hidden="true">?</span>
            <p id="context-help-introduction">@Topic.Introduction</p>
        </div>

        <div class="help-dialog__sections">
            @for (var index = 0; index < Topic.Sections.Count; index++)
            {
                var section = Topic.Sections[index];
                <article class="help-section">
                    <h3>@section.Title</h3>
                    <p>@section.Text</p>
                    @if (!string.IsNullOrWhiteSpace(section.ImageSource))
                    {
                        <img class="help-section__image" src="@section.ImageSource" alt="@(section.ImageAlt ?? string.Empty)" />
                    }
                    @if (section.Illustration is HelpIllustration.ProgressExercise or HelpIllustration.ProgressWorkout)
                    {
                        <figure class="help-chart" aria-label="@(section.Illustration == HelpIllustration.ProgressExercise ? "Пример графика динамики упражнения по датам" : "Пример графика общего прогресса тренировки по датам")">
                            <div class="help-chart__legend">
                                <span>@(section.Illustration == HelpIllustration.ProgressExercise ? "Рабочее значение" : "Объём тренировки")</span>
                                <strong>+12%</strong>
                            </div>
                            <svg viewBox="0 0 520 190" role="img" aria-hidden="true" preserveAspectRatio="none">
                                <path class="help-chart__grid" d="M48 25H500 M48 75H500 M48 125H500 M48 175H500 M48 18V175" />
                                <path class="help-chart__area" d="M48 151 C112 143, 130 116, 190 123 S284 81, 342 91 S420 48, 500 35 L500 175 L48 175 Z" />
                                <path class="help-chart__line" d="M48 151 C112 143, 130 116, 190 123 S284 81, 342 91 S420 48, 500 35" />
                                <g class="help-chart__points"><circle cx="48" cy="151" r="5"/><circle cx="190" cy="123" r="5"/><circle cx="342" cy="91" r="5"/><circle cx="500" cy="35" r="5"/></g>
                            </svg>
                            <div class="help-chart__axis"><span>Раньше</span><span>Дата →</span><span>Сейчас</span></div>
                        </figure>
                    }
                    @if (section.Steps is { Count: > 0 })
                    {
                        <ol>
                            @foreach (var step in section.Steps)
                            {
                                <li>@step</li>
                            }
                        </ol>
                    }
                </article>
            }
        </div>
    </section>
    <span class="help-focus-sentinel" tabindex="0" @onfocus="FocusCloseAsync"></span>
</div>

@code {
    [Parameter, EditorRequired] public HelpTopic Topic { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _closeButton;
    private bool _focused;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_focused)
        {
            _focused = true;
            await _closeButton.FocusAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
    private Task FocusCloseAsync() => _closeButton.FocusAsync().AsTask();
    private Task HandleKeyDown(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
