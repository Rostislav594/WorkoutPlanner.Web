@inject IAppText Text

<div class="help-overlay" @onclick="CloseAsync">
    <span class="help-focus-sentinel" tabindex="0" @onfocus="FocusCloseAsync"></span>
    <section class="help-dialog"
             id="context-help-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="context-help-title"
             aria-describedby="context-help-introduction"
             tabindex="-1"
             @onkeydown="HandleKeyDown"
             @onclick:stopPropagation="true">
        <header class="help-dialog__header">
            <div>
                <p>@Text["Help_Header"]</p>
                <h2 id="context-help-title">@Text[Topic.TitleKey]</h2>
            </div>
            <button type="button" aria-label="@Text["Help_Close"]" @ref="_closeButton" @onclick="CloseAsync"><span class="material-symbols-rounded" aria-hidden="true">close</span></button>
        </header>

        <div class="help-dialog__intro">
            <span class="help-dialog__intro-icon" aria-hidden="true">?</span>
            <p id="context-help-introduction">@Text[Topic.IntroductionKey]</p>
        </div>

        <div class="help-dialog__sections">
            @for (var index = 0; index < Topic.Sections.Count; index++)
            {
                var section = Topic.Sections[index];
                <article class="help-section">
                    <h3>@Text[section.TitleKey]</h3>
                    <p>@Text[section.TextKey]</p>
                    @if (!string.IsNullOrWhiteSpace(section.ImageSource))
                    {
                        <img class="help-section__image" src="@section.ImageSource" alt="@(section.ImageAltKey is null ? string.Empty : Text[section.ImageAltKey])" />
                    }
                    @if (section.Illustration is HelpIllustration.ProgressExercise or HelpIllustration.ProgressWorkout)
                    {
                        @* Рисуем настоящий ProgressLineChart с демонстрационным рядом,
                           а не его копию: нарисованная отдельно иллюстрация расходится
                           с интерфейсом при первой же правке дизайна графика. *@
                        <figure class="help-chart">
                            @* Иллюстрация скрыта от скринридера целиком: у графика есть
                               собственный заголовок, и в дереве доступности он встаёт
                               в один ряд с заголовками секций руководства, ломая их
                               порядок. Содержание секции полностью передают шаги,
                               а о самой картинке сообщает подпись ниже.
                               Фокусируемых элементов внутри нет: CompactPresentation
                               убирает таблицу значений, а маркеры точек без
                               PointSelected рисуются как span. *@
                            <div class="help-chart__frame" aria-hidden="true">
                                <ProgressLineChart Title="@Text["Progress_ChartTitle"]"
                                                   Points="SampleChartPoints"
                                                   CompactPresentation="true" />
                            </div>
                            <figcaption class="help-chart__caption">@Text["Help_ChartSample"]</figcaption>
                        </figure>
                    }
                    @if (section.StepKeys is { Count: > 0 })
                    {
                        <ol>
                            @foreach (var stepKey in section.StepKeys)
                            {
                                <li>@Text[stepKey]</li>
                            }
                        </ol>
                    }
                </article>
            }
        </div>
    </section>
    <span class="help-focus-sentinel" tabindex="0" @onfocus="FocusCloseAsync"></span>
</div>

@code {
    [Parameter, EditorRequired] public HelpTopic Topic { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }

    // Демонстрационный ряд для иллюстрации: пять точек за месяц, привязанные к
    // сегодняшней дате, чтобы подписи оси выглядели так же, как в разделе
    // «Прогресс», а не как застывший прошлогодний период.
    private IReadOnlyList<WorkoutPlanner.Api.Contracts.ProgressChartPointApiResponse> SampleChartPoints { get; } =
        BuildSampleChartPoints();

    private static IReadOnlyList<WorkoutPlanner.Api.Contracts.ProgressChartPointApiResponse> BuildSampleChartPoints()
    {
        var today = DateTime.Today;
        return
        [
            new(today.AddDays(-28), 0m),
            new(today.AddDays(-21), 3.5m),
            new(today.AddDays(-14), 6m),
            new(today.AddDays(-7), 5m),
            new(today, 12m)
        ];
    }

    private ElementReference _closeButton;
    private bool _focused;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_focused)
        {
            _focused = true;
            await _closeButton.FocusAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
    private Task FocusCloseAsync() => _closeButton.FocusAsync().AsTask();
    private Task HandleKeyDown(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;
}
