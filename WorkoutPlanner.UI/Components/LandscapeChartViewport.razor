            <path class="rotation-path" d="M50 92c14 35 52 52 87 39 16-6 29-17 37-31" />
            <path class="rotation-arrow" d="m166 91 12 8 7-13" />
            <rect class="phone phone-landscape" x="62" y="50" width="116" height="68" rx="14" />
            <line class="phone-detail landscape-detail" x1="69" y1="76" x2="69" y2="92" />
