@using System.Globalization
@using Microsoft.JSInterop
@using WorkoutPlanner.Api.Contracts
@implements IAsyncDisposable
@inject IAppText Text
@inject IJSRuntime JS

@* Столбики по тренировкам — в том же виде, что графики на главной админки:
   плоскость чуть наклонена вглубь, под ней отражение, как на глянцевом полу.
   Столбики идут по порядку тренировок, а не по датам: несколько тренировок
   за один день не слипаются в одну точку. Последняя тренировка — оранжевая. *@
<section class="progress-chart @(StagedReveal ? "staged-reveal" : null) @(CompactPresentation ? "compact-presentation" : null)" aria-label="@Title" style="@RevealStyle">
    <div class="chart-heading @(ShowTitle ? null : "chart-heading--untitled")">
        <h3 class="@(ShowTitle ? null : "chart-title--hidden")">@Title</h3>
        @if (Points.Count > 0)
        {
            <strong class="chart-latest">@FormatChartPercent(Points[^1].Percent)</strong>
        }
        else if (!CompactPresentation)
        {
            <span>@Text["Chart_Last30Days"]</span>
        }
    </div>
    @if (Points.Count == 0)
    {
        <p class="empty">@Text["Chart_NoData"]</p>
    }
    else
    {
        <div class="chart-frame">
            <div class="chart-stage">
                <div class="chart-bars"
                     @ref="_bars"
                     role="@(PointSelected.HasDelegate ? "group" : "img")"
                     aria-label="@AccessibleSummary"
                     style="--zero:@Format(ZeroRatio);">
                    @for (var index = 0; index < Points.Count; index++)
                    {
                        var point = Points[index];
                        var label = $"{point.Date:dd.MM.yyyy}: {FormatSignedPercent(point.Percent)}";
                        var barClass = BarClass(index);
                        if (PointSelected.HasDelegate)
                        {
                            <button class="chart-column"
                                    type="button"
                                    style="@ColumnStyle(index)"
                                    title="@label"
                                    aria-label="@label"
                                    @onclick="() => PointSelected.InvokeAsync(point)">
                                <span class="@barClass" aria-hidden="true">@BarLabel(index)</span>
                            </button>
                        }
                        else
                        {
                            <span class="chart-column" style="@ColumnStyle(index)" title="@label">
                                <span class="@barClass" aria-hidden="true">@BarLabel(index)</span>
                            </span>
                        }
                    }
                </div>
            </div>
            <div class="chart-axis" aria-hidden="true" style="--count:@Points.Count;">
                <span class="@(Points.Count > 1 ? "chart-axis__start" : "chart-axis__single")">@Points[0].Date.ToString("dd.MM", CultureInfo.CurrentCulture)</span>
                @if (Points.Count > 1)
                {
                    <span class="chart-axis__end">@Points[^1].Date.ToString("dd.MM", CultureInfo.CurrentCulture)</span>
                }
            </div>
        </div>

        @if (!CompactPresentation)
        {
            <div class="chart-values">
                <span>@Text["Chart_Latest"] <strong>@FormatPercent(Points[^1].Percent)</strong></span>
                <span>@Text["Chart_Best"] <strong>@FormatPercent(Points.Max(x => x.Percent))</strong></span>
            </div>

            <details class="chart-data-details">
                <summary>@Text["Chart_ShowValues"]</summary>
                <div class="chart-data-scroll">
                    <table>
                        <caption>@Text["Chart_TableCaption"]</caption>
                        <thead>
                            <tr>
                                <th scope="col">@Text["Chart_ColumnDate"]</th>
                                <th scope="col">@Text["Chart_ColumnChange"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var point in Points)
                            {
                                <tr>
                                    <td>@point.Date.ToString("dd.MM.yyyy", CultureInfo.CurrentCulture)</td>
                                    <td>@FormatSignedPercent(point.Percent)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    }
</section>

@code {
    // Столбики вырастают по очереди за это время, как бы много их ни было.
    private const double GrowTotalSeconds = 1.2;
    private const double GrowStepMaxSeconds = .08;
    // Длительность chart-bar-grow в ProgressLineChart.razor.css.
    private const double GrowSeconds = .6;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ProgressChartPointApiResponse> Points { get; set; } = [];

    /// <summary>
    /// false прячет заголовок с экрана, но оставляет его экранному диктору:
    /// окно прогресса и так подписано названием тренировки.
    /// </summary>
    [Parameter]
    public bool ShowTitle { get; set; } = true;

    [Parameter]
    public bool StagedReveal { get; set; }

    [Parameter]
    public bool CompactPresentation { get; set; }

    [Parameter]
    public EventCallback<ProgressChartPointApiResponse> PointSelected { get; set; }

    // Шкала всегда включает ноль: рост идёт вверх от нулевой линии, спад — вниз.
    private decimal Highest => Points.Count == 0 ? 0 : Math.Max(0, Points.Max(x => x.Percent));
    private decimal Lowest => Points.Count == 0 ? 0 : Math.Min(0, Points.Min(x => x.Percent));
    private decimal Range => Highest - Lowest;

    // Положение нулевой линии от низа поля, в долях высоты.
    private double ZeroRatio => Range == 0 ? 0 : (double)(-Lowest / Range);

    private string BarClass(int index)
    {
        var classes = "chart-bar";
        if (Points[index].Percent == 0 || Range == 0)
            classes += " chart-bar--empty";
        else if (Points[index].Percent < 0)
            classes += " chart-bar--negative";
        if (index == Points.Count - 1)
            classes += " chart-bar--latest";
        return classes;
    }

    private double GrowStepSeconds => Math.Min(GrowStepMaxSeconds, GrowTotalSeconds / Math.Max(1, Points.Count));

    // Нижний край и высота столбика в долях поля; задержка роста — по номеру.
    private string ColumnStyle(int index)
    {
        var value = Points[index].Percent;
        var size = Range == 0 ? 0 : (double)(Math.Abs(value) / Range);
        var bottom = value < 0 ? ZeroRatio - size : ZeroRatio;
        return $"--bottom:{Format(bottom)};--size:{Format(size)};--grow-delay:{Format(GrowStepSeconds * index)}s;";
    }

    // Число последней тренировки появляется, когда дорос последний столбик.
    private string? RevealStyle => StagedReveal && Points.Count > 0
        ? $"--latest-delay:{Format(GrowStepSeconds * (Points.Count - 1) + GrowSeconds)}s;"
        : null;

    private string AccessibleSummary => Text.Format(
        "Chart_Summary",
        Title,
        Points.Min(x => x.Date).ToString("dd.MM.yyyy", CultureInfo.InvariantCulture),
        Points.Max(x => x.Date).ToString("dd.MM.yyyy", CultureInfo.InvariantCulture),
        Points.Count,
        FormatPercent(Points[^1].Percent),
        FormatPercent(Points.Max(x => x.Percent)));

    // Процент внутри столбика: вертикальная белая надпись. У последней
    // тренировки её нет — тот же процент уже написан над графиком.
    // Размер и проявление при масштабировании задаёт chartBarLabels.js.
    private RenderFragment? BarLabel(int index) =>
        Points[index].Percent == 0 || Range == 0 || index == Points.Count - 1
            ? null
            : @<span class="chart-bar-label">@FormatChartPercent(Points[index].Percent, "0.#")</span>;

    private ElementReference _bars;
    private IJSObjectReference? _labels;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Points.Count == 0)
            return;

        try
        {
            if (_labels is null)
            {
                _labels = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/WorkoutPlanner.UI/js/chartBarLabels.js");
                await _labels.InvokeVoidAsync("attach", _bars);
            }
            else
            {
                await _labels.InvokeVoidAsync("refresh", _bars);
            }
        }
        catch (JSException exception)
        {
            // Без модуля надписи просто не появятся — сам график работает.
            System.Diagnostics.Debug.WriteLine($"Chart bar labels failed: {exception.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_labels is null)
            return;

        try
        {
            await _labels.InvokeVoidAsync("detach", _bars);
            await _labels.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // WebView уже закрыт вместе со страницей.
        }
    }

    // Значения уходят в CSS, поэтому только с точкой, а не с русской запятой.
    private static string Format(double value) =>
        value.ToString("0.####", CultureInfo.InvariantCulture);

    private static string FormatPercent(decimal value, string format = "0.##") =>
        $"{value.ToString(format, CultureInfo.CurrentCulture)}%";

    // На самом графике рост без «+», спад — с обычным дефисом.
    private static string FormatChartPercent(decimal value, string format = "0.##")
    {
        var magnitude = FormatPercent(Math.Abs(value), format);
        return value < 0 && magnitude != "0%" ? $"-{magnitude}" : magnitude;
    }

    private static string FormatSignedPercent(decimal value) =>
        $"{(value > 0 ? "+" : string.Empty)}{FormatPercent(value)}";
}
