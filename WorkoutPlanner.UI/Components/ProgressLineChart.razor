@using System.Globalization
@using WorkoutPlanner.Api.Contracts

<section class="progress-chart" aria-label="@Title">
    <div class="chart-heading">
        <h3>@Title</h3>
        <span>Последние 30 дней</span>
    </div>
    <p class="chart-baseline">Изменение относительно первой сохранённой тренировки</p>
    @if (Points.Count == 0)
    {
        <p class="empty">За последние 30 дней данных для графика нет.</p>
    }
    else
    {
        <div class="chart-frame" role="img" aria-label="@AccessibleSummary">
            <svg viewBox="0 0 600 260" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                @foreach (var tick in YAxisTicks)
                {
                    <line class="grid-line" x1="52" y1="@Format(Y(tick))" x2="584" y2="@Format(Y(tick))" />
                }
                @if (Minimum < 0 && Maximum > 0)
                {
                    <line class="zero-line" x1="52" y1="@Format(Y(0))" x2="584" y2="@Format(Y(0))" />
                }
                @if (Points.Count > 1)
                {
                    <polyline class="progress-line" points="@PolylinePoints" />
                }
            </svg>

            @foreach (var tick in YAxisTicks)
            {
                <span class="axis-label y-axis-label" style="@YLabelStyle(tick)">@FormatPercent(tick)</span>
            }
            @foreach (var tick in XAxisTicks)
            {
                <span class="axis-label x-axis-label" style="@XLabelStyle(tick)">@tick.ToString("dd.MM", CultureInfo.CurrentCulture)</span>
            }
            @for (var index = 0; index < Points.Count; index++)
            {
                var point = Points[index];
                <span class="chart-marker @(index == Points.Count - 1 ? "latest" : null)"
                      style="@MarkerStyle(point)"
                      title="@($"{point.Date:dd.MM.yyyy}: {FormatPercent(point.Percent)}")"></span>
            }
        </div>

        <div class="chart-values">
            <span>Последнее: <strong>@FormatPercent(Points[^1].Percent)</strong></span>
            <span>Лучшее: <strong>@FormatPercent(Points.Max(x => x.Percent))</strong></span>
        </div>

        <details class="chart-data-details">
            <summary>Показать точные значения</summary>
            <div class="chart-data-scroll">
                <table>
                    <caption>Данные графика за последние 30 дней</caption>
                    <thead>
                        <tr>
                            <th scope="col">Дата</th>
                            <th scope="col">Изменение</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var point in Points)
                        {
                            <tr>
                                <td>@point.Date.ToString("dd.MM.yyyy", CultureInfo.CurrentCulture)</td>
                                <td>@FormatSignedPercent(point.Percent)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</section>

@code {
    private const double PlotLeft = 52;
    private const double PlotRight = 584;
    private const double PlotTop = 20;
    private const double PlotBottom = 218;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ProgressChartPointApiResponse> Points { get; set; } = [];

    private DateTime StartDate => Points.Min(x => x.Date).Date;
    private DateTime EndDate => Points.Max(x => x.Date).Date;

    private decimal Minimum
    {
        get
        {
            if (Points.Count == 0)
                return 0;
            var minimum = Math.Min(0, Points.Min(x => x.Percent));
            var maximum = Math.Max(0, Points.Max(x => x.Percent));
            if (minimum == maximum)
                return minimum - 5;
            var padding = Math.Max(2, (maximum - minimum) * .12m);
            return Math.Floor(minimum - padding);
        }
    }

    private decimal Maximum
    {
        get
        {
            if (Points.Count == 0)
                return 5;
            var minimum = Math.Min(0, Points.Min(x => x.Percent));
            var maximum = Math.Max(0, Points.Max(x => x.Percent));
            if (minimum == maximum)
                return maximum + 5;
            var padding = Math.Max(2, (maximum - minimum) * .12m);
            return Math.Ceiling(maximum + padding);
        }
    }

    private IReadOnlyList<decimal> YAxisTicks => Enumerable.Range(0, 5)
        .Select(index => Minimum + (Maximum - Minimum) * index / 4)
        .Reverse()
        .ToList();

    private IReadOnlyList<DateTime> XAxisTicks
    {
        get
        {
            var days = Math.Max(0, (EndDate - StartDate).Days);
            var tickCount = Math.Min(5, days + 1);
            if (tickCount <= 1)
                return [StartDate];

            return Enumerable.Range(0, tickCount)
                .Select(index => StartDate.AddDays(
                    Math.Round(days * index / (double)(tickCount - 1))))
                .Distinct()
                .ToList();
        }
    }

    private string PolylinePoints => string.Join(
        " ",
        Points.Select(point => $"{Format(X(point.Date))},{Format(Y(point.Percent))}"));

    private string AccessibleSummary =>
        $"{Title}. Период с {StartDate:dd.MM.yyyy} по {EndDate:dd.MM.yyyy}. " +
        $"Точек: {Points.Count}. Последнее значение {FormatPercent(Points[^1].Percent)}. " +
        $"Лучшее значение {FormatPercent(Points.Max(x => x.Percent))}.";

    private double X(DateTime date)
    {
        var totalDays = (EndDate - StartDate).TotalDays;
        if (totalDays <= 0)
            return (PlotLeft + PlotRight) / 2;
        return PlotLeft + (PlotRight - PlotLeft) * (date.Date - StartDate).TotalDays / totalDays;
    }

    private double Y(decimal value)
    {
        var range = Maximum - Minimum;
        if (range == 0)
            return (PlotTop + PlotBottom) / 2;
        var ratio = (double)((value - Minimum) / range);
        return PlotBottom - (PlotBottom - PlotTop) * ratio;
    }

    private string MarkerStyle(ProgressChartPointApiResponse point) =>
        $"left:{Format(X(point.Date) / 6)}%;top:{Format(Y(point.Percent) / 2.6)}%;";

    private string XLabelStyle(DateTime date) =>
        $"left:{Format(X(date) / 6)}%;top:{Format((PlotBottom + 13) / 2.6)}%;";

    private string YLabelStyle(decimal value) =>
        $"left:{Format((PlotLeft - 7) / 6)}%;top:{Format(Y(value) / 2.6)}%;";

    private static string Format(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string FormatPercent(decimal value) =>
        $"{value.ToString("0.##", CultureInfo.CurrentCulture)}%";

    private static string FormatSignedPercent(decimal value) =>
        $"{(value > 0 ? "+" : string.Empty)}{FormatPercent(value)}";
}
