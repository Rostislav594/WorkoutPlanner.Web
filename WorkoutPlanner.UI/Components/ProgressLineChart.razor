@using System.Globalization
@using WorkoutPlanner.Api.Contracts

<section class="progress-chart" aria-label="@Title">
    <h3>@Title</h3>
    @if (Points.Count == 0)
    {
        <p class="empty">Данных для графика пока нет.</p>
    }
    else
    {
        <div class="chart-frame" role="img" aria-label="@AccessibleSummary">
            <svg viewBox="0 0 600 260" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <line class="axis-line" x1="52" y1="20" x2="52" y2="218" />
                <line class="axis-line" x1="52" y1="218" x2="584" y2="218" />
                @if (Minimum < 0 && Maximum > 0)
                {
                    <line class="zero-line" x1="52" y1="@Format(Y(0))" x2="584" y2="@Format(Y(0))" />
                }
                @if (Points.Count > 1)
                {
                    <polyline class="progress-line" points="@PolylinePoints" />
                }
                @for (var index = 0; index < Points.Count; index++)
                {
                    var point = Points[index];
                    <circle class="progress-point" cx="@Format(X(index))" cy="@Format(Y(point.Percent))" r="6">
                        <title>@point.Label: @FormatPercent(point.Percent)</title>
                    </circle>
                    @if (ShouldShowLabel(index))
                    {
                        <foreignObject x="@Format(X(index) - 35)" y="226" width="70" height="28">
                            <div class="point-label">@ShortLabel(point.Label)</div>
                        </foreignObject>
                    }
                }
                <foreignObject x="0" y="15" width="47" height="24">
                    <div class="axis-label">@FormatPercent(Maximum)</div>
                </foreignObject>
                <foreignObject x="0" y="205" width="47" height="24">
                    <div class="axis-label">@FormatPercent(Minimum)</div>
                </foreignObject>
            </svg>
        </div>
        <div class="chart-values" aria-hidden="true">
            <span>Последнее: <strong>@FormatPercent(Points[^1].Percent)</strong></span>
            <span>Лучшее: <strong>@FormatPercent(Points.Max(x => x.Percent))</strong></span>
        </div>
    }
</section>

@code {
    private const double PlotLeft = 52;
    private const double PlotRight = 584;
    private const double PlotTop = 20;
    private const double PlotBottom = 218;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ProgressChartPointApiResponse> Points { get; set; } = [];

    private decimal Minimum
    {
        get
        {
            if (Points.Count == 0)
                return 0;
            var minimum = Math.Min(0, Points.Min(x => x.Percent));
            var maximum = Math.Max(0, Points.Max(x => x.Percent));
            if (minimum == maximum)
                return minimum - 5;
            var padding = Math.Max(2, (maximum - minimum) * .12m);
            return Math.Floor(minimum - padding);
        }
    }

    private decimal Maximum
    {
        get
        {
            if (Points.Count == 0)
                return 5;
            var minimum = Math.Min(0, Points.Min(x => x.Percent));
            var maximum = Math.Max(0, Points.Max(x => x.Percent));
            if (minimum == maximum)
                return maximum + 5;
            var padding = Math.Max(2, (maximum - minimum) * .12m);
            return Math.Ceiling(maximum + padding);
        }
    }

    private string PolylinePoints => string.Join(
        " ",
        Points.Select((point, index) => $"{Format(X(index))},{Format(Y(point.Percent))}"));

    private string AccessibleSummary => Points.Count == 0
        ? $"{Title}. Данных нет."
        : $"{Title}. Точек: {Points.Count}. Последнее значение {FormatPercent(Points[^1].Percent)}. Лучшее значение {FormatPercent(Points.Max(x => x.Percent))}.";

    private double X(int index) => Points.Count <= 1
        ? (PlotLeft + PlotRight) / 2
        : PlotLeft + (PlotRight - PlotLeft) * index / (Points.Count - 1d);

    private double Y(decimal value)
    {
        var range = Maximum - Minimum;
        if (range == 0)
            return (PlotTop + PlotBottom) / 2;
        var ratio = (double)((value - Minimum) / range);
        return PlotBottom - (PlotBottom - PlotTop) * ratio;
    }

    private bool ShouldShowLabel(int index)
    {
        if (Points.Count <= 5)
            return true;
        if (index == 0 || index == Points.Count - 1)
            return true;
        var interval = (int)Math.Ceiling(Points.Count / 4d);
        return index % interval == 0;
    }

    private static string ShortLabel(string value) => value.Length <= 8
        ? value
        : value[..8];

    private static string Format(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string FormatPercent(decimal value) =>
        $"{value.ToString("0.##", CultureInfo.CurrentCulture)}%";
}
