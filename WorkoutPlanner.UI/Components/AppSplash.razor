@if (_visible)
{
    <div class="app-splash @(_isLeaving ? "app-splash-leaving" : null)"
         role="status"
         aria-live="polite"
         aria-label="Загрузка приложения">
        <div class="app-splash-content">
            <div class="app-splash-title">GPlanner</div>
            <div class="app-splash-subtitle">Загрузка</div>
            <div class="app-splash-loader" aria-hidden="true">
                <span></span><span></span><span></span>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool? Ready { get; set; }

    private bool _visible = true;
    private bool _isLeaving;
    private bool _hideStarted;
    private DateTime _shownAtUtc = DateTime.UtcNow;

    protected override void OnParametersSet()
    {
        if (Ready == true && !_hideStarted)
            _ = HideAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Ready is not null)
            return;

        await Task.Delay(2200);
        await HideAsync();
    }

    private async Task HideAsync()
    {
        if (_hideStarted)
            return;

        _hideStarted = true;
        var elapsed = DateTime.UtcNow - _shownAtUtc;
        var minimumDuration = TimeSpan.FromMilliseconds(450);
        if (elapsed < minimumDuration)
            await Task.Delay(minimumDuration - elapsed);

        _isLeaving = true;
        await InvokeAsync(StateHasChanged);

        await Task.Delay(300);
        _visible = false;
        await InvokeAsync(StateHasChanged);
    }
}
