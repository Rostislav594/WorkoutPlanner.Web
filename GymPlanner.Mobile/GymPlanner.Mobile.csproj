<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>GymPlanner.Mobile</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <!-- MAUI 10.0.20 can generate invalid Android fragment container resource IDs,
             causing an immediate NavigationRootManager crash on physical devices. -->
        <MauiVersion>10.0.60</MauiVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>GymPlanner</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.gymplanner.mobile</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <!-- Redmi/device Debug builds must be complete, directly installable APKs.
             A single RID keeps the package arm64-only, and embedding assemblies
             disables Fast Deployment's split app/runtime payload. Keeping the
             output in the TFM directory also prevents an obsolete incomplete APK
             beside the current RID-specific package from being installed by mistake. -->
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' == ''">android-arm64</RuntimeIdentifier>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <AndroidPackageFormats>apk</AndroidPackageFormats>
        <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
        <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    </PropertyGroup>

    <ItemGroup Condition="'$(GymPlannerApiBaseAddress)' != ''">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>GymPlannerApiBaseAddress</_Parameter1>
            <_Parameter2>$(GymPlannerApiBaseAddress)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <AndroidManifestOverlay Include="Platforms\Android\AndroidManifest.Debug.xml" />
    </ItemGroup>

    <Target Name="ConfigureGymPlannerAndroidDebugApiReverse" AfterTargets="Install" DependsOnTargets="_ResolveMonoAndroidSdks;_AndroidAdbToolPath" Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' and '$(AdbTarget)' != '' and '$(GymPlannerApiBaseAddress)' == ''">
        <Exec Command="&quot;$(_AdbToolPath)&quot; $(AdbTarget) reverse tcp:5121 tcp:5121" />
    </Target>

    <ItemGroup>
        <GoogleServicesJson Include="google-services.json"
                           Condition="Exists('google-services.json')" />
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F1115" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\emblem.png" Color="#0F1115" BaseSize="256,256" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WorkoutPlanner.Api.Contracts\WorkoutPlanner.Api.Contracts.csproj" />
        <ProjectReference Include="..\WorkoutPlanner.Domain\WorkoutPlanner.Domain.csproj" />
        <ProjectReference Include="..\WorkoutPlanner.UI\WorkoutPlanner.UI.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
        <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.0.0.1"
                          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    </ItemGroup>

</Project>
