@implements IDisposable
@using GymPlanner.Mobile.Offline
@inject OfflineStatusService Status
@inject IAppLanguageService Language
@inject IAppText Text

@* Короткое уведомление и лист «Офлайн-режим». Живут вне шапки: её
   backdrop-filter сделал бы fixed-элементы привязанными к шапке, а не к экрану. *@
@if (Status.Notice is { } notice && !Status.IsSheetOpen)
{
    <div class="offline-notice @(notice.IsProblem ? "offline-notice--problem" : null)"
         role="@(notice.IsProblem ? "alert" : "status")" aria-atomic="true">
        <span class="material-symbols-rounded offline-notice__icon" aria-hidden="true">@notice.Icon</span>
        <span class="offline-notice__text">
            <strong>@notice.Title</strong>
            <span>@notice.Body</span>
        </span>
        <button class="offline-notice__more" type="button" @onclick="Status.OpenSheet">
            @Text["Offline_NoticeMore"]
        </button>
    </div>
}

@if (Status.IsSheetOpen)
{
    <div class="offline-overlay" @onclick="Status.CloseSheet">
        <section class="offline-sheet" role="dialog" aria-modal="true" aria-labelledby="offline-sheet-title"
                 @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
            <div class="offline-sheet__heading">
                <div>
                    <span class="offline-sheet__eyebrow">@Text["Offline_SheetEyebrow"]</span>
                    <h2 id="offline-sheet-title">@Text["Offline_SheetTitle"]</h2>
                </div>
                <button class="offline-sheet__close" type="button" aria-label="@Text["Common_Close"]" @onclick="Status.CloseSheet">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>

            <div class="offline-sheet__status @(Status.IsOffline ? "offline-sheet__status--offline" : "offline-sheet__status--online")"
                 role="status" aria-atomic="true">
                <span class="material-symbols-rounded" aria-hidden="true">@StatusIcon</span>
                <span>
                    <strong>@StatusTitle</strong>
                    <span class="offline-sheet__contact">@LastContactText</span>
                </span>
            </div>

            @if (Status.Issues.Count > 0)
            {
                <h3 class="offline-sheet__section offline-sheet__section--problem">@Text["Offline_IssuesTitle"]</h3>
                <ul class="offline-sheet__list offline-sheet__list--issues">
                    @foreach (var issue in Status.Issues)
                    {
                        <li>
                            <span class="material-symbols-rounded" aria-hidden="true">sync_problem</span>
                            <span>
                                <strong>@OperationTitle(issue.Kind, issue.Label)</strong>
                                <span class="offline-sheet__detail">@issue.Message</span>
                            </span>
                        </li>
                    }
                </ul>
                <button class="offline-sheet__text-button" type="button" disabled="@_clearingIssues" @onclick="ClearIssuesAsync">
                    @Text["Offline_IssuesDismiss"]
                </button>
            }

            @if (Status.Pending.Count > 0)
            {
                <h3 class="offline-sheet__section">@Text.Format("Offline_PendingTitle", Status.Pending.Count)</h3>
                <ul class="offline-sheet__list offline-sheet__list--pending">
                    @foreach (var operation in Status.Pending)
                    {
                        <li>
                            <span class="material-symbols-rounded" aria-hidden="true">schedule</span>
                            <span>@OperationTitle(operation.Kind, operation.Label)</span>
                        </li>
                    }
                </ul>
            }

            <h3 class="offline-sheet__section">@Text["Offline_WorksTitle"]</h3>
            <ul class="offline-sheet__list offline-sheet__list--works">
                @foreach (var key in WorksOffline)
                {
                    <li>
                        <span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
                        <span>@Text[key]</span>
                    </li>
                }
            </ul>

            <h3 class="offline-sheet__section">@Text["Offline_NeedsTitle"]</h3>
            <ul class="offline-sheet__list offline-sheet__list--needs">
                @foreach (var key in NeedsInternet)
                {
                    <li>
                        <span class="material-symbols-rounded" aria-hidden="true">wifi_off</span>
                        <span>@Text[key]</span>
                    </li>
                }
            </ul>

            <p class="offline-sheet__hint">@Text["Offline_SyncHint"]</p>

            <div class="offline-sheet__actions">
                @if (Status.IsOffline)
                {
                    <button class="offline-sheet__primary" type="button" disabled="@_checking" @onclick="CheckConnectionAsync">
                        <span class="material-symbols-rounded" aria-hidden="true">refresh</span>
                        @Text[_checking ? "Offline_Checking" : "Offline_CheckConnection"]
                    </button>
                }
                <button class="offline-sheet__secondary" type="button" @onclick="Status.CloseSheet">@Text["Common_Close"]</button>
            </div>
        </section>
    </div>
}

@code {
    // Порядок — от главного для зала к второстепенному.
    private static readonly string[] WorksOffline =
    [
        "Offline_Works_Workout",
        "Offline_Works_Viewing",
        "Offline_Works_Progress",
        "Offline_Works_Profile",
        "Offline_Works_Notebook"
    ];

    private static readonly string[] NeedsInternet =
    [
        "Offline_Needs_Editing",
        "Offline_Needs_Account",
        "Offline_Needs_Watch",
        "Offline_Needs_Media",
        "Offline_Needs_Inbox"
    ];

    private bool _checking;
    private bool _clearingIssues;

    protected override void OnInitialized() => Status.Changed += OnStatusChanged;

    private string StatusIcon =>
        Status.IsOffline ? "cloud_off"
        : Status.IsSyncing ? "cloud_sync"
        : Status.Pending.Count > 0 ? "cloud_upload"
        : "cloud_done";

    private string StatusTitle =>
        Status.IsOffline ? Text["Offline_StatusOffline"]
        : Status.IsSyncing ? Text["Offline_StatusSyncing"]
        : Text["Offline_StatusOnline"];

    private string LastContactText
    {
        get
        {
            if (Status.LastServerContactUtc is not { } contact)
                return Text["Offline_LastContactUnknown"];

            var culture = System.Globalization.CultureInfo.GetCultureInfo(Language.Current);
            var local = contact.ToLocalTime();
            var value = local.Date == DateTime.Today
                ? local.ToString("t", culture)
                : local.ToString("g", culture);
            return Text.Format("Offline_LastContact", value);
        }
    }

    private string OperationTitle(string kind, string? label)
    {
        var title = Text[kind switch
        {
            OutboxKinds.CompleteScheduledWorkout or OutboxKinds.CompleteFreeWorkout => "Offline_Op_CompleteWorkout",
            OutboxKinds.DiscardFreeWorkoutDraft => "Offline_Op_DiscardDraft",
            OutboxKinds.UpdateExercise => "Offline_Op_UpdateExercise",
            OutboxKinds.DeleteExercise => "Offline_Op_DeleteExercise",
            OutboxKinds.ReorderSuperset => "Offline_Op_ReorderSuperset",
            _ => "Offline_Op_Other"
        }];
        return string.IsNullOrWhiteSpace(label) ? title : $"{title} · {label}";
    }

    private async Task CheckConnectionAsync()
    {
        if (_checking)
            return;

        _checking = true;
        Status.CheckConnection();
        // Проба занимает до нескольких секунд; кнопка честно показывает ожидание,
        // а результат приходит через изменение статуса.
        await Task.Delay(1500);
        _checking = false;
    }

    private async Task ClearIssuesAsync()
    {
        if (_clearingIssues)
            return;

        _clearingIssues = true;
        try
        {
            await Status.ClearIssuesAsync();
        }
        finally
        {
            _clearingIssues = false;
        }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            Status.CloseSheet();
    }

    private void OnStatusChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Status.Changed -= OnStatusChanged;
}
