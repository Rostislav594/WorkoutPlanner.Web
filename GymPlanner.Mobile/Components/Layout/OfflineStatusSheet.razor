@implements IDisposable
@using GymPlanner.Mobile.Offline
@inject OfflineStatusService Status
@inject IAppText Text

@* Короткое уведомление и окно «Нет связи с сервером». Живут вне шапки: её
   backdrop-filter сделал бы fixed-элементы привязанными к шапке, а не к экрану. *@
@if (Status.Notice is { } notice && !Status.IsSheetOpen)
{
    <div class="offline-notice @(notice.IsProblem ? "offline-notice--problem" : null)"
         role="@(notice.IsProblem ? "alert" : "status")" aria-atomic="true">
        <span class="material-symbols-rounded offline-notice__icon" aria-hidden="true">@notice.Icon</span>
        <span class="offline-notice__text">
            <strong>@notice.Title</strong>
            <span>@notice.Body</span>
        </span>
        @if (notice.IsProblem)
        {
            <button class="offline-notice__more" type="button" @onclick="Status.OpenSheet">
                @Text["Offline_NoticeMore"]
            </button>
        }
    </div>
}

@if (Status.IsSheetOpen)
{
    <div class="offline-overlay" @onclick="Status.CloseSheet">
        <section class="offline-sheet" role="dialog" aria-modal="true" aria-labelledby="offline-sheet-title"
                 @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
            <div class="offline-sheet__title @(Status.IsOffline ? null : "offline-sheet__title--problem")">
                <span class="material-symbols-rounded" aria-hidden="true">@(Status.IsOffline ? "cloud_off" : "sync_problem")</span>
                <h2 id="offline-sheet-title">@Text[Status.IsOffline ? "Offline_StatusOffline" : "Offline_IssuesTitle"]</h2>
            </div>

            @* Отклонённое сервером человек должен увидеть: иначе изменение пропадёт молча. *@
            @if (Status.Issues.Count > 0)
            {
                @if (Status.IsOffline)
                {
                    <h3 class="offline-sheet__section offline-sheet__section--problem">@Text["Offline_IssuesTitle"]</h3>
                }
                <ul class="offline-sheet__list offline-sheet__list--issues">
                    @foreach (var issue in Status.Issues)
                    {
                        <li>
                            <span class="material-symbols-rounded" aria-hidden="true">sync_problem</span>
                            <span>
                                <strong>@OperationTitle(issue.Kind, issue.Label)</strong>
                                <span class="offline-sheet__detail">@issue.Message</span>
                            </span>
                        </li>
                    }
                </ul>
                <button class="offline-sheet__text-button" type="button" disabled="@_clearingIssues" @onclick="ClearIssuesAsync">
                    @Text["Offline_IssuesDismiss"]
                </button>
            }

            <div class="offline-sheet__actions">
                @if (Status.IsOffline)
                {
                    <button class="offline-sheet__primary" type="button" disabled="@_checking" @onclick="CheckConnectionAsync">
                        <span class="material-symbols-rounded" aria-hidden="true">refresh</span>
                        @Text[_checking ? "Offline_Checking" : "Offline_CheckConnection"]
                    </button>
                }
                <button class="offline-sheet__secondary" type="button" @onclick="Status.CloseSheet">@Text["Common_Close"]</button>
            </div>
        </section>
    </div>
}

@code {
    private bool _checking;
    private bool _clearingIssues;

    protected override void OnInitialized() => Status.Changed += OnStatusChanged;

    private string OperationTitle(string kind, string? label)
    {
        var title = Text[kind switch
        {
            OutboxKinds.CompleteScheduledWorkout or OutboxKinds.CompleteFreeWorkout => "Offline_Op_CompleteWorkout",
            OutboxKinds.DiscardFreeWorkoutDraft => "Offline_Op_DiscardDraft",
            OutboxKinds.UpdateExercise => "Offline_Op_UpdateExercise",
            OutboxKinds.DeleteExercise => "Offline_Op_DeleteExercise",
            OutboxKinds.ReorderSuperset => "Offline_Op_ReorderSuperset",
            OutboxKinds.UpdateRestTimers => "Offline_Op_UpdateRestTimers",
            OutboxKinds.CreatePlan => "Offline_Op_CreatePlan",
            OutboxKinds.RenamePlan => "Offline_Op_RenamePlan",
            OutboxKinds.DeletePlan => "Offline_Op_DeletePlan",
            OutboxKinds.CreateExercise => "Offline_Op_CreateExercise",
            OutboxKinds.ScheduleWorkout => "Offline_Op_ScheduleWorkout",
            OutboxKinds.MoveWorkout => "Offline_Op_MoveWorkout",
            OutboxKinds.DeleteWorkoutDay => "Offline_Op_DeleteWorkoutDay",
            OutboxKinds.DeleteHistory => "Offline_Op_DeleteHistory",
            OutboxKinds.SaveProfile or OutboxKinds.SaveRestTimers or OutboxKinds.SaveLanguage => "Offline_Op_SaveProfile",
            _ => "Offline_Op_Other"
        }];
        return string.IsNullOrWhiteSpace(label) ? title : $"{title} · {label}";
    }

    private async Task CheckConnectionAsync()
    {
        if (_checking)
            return;

        _checking = true;
        Status.CheckConnection();
        // Проба занимает до нескольких секунд; кнопка честно показывает ожидание,
        // а результат приходит через изменение статуса.
        await Task.Delay(1500);
        _checking = false;
    }

    private async Task ClearIssuesAsync()
    {
        if (_clearingIssues)
            return;

        _clearingIssues = true;
        try
        {
            await Status.ClearIssuesAsync();
        }
        finally
        {
            _clearingIssues = false;
        }
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            Status.CloseSheet();
    }

    private void OnStatusChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Status.Changed -= OnStatusChanged;
}
