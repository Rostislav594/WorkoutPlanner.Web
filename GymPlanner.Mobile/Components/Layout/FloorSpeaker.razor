@* A decorative part of the wallpaper scene. Only the exposed membranes move;
   the cabinet and its floor contact remain still within that scene. *@
<div class="floor-speaker" aria-hidden="true">
    <span class="floor-speaker__shadow"></span>
    <div class="floor-speaker__artwork">
        <img class="floor-speaker__cabinet" src="images/floor-speaker.png"
             width="1024" height="1536" alt="" draggable="false" />
        <img class="floor-speaker__cone floor-speaker__cone--upper" src="images/floor-speaker.png"
             width="1024" height="1536" alt="" draggable="false" />
        <img class="floor-speaker__cone floor-speaker__cone--lower" src="images/floor-speaker.png"
             width="1024" height="1536" alt="" draggable="false" />
    </div>
    <svg class="floor-speaker__sound floor-speaker__sound--upper" viewBox="0 0 100 100" focusable="false">
