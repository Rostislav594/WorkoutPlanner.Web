@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject MobileAuthenticationService Authentication
@inject IWelcomeGuideApiClient WelcomeGuide
@inject NavigationManager Navigation
@inject NotificationNavigationService NotificationNavigation
@inject PushRegistrationCoordinator PushRegistration
@inject IAudioSpectrumService AudioSpectrum
@inject MobileLifecycleService Lifecycle
@inject IJSRuntime JavaScript
@inject IAppText Text

<div class="mobile-shell @(IsPrimaryNavigationPage ? "wallpaper-shell" : "ambient-shell") @(IsHomePage ? "home-shell" : null) @(HidesApplicationNavigation ? "mobile-shell--flow" : null) @(_audioState == AudioSpectrumState.Active ? "audio-reactive" : null)"
     style="--wallpaper-shift: @WallpaperShift;">
    <div class="ambient-dust" aria-hidden="true">
        <span class="ambient-dust__layer ambient-dust__layer--far"></span>
        <span class="ambient-dust__layer ambient-dust__layer--near"></span>
    </div>
    @if (!HidesApplicationNavigation)
    {
        <header class="mobile-header">
            <a class="mobile-brand" href="/" aria-label="@Text["Layout_BrandHome"]">
                <span>GPlanner</span>
            </a>
            <div class="header-audio-visualizer" aria-hidden="true">
                <canvas class="audio-equalizer-canvas" @ref="_audioCanvas"></canvas>
            </div>
            <AuthorizeView>
                <Authorized>
                    <div class="header-actions">
                        @if (AudioSpectrum.IsAvailable)
                        {
                            <button class="audio-equalizer-toggle @(_audioState == AudioSpectrumState.Active ? "audio-equalizer-toggle--active" : null)"
                                    type="button"
                                    disabled="@(_audioState == AudioSpectrumState.Starting)"
                                    aria-pressed="@(_audioState == AudioSpectrumState.Active ? "true" : "false")"
                                    aria-label="@AudioToggleLabel"
                                    title="@AudioToggleLabel"
                                    @onclick="ToggleAudioVisualizationAsync">
                                <span class="material-symbols-rounded" aria-hidden="true">graphic_eq</span>
                                <span class="audio-equalizer-toggle__signal" aria-hidden="true"></span>
                            </button>
                        }
                        <a class="profile-button" href="profile" aria-label="@Text["Layout_OpenProfile"]">
                            <span class="material-symbols-rounded" aria-hidden="true">person</span>
                        </a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <span class="connection-mode">GymPlanner</span>
                </NotAuthorized>
            </AuthorizeView>
        </header>
    }
    @if (!HidesApplicationNavigation && _audioMessageKey is not null)
    {
        <div class="audio-equalizer-message" role="status">
            <span class="material-symbols-rounded" aria-hidden="true">info</span>
            <span>@Text[_audioMessageKey]</span>
        </div>
    }
    <main class="mobile-content">
        <div class="page-transition" @key="CurrentPageKey">
            @* Верхний перехват для рендерера. Необработанное исключение страницы
               иначе сносит весь рендерер Blazor, и приложение просто замирает:
               не работают ни кнопки, ни навигация, ни закрытие открытого диалога.
               ErrorBoundary оставляет живыми шапку и нижнюю навигацию, поэтому
               из сломанного раздела всегда можно уйти. Ключ страницы пересоздаёт
               границу при переходе, так что отдельно сбрасывать её не нужно. *@
            <ErrorBoundary @ref="_pageErrorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="page-error" role="alert">
                        <span class="page-error__icon material-symbols-rounded" aria-hidden="true">error</span>
                        <h2 class="page-error__title">@Text["Layout_PageErrorTitle"]</h2>
                        <p class="page-error__body">@Text["Layout_PageErrorBody"]</p>
                        <button class="page-error__action" type="button" @onclick="RetryFailedPage">
                            @Text["Common_Retry"]
                        </button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>
    @if (!HidesApplicationNavigation)
    {
        <nav class="mobile-navigation" aria-label="@Text["Nav_Main"]">
            @if (_activeNavigationIndex >= 0)
            {
                <span @key="_navigationMotionKey"
                      class="navigation-indicator @(_animateNavigationIndicator ? "navigation-indicator--moving" : null)"
                      style="@NavigationIndicatorStyle"
                      aria-hidden="true">
                    <span class="navigation-indicator__blob"></span>
                </span>
            }
            <NavLink href="today">
                <span class="material-symbols-rounded" aria-hidden="true">home</span>
                <span class="navigation-label">@Text["Nav_Today"]</span>
            </NavLink>
            <NavLink href="workouts">
                <span class="material-symbols-rounded" aria-hidden="true">fitness_center</span>
                <span class="navigation-label">@Text["Nav_Workouts"]</span>
            </NavLink>
            <NavLink href="/" Match="NavLinkMatch.All">
                <span class="material-symbols-rounded" aria-hidden="true">dashboard</span>
                <span class="navigation-label">@Text["Nav_Home"]</span>
            </NavLink>
            <NavLink href="history">
                <span class="material-symbols-rounded" aria-hidden="true">history</span>
                <span class="navigation-label">@Text["Nav_History"]</span>
            </NavLink>
            <NavLink href="progress">
                <span class="material-symbols-rounded" aria-hidden="true">monitoring</span>
                <span class="navigation-label">@Text["Nav_Progress"]</span>
            </NavLink>
        </nav>
    }
</div>

@code {
    private bool _checkingWelcomeGuide;
    private ErrorBoundary? _pageErrorBoundary;
    private int _activeNavigationIndex;
    private int _previousNavigationIndex;
    private long _navigationMotionKey;
    private bool _animateNavigationIndicator;
    private ElementReference _audioCanvas;
    private IJSObjectReference? _audioEqualizerModule;
    private AudioSpectrumState _audioState = AudioSpectrumState.Inactive;
    private AudioSpectrumFrame _latestSpectrumFrame;
    private int _spectrumDispatchPending;
    private string? _audioMessageKey;
    private bool _audioCanvasReady;

    // Recover пересоздаёт содержимое границы, то есть страница инициализируется
    // заново. Для сетевого сбоя этого достаточно; если причина устойчивая,
    // экран ошибки просто появится снова, а не оставит пользователя в тупике.
    private void RetryFailedPage() => _pageErrorBoundary?.Recover();

    private string CurrentPageKey =>
        Navigation.ToBaseRelativePath(Navigation.Uri);
    private bool IsHomePage => string.IsNullOrEmpty(
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/'));
    private bool IsPrimaryNavigationPage => IsPrimaryRoute(CurrentRoute);
    private string AudioToggleLabel => Text[
        _audioState == AudioSpectrumState.Active
            ? "AudioEqualizer_Stop"
            : "AudioEqualizer_Start"];
    private string WallpaperShift => _activeNavigationIndex switch
    {
        0 => "8vw",
        1 => "4vw",
        3 => "-4vw",
        4 => "-8vw",
        _ => "0vw"
    };
    private bool HidesApplicationNavigation =>
        string.Equals(CurrentRoute, "profile/setup", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentRoute, "firstlaunch", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(CurrentRoute, "welcome-guide", StringComparison.OrdinalIgnoreCase);
    private string CurrentRoute => Navigation.ToBaseRelativePath(Navigation.Uri)
        .Split('?', '#')[0]
        .Trim('/');

    private static bool IsPrimaryRoute(string route) =>
        route.Length == 0 ||
        route.Equals("today", StringComparison.OrdinalIgnoreCase) ||
        route.Equals("workouts", StringComparison.OrdinalIgnoreCase) ||
        route.Equals("history", StringComparison.OrdinalIgnoreCase) ||
        route.Equals("progress", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        _audioState = AudioSpectrum.State;
        _activeNavigationIndex = NavigationIndexFor(Navigation.Uri);
        _previousNavigationIndex = Math.Max(0, _activeNavigationIndex);
        AudioSpectrum.SpectrumUpdated += OnSpectrumUpdated;
        AudioSpectrum.StateChanged += OnAudioStateChanged;
        Lifecycle.Suspended += OnApplicationSuspended;
        NotificationNavigation.RouteRequested += OpenNotificationRoute;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var nextNavigationIndex = NavigationIndexFor(args.Location);
        if (nextNavigationIndex != _activeNavigationIndex)
        {
            _animateNavigationIndicator = _activeNavigationIndex >= 0 && nextNavigationIndex >= 0;
            _previousNavigationIndex = _animateNavigationIndicator
                ? _activeNavigationIndex
                : Math.Max(0, nextNavigationIndex);
            _activeNavigationIndex = nextNavigationIndex;
            _navigationMotionKey++;
        }

        _ = InvokeAsync(async () =>
        {
            if (HidesApplicationNavigation)
            {
                await DisposeAudioCanvasAsync();
                await StopAudioVisualizationAsync(clearMessage: true);
            }

            StateHasChanged();
            await CheckWelcomeGuideAsync();
        });
    }

    private string NavigationIndicatorStyle
    {
        get
        {
            var distance = Math.Abs(_activeNavigationIndex - _previousNavigationIndex);
            var boundedDistance = Math.Min(distance, 4);
            var stretch = 1 + boundedDistance * .3;
            var duration = .54 + boundedDistance * .03;
            return $"--nav-from-offset:var(--nav-offset-{_previousNavigationIndex});" +
                   $"--nav-to-offset:var(--nav-offset-{_activeNavigationIndex});" +
                   $"--nav-stretch:{stretch.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)};" +
                   $"--nav-duration:{duration.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}s";
        }
    }

    private int NavigationIndexFor(string uri)
    {
        var route = Navigation.ToBaseRelativePath(uri)
            .Split('?', '#')[0]
            .Trim('/');

        if (route.Equals("today", StringComparison.OrdinalIgnoreCase)) return 0;
        if (route.Equals("workouts", StringComparison.OrdinalIgnoreCase) ||
            route.StartsWith("workouts/", StringComparison.OrdinalIgnoreCase)) return 1;
        if (route.Length == 0) return 2;
        if (route.Equals("history", StringComparison.OrdinalIgnoreCase)) return 3;
        if (route.Equals("progress", StringComparison.OrdinalIgnoreCase) ||
            route.StartsWith("progress/", StringComparison.OrdinalIgnoreCase)) return 4;
        return -1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!HidesApplicationNavigation && !_audioCanvasReady)
        {
            _audioEqualizerModule ??= await JavaScript.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/audioEqualizer.js");
            await _audioEqualizerModule.InvokeVoidAsync("initialize", _audioCanvas);
            _audioCanvasReady = true;

            if (_audioState == AudioSpectrumState.Active)
                await _audioEqualizerModule.InvokeVoidAsync("setActive", _audioCanvas, true);
        }

        if (!firstRender)
            return;

        if (NotificationNavigation.ConsumePendingRoute() is { } route)
        {
            Navigation.NavigateTo(route);
            return;
        }

        await Authentication.InitializeAsync();
        await PushRegistration.InitializeAsync();
        await CheckWelcomeGuideAsync();
    }

    private async Task CheckWelcomeGuideAsync()
    {
        if (_checkingWelcomeGuide ||
            !Authentication.IsAuthenticated ||
            CurrentRoute.StartsWith("account/", StringComparison.OrdinalIgnoreCase) ||
            HidesApplicationNavigation)
        {
            return;
        }

        _checkingWelcomeGuide = true;
        try
        {
            var state = await WelcomeGuide.GetStateAsync();
            if (state.Succeeded && state.Value is { IsCompleted: false })
                Navigation.NavigateTo("/firstlaunch", replace: true);
        }
        finally
        {
            _checkingWelcomeGuide = false;
        }
    }

    private void OpenNotificationRoute(string route) =>
        _ = InvokeAsync(() => Navigation.NavigateTo(route));

    private async Task ToggleAudioVisualizationAsync()
    {
        if (_audioState == AudioSpectrumState.Starting)
            return;

        _audioMessageKey = null;
        if (_audioState == AudioSpectrumState.Active)
        {
            await StopAudioVisualizationAsync(clearMessage: true);
            return;
        }

        _audioState = AudioSpectrumState.Starting;
        StateHasChanged();
        var result = await AudioSpectrum.StartAsync();
        await ApplyAudioStateAsync(result);
    }

    private void OnAudioStateChanged(AudioSpectrumState state) =>
        _ = InvokeAsync(() => ApplyAudioStateAsync(state));

    private async Task ApplyAudioStateAsync(AudioSpectrumState state)
    {
        _audioState = state;
        _audioMessageKey = state switch
        {
            AudioSpectrumState.PermissionDenied => "AudioEqualizer_PermissionDenied",
            AudioSpectrumState.Unavailable => "AudioEqualizer_Unavailable",
            AudioSpectrumState.Error => "AudioEqualizer_Error",
            _ => null
        };

        if (_audioCanvasReady && _audioEqualizerModule is not null)
        {
            await _audioEqualizerModule.InvokeVoidAsync(
                "setActive",
                _audioCanvas,
                state == AudioSpectrumState.Active);
        }

        StateHasChanged();
    }

    private void OnSpectrumUpdated(AudioSpectrumFrame frame)
    {
        _latestSpectrumFrame = frame;
        if (Interlocked.CompareExchange(ref _spectrumDispatchPending, 1, 0) == 0)
            _ = InvokeAsync(PushLatestSpectrumFrameAsync);
    }

    private async Task PushLatestSpectrumFrameAsync()
    {
        try
        {
            if (!_audioCanvasReady ||
                _audioEqualizerModule is null ||
                _audioState != AudioSpectrumState.Active)
            {
                return;
            }

            var frame = _latestSpectrumFrame;
            await _audioEqualizerModule.InvokeVoidAsync(
                "update",
                _audioCanvas,
                frame.Bass,
                frame.LowMid,
                frame.Mid,
                frame.High,
                frame.Beat,
                frame.Level);
        }
        catch (JSException)
        {
        }
        finally
        {
            Interlocked.Exchange(ref _spectrumDispatchPending, 0);
        }
    }

    private void OnApplicationSuspended() =>
        _ = InvokeAsync(() => StopAudioVisualizationAsync(clearMessage: true));

    private async Task StopAudioVisualizationAsync(bool clearMessage)
    {
        await AudioSpectrum.StopAsync();
        _audioState = AudioSpectrumState.Inactive;
        if (clearMessage)
            _audioMessageKey = null;

        if (_audioCanvasReady && _audioEqualizerModule is not null)
            await _audioEqualizerModule.InvokeVoidAsync("setActive", _audioCanvas, false);

        StateHasChanged();
    }

    private async Task DisposeAudioCanvasAsync()
    {
        if (!_audioCanvasReady || _audioEqualizerModule is null)
            return;

        try
        {
            await _audioEqualizerModule.InvokeVoidAsync("dispose", _audioCanvas);
        }
        catch (JSException)
        {
        }
        finally
        {
            _audioCanvasReady = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        AudioSpectrum.SpectrumUpdated -= OnSpectrumUpdated;
        AudioSpectrum.StateChanged -= OnAudioStateChanged;
        Lifecycle.Suspended -= OnApplicationSuspended;
        NotificationNavigation.RouteRequested -= OpenNotificationRoute;
        Navigation.LocationChanged -= OnLocationChanged;

        await AudioSpectrum.StopAsync();
        if (_audioEqualizerModule is not null)
        {
            try
            {
                await DisposeAudioCanvasAsync();
                await _audioEqualizerModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
