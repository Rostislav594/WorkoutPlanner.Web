@page "/history"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using WorkoutPlanner.Api.Contracts
@inject IWorkoutLifecycleApiClient LifecycleClient
@inject IAppText Text
@inject NavigationManager Navigation

<section class="history-page" aria-busy="@_isLoading">
    <header class="history-page-header">
        <div class="page-title-row">
            <h1>@Text["History_Title"]</h1>
            <HelpButton Topic="HelpContentCatalog.History" />
        </div>
        <div class="header-line" aria-hidden="true"></div>
    </header>

    @if (_errors.Count > 0)
    {
        <div class="history-error" role="alert">
            <span class="material-symbols-rounded" aria-hidden="true">error</span>
            <div>
                <strong>@Text["History_LoadFailed"]</strong>
                <p>@string.Join(" ", _errors)</p>
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <div class="history-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>@Text["History_Loading"]</span>
        </div>
    }
    else if (_history.Count == 0)
    {
        <div class="history-empty">
            <div class="history-empty-visual" aria-hidden="true">
                <span class="material-symbols-rounded">history_toggle_off</span>
            </div>
            <h2>@Text["History_EmptyTitle"]</h2>
            <p>@Text["History_EmptyBody"]</p>
            @if (_errors.Count > 0)
            {
                <button class="secondary-button retry-button" type="button" @onclick="LoadAsync">@Text["Common_Retry"]</button>
            }
        </div>
    }
    else
    {
        <div class="history-list">
            @foreach (var item in _history)
            {
                var isTarget = item.Id == _targetHistoryId;
                <button class="history-card @(isTarget ? "history-card--targeted" : null)"
                        id="history-card-@item.Id"
                        type="button"
                        autofocus="@isTarget"
                        aria-current="@(isTarget ? "true" : null)"
                        @onclick="() => OpenHistory(item)"
                        aria-label="@Text.Format("History_Open", item.WorkoutName)">
                    <span class="history-card-content">
                        <span class="history-title">@item.WorkoutName</span>
                        <span class="history-date">
                            <span class="material-symbols-rounded" aria-hidden="true">calendar_today</span>
                            @item.Date.ToString("dd MMMM yyyy, HH:mm", UiCulture)
                        </span>
                    </span>
                    <span class="history-card-aside">
                        @if (item.SnapshotAvailable)
                        {
                            <span class="card-meta">@Text.Plural("Exercises", item.Exercises.Count)</span>
                        }
                        else
                        {
                            <span class="legacy-label">@Text["History_Legacy"]</span>
                        }
                        <span class="material-symbols-rounded card-chevron" aria-hidden="true">chevron_right</span>
                    </span>
                </button>
            }
        </div>
    }
</section>

@if (_selected is not null)
{
    <div class="modal-overlay" @onclick="CloseHistory">
        <section class="modal-window history-dialog" role="dialog" aria-modal="true" aria-labelledby="history-title" @onclick:stopPropagation="true">
            <header class="dialog-header">
                <div>
                    <h2 id="history-title">@_selected.WorkoutName</h2>
                    <p>
                        <span class="material-symbols-rounded" aria-hidden="true">calendar_today</span>
                        @_selected.Date.ToString("dd MMMM yyyy, HH:mm", UiCulture)
                    </p>
                </div>
                <button class="close-button" type="button" disabled="@_isBusy" @onclick="CloseHistory" aria-label="@Text["History_Close"]">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </header>

            @if (_dialogErrors.Count > 0)
            {
                <div class="dialog-error" role="alert">@string.Join(" ", _dialogErrors)</div>
            }

            @if (!_selected.SnapshotAvailable)
            {
                <div class="snapshot-unavailable" role="status">
                    <span class="material-symbols-rounded" aria-hidden="true">inventory_2</span>
                    <h3>@Text["History_SnapshotUnavailableTitle"]</h3>
                    <p>@Text["History_SnapshotUnavailableBody"]</p>
                </div>
            }
            else
            {
                <div class="history-exercises">
                    @foreach (var group in SelectedExerciseGroups)
                    {
                        @if (group.IsSuperset)
                        {
                            var supersetStatus = GetSupersetStatus(group);
                            <article class="history-exercise history-superset" aria-label="@Text.Format("History_SupersetLabel", string.Join(Text["Common_AndSeparator"], group.Exercises.Select(x => x.Name)))">
                                <header class="history-superset-heading">
                                    <span class="material-symbols-rounded" aria-hidden="true">link</span>
                                    <div class="history-superset-title">
                                        <span class="history-superset-kicker">@Text["Common_Superset"]</span>
                                        <div class="history-superset-names" aria-label="@string.Join(" / ", group.Exercises.Select(x => x.Name))">
                                            @for (var exerciseIndex = 0; exerciseIndex < group.Exercises.Count; exerciseIndex++)
                                            {
                                                var exercise = group.Exercises[exerciseIndex];
                                                if (exerciseIndex > 0)
                                                {
                                                    <span class="history-superset-name-separator" aria-hidden="true">/</span>
                                                }
                                                <span class="history-superset-name @(exerciseIndex == 0 ? "superset-tone-a" : "superset-tone-b")">@exercise.Name</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="status-badge status-@supersetStatus.ToLowerInvariant()">@Text[WorkoutDifficulties.KeyFor(supersetStatus)]</span>
                                </header>

                                <div class="history-sets history-superset-rounds">
                                    @foreach (var roundNumber in GetSupersetRoundNumbers(group))
                                    {
                                        <section class="history-superset-round" aria-label="@Text.Format("History_Round", roundNumber)">
                                            @for (var exerciseIndex = 0; exerciseIndex < group.Exercises.Count; exerciseIndex++)
                                            {
                                                var exercise = group.Exercises[exerciseIndex];
                                                var set = exercise.Sets.FirstOrDefault(candidate => candidate.SetNumber == roundNumber);
                                                if (set is null)
                                                    continue;

                                                <div class="history-set history-superset-set @(exerciseIndex == 0 ? "superset-tone-a" : "superset-tone-b")">
                                                    <span class="completion-mark @(set.Completed ? "done" : null)" aria-label="@(set.Completed ? Text["Common_SetCompleted"] : Text["Common_SetNotCompleted"])">
                                                        <span class="material-symbols-rounded" aria-hidden="true">@(set.Completed ? "check" : "remove")</span>
                                                    </span>
                                                    <span class="history-set-label">
                                                        <span class="history-superset-exercise-name">@Text.Format("History_SupersetSetName", exercise.Name, set.SetNumber)</span>
                                                        <span class="set-kind @(set.IsWarmup ? "warmup" : "working")">
                                                            @(set.IsWarmup ? Text["Common_WarmupSet"] : Text["Common_WorkingSet"])
                                                        </span>
                                                    </span>
                                                    <strong>
                                                        <span>@set.Weight.ToString("0.##", UiCulture) @Text["Common_Kg"]</span>
                                                        <span aria-hidden="true">×</span>
                                                        <span>@set.Repetitions</span>
                                                    </strong>
                                                </div>
                                            }
                                        </section>
                                    }
                                </div>
                            </article>
                        }
                        else
                        {
                            var exercise = group.Exercises[0];
                            <article class="history-exercise">
                                <div class="exercise-heading">
                                    <div>
                                        <span class="exercise-index">@Text["Common_Exercise"]</span>
                                        <h3>@exercise.Name</h3>
                                    </div>
                                    <span class="status-badge status-@exercise.Status.ToLowerInvariant()">@Text[WorkoutDifficulties.KeyFor(exercise.Status)]</span>
                                </div>
                                <div class="history-sets">
                                    @foreach (var set in exercise.Sets.OrderBy(x => x.SetNumber))
                                    {
                                        <div class="history-set">
                                            <span class="completion-mark @(set.Completed ? "done" : null)" aria-label="@(set.Completed ? Text["Common_SetCompleted"] : Text["Common_SetNotCompleted"])">
                                                <span class="material-symbols-rounded" aria-hidden="true">@(set.Completed ? "check" : "remove")</span>
                                            </span>
                                            <span class="history-set-label">
                                                <span>@Text.Format("Common_SetNumber", set.SetNumber)</span>
                                                <span class="set-kind @(set.IsWarmup ? "warmup" : "working")">
                                                    @(set.IsWarmup ? Text["Common_WarmupSet"] : Text["Common_WorkingSet"])
                                                </span>
                                            </span>
                                            <strong>
                                                <span>@set.Weight.ToString("0.##", UiCulture) @Text["Common_Kg"]</span>
                                                <span aria-hidden="true">×</span>
                                                <span>@set.Repetitions</span>
                                            </strong>
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_selected.Summary))
            {
                <div class="history-summary">
                    <span class="material-symbols-rounded" aria-hidden="true">notes</span>
                    <p>@_selected.Summary</p>
                </div>
            }

            <div class="dialog-actions">
                @if (_confirmDelete)
                {
                    <p class="delete-warning">@Text["History_DeleteWarning"]</p>
                    <button class="danger-button" type="button" disabled="@_isBusy" @onclick="DeleteAsync">
                        @(_isBusy ? Text["Common_Deleting"] : Text["History_DeleteConfirm"])
                    </button>
                    <button class="secondary-button" type="button" disabled="@_isBusy" @onclick="CancelDelete">@Text["Common_Cancel"]</button>
                }
                else
                {
                    <button class="danger-button" type="button" @onclick="ConfirmDelete">@Text["History_DeleteEntry"]</button>
                }
            </div>
        </section>
    </div>
}

@code {
    // Даты и вес показываем в культуре выбранного языка.
    private CultureInfo UiCulture => CultureInfo.GetCultureInfo(Text.Language);
    private readonly List<WorkoutHistoryApiResponse> _history = [];
    private readonly List<string> _errors = [];
    private readonly List<string> _dialogErrors = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private WorkoutHistoryApiResponse? _selected;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _confirmDelete;
    private int? _targetHistoryId;
    private bool _targetScrollPending;

    [Parameter, SupplyParameterFromQuery(Name = "workout")]
    public string? TargetWorkout { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "date")]
    public DateTime? TargetDate { get; set; }

    private IReadOnlyList<HistoryExerciseGroup> SelectedExerciseGroups =>
        (_selected?.Exercises ?? [])
            .Select((exercise, index) => new { Exercise = exercise, Index = index })
            .GroupBy(item => item.Exercise.SupersetGroupId is { } groupId
                ? $"superset:{groupId}"
                : $"exercise:{item.Index}")
            .Select(group => new HistoryExerciseGroup(
                group.Key.StartsWith("superset:", StringComparison.Ordinal) && group.Count() > 1,
                group.Select(item => item.Exercise).ToList()))
            .ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errors.Clear();
        try
        {
            var result = await LifecycleClient.GetHistoryAsync(_disposeCts.Token);
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                return;
            }

            _history.Clear();
            _history.AddRange(result.Value!
                .OrderByDescending(x => x.Date));
            UpdateTargetHistory();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (!_isLoading)
            UpdateTargetHistory();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!_targetScrollPending || _targetHistoryId is not { } targetId)
            return;

        _targetScrollPending = false;
        var uriWithoutFragment = Navigation.Uri.Split('#', 2)[0];
        Navigation.NavigateTo(
            $"{uriWithoutFragment}#history-card-{targetId}",
            replace: true);
    }

    private void UpdateTargetHistory()
    {
        if (string.IsNullOrWhiteSpace(TargetWorkout) || TargetDate is null)
        {
            _targetHistoryId = null;
            _targetScrollPending = false;
            return;
        }

        var targetHistoryId = _history
            .Where(item =>
                string.Equals(item.WorkoutName, TargetWorkout, StringComparison.Ordinal) &&
                item.Date.Date == TargetDate.Value.Date)
            .OrderBy(item => Math.Abs((item.Date - TargetDate.Value).Ticks))
            .Select(item => (int?)item.Id)
            .FirstOrDefault();

        if (_targetHistoryId == targetHistoryId)
            return;

        _targetHistoryId = targetHistoryId;
        _targetScrollPending = targetHistoryId is not null;
    }

    private void OpenHistory(WorkoutHistoryApiResponse item)
    {
        _selected = item;
        _confirmDelete = false;
        _dialogErrors.Clear();
    }

    private void CloseHistory()
    {
        if (_isBusy)
            return;

        _selected = null;
        _confirmDelete = false;
        _dialogErrors.Clear();
    }

    private void ConfirmDelete() => _confirmDelete = true;
    private void CancelDelete() => _confirmDelete = false;

    private async Task DeleteAsync()
    {
        if (_isBusy || _selected is null)
            return;

        _isBusy = true;
        _dialogErrors.Clear();
        var id = _selected.Id;
        try
        {
            var result = await LifecycleClient.DeleteHistoryAsync(
                id,
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _dialogErrors.AddRange(result.Errors);
                return;
            }

            _history.RemoveAll(x => x.Id == id);
            _selected = null;
            _confirmDelete = false;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static IReadOnlyList<int> GetSupersetRoundNumbers(HistoryExerciseGroup group) =>
        group.Exercises
            .SelectMany(exercise => exercise.Sets)
            .Select(set => set.SetNumber)
            .Distinct()
            .OrderBy(setNumber => setNumber)
            .ToList();

    private static string GetSupersetStatus(HistoryExerciseGroup group)
    {
        var status = group.Exercises[0].Status;
        return group.Exercises.All(exercise => exercise.Status == status) ? status : "NotCompleted";
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private sealed record HistoryExerciseGroup(
        bool IsSuperset,
        IReadOnlyList<WorkoutHistoryExerciseApiResponse> Exercises);
}
