@page "/history"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using WorkoutPlanner.Api.Contracts
@inject IWorkoutLifecycleApiClient LifecycleClient

<section class="history-page" aria-busy="@_isLoading">
    <header class="history-page-header">
        <div class="page-title-row">
            <h1>История</h1>
            <HelpButton Topic="HelpContentCatalog.History" />
        </div>
        <div class="header-line" aria-hidden="true"></div>
    </header>

    @if (_errors.Count > 0)
    {
        <div class="history-error" role="alert">
            <span class="material-symbols-rounded" aria-hidden="true">error</span>
            <div>
                <strong>Не удалось загрузить историю</strong>
                <p>@string.Join(" ", _errors)</p>
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <div class="history-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Загружаем историю…</span>
        </div>
    }
    else if (_history.Count == 0)
    {
        <div class="history-empty">
            <div class="history-empty-visual" aria-hidden="true">
                <span class="material-symbols-rounded">history_toggle_off</span>
            </div>
            <h2>История пока пуста</h2>
            <p>Завершённые тренировки и их результаты появятся здесь.</p>
            @if (_errors.Count > 0)
            {
                <button class="secondary-button retry-button" type="button" @onclick="LoadAsync">Повторить</button>
            }
        </div>
    }
    else
    {
        <div class="history-list">
            @foreach (var item in _history)
            {
                <button class="history-card" type="button" @onclick="() => OpenHistory(item)" aria-label="Открыть историю тренировки @item.WorkoutName">
                    <span class="history-card-content">
                        <span class="history-title">@item.WorkoutName</span>
                        <span class="history-date">
                            <span class="material-symbols-rounded" aria-hidden="true">calendar_today</span>
                            @item.Date.ToLocalTime().ToString("dd MMMM yyyy, HH:mm", RussianCulture)
                        </span>
                    </span>
                    <span class="history-card-aside">
                        @if (item.SnapshotAvailable)
                        {
                            <span class="card-meta">@item.Exercises.Count @GetExerciseCountLabel(item.Exercises.Count)</span>
                        }
                        else
                        {
                            <span class="legacy-label">Архивная</span>
                        }
                        <span class="material-symbols-rounded card-chevron" aria-hidden="true">chevron_right</span>
                    </span>
                </button>
            }
        </div>
    }
</section>

@if (_selected is not null)
{
    <div class="modal-overlay" @onclick="CloseHistory">
        <section class="modal-window history-dialog" role="dialog" aria-modal="true" aria-labelledby="history-title" @onclick:stopPropagation="true">
            <header class="dialog-header">
                <div>
                    <h2 id="history-title">@_selected.WorkoutName</h2>
                    <p>
                        <span class="material-symbols-rounded" aria-hidden="true">calendar_today</span>
                        @_selected.Date.ToLocalTime().ToString("dd MMMM yyyy, HH:mm", RussianCulture)
                    </p>
                </div>
                <button class="close-button" type="button" disabled="@_isBusy" @onclick="CloseHistory" aria-label="Закрыть историю">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </header>

            @if (_dialogErrors.Count > 0)
            {
                <div class="dialog-error" role="alert">@string.Join(" ", _dialogErrors)</div>
            }

            @if (!_selected.SnapshotAvailable)
            {
                <div class="snapshot-unavailable" role="status">
                    <span class="material-symbols-rounded" aria-hidden="true">inventory_2</span>
                    <h3>Детали архивной записи недоступны</h3>
                    <p>Исходные данные сохранены на сервере без изменений и не будут перезаписаны.</p>
                </div>
            }
            else
            {
                <div class="history-exercises">
                    @foreach (var group in SelectedExerciseGroups)
                    {
                        @if (group.IsSuperset)
                        {
                            var supersetStatus = GetSupersetStatus(group);
                            <article class="history-exercise history-superset" aria-label="Суперсет @string.Join(" и ", group.Exercises.Select(x => x.Name))">
                                <header class="history-superset-heading">
                                    <span class="material-symbols-rounded" aria-hidden="true">link</span>
                                    <div class="history-superset-title">
                                        <span class="history-superset-kicker">Суперсет</span>
                                        <div class="history-superset-names" aria-label="@string.Join(" / ", group.Exercises.Select(x => x.Name))">
                                            @for (var exerciseIndex = 0; exerciseIndex < group.Exercises.Count; exerciseIndex++)
                                            {
                                                var exercise = group.Exercises[exerciseIndex];
                                                if (exerciseIndex > 0)
                                                {
                                                    <span class="history-superset-name-separator" aria-hidden="true">/</span>
                                                }
                                                <span class="history-superset-name @(exerciseIndex == 0 ? "superset-tone-a" : "superset-tone-b")">@exercise.Name</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="status-badge status-@supersetStatus.ToLowerInvariant()">@GetStatusText(supersetStatus)</span>
                                </header>

                                <div class="history-sets history-superset-rounds">
                                    @foreach (var roundNumber in GetSupersetRoundNumbers(group))
                                    {
                                        <section class="history-superset-round" aria-label="Круг @roundNumber">
                                            @for (var exerciseIndex = 0; exerciseIndex < group.Exercises.Count; exerciseIndex++)
                                            {
                                                var exercise = group.Exercises[exerciseIndex];
                                                var set = exercise.Sets.FirstOrDefault(candidate => candidate.SetNumber == roundNumber);
                                                if (set is null)
                                                    continue;

                                                <div class="history-set history-superset-set @(exerciseIndex == 0 ? "superset-tone-a" : "superset-tone-b")">
                                                    <span class="completion-mark @(set.Completed ? "done" : null)" aria-label="@(set.Completed ? "Выполнен" : "Не выполнен")">
                                                        <span class="material-symbols-rounded" aria-hidden="true">@(set.Completed ? "check" : "remove")</span>
                                                    </span>
                                                    <span class="history-set-label">
                                                        <span class="history-superset-exercise-name">@exercise.Name · подход @set.SetNumber</span>
                                                        <span class="set-kind @(set.IsWarmup ? "warmup" : "working")">
                                                            @(set.IsWarmup ? "Разминочный" : "Рабочий")
                                                        </span>
                                                    </span>
                                                    <strong>
                                                        <span>@set.Weight.ToString("0.##", RussianCulture) кг</span>
                                                        <span aria-hidden="true">×</span>
                                                        <span>@set.Repetitions</span>
                                                    </strong>
                                                </div>
                                            }
                                        </section>
                                    }
                                </div>
                            </article>
                        }
                        else
                        {
                            var exercise = group.Exercises[0];
                            <article class="history-exercise">
                                <div class="exercise-heading">
                                    <div>
                                        <span class="exercise-index">Упражнение</span>
                                        <h3>@exercise.Name</h3>
                                    </div>
                                    <span class="status-badge status-@exercise.Status.ToLowerInvariant()">@GetStatusText(exercise.Status)</span>
                                </div>
                                <div class="history-sets">
                                    @foreach (var set in exercise.Sets.OrderBy(x => x.SetNumber))
                                    {
                                        <div class="history-set">
                                            <span class="completion-mark @(set.Completed ? "done" : null)" aria-label="@(set.Completed ? "Выполнен" : "Не выполнен")">
                                                <span class="material-symbols-rounded" aria-hidden="true">@(set.Completed ? "check" : "remove")</span>
                                            </span>
                                            <span class="history-set-label">
                                                <span>Подход @set.SetNumber</span>
                                                <span class="set-kind @(set.IsWarmup ? "warmup" : "working")">
                                                    @(set.IsWarmup ? "Разминочный" : "Рабочий")
                                                </span>
                                            </span>
                                            <strong>
                                                <span>@set.Weight.ToString("0.##", RussianCulture) кг</span>
                                                <span aria-hidden="true">×</span>
                                                <span>@set.Repetitions</span>
                                            </strong>
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_selected.Summary))
            {
                <div class="history-summary">
                    <span class="material-symbols-rounded" aria-hidden="true">notes</span>
                    <p>@_selected.Summary</p>
                </div>
            }

            <div class="dialog-actions">
                @if (_confirmDelete)
                {
                    <p class="delete-warning">Удалить эту запись истории без возможности восстановления?</p>
                    <button class="danger-button" type="button" disabled="@_isBusy" @onclick="DeleteAsync">
                        @(_isBusy ? "Удаляем…" : "Удалить точно")
                    </button>
                    <button class="secondary-button" type="button" disabled="@_isBusy" @onclick="CancelDelete">Отмена</button>
                }
                else
                {
                    <button class="danger-button" type="button" @onclick="ConfirmDelete">Удалить запись</button>
                }
            </div>
        </section>
    </div>
}

@code {
    private static readonly CultureInfo RussianCulture =
        CultureInfo.GetCultureInfo("ru-RU");
    private readonly List<WorkoutHistoryApiResponse> _history = [];
    private readonly List<string> _errors = [];
    private readonly List<string> _dialogErrors = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private WorkoutHistoryApiResponse? _selected;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _confirmDelete;
    private IReadOnlyList<HistoryExerciseGroup> SelectedExerciseGroups =>
        (_selected?.Exercises ?? [])
            .Select((exercise, index) => new { Exercise = exercise, Index = index })
            .GroupBy(item => item.Exercise.SupersetGroupId is { } groupId
                ? $"superset:{groupId}"
                : $"exercise:{item.Index}")
            .Select(group => new HistoryExerciseGroup(
                group.Key.StartsWith("superset:", StringComparison.Ordinal) && group.Count() > 1,
                group.Select(item => item.Exercise).ToList()))
            .ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errors.Clear();
        try
        {
            var result = await LifecycleClient.GetHistoryAsync(_disposeCts.Token);
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                return;
            }

            _history.Clear();
            _history.AddRange(result.Value!
                .OrderByDescending(x => x.Date));
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenHistory(WorkoutHistoryApiResponse item)
    {
        _selected = item;
        _confirmDelete = false;
        _dialogErrors.Clear();
    }

    private void CloseHistory()
    {
        if (_isBusy)
            return;

        _selected = null;
        _confirmDelete = false;
        _dialogErrors.Clear();
    }

    private void ConfirmDelete() => _confirmDelete = true;
    private void CancelDelete() => _confirmDelete = false;

    private async Task DeleteAsync()
    {
        if (_isBusy || _selected is null)
            return;

        _isBusy = true;
        _dialogErrors.Clear();
        var id = _selected.Id;
        try
        {
            var result = await LifecycleClient.DeleteHistoryAsync(
                id,
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _dialogErrors.AddRange(result.Errors);
                return;
            }

            _history.RemoveAll(x => x.Id == id);
            _selected = null;
            _confirmDelete = false;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string GetStatusText(string status) => status switch
    {
        "Easy" => "Легко",
        "Medium" => "Средне",
        "Hard" => "Тяжело",
        "Max" => "Предел",
        _ => "Не оценено"
    };

    private static IReadOnlyList<int> GetSupersetRoundNumbers(HistoryExerciseGroup group) =>
        group.Exercises
            .SelectMany(exercise => exercise.Sets)
            .Select(set => set.SetNumber)
            .Distinct()
            .OrderBy(setNumber => setNumber)
            .ToList();

    private static string GetSupersetStatus(HistoryExerciseGroup group)
    {
        var status = group.Exercises[0].Status;
        return group.Exercises.All(exercise => exercise.Status == status) ? status : "NotCompleted";
    }

    private static string GetExerciseCountLabel(int count)
    {
        var remainder100 = count % 100;
        if (remainder100 is >= 11 and <= 14)
            return "упражнений";

        return (count % 10) switch
        {
            1 => "упражнение",
            >= 2 and <= 4 => "упражнения",
            _ => "упражнений"
        };
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private sealed record HistoryExerciseGroup(
        bool IsSuperset,
        IReadOnlyList<WorkoutHistoryExerciseApiResponse> Exercises);
}
