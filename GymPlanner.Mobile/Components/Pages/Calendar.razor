@page "/calendar"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using WorkoutPlanner.Api.Contracts
@inject IWorkoutApiClient WorkoutClient
@inject IWorkoutLifecycleApiClient LifecycleClient
@inject ILocalWorkoutReminderService ReminderService

<section class="calendar-page" aria-busy="@_isLoading">
    <header class="calendar-header">
        <h1>Календарь</h1>
        <div class="header-line" aria-hidden="true"></div>
    </header>

    @if (_errors.Count > 0)
    {
        <div class="calendar-error" role="alert">
            <span class="material-symbols-rounded" aria-hidden="true">error</span>
            <div>
                <strong>Не удалось загрузить календарь</strong>
                <p>@string.Join(" ", _errors)</p>
            </div>
        </div>
    }

    <div class="month-header">
        <button class="month-button" type="button" disabled="@_isLoading" @onclick="PreviousMonthAsync" aria-label="Предыдущий месяц">
            <span class="material-symbols-rounded" aria-hidden="true">chevron_left</span>
        </button>
        <h2 class="month-title">@MonthTitle</h2>
        <button class="month-button" type="button" disabled="@_isLoading" @onclick="NextMonthAsync" aria-label="Следующий месяц">
            <span class="material-symbols-rounded" aria-hidden="true">chevron_right</span>
        </button>
    </div>

    @if (_isLoading)
    {
        <div class="calendar-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Загружаем календарь…</span>
        </div>
    }
    else
    {
        <div class="weekdays" aria-hidden="true">
            @foreach (var dayName in WeekdayNames)
            {
                <span>@dayName</span>
            }
        </div>
        <div class="calendar-grid" aria-label="@MonthTitle">
            @foreach (var date in CalendarCells)
            {
                if (date is null)
                {
                    <span class="calendar-empty" aria-hidden="true"></span>
                }
                else
                {
                    var workoutDay = FindDay(date.Value);
                    var plan = workoutDay is null
                        ? null
                        : _plans.FirstOrDefault(x => x.Id == workoutDay.TrainingPlanId);
                    <button type="button"
                            class="calendar-day @(workoutDay is not null ? "has-workout" : null) @(date.Value.Date == DateTime.Today ? "today-day" : null) @(_selectedDate?.Date == date.Value.Date ? "selected-day" : null) @(workoutDay?.IsCompleted == true ? "completed-day" : null)"
                            @onclick="() => OpenDayAsync(date.Value)"
                            aria-label="@GetDayLabel(date.Value, plan, workoutDay)">
                        <span class="day-number">@date.Value.Day</span>
                        @if (plan is not null)
                        {
                            <span class="calendar-marker @GetWorkoutMarkerClass(plan)">
                                @if (workoutDay?.IsCompleted == true)
                                {
                                    <span class="marker-completed" aria-hidden="true">✓</span>
                                }
                                <span class="calendar-marker-full">@plan.WorkoutName</span>
                                <span class="calendar-marker-short">@GetShortName(plan.WorkoutName)</span>
                            </span>
                        }
                    </button>
                }
            }
        </div>
    }
</section>

@if (_selectedDate is not null)
{
    var selectedDay = FindDay(_selectedDate.Value);

    @if (selectedDay is not null)
    {
        <div class="modal-overlay action-overlay" @onclick="CloseDay">
            <section class="modal-window workout-action-dialog"
                     role="dialog"
                     aria-modal="true"
                     aria-label="Действия с тренировкой"
                     @onclick:stopPropagation="true">
                @if (_dialogErrors.Count > 0)
                {
                    <div class="dialog-error" role="alert">@string.Join(" ", _dialogErrors)</div>
                }

                <div class="workout-action-list">
                    <button class="danger-button" type="button" disabled="@_isBusy" @onclick="DeleteAsync">
                        Удалить
                    </button>
                    <label class="move-date-action @(_isBusy ? "is-disabled" : null)">
                        <span>Перенести на другую дату</span>
                        <input type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               disabled="@_isBusy"
                               aria-label="Выбрать новую дату тренировки"
                               @bind="_moveDate"
                               @bind:after="MoveAsync" />
                    </label>
                </div>
            </section>
        </div>
    }
    else
    {
        <div class="modal-overlay" @onclick="CloseDay">
            <section class="modal-window calendar-day-dialog" role="dialog" aria-modal="true" aria-labelledby="selected-day-title" @onclick:stopPropagation="true">
            <header class="calendar-modal-header">
                <div>
                    <span class="modal-eyebrow">Выбранный день</span>
                    <h2 id="selected-day-title">
                        <span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>
                        @_selectedDate.Value.ToString("dd MMMM yyyy", RussianCulture)
                    </h2>
                </div>
                <button class="icon-close-button" type="button" disabled="@_isBusy" @onclick="CloseDay" aria-label="Закрыть">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </header>

            @if (_dialogErrors.Count > 0)
            {
                <div class="dialog-error" role="alert">@string.Join(" ", _dialogErrors)</div>
            }

            @if (_selectedDate.Value.Date >= DateTime.Today)
            {
                <section class="workout-picker" aria-labelledby="workout-picker-title">
                    <h3 id="workout-picker-title">Назначить тренировку</h3>
                    @if (_plans.Count == 0)
                    {
                        <p class="empty-hint">Сначала создайте тренировочный план.</p>
                    }
                    else
                    {
                        <div class="workout-picker-grid">
                            @foreach (var plan in _plans)
                            {
                                <button class="workout-picker-card @(_selectedPlanId == plan.Id ? "selected-plan" : null)"
                                        type="button"
                                        disabled="@_isBusy"
                                        aria-pressed="@(_selectedPlanId == plan.Id)"
                                        @onclick="() => _selectedPlanId = plan.Id">
                                    <span class="workout-picker-name">@plan.WorkoutName</span>
                                    @if (_selectedPlanId == plan.Id)
                                    {
                                        <span class="material-symbols-rounded plan-check" aria-hidden="true">check_circle</span>
                                    }
                                </button>
                            }
                        </div>
                    }
                </section>
            }
            else
            {
                <div class="past-day-hint">
                    <span class="material-symbols-rounded" aria-hidden="true">history</span>
                    <p>Этот день уже прошёл. Назначить тренировку невозможно.</p>
                </div>
            }

            <div class="dialog-actions">
                @if (_selectedDate.Value.Date >= DateTime.Today)
                {
                    <button class="primary-button" type="button" disabled="@(_isBusy || _selectedPlanId == 0)" @onclick="ScheduleAsync">
                        @(_isBusy ? "Сохраняем…" : "Назначить")
                    </button>
                }
                <button class="secondary-button" type="button" disabled="@_isBusy" @onclick="CloseDay">Закрыть</button>
            </div>
            </section>
        </div>
    }
}

@code {
    private static readonly CultureInfo RussianCulture = CultureInfo.GetCultureInfo("ru-RU");
    private static readonly string[] WeekdayNames = ["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"];
    private readonly List<TrainingPlanApiResponse> _plans = [];
    private readonly List<WorkoutDayApiResponse> _workoutDays = [];
    private readonly List<string> _errors = [];
    private readonly List<string> _dialogErrors = [];
    private readonly List<string> _reminderErrors = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private DateTime _currentMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _selectedDate;
    private DateTime _moveDate = DateTime.Today.AddDays(1);
    private int _selectedPlanId;
    private string _reminderTime = "09:00";
    private LocalWorkoutReminder? _scheduledReminder;
    private bool _isLoading = true;
    private bool _isBusy;

    private string MonthTitle => _currentMonth.ToString("MMMM yyyy", RussianCulture);

    private IEnumerable<DateTime?> CalendarCells
    {
        get
        {
            var mondayOffset = ((int)_currentMonth.DayOfWeek + 6) % 7;
            for (var index = 0; index < mondayOffset; index++)
                yield return null;
            for (var day = 1; day <= DateTime.DaysInMonth(_currentMonth.Year, _currentMonth.Month); day++)
                yield return new DateTime(_currentMonth.Year, _currentMonth.Month, day);
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync(loadPlans: true);

    private async Task LoadAsync(bool loadPlans)
    {
        _isLoading = true;
        _errors.Clear();
        var monthEnd = _currentMonth.AddMonths(1).AddDays(-1);
        var calendarTask = LifecycleClient.GetCalendarAsync(
            _currentMonth,
            monthEnd,
            _disposeCts.Token);
        var plansTask = loadPlans
            ? WorkoutClient.GetPlansAsync(_disposeCts.Token)
            : null;

        try
        {
            if (plansTask is not null)
                await Task.WhenAll(calendarTask, plansTask);
            else
                await calendarTask;

            var calendarResult = await calendarTask;
            if (!calendarResult.Succeeded)
                _errors.AddRange(calendarResult.Errors);
            else
            {
                _workoutDays.Clear();
                _workoutDays.AddRange(calendarResult.Value!);
            }

            if (plansTask is not null)
            {
                var plansResult = await plansTask;
                if (!plansResult.Succeeded)
                    _errors.AddRange(plansResult.Errors);
                else
                {
                    _plans.Clear();
                    _plans.AddRange(plansResult.Value!);
                }
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PreviousMonthAsync()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        await LoadAsync(loadPlans: false);
    }

    private async Task NextMonthAsync()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        await LoadAsync(loadPlans: false);
    }

    private Task OpenDayAsync(DateTime date)
    {
        _selectedDate = date;
        _dialogErrors.Clear();
        _reminderErrors.Clear();
        _selectedPlanId = FindDay(date)?.TrainingPlanId ?? 0;
        _moveDate = date.Date < DateTime.Today ? DateTime.Today : date.Date.AddDays(1);
        var day = FindDay(date);
        _scheduledReminder = day is null
            ? null
            : ReminderService.GetScheduled(day.Id);
        if (_scheduledReminder is not null)
            _reminderTime = _scheduledReminder.NotifyAt.ToLocalTime().ToString("HH:mm");
        else
            _reminderTime = "09:00";
        return Task.CompletedTask;
    }

    private void CloseDay()
    {
        if (_isBusy)
            return;
        CloseDayAfterSuccess();
    }

    private void ChangeReminderTime(ChangeEventArgs args)
    {
        if (args.Value is not null)
            _reminderTime = args.Value.ToString() ?? _reminderTime;
    }

    private async Task ScheduleAsync()
    {
        if (_isBusy || _selectedDate is null || _selectedPlanId == 0)
            return;

        _isBusy = true;
        _dialogErrors.Clear();
        try
        {
            var result = await LifecycleClient.ScheduleWorkoutAsync(
                new ScheduleWorkoutRequest(_selectedDate.Value.Date, _selectedPlanId),
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _dialogErrors.AddRange(result.Errors);
                return;
            }

            ReplaceDay(result.Value!);
            if (_scheduledReminder is not null)
            {
                var plan = _plans.First(x => x.Id == _selectedPlanId);
                var updatedReminder = new LocalWorkoutReminder(
                    result.Value!.Id,
                    plan.Id,
                    plan.WorkoutName,
                    _scheduledReminder.NotifyAt);
                var reminderResult = await ReminderService.ScheduleAsync(
                    updatedReminder,
                    _disposeCts.Token);
                if (!reminderResult.Succeeded)
                {
                    _reminderErrors.AddRange(reminderResult.Errors);
                    return;
                }

                _scheduledReminder = updatedReminder;
            }
            CloseDayAfterSuccess();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteAsync()
    {
        var day = _selectedDate is null ? null : FindDay(_selectedDate.Value);
        if (_isBusy || day is null)
            return;

        _isBusy = true;
        _dialogErrors.Clear();
        try
        {
            var result = await LifecycleClient.DeleteCalendarDayAsync(
                day.Id,
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _dialogErrors.AddRange(result.Errors);
                return;
            }

            _workoutDays.RemoveAll(x => x.Id == day.Id);
            var reminderResult = await ReminderService.CancelAsync(
                day.Id,
                _disposeCts.Token);
            if (!reminderResult.Succeeded)
            {
                _dialogErrors.AddRange(reminderResult.Errors);
                return;
            }

            CloseDayAfterSuccess();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task MoveAsync()
    {
        var day = _selectedDate is null ? null : FindDay(_selectedDate.Value);
        if (_isBusy || day is null)
            return;

        if (_moveDate.Date < DateTime.Today || _moveDate.Date == day.Date.Date)
        {
            _dialogErrors.Clear();
            _dialogErrors.Add("Выберите другую текущую или будущую дату.");
            return;
        }

        _isBusy = true;
        _dialogErrors.Clear();
        try
        {
            var result = await LifecycleClient.MoveCalendarDayAsync(
                day.Id,
                new MoveWorkoutRequest(_moveDate.Date),
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _dialogErrors.AddRange(result.Errors);
                return;
            }

            _workoutDays.RemoveAll(x => x.Id == day.Id);
            if (_moveDate.Year == _currentMonth.Year && _moveDate.Month == _currentMonth.Month)
                _workoutDays.Add(result.Value!);

            if (_scheduledReminder is not null)
            {
                await ReminderService.CancelAsync(day.Id, _disposeCts.Token);
                _scheduledReminder = null;
            }

            CloseDayAfterSuccess();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private WorkoutDayApiResponse? FindDay(DateTime date) =>
        _workoutDays.FirstOrDefault(x => x.Date.Date == date.Date);

    private void ReplaceDay(WorkoutDayApiResponse day)
    {
        var existing = _workoutDays.FindIndex(x =>
            x.Id == day.Id || x.Date.Date == day.Date.Date);
        if (existing < 0)
            _workoutDays.Add(day);
        else
            _workoutDays[existing] = day;
    }

    private void CloseDayAfterSuccess()
    {
        _selectedDate = null;
        _selectedPlanId = 0;
        _dialogErrors.Clear();
        _reminderErrors.Clear();
        _scheduledReminder = null;
    }

    private async Task ScheduleReminderAsync()
    {
        var day = _selectedDate is null ? null : FindDay(_selectedDate.Value);
        var plan = day is null
            ? null
            : _plans.FirstOrDefault(x => x.Id == day.TrainingPlanId);
        if (_isBusy || day is null || plan is null)
            return;

        _reminderErrors.Clear();
        if (!TimeOnly.TryParseExact(
                _reminderTime,
                "HH:mm",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var time))
        {
            _reminderErrors.Add("Укажите корректное время напоминания.");
            return;
        }

        var localDateTime = DateTime.SpecifyKind(
            day.Date.Date.Add(time.ToTimeSpan()),
            DateTimeKind.Unspecified);
        if (TimeZoneInfo.Local.IsInvalidTime(localDateTime))
        {
            _reminderErrors.Add("Это время пропускается при переходе на летнее время.");
            return;
        }

        var notifyAt = new DateTimeOffset(
            localDateTime,
            TimeZoneInfo.Local.GetUtcOffset(localDateTime));
        if (notifyAt <= DateTimeOffset.Now)
        {
            _reminderErrors.Add("Время напоминания должно быть в будущем.");
            return;
        }

        _isBusy = true;
        try
        {
            var permission = await ReminderService.RequestPermissionAsync(
                _disposeCts.Token);
            if (!permission.Succeeded)
            {
                _reminderErrors.AddRange(permission.Errors);
                return;
            }

            var reminder = new LocalWorkoutReminder(
                day.Id,
                plan.Id,
                plan.WorkoutName,
                notifyAt);
            var result = await ReminderService.ScheduleAsync(
                reminder,
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _reminderErrors.AddRange(result.Errors);
                return;
            }

            _scheduledReminder = reminder;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CancelReminderAsync()
    {
        var day = _selectedDate is null ? null : FindDay(_selectedDate.Value);
        if (_isBusy || day is null)
            return;

        _isBusy = true;
        _reminderErrors.Clear();
        try
        {
            var result = await ReminderService.CancelAsync(
                day.Id,
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _reminderErrors.AddRange(result.Errors);
                return;
            }

            _scheduledReminder = null;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string GetShortName(string name)
    {
        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0)
            return string.Empty;
        if (words.Length == 1)
            return words[0].Length <= 3 ? words[0] : words[0][..3];
        return string.Concat(words.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }

    private static string GetWorkoutMarkerClass(TrainingPlanApiResponse plan) =>
        $"marker-custom-{Math.Abs(plan.Id) % 6}";

    private static string GetDayLabel(
        DateTime date,
        TrainingPlanApiResponse? plan,
        WorkoutDayApiResponse? day)
    {
        var label = date.ToString("dd MMMM yyyy", RussianCulture);
        if (plan is not null)
            label += $", {plan.WorkoutName}";
        if (day?.IsCompleted == true)
            label += ", завершена";
        return label;
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }
}
