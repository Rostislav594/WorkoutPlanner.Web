@page "/notebook"
@attribute [Authorize]
@implements IDisposable
@using GymPlanner.Mobile.Notes
@inject IAppText Text

<section class="notebook-page" aria-labelledby="notebook-title">
    <header class="notebook-header">
        <a class="back-button" href="/" aria-label="@Text["Notebook_Back"]">
            <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
        </a>
        <div>
            <h1 id="notebook-title">@Text["Home_Notebook"]</h1>
            <p>@Text["Notebook_Subtitle"]</p>
        </div>
    </header>

    <div class="tabs" role="tablist" aria-label="@Text["Notebook_Tabs"]">
        @foreach (var tab in _tabs)
        {
            <button class="tab-button @(tab.Id == _activeId ? "active" : null)"
                    type="button"
                    role="tab"
                    aria-selected="@(tab.Id == _activeId)"
                    aria-label="@Text.Format("Notebook_TabHint", tab.Name)"
                    @onpointerdown="() => BeginRenameHold(tab.Id)"
                    @onpointerup="CancelRenameHold"
                    @onpointercancel="CancelRenameHold"
                    @onpointerleave="CancelRenameHold"
                    @oncontextmenu="() => OpenRenameTab(tab.Id)"
                    @oncontextmenu:preventDefault="true"
                    @onclick="() => SelectTab(tab.Id)">
                @if (tab.Id == _homeNoteId)
                {
                    <span class="material-symbols-rounded tab-home-mark" aria-hidden="true">push_pin</span>
                }
                @tab.Name
            </button>
        }
        <button class="add-tab-button" type="button" @onclick="OpenNewTab" aria-label="@Text["Notebook_AddTab"]">
            <span class="material-symbols-rounded" aria-hidden="true">add</span>
        </button>
    </div>

    @if (ActiveTab is { } activeTab)
    {
        <label class="note-editor">
            <span class="visually-hidden">@Text.Format("Notebook_NoteText", activeTab.Name)</span>
            <textarea @bind="activeTab.Content" @bind:event="oninput" placeholder="@Text["Notebook_Placeholder"]"></textarea>
        </label>
        <div class="notebook-actions">
            <button class="primary-button" type="button" @onclick="Save">@Text["Common_Save"]</button>
            <button class="danger-button" type="button" disabled="@(_tabs.Count == 1)" @onclick="DeleteActive">@Text["Notebook_DeleteTab"]</button>
        </div>
    }
</section>

@if (_showNewTab)
{
    <div class="modal-overlay" @onclick="CloseNewTab">
        <section class="modal-window" role="dialog" aria-modal="true" aria-labelledby="new-tab-title" @onclick:stopPropagation="true">
            <h2 id="new-tab-title">@Text["Notebook_NewTab"]</h2>
            <label>
                @Text["Common_Name"]
                <input class="form-control" maxlength="40" @bind="_newTabName" />
            </label>
            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="notebook-error" role="alert">@_error</p>
            }
            <div class="notebook-actions">
                <button class="primary-button" type="button" @onclick="CreateTab">@Text["Common_Create"]</button>
                <button class="secondary-button" type="button" @onclick="CloseNewTab">@Text["Common_Cancel"]</button>
            </div>
        </section>
    </div>
}

@if (_renameTabId is not null)
{
    <div class="modal-overlay" @onclick="CloseRenameTab">
        <section class="modal-window" role="dialog" aria-modal="true" aria-labelledby="rename-tab-title" @onclick:stopPropagation="true">
            <div class="notebook-modal-heading">
                <div>
                    <span>@Text["Notebook_TabSettings"]</span>
                    <h2 id="rename-tab-title">@Text["Notebook_RenameTab"]</h2>
                </div>
                <button class="notebook-modal-close" type="button" aria-label="@Text["Common_Close"]" @onclick="CloseRenameTab">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>
            <label>
                @Text["Notebook_NewName"]
                <input class="form-control" maxlength="40" autofocus @bind="_renameTabName" />
            </label>
            @if (!string.IsNullOrEmpty(_renameError))
            {
                <p class="notebook-error" role="alert">@_renameError</p>
            }
            @{ var isOnHome = _renameTabId == _homeNoteId; }
            <button class="home-note-button @(isOnHome ? "is-on-home" : null)"
                    type="button"
                    aria-pressed="@(isOnHome ? "true" : "false")"
                    @onclick="() => ShowOnHome(_renameTabId.Value)">
                <span class="material-symbols-rounded" aria-hidden="true">@(isOnHome ? "check_circle" : "push_pin")</span>
                @(isOnHome ? Text["Notebook_OnHome"] : Text["Notebook_ShowOnHome"])
            </button>
            <div class="notebook-actions">
                <button class="primary-button" type="button" @onclick="RenameTab">@Text["Common_Save"]</button>
            </div>
        </section>
    </div>
}

@code {
    private readonly List<NotebookNote> _tabs = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private Guid _activeId;
    private Guid? _homeNoteId;
    private bool _showNewTab;
    private Guid? _renameTabId;
    private string _newTabName = string.Empty;
    private string _renameTabName = string.Empty;
    private string? _error;
    private string? _renameError;
    private CancellationTokenSource? _renameHoldCts;

    private NotebookNote? ActiveTab => _tabs.FirstOrDefault(x => x.Id == _activeId);

    protected override void OnInitialized()
    {
        _tabs.AddRange(NotebookStorage.Load());
        if (_tabs.Count == 0)
            _tabs.Add(new NotebookNote(Guid.NewGuid(), Text["Notebook_DefaultTabName"], string.Empty));
        _activeId = _tabs[0].Id;
        RefreshHomeNote();
    }

    // Заметку для главной выбирают в настройках вкладки (долгое нажатие на название).
    private void ShowOnHome(Guid id)
    {
        NotebookStorage.SetHomeNote(id);
        Save();
    }

    private void RefreshHomeNote() => _homeNoteId = NotebookStorage.FindHomeNote(_tabs)?.Id;

    private void SelectTab(Guid id) { Save(); _activeId = id; }
    private void OpenNewTab() { _newTabName = string.Empty; _error = null; _showNewTab = true; }
    private void CloseNewTab() { _showNewTab = false; _error = null; }

    private async Task BeginRenameHold(Guid id)
    {
        CancelRenameHold();
        _renameHoldCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        try
        {
            await Task.Delay(550, _renameHoldCts.Token);
            OpenRenameTab(id);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelRenameHold()
    {
        _renameHoldCts?.Cancel();
        _renameHoldCts?.Dispose();
        _renameHoldCts = null;
    }

    private void OpenRenameTab(Guid id)
    {
        CancelRenameHold();
        var tab = _tabs.FirstOrDefault(x => x.Id == id);
        if (tab is null) return;
        _renameTabId = id;
        _renameTabName = tab.Name;
        _renameError = null;
    }

    private void CloseRenameTab()
    {
        CancelRenameHold();
        _renameTabId = null;
        _renameTabName = string.Empty;
        _renameError = null;
    }

    private void RenameTab()
    {
        if (_renameTabId is not { } id) return;
        var name = _renameTabName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { _renameError = Text["Notebook_NameRequired"]; return; }
        if (_tabs.Any(x => x.Id != id && string.Equals(x.Name, name, StringComparison.CurrentCultureIgnoreCase))) { _renameError = Text["Notebook_NameTaken"]; return; }
        var index = _tabs.FindIndex(x => x.Id == id);
        if (index < 0) { CloseRenameTab(); return; }
        var tab = _tabs[index];
        _tabs[index] = new NotebookNote(tab.Id, name, tab.Content);
        Save();
        CloseRenameTab();
    }

    private void CreateTab()
    {
        var name = _newTabName.Trim();
        if (string.IsNullOrWhiteSpace(name)) { _error = Text["Notebook_NameRequired"]; return; }
        if (_tabs.Any(x => string.Equals(x.Name, name, StringComparison.CurrentCultureIgnoreCase))) { _error = Text["Notebook_NameTaken"]; return; }
        var tab = new NotebookNote(Guid.NewGuid(), name, string.Empty);
        _tabs.Add(tab); _activeId = tab.Id; Save(); CloseNewTab();
    }

    private void DeleteActive()
    {
        if (_tabs.Count == 1 || ActiveTab is null) return;
        _tabs.Remove(ActiveTab); _activeId = _tabs[0].Id; Save();
    }

    // Удалённая заметка с главной уступает место первой вкладке, поэтому
    // отметку пересчитываем при каждом сохранении.
    private void Save()
    {
        NotebookStorage.Save(_tabs);
        RefreshHomeNote();
    }

    public void Dispose()
    {
        CancelRenameHold();
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }
}
