@page "/account/register"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject MobileAuthenticationService Authentication
@inject NavigationManager Navigation
@inject IAppText Text

@if (_showCreatorIntro)
{
    <CreatorIntro IsBusy="@_isBusy" OnCompleted="ShowFinalWelcomeAsync" />
}
else
{
<section class="auth-card auth-card--register" aria-labelledby="register-title">
    <h1 id="register-title" class="auth-title">@Text["Register_Title"]</h1>

    @if (_errors.Count > 0)
    {
        <div class="auth-error" role="alert">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </div>
    }

    <EditForm class="auth-form" Model="_input" OnValidSubmit="RegisterAsync">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label for="register-email">Email</label>
            <div class="auth-input-shell">
                <span class="auth-field-icon material-symbols-rounded" aria-hidden="true">mail</span>
                <InputText id="register-email"
                           class="auth-input"
                           @bind-Value="_input.Email"
                           autocomplete="username"
                           inputmode="email"
                           placeholder="@Text["Auth_EmailPlaceholder"]" />
            </div>
            <LocalizedValidationMessage For="@(() => _input.Email)" />
        </div>

        <div class="auth-field">
            <label for="register-password">@Text["Common_Password"]</label>
            <div class="auth-input-shell auth-input-shell--password">
                <span class="auth-field-icon material-symbols-rounded" aria-hidden="true">lock</span>
                <InputText id="register-password"
                           class="auth-input"
                           type="@(_showPassword ? "text" : "password")"
                           @bind-Value="_input.Password"
                           autocomplete="new-password"
                           placeholder="@Text["Auth_PasswordPlaceholder"]" />
                <button class="auth-visibility-toggle"
                        type="button"
                        aria-label="@Text[_showPassword ? "Common_HidePassword" : "Common_ShowPassword"]"
                        aria-pressed="@(_showPassword ? "true" : "false")"
                        @onclick="TogglePasswordVisibility">
                    <span class="material-symbols-rounded" aria-hidden="true">@(_showPassword ? "visibility_off" : "visibility")</span>
                </button>
            </div>
            <LocalizedValidationMessage For="@(() => _input.Password)" />
        </div>

        <div class="auth-field">
            <label for="register-confirm-password">@Text["Register_ConfirmPassword"]</label>
            <div class="auth-input-shell auth-input-shell--password">
                <span class="auth-field-icon material-symbols-rounded" aria-hidden="true">lock_reset</span>
                <InputText id="register-confirm-password"
                           class="auth-input"
                           type="@(_showConfirmPassword ? "text" : "password")"
                           @bind-Value="_input.ConfirmPassword"
                           autocomplete="new-password"
                           placeholder="@Text["Register_ConfirmPassword"]" />
                <button class="auth-visibility-toggle"
                        type="button"
                        aria-label="@Text[_showConfirmPassword ? "Common_HidePassword" : "Common_ShowPassword"]"
                        aria-pressed="@(_showConfirmPassword ? "true" : "false")"
                        @onclick="ToggleConfirmPasswordVisibility">
                    <span class="material-symbols-rounded" aria-hidden="true">@(_showConfirmPassword ? "visibility_off" : "visibility")</span>
                </button>
            </div>
            <LocalizedValidationMessage For="@(() => _input.ConfirmPassword)" />
        </div>

        <button class="auth-submit" type="submit" disabled="@_isBusy">
            @(_isBusy ? Text["Register_SubmitBusy"] : Text["Register_Submit"])
        </button>
    </EditForm>

    <p class="auth-footer">@Text["Register_HaveAccount"] <a href="/account/login">@Text["Register_SignIn"]</a></p>
</section>
}

@code {
    private readonly RegisterInput _input = new();
    private readonly List<string> _errors = [];
    private bool _isBusy;
    private bool _showCreatorIntro;
    private bool _showPassword;
    private bool _showConfirmPassword;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;
    private void ToggleConfirmPasswordVisibility() => _showConfirmPassword = !_showConfirmPassword;

    private async Task RegisterAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            var result = await Authentication.RegisterAsync(
                _input.Email,
                _input.Password,
                $"{DeviceInfo.Current.Platform} {DeviceInfo.Current.Model}");
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                return;
            }

            _showCreatorIntro = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task ShowFinalWelcomeAsync()
    {
        if (_isBusy)
            return Task.CompletedTask;

        _isBusy = true;
        Navigation.NavigateTo("/profile/setup", replace: true);
        return Task.CompletedTask;
    }

    private sealed class RegisterInput
    {
        // В атрибутах лежат ключи ресурсов: их печатает LocalizedValidationMessage.
        [Required(ErrorMessage = "Validation_EmailRequired")]
        [EmailAddress(ErrorMessage = "Validation_EmailInvalid")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Validation_PasswordRequired")]
        [MinLength(6, ErrorMessage = "Validation_PasswordTooShort")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Validation_PasswordsDoNotMatch")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
