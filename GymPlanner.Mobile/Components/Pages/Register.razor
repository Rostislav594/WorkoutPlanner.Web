@page "/account/register"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject MobileAuthenticationService Authentication
@inject NavigationManager Navigation

@if (_showCreatorIntro)
{
    <CreatorIntro IsBusy="@_isBusy" OnCompleted="ShowFinalWelcomeAsync" />
}
else
{
<section class="auth-card" aria-labelledby="register-title">
    <div class="auth-brand">
        <img src="_content/WorkoutPlanner.UI/images/Emblem.png" alt="GPlanner" />
    </div>
    <h1 id="register-title">Регистрация</h1>
    
    @if (_errors.Count > 0)
    {
        <div class="auth-error" role="alert">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </div>
    }

    <EditForm Model="_input" OnValidSubmit="RegisterAsync">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label for="register-email">Email</label>
            <InputText id="register-email" class="auth-input" @bind-Value="_input.Email" autocomplete="username" inputmode="email" />
            <ValidationMessage For="@(() => _input.Email)" />
        </div>

        <div class="auth-field">
            <label for="register-password">Пароль</label>
            <InputText id="register-password" class="auth-input" type="password" @bind-Value="_input.Password" autocomplete="new-password" />
            <ValidationMessage For="@(() => _input.Password)" />
        </div>

        <div class="auth-field">
            <label for="register-confirm-password">Повторите пароль</label>
            <InputText id="register-confirm-password" class="auth-input" type="password" @bind-Value="_input.ConfirmPassword" autocomplete="new-password" />
            <ValidationMessage For="@(() => _input.ConfirmPassword)" />
        </div>

        <button class="auth-submit" type="submit" disabled="@_isBusy">
            @(_isBusy ? "Создаём аккаунт…" : "Создать аккаунт")
        </button>
    </EditForm>

    <p class="auth-footer">Уже есть аккаунт? <a href="/account/login">Войти</a></p>
</section>
}

@code {
    private readonly RegisterInput _input = new();
    private readonly List<string> _errors = [];
    private bool _isBusy;
    private bool _showCreatorIntro;

    private async Task RegisterAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            var result = await Authentication.RegisterAsync(
                _input.Email,
                _input.Password,
                $"{DeviceInfo.Current.Platform} {DeviceInfo.Current.Model}");
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                return;
            }

            _showCreatorIntro = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task ShowFinalWelcomeAsync()
    {
        if (_isBusy)
            return Task.CompletedTask;

        _isBusy = true;
        Navigation.NavigateTo("/profile/setup", replace: true);
        return Task.CompletedTask;
    }

    private sealed class RegisterInput
    {
        [Required(ErrorMessage = "Введите email.")]
        [EmailAddress(ErrorMessage = "Введите корректный email.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Введите пароль.")]
        [MinLength(6, ErrorMessage = "Пароль должен содержать не менее 6 символов.")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Пароли не совпадают.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
