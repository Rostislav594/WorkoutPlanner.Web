@page "/progress"
@attribute [Authorize]
@inject IAppText Text

<section class="progress-menu-page" aria-labelledby="progress-page-title">
    <div class="page-title-row">
        <h1 id="progress-page-title" class="progress-title">@Text["Progress_Title"]</h1>
        <HelpButton Topic="HelpContentCatalog.Progress" />
    </div>

    <nav class="progress-menu" aria-label="@Text["Progress_Sections"]">
        <a class="progress-menu-card" href="/progress/exercises">
            <img class="progress-menu-card-art" src="/images/progress-exercises-reference.png" alt="" aria-hidden="true" />
            <img class="progress-menu-card-figures progress-menu-card-figures--exercise" src="/images/progress-exercises-figures.png" alt="" aria-hidden="true" />
            <span class="progress-menu-title">@Text["Progress_Exercises"]</span>
        </a>

        <a class="progress-menu-card" href="/progress/workouts">
            <img class="progress-menu-card-art progress-menu-card-art--bottom" src="/images/progress-exercises-reference.png" alt="" aria-hidden="true" />
            <img class="progress-menu-card-figures progress-menu-card-figures--workouts" src="/images/progress-workouts-figures.png" alt="" aria-hidden="true" />
            <span class="progress-menu-title">@Text["Progress_Workouts"]</span>
        </a>
    </nav>
</section>
