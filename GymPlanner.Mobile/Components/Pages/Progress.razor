@page "/progress"
@attribute [Authorize]

<section class="progress-menu-page" aria-labelledby="progress-page-title">
    <div class="page-title-row">
        <h1 id="progress-page-title" class="progress-title">Прогресс</h1>
        <HelpButton Topic="HelpContentCatalog.Progress" />
    </div>

    <nav class="progress-menu" aria-label="Разделы прогресса">
        <a class="progress-menu-card" href="/progress/exercises">
            <img src="_content/WorkoutPlanner.UI/images/progress-exercises.png"
                 class="progress-menu-image"
                 alt="" />
            <span class="progress-menu-title">Упражнения</span>
        </a>

        <a class="progress-menu-card" href="/progress/workouts">
            <img src="_content/WorkoutPlanner.UI/images/progress-workouts.png"
                 class="progress-menu-image"
                 alt="" />
            <span class="progress-menu-title">Тренировки</span>
        </a>
    </nav>
</section>
