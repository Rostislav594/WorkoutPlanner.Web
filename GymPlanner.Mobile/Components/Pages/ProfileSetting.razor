@page "/profile/{Section}"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Logging
@using GymPlanner.Mobile.ExternalLinks
@using GymPlanner.Mobile.Localization
@using GymPlanner.Mobile.Notifications
@using WorkoutPlanner.Api.Contracts
@using WorkoutPlanner.Localization
@inject IProfileApiClient ProfileClient
@inject IWatchManagementApiClient WatchClient
@inject ISupportApiClient SupportClient
@inject IMobilePhotoPicker PhotoPicker
@inject IExternalLinkOpener LinkOpener
@inject IAppLanguageService Language
@inject IAppText Text
@inject MobileAuthenticationService Authentication
@inject NavigationManager Navigation
@inject ILogger<ProfileSetting> Logger
@inject PushRegistrationCoordinator PushRegistration

<section class="profile-setting-page" aria-busy="@_isLoading">
    <header class="setting-header">
        <a class="back-button" href="/profile" aria-label="@Text["ProfileSetting_BackToProfile"]">
            <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
        </a>
        <div>
            <p class="setting-eyebrow">@Text["Profile_Title"]</p>
            <h1>@Text[Setting.TitleKey]</h1>
        </div>
    </header>

    @if (_isLoading)
    {
        <div class="setting-state" role="status"><span class="loading-spinner" aria-hidden="true"></span><span>@Text["Common_Loading"]</span></div>
    }
    else if (_errors.Count > 0)
    {
        <div class="auth-error" role="alert">@string.Join(" ", _errors)</div>
    }
    else if (!Setting.IsAvailable)
    {
        <article class="setting-card setting-card--placeholder">
            <span class="setting-icon material-symbols-rounded" aria-hidden="true">@Setting.Icon</span>
            <span class="setting-soon" role="status">@Text["Common_Soon"]</span>
            <h2>@Text[Setting.TitleKey]</h2>
            <p>@Text[Setting.DescriptionKey]</p>
            <a class="setting-secondary-action" href="/profile">@Text["ProfileSetting_BackToProfile"]</a>
        </article>
    }
    else if (Section == "personal-information")
    {
        <EditForm class="setting-card" Model="_profileInput" OnValidSubmit="SaveProfileAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />
            <p class="setting-description">@Text["ProfileSetting_PersonalDescription"]</p>
            <div class="setting-form-grid">
                <label>Email <input class="auth-input" value="@_profile?.Email" readonly /></label>
                <label>@Text["Common_FirstName"] <InputText class="auth-input" @bind-Value="_profileInput.FirstName" autocomplete="given-name" /></label>
                <label>@Text["Common_LastName"] <InputText class="auth-input" @bind-Value="_profileInput.LastName" autocomplete="family-name" /></label>
                <label>@Text["Common_BirthDate"] <InputDate class="auth-input" @bind-Value="_profileInput.BirthDate" /></label>
                <label>@Text["Common_Gender"] <SystemChoiceField class="auth-input" Title="@Text["Common_Gender"]" Options="GenderOptions" @bind-Value="_profileInput.Gender" AriaLabel="@Text["ProfileSetup_SelectGender"]" /></label>
            </div>
            <button class="setting-primary-action" type="submit" disabled="@_isBusy">@(_isBusy ? Text["Common_Saving"] : Text["Profile_SaveChanges"])</button>
        </EditForm>
    }
    else if (Section == "devices")
    {
        <div class="watch-settings-stack" aria-busy="@_isBusy">
            @if (!string.IsNullOrWhiteSpace(_watchMessage))
            {
                <div class="watch-success" role="status">@_watchMessage</div>
            }
            @if (_watchErrors.Count > 0)
            {
                <div class="watch-error" role="alert">
                    <span>@string.Join(" ", _watchErrors)</span>
                </div>
            }

            <article class="setting-card watch-pairing-card">
                <div class="watch-card-heading">
                    <span class="setting-icon material-symbols-rounded" aria-hidden="true">watch</span>
                    <div>
                        <p class="setting-eyebrow">Wear OS</p>
                        <h2>@Text["Watch_ConnectTitle"]</h2>
                    </div>
                </div>
                <p class="setting-description">
                    @Text["Watch_ConnectHint"]
                </p>

                @if (_pairingCode is not null)
                {
                    <div class="watch-pairing-result" role="status">
                        <span>@Text["Watch_PairingCode"]</span>
                        <output aria-label="@Text.Format("Watch_PairingCodeSpeech", FormatCodeForSpeech(_pairingCode.Code))">
                            @_pairingCode.Code
                        </output>
                        <small>
                            @Text.Format("Watch_CodeValidUntil", _pairingCode.ExpiresAtUtc.ToLocalTime().ToString("HH:mm"))
                        </small>
                    </div>
                }

                <button class="setting-primary-action" type="button"
                        disabled="@_isBusy" @onclick="CreatePairingCodeAsync">
                    @(_isBusy
                        ? Text["Watch_CreatingCode"]
                        : _pairingCode is null ? Text["Watch_CreateCode"] : Text["Watch_CreateNewCode"])
                </button>
            </article>

            <article class="setting-card watch-devices-card">
                <div class="watch-list-heading">
                    <div>
                        <p class="setting-eyebrow">@Text["Watch_YourDevices"]</p>
                        <h2>@Text["Watch_ConnectedTitle"]</h2>
                    </div>
                    <button class="watch-refresh-button" type="button"
                            aria-label="@Text["Watch_RefreshList"]"
                            disabled="@_isBusy" @onclick="LoadWatchDevicesAsync">
                        <span class="material-symbols-rounded" aria-hidden="true">refresh</span>
                    </button>
                </div>

                @if (_isBusy && !_watchDevicesLoaded)
                {
                    <div class="watch-list-state" role="status">@Text["Watch_LoadingDevices"]</div>
                }
                else if (!_watchDevicesLoaded)
                {
                    <div class="watch-list-state">
                        <strong>@Text["Watch_ListUnavailable"]</strong>
                        <span>@Text["Watch_ListUnavailableHint"]</span>
                        <button class="watch-list-retry" type="button"
                                disabled="@_isBusy" @onclick="LoadWatchDevicesAsync">
                            @Text["Watch_RetryLoad"]
                        </button>
                    </div>
                }
                else if (!ActiveWatchDevices.Any())
                {
                    <div class="watch-list-state">
                        <span class="material-symbols-rounded" aria-hidden="true">watch_off</span>
                        <strong>@Text["Watch_NoDevices"]</strong>
                        <span>@Text["Watch_NoDevicesHint"]</span>
                    </div>
                }
                else
                {
                    <div class="watch-device-list">
                        @foreach (var device in ActiveWatchDevices)
                        {
                            <section class="watch-device-item" aria-label="@device.DisplayName">
                                <div class="watch-device-copy">
                                    <strong>@device.DisplayName</strong>
                                    <span>@FormatWatchMetadata(device)</span>
                                    <small>@FormatLastSeen(device.LastSeenAtUtc)</small>
                                </div>
                                <button class="watch-disconnect-button" type="button"
                                        disabled="@_isBusy"
                                        @onclick="() => ConfirmWatchRevocation(device)">
                                    @Text["Watch_Disconnect"]
                                </button>
                            </section>
                        }
                    </div>

                    @if (ActiveWatchDevices.Count() > 1)
                    {
                        <button class="watch-disconnect-all" type="button"
                                disabled="@_isBusy" @onclick="ConfirmAllWatchRevocations">
                            @Text["Watch_DisconnectAll"]
                        </button>
                    }
                }
            </article>

            @if (_watchPendingRevocation is not null || _revokeAllWatchesRequested)
            {
                <article class="setting-card watch-confirmation" role="alertdialog"
                         aria-labelledby="watch-confirmation-title"
                         aria-describedby="watch-confirmation-description">
                    <span class="material-symbols-rounded" aria-hidden="true">warning</span>
                    <h2 id="watch-confirmation-title">@Text["Watch_DisconnectTitle"]</h2>
                    <p id="watch-confirmation-description">
                        @(_revokeAllWatchesRequested
                            ? Text["Watch_DisconnectAllWarning"]
                            : Text.Format("Watch_DisconnectOneWarning", _watchPendingRevocation!.DisplayName))
                    </p>
                    <div class="watch-confirmation-actions">
                        <button class="setting-secondary-action" type="button"
                                disabled="@_isBusy" @onclick="CancelWatchRevocation">
                            @Text["Common_Cancel"]
                        </button>
                        <button class="setting-danger-action" type="button"
                                disabled="@_isBusy" @onclick="RevokeConfirmedWatchesAsync">
                            @(_isBusy ? Text["Watch_Disconnecting"] : Text["Watch_Disconnect"])
                        </button>
                    </div>
                </article>
            }
        </div>
    }
    else if (Section == "notifications")
    {
        <article class="setting-card push-settings-card" aria-busy="@_isBusy">
            <p class="setting-description">@Text["ProfilePush_Description"]</p>
            <button class="push-setting-toggle" type="button" role="switch"
                    aria-label="@Text["ProfilePush_Master"]"
                    aria-checked="@(PushRegistration.IsEnabled ? "true" : "false")"
                    disabled="@_isBusy" @onclick="TogglePushAsync">
                <span class="push-setting-copy">
                    <strong>@Text["ProfilePush_Master"]</strong>
                    <span aria-hidden="true">@Text[PushRegistration.IsEnabled ? "ProfilePush_Enabled" : "ProfilePush_Disabled"]</span>
                </span>
                <span class="push-setting-switch" aria-hidden="true"><span></span></span>
            </button>
            <p class="setting-description push-setting-hint">@Text["ProfilePush_SystemHint"]</p>
            @if (_isBusy)
            {
                <p class="push-setting-status" role="status">@Text["ProfilePush_Updating"]</p>
            }
            @if (_pushError is not null)
            {
                <p class="idea-error" role="alert">@_pushError</p>
            }
        </article>
    }
    else if (Section == "sessions")
    {
        <div class="watch-settings-stack" aria-busy="@_isBusy">
            <article class="setting-card">
                <p class="setting-description">@Text["Sessions_Description"]</p>
                <button class="watch-list-retry" disabled="@_isBusy" @onclick="LoadSessionsAsync">@Text["Sessions_Refresh"]</button>
                @if (_sessionError is not null) { <p class="idea-error" role="alert">@_sessionError</p> }
                @if (_sessionMessage is not null) { <p class="watch-success" role="status">@_sessionMessage</p> }
                @if (_sessionsLoaded && _sessions.Count == 0) { <p class="setting-description">@Text["Sessions_Empty"]</p> }
                <div class="watch-device-list">
                    @foreach (var session in _sessions)
                    {
                        <article class="watch-device-item" @key="session.Id">
                            <div class="watch-device-copy">
                                <strong>@SessionName(session)</strong>
                                @if (session.IsCurrent) { <span>@Text["Sessions_Current"]</span> }
                                <span>@Text.Format("Sessions_Created", SessionDate(session.CreatedAtUtc))</span>
                                @if (session.LastRefreshedAtUtc is { } refreshed) { <span>@Text.Format("Sessions_Refreshed", SessionDate(refreshed))</span> }
                            </div>
                            <button class="watch-disconnect-button" disabled="@_isBusy" @onclick="() => _pendingSession = session">@Text["Sessions_End"]</button>
                            @if (_pendingSession?.Id == session.Id)
                            {
                                <div class="session-confirmation">
                                    <p>@Text.Format(session.IsCurrent ? "Sessions_ConfirmCurrent" : "Sessions_Confirm", SessionName(session))</p>
                                    <div class="watch-confirmation-actions">
                                        <button class="setting-secondary-action" disabled="@_isBusy" @onclick="() => _pendingSession = null">@Text["Common_Cancel"]</button>
                                        <button class="setting-danger-action" disabled="@_isBusy" @onclick="RevokeSessionAsync">@Text["Sessions_End"]</button>
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            </article>
        </div>
    }
    else if (Section == "rest-timers")
    {
        <div class="setting-card">
            <p class="setting-description">@Text["Profile_RestTimersHint"]</p>
            <div class="setting-form-grid"><label>@Text["Profile_RestBetweenSets"]<input class="auth-input" type="number" min="5" max="3600" @bind="_restBetweenSetsSeconds" /></label><label>@Text["Profile_RestBetweenExercises"]<input class="auth-input" type="number" min="5" max="3600" @bind="_restBetweenExercisesSeconds" /></label></div>
            <button class="setting-primary-action" type="button" disabled="@_isBusy" @onclick="SaveRestTimersAsync">@(_isBusy ? Text["Common_Saving"] : Text["Profile_ApplyToAllTimers"])</button>
        </div>
    }
    else if (Section == "change-password")
    {
        <EditForm class="setting-card" Model="_passwordInput" OnValidSubmit="ChangePasswordAsync"><DataAnnotationsValidator /><ValidationSummary class="validation-summary" /><div class="setting-form-grid"><label>@Text["Profile_CurrentPassword"] <InputText class="auth-input" type="password" @bind-Value="_passwordInput.CurrentPassword" autocomplete="current-password" /></label><label>@Text["Profile_NewPassword"] <InputText class="auth-input" type="password" @bind-Value="_passwordInput.NewPassword" autocomplete="new-password" /></label><label>@Text["Profile_ConfirmNewPassword"] <InputText class="auth-input" type="password" @bind-Value="_passwordInput.ConfirmPassword" autocomplete="new-password" /></label></div><button class="setting-primary-action" type="submit" disabled="@_isBusy">@(_isBusy ? Text["Profile_PasswordBusy"] : Text["ProfileItem_ChangePassword"])</button></EditForm>
    }
    else if (Section == "report-problem")
    {
        <div class="setting-card"><label class="support-field">@Text["Profile_SupportQuestion"]<textarea maxlength="2000" placeholder="@Text["Profile_SupportPlaceholder"]" @bind="_supportMessage" @bind:event="oninput"></textarea></label><p class="setting-description">@Text["ProfileSetting_SupportHint"]</p><button class="setting-secondary-action" type="button" disabled="@_isBusy" @onclick="PickScreenshotAsync">@Text["Profile_AddScreenshot"]</button>@if (_screenshot is not null) { <p class="setting-description">@Text.Format("ProfileSetting_ScreenshotAttached", _screenshot.FileName)</p> }<button class="setting-primary-action" type="button" disabled="@(_isBusy || _supportMessage.Trim().Length < 10)" @onclick="SubmitSupportAsync">@(_isBusy ? Text["Profile_Sending"] : Text["Profile_Send"])</button></div>
    }
    else if (Section == "suggest-idea")
    {
        <article class="setting-card idea-card">
            <a class="idea-link" href="@InstagramUrl" target="_blank" rel="noopener noreferrer" @onclick="OpenInstagramAsync" @onclick:preventDefault="true">
                <span class="idea-link-icon material-symbols-rounded" aria-hidden="true">photo_camera</span>
                <span class="idea-link-text"><span class="idea-link-title">Instagram</span><span class="idea-link-handle">@@@InstagramHandle</span></span>
                <span class="idea-link-open material-symbols-rounded" aria-hidden="true">open_in_new</span>
            </a>
            <p class="idea-description">@Text["Profile_SuggestIdea_Body"]</p>
            @if (_instagramError is not null)
            {
                <p class="idea-error" role="alert">@_instagramError</p>
            }
        </article>
    }
    else if (Section == "language")
    {
        <article class="setting-card language-card">
            <p class="setting-description">@Text["Profile_Language_Description"]</p>
            <div class="language-options" role="radiogroup" aria-label="@Text["Profile_Language_Title"]">
                @foreach (var option in AppLanguages.All)
                {
                    var isCurrent = option.Code == Language.Current;
                    <button class="@(isCurrent ? "language-option language-option--active" : "language-option")"
                            type="button"
                            role="radio"
                            aria-checked="@(isCurrent ? "true" : "false")"
                            disabled="@_isBusy"
                            @onclick="() => SelectLanguageAsync(option.Code)">
                        <span class="language-option-name">@option.NativeName</span>
                        @if (isCurrent)
                        {
                            <span class="material-symbols-rounded" aria-hidden="true">check</span>
                        }
                    </button>
                }
            </div>
            @if (_languageError is not null)
            {
                <p class="idea-error" role="alert">@_languageError</p>
            }
        </article>
    }
    else if (Section == "logout")
    {
        <article class="setting-card"><p class="setting-description">@Text["ProfileSetting_LogoutHint"]</p><button class="setting-primary-action" type="button" disabled="@_isBusy" @onclick="LogoutAsync">@Text["ProfileItem_Logout"]</button></article>
    }
    else if (Section == "delete-account")
    {
        <article class="setting-card setting-card--danger"><span class="setting-icon material-symbols-rounded" aria-hidden="true">warning</span><h2>@Text["Profile_DeleteAccountTitle"]</h2><p>@Text["ProfileSetting_DeleteWarning"]</p>@if (!_deleteConfirmed) { <button class="setting-danger-action" type="button" @onclick="() => _deleteConfirmed = true">@Text["Common_Continue"]</button> } else { <p class="delete-confirmation">@Text["ProfileSetting_DeleteIrreversible"]</p><button class="setting-danger-action" type="button" disabled="@_isBusy" @onclick="DeleteAccountAsync">@(_isBusy ? Text["Common_Deleting"] : Text["Profile_DeleteForever"])</button> }</article>
    }
</section>

@code {
    // Значение остаётся русским: оно уходит на сервер и хранится в профиле.
    // Переводится только подпись, которую видит пользователь.
    private IReadOnlyList<SystemChoiceOption> GenderOptions =>
    [
        new("Мужской", Text["Gender_Male"]),
        new("Женский", Text["Gender_Female"]),
        new("Не указывать", Text["Gender_Unspecified"])
    ];

    [Parameter] public string Section { get; set; } = string.Empty;
    private readonly List<string> _errors = [];
    private readonly List<string> _watchErrors = [];
    private readonly ProfileInput _profileInput = new();
    private readonly PasswordInput _passwordInput = new();
    private ProfileResponse? _profile;
    private CreateWatchPairingCodeResponse? _pairingCode;
    private IReadOnlyList<WatchDeviceResponse> _watchDevices = [];
    private WatchDeviceResponse? _watchPendingRevocation;
    private PickedPhoto? _screenshot;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _deleteConfirmed;
    private bool _watchDevicesLoaded;
    private bool _revokeAllWatchesRequested;
    private string _supportMessage = string.Empty;
    private string? _watchMessage;
    private string? _pushError;
    private IEnumerable<WatchDeviceResponse> ActiveWatchDevices =>
        _watchDevices.Where(device => !device.IsRevoked);
    private ProfileSettingInfo Setting => Settings.TryGetValue(Section, out var setting)
        ? setting
        : new("ProfileSetting_NotFoundTitle", "help", "ProfileSetting_NotFoundDescription", false);
    private static readonly IReadOnlyDictionary<string, ProfileSettingInfo> Settings = new Dictionary<string, ProfileSettingInfo>(StringComparer.OrdinalIgnoreCase) {
        ["personal-information"] = new("ProfileItem_PersonalInformation", "badge", "", true), ["rest-timers"] = new("ProfileItem_RestTimers", "timer", "", true), ["change-password"] = new("ProfileItem_ChangePassword", "password", "", true), ["report-problem"] = new("ProfileItem_ReportProblem", "bug_report", "", true), ["logout"] = new("ProfileItem_Logout", "logout", "", true), ["delete-account"] = new("ProfileItem_DeleteAccount", "delete_forever", "", true), ["devices"] = new("ProfileItem_ConnectedDevices", "devices", "", true), ["my-data"] = new("ProfileItem_MyData", "database", "", true),
        ["units"] = new("ProfileItem_Units", "scale", "ProfileSoon_Units", false), ["workout-settings"] = new("ProfileItem_WorkoutSettings", "exercise", "ProfileSoon_WorkoutSettings", false), ["notifications"] = new("ProfileItem_Notifications", "notifications", "", true, RequiresProfile: false), ["appearance"] = new("ProfileItem_Appearance", "palette", "ProfileSoon_Appearance", false), ["language"] = new("Profile_Language_Title", "language", "", true, RequiresProfile: false), ["export"] = new("ProfileItem_Export", "download", "ProfileSoon_Export", false), ["sync"] = new("ProfileItem_Sync", "sync", "ProfileSoon_Sync", false), ["sessions"] = new("ProfileItem_Sessions", "devices_other", "", true, RequiresProfile: false), ["help"] = new("ProfileItem_Help", "help", "ProfileSoon_Help", false), ["suggest-idea"] = new("Profile_SuggestIdea_Title", "lightbulb", "", true, RequiresProfile: false), ["about"] = new("ProfileItem_AboutApp", "info", "ProfileAbout_Description", false), ["privacy"] = new("ProfileItem_Privacy", "privacy_tip", "ProfileSoon_Privacy", false) };
    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errors.Clear();
        _pushError = null;
        var replacementRoute = Section.ToLowerInvariant() switch
        {
            "email" => "/profile/personal-information",
            "export" or "sync" or "my-data" => "/profile/sessions",
            _ => null
        };

        if (replacementRoute is not null)
        {
            Navigation.NavigateTo(replacementRoute, replace: true);
            return;
        }

        if (Section == "sessions")
        {
            await LoadSessionsAsync();
            _isLoading = false;
            return;
        }

        if (Section == "devices")
        {
            await LoadWatchDevicesAsync();
            _isLoading = false;
            return;
        }

        if (!Setting.IsAvailable || !Setting.RequiresProfile) { _isLoading = false; return; }
        var result = await ProfileClient.GetAsync();
        if (!result.Succeeded) _errors.AddRange(result.Errors);
        else { _profile = result.Value; Language.ApplyFromProfile(_profile!.PreferredLanguage); _profileInput.FirstName = _profile!.FirstName; _profileInput.LastName = _profile.LastName; _profileInput.BirthDate = _profile.BirthDate; _profileInput.Gender = _profile.Gender; _restBetweenSetsSeconds = _profile.RestBetweenSetsSeconds; _restBetweenExercisesSeconds = _profile.RestBetweenExercisesSeconds; }
        _isLoading = false;
    }
    private string? _languageError;
    private async Task TogglePushAsync()
    {
        if (_isBusy) return;
        _isBusy = true;
        _pushError = null;
        try
        {
            var result = await PushRegistration.SetEnabledAsync(!PushRegistration.IsEnabled);
            if (!result.Succeeded)
                _pushError = string.Join(" ", result.Errors);
        }
        finally { _isBusy = false; }
    }
    private List<AccountSessionResponse> _sessions = [];
    private AccountSessionResponse? _pendingSession;
    private bool _sessionsLoaded;
    private string? _sessionError, _sessionMessage;
    private string SessionName(AccountSessionResponse session) => string.IsNullOrWhiteSpace(session.DeviceName) ? Text["Sessions_Unknown"] : session.DeviceName;
    private static string SessionDate(DateTime value) => DateTime.SpecifyKind(value, DateTimeKind.Utc).ToLocalTime().ToString("g");
    private async Task LoadSessionsAsync()
    {
        if (_isBusy) return;
        _isBusy = true;
        _sessionError = null;
        try
        {
            var result = await ProfileClient.GetSessionsAsync();
            if (!result.Succeeded) _sessionError = string.Join(" ", result.Errors);
            else { _sessions = result.Value!; _sessionsLoaded = true; _pendingSession = null; }
        }
        finally { _isBusy = false; }
    }
    private async Task RevokeSessionAsync()
    {
        if (_isBusy || _pendingSession is null) return;
        var session = _pendingSession;
        _isBusy = true;
        _sessionError = null;
        _sessionMessage = null;
        try
        {
            var result = await ProfileClient.RevokeSessionAsync(session.Id);
            if (!result.Succeeded) { _sessionError = string.Join(" ", result.Errors); return; }
            _sessions.RemoveAll(x => x.Id == session.Id);
            _pendingSession = null;
            if (session.IsCurrent)
            {
                await Authentication.ClearAsync();
                Navigation.NavigateTo("/account/login", replace: true);
            }
            else _sessionMessage = Text["Sessions_Ended"];
        }
        finally { _isBusy = false; }
    }
    private async Task SelectLanguageAsync(string languageCode)
    {
        if (_isBusy || languageCode == Language.Current) return;
        _isBusy = true;
        _languageError = null;
        try
        {
            // Применяем сразу: интерфейс не должен ждать сервер, и выбор
            // обязан сохраниться даже без сети.
            Language.Apply(languageCode);

            var result = await ProfileClient.SaveLanguageAsync(new(languageCode));
            if (!result.Succeeded) _languageError = string.Join(" ", result.Errors);
        }
        finally { _isBusy = false; }
    }
    private const string InstagramHandle = "gymplanner1";
    private const string InstagramUrl = $"https://www.instagram.com/{InstagramHandle}/";
    private string? _instagramError;
    private async Task OpenInstagramAsync() { _instagramError = null; if (!await LinkOpener.OpenAsync(InstagramUrl)) _instagramError = Text.Format("ProfileSetting_InstagramFailed", InstagramUrl); }
    private int _restBetweenSetsSeconds = 90; private int _restBetweenExercisesSeconds = 120;
    private async Task LoadWatchDevicesAsync()
    {
        await RunWatchActionAsync(async () =>
        {
            var result = await WatchClient.GetDevicesAsync();
            if (!result.Succeeded)
            {
                _watchErrors.AddRange(result.Errors);
                return;
            }

            _watchDevices = result.Value!;
            _watchDevicesLoaded = true;
        }, clearMessage: false);
    }

    private async Task CreatePairingCodeAsync()
    {
        await RunWatchActionAsync(async () =>
        {
            var result = await WatchClient.CreatePairingCodeAsync();
            if (!result.Succeeded)
            {
                _watchErrors.AddRange(result.Errors);
                return;
            }

            _pairingCode = result.Value;
            _watchMessage = Text["Watch_CodeCreated"];
        });
    }

    private void ConfirmWatchRevocation(WatchDeviceResponse device)
    {
        _watchPendingRevocation = device;
        _revokeAllWatchesRequested = false;
        _watchErrors.Clear();
        _watchMessage = null;
    }

    private void ConfirmAllWatchRevocations()
    {
        _watchPendingRevocation = null;
        _revokeAllWatchesRequested = true;
        _watchErrors.Clear();
        _watchMessage = null;
    }

    private void CancelWatchRevocation()
    {
        if (_isBusy) return;
        _watchPendingRevocation = null;
        _revokeAllWatchesRequested = false;
    }

    private async Task RevokeConfirmedWatchesAsync()
    {
        var revokeAll = _revokeAllWatchesRequested;
        var device = _watchPendingRevocation;
        await RunWatchActionAsync(async () =>
        {
            var result = revokeAll
                ? await WatchClient.RevokeAllAsync()
                : device is null
                    ? ApiResult.Failure(Text["Watch_NoDeviceSelected"])
                    : await WatchClient.RevokeAsync(device.DeviceId);
            if (!result.Succeeded)
            {
                _watchErrors.AddRange(result.Errors);
                return;
            }

            _watchDevices = revokeAll
                ? _watchDevices.Select(item => item with { IsRevoked = true }).ToArray()
                : _watchDevices.Select(item =>
                    item.DeviceId == device!.DeviceId
                        ? item with { IsRevoked = true }
                        : item).ToArray();
            _watchMessage = revokeAll
                ? Text["Watch_AllDisconnected"]
                : Text.Format("Watch_OneDisconnected", device!.DisplayName);
            _watchPendingRevocation = null;
            _revokeAllWatchesRequested = false;
        });
    }

    private async Task RunWatchActionAsync(Func<Task> action, bool clearMessage = true)
    {
        if (_isBusy) return;
        _isBusy = true;
        _watchErrors.Clear();
        if (clearMessage) _watchMessage = null;
        try { await action(); }
        finally { _isBusy = false; }
    }

    private static string FormatCodeForSpeech(string code) =>
        string.Join(' ', code.ToCharArray());

    private static string FormatWatchMetadata(WatchDeviceResponse device)
    {
        var values = new[] { device.DeviceModel, device.AppVersion is null ? null : $"GPlanner {device.AppVersion}" }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        var metadata = string.Join(" · ", values);
        return string.IsNullOrWhiteSpace(metadata) ? "Wear OS" : metadata;
    }

    private string FormatLastSeen(DateTime? lastSeenAtUtc) =>
        lastSeenAtUtc is null
            ? Text["Watch_NeverSynced"]
            : Text.Format("Watch_LastSeen", lastSeenAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"));
    private async Task SaveProfileAsync() { await RunAsync(async () => { var r = await ProfileClient.SaveAsync(new(_profileInput.FirstName, _profileInput.LastName, _profileInput.BirthDate, _profileInput.Gender)); if (!r.Succeeded) _errors.AddRange(r.Errors); else Navigation.NavigateTo("/profile", replace: true); }); }
    private async Task SaveRestTimersAsync() { if (_restBetweenSetsSeconds is < 5 or > 3600 || _restBetweenExercisesSeconds is < 5 or > 3600) { _errors.Add(Text["Profile_RestTimerRange"]); return; } await RunAsync(async () => { var r = await ProfileClient.SaveRestTimerSettingsAsync(new(_restBetweenSetsSeconds, _restBetweenExercisesSeconds)); if (!r.Succeeded) _errors.AddRange(r.Errors); else Navigation.NavigateTo("/profile", replace: true); }); }
    private async Task ChangePasswordAsync() { await RunAsync(async () => { var r = await ProfileClient.ChangePasswordAsync(new(_passwordInput.CurrentPassword, _passwordInput.NewPassword)); if (!r.Succeeded) _errors.AddRange(r.Errors); else { await Authentication.ClearAsync(); Navigation.NavigateTo("/account/login", replace: true); } }); }
    private async Task PickScreenshotAsync() { var r = await PhotoPicker.PickAsync(MobilePhotoSource.Library); if (r.Succeeded) _screenshot = r.Photo; else if (!r.Cancelled) _errors.AddRange(r.Errors); }
    private async Task SubmitSupportAsync() { await RunAsync(async () => { var r = await SupportClient.CreateAsync(_supportMessage.Trim(), _screenshot, GetDeviceContext()); if (!r.Succeeded) _errors.AddRange(r.Errors); else Navigation.NavigateTo("/profile", replace: true); }); }
    private async Task LogoutAsync() { await RunAsync(async () => { var r = await Authentication.LogoutAsync(); if (!r.Succeeded) _errors.AddRange(r.Errors); else Navigation.NavigateTo("/account/login", replace: true); }); }
    private async Task DeleteAccountAsync() { await RunAsync(async () => { var r = await ProfileClient.DeleteAccountAsync(); if (!r.Succeeded) _errors.AddRange(r.Errors); else { await Authentication.ClearAsync(); Navigation.NavigateTo("/account/login", replace: true); } }); }
    private async Task RunAsync(Func<Task> action) { if (_isBusy) return; _isBusy = true; _errors.Clear(); try { await action(); } finally { _isBusy = false; } }
    private SupportDeviceContext GetDeviceContext() { try { return new(AppInfo.Current.VersionString, DeviceInfo.Current.Platform.ToString(), DeviceInfo.Current.VersionString, $"{DeviceInfo.Current.Manufacturer} {DeviceInfo.Current.Model}".Trim()); } catch (Exception exception) { Logger.LogDebug(exception, "Device context is unavailable for a support ticket."); return new(null, null, null, null); } }
    private sealed class ProfileInput { [Required, MaxLength(80)] public string FirstName { get; set; } = string.Empty; [Required, MaxLength(80)] public string LastName { get; set; } = string.Empty; [Required] public DateTime? BirthDate { get; set; } [Required] public string Gender { get; set; } = string.Empty; }
    private sealed class PasswordInput { [Required] public string CurrentPassword { get; set; } = string.Empty; [Required, MinLength(6)] public string NewPassword { get; set; } = string.Empty; [Compare(nameof(NewPassword), ErrorMessage = "Validation_PasswordsDoNotMatch")] public string ConfirmPassword { get; set; } = string.Empty; }
    // Каталог хранит КЛЮЧИ ресурсов, а не готовый текст: раздел выбирается
    // по маршруту один раз, а язык пользователь может переключить в любой момент.
    private sealed record ProfileSettingInfo(string TitleKey, string Icon, string DescriptionKey, bool IsAvailable, bool RequiresProfile = true);
}
