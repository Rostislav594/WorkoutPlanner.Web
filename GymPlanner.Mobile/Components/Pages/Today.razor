    private void ToggleSupersetExercise(int id)
    {
        if (_exercises.FirstOrDefault(exercise => exercise.Id == id)?.SupersetGroupId is not null)
            return;

        if (!_supersetSelection.Remove(id) && _supersetSelection.Count < 2)
            _supersetSelection.Add(id);
    }

    private async Task CreateSupersetAsync()
    {
        if (_isBusy || _supersetSelection.Count != 2 ||
            _supersetSelection.Any(id => _exercises.FirstOrDefault(exercise => exercise.Id == id)?.SupersetGroupId is not null))
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            // Свободная тренировка идёт тем же путём, что и запланированная:
            // её упражнения теперь живут на сервере и правятся так же.
            var groupId = (_exercises.Max(x => x.SupersetGroupId) ?? 0) + 1;
            foreach (var exercise in _exercises.Where(x => _supersetSelection.Contains(x.Id)))
            {
                exercise.SupersetGroupId = groupId;
                var result = await WorkoutClient.UpdateExerciseAsync(exercise.Id, exercise.ToRequest(), _disposeCts.Token);
                if (!result.Succeeded)
                {
                    _errors.AddRange(result.Errors);
                    return;
                }
                exercise.UpdateFrom(result.Value!);
            }

            _showSupersetDialog = false;
            _supersetSelection.Clear();
        }
        finally
        {
            _isBusy = false;
        }
    }

    // Перестановка видна сразу, сервер сохраняет её следом; при отказе порядок возвращается.
    private async Task SwapSupersetAsync(ExerciseGroup group)
    {
        var planId = _freeDraftPlanId ?? _workout?.TrainingPlan.Id;
        if (_isBusy || _swappingSuperset || planId is null || group.Exercises.Count < 2 || group.Exercises[0].SupersetGroupId is not { } groupId)
            return;

        var previous = _exercises.ToArray();
        var newOrder = group.Exercises.Reverse().Select(x => x.Id).ToArray();
        var reordered = SupersetOrdering.Apply(_exercises, newOrder, x => x.Id);
        _swappingSuperset = true;
        _errors.Clear();
        try
        {
            var capture = _swapAnimation.CaptureAsync(groupId);
            _exercises.Clear();
            _exercises.AddRange(reordered);
            _swappedSupersetId = groupId;
            _supersetSwapVersion++;
            StateHasChanged();
            await capture;

            var result = await WorkoutClient.ReorderSupersetAsync(
                planId.Value,
                groupId,
                new ReorderSupersetRequest(newOrder),
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _exercises.Clear();
                _exercises.AddRange(previous);
                _errors.AddRange(result.Errors);
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _swappingSuperset = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
