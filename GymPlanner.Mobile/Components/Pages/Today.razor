@code {
    // Без связи действия, которым нужен сервер, неактивны (флаг передаёт шапка).
    [CascadingParameter(Name = "IsOffline")]
    public bool IsOffline { get; set; }
    // Неназначенная карточка показывает общий заголовок: имя появится
    // только после выбора упражнения из библиотеки.
    private string DisplayNameOf(ExerciseDraft exercise) =>
        exercise.IsConfigured ? exercise.Name : Text["WorkoutDetails_NewExercise"];

    private readonly List<ExerciseDraft> _exercises = [];
    private readonly List<ExerciseDefinitionApiResponse> _exerciseDefinitions = [];
    private readonly List<string> _errors = [];
    private readonly List<string> _freeEditorErrors = [];
    private readonly List<string> _templateErrors = [];
    private readonly List<string> _photoErrors = [];
    private readonly Dictionary<int, string> _photoThumbnails = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private TodayWorkoutApiResponse? _workout;
    private WorkoutHistoryApiResponse? _completedHistory;
    private readonly List<NextSessionChoice> _nextSessionChoices = [];
    private readonly List<string> _nextSessionErrors = [];
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isFreeWorkout;
    private bool _showFreeExerciseEditor;
    private bool _showFreeTemplatePrompt;
    private bool _showTemplateNamePrompt;
    private bool _showSupersetDialog;
    private int? _swappedSupersetId;
    private int _supersetSwapVersion;
    // Перестановка блокирует только свою кнопку: общий флаг занятости гасил бы
    // все кнопки карточки, и они мигали бы при каждом нажатии.
    private bool _swappingSuperset;
    private SupersetSwapAnimation _swapAnimation = null!;
    private bool _photoBusy;
    private bool _confirmPhotoDelete;
    private bool _isCreatingFreeExercise;
    private static readonly TimeSpan FinishHoldFeedbackDelay = TimeSpan.FromMilliseconds(100);
    private static readonly TimeSpan FinishHoldDuration = TimeSpan.FromMilliseconds(3400);
    private bool _isFinishHoldActive;
    private bool _isFinishAnimationActive;
    private int _nextFreeExerciseId = -1;
    /// <summary>
    /// План черновика идущей свободной тренировки.
    /// </summary>
    /// <remarks>
    /// Свободная тренировка живёт на сервере с самого начала, иначе её не видят
    /// часы. Упражнения добавляются в этот план обычными эндпоинтами, поэтому
    /// идентификаторы у них настоящие, а не выдуманные локально.
    /// </remarks>
    private int? _freeDraftPlanId;
    private int? _editActionExerciseId;
    private int? _freeEditorExerciseId;
    private ExerciseGroup? _supersetActionGroup;
    private CancellationTokenSource? _supersetHoldCts;
    private bool _supersetDeleteConfirmation;
    private ExerciseDraft? _freeEditorDraft;
    private ExerciseDraft? _photoExercise;
    private string _templateName = string.Empty;
    private string _completionMessage = string.Empty;
    private string? _photoDataUri;
    private CancellationTokenSource? _exerciseHoldCts;
    private CancellationTokenSource? _finishHoldCts;
    private readonly HashSet<int> _supersetSelection = [];
    private readonly Dictionary<string, RestTimerState> _restTimers = [];
    private readonly List<RestTimerState> _queuedRestTimers = [];
    private RestTimerState? _selectedRestTimer;
    // Значение поля в окне таймера: применяется к таймерам и шаблону, когда окно закрывают.
    private int _restDraftSeconds;
    // Отдых между подходами хранится в упражнениях, а этот — в шаблоне (или в
    // черновике свободной тренировки) и общий для всех переходов между упражнениями.
    private int _restBetweenExercisesSeconds = RestTimerDefaults.BetweenExercisesSeconds;

    private IReadOnlyList<SystemChoiceOption> ExerciseDefinitionOptions =>
        _exerciseDefinitions
            .Select(definition => new SystemChoiceOption(definition.Id.ToString(), definition.Name))
            .ToList();

    private IReadOnlyList<ExerciseGroup> ExerciseGroups => _exercises
        .GroupBy(x => x.SupersetGroupId is { } groupId ? $"s:{groupId}" : $"e:{x.Id}")
        .Select(x => new ExerciseGroup(x.First().SupersetGroupId is not null && x.Count() > 1, x.ToList()))
        .ToList();

    private IReadOnlyList<ExerciseDraft> SupersetCandidates =>
        _exercises.Where(exercise => exercise.SupersetGroupId is null).ToList();

    private int TotalSets => _exercises
        .Where(x => x.IsConfigured)
        .Sum(x => x.Sets.Count);
    private int CompletedSets => _exercises
        .Where(x => x.IsConfigured)
        .Sum(x => x.Sets.Count(set => set.Completed));
    private double ProgressPercent => TotalSets == 0
        ? 0
        : CompletedSets * 100d / TotalSets;
    private ExerciseDraft? EditActionExercise => _editActionExerciseId is { } id
        ? _exercises.FirstOrDefault(x => x.Id == id)
        : null;
    private bool HasFinishableExercise => _exercises.Any(exercise => exercise.IsConfigured);

    protected override async Task OnInitializedAsync()
    {
        _swapAnimation = new SupersetSwapAnimation(JS);
        Lifecycle.Suspended += SaveSessionOnSuspend;
        Tutorial.Stopping += OnTutorialStopping;
        Tutorial.Stopped += OnTutorialStopped;
        _ = RunRestTimerLoopAsync();
        await LoadAsync();
    }

    // Идущая тренировка хранится на телефоне: закрытое системой приложение
    // не должно терять ни одного подхода.
    private string? _savedSessionJson;

    private (int PlanId, int? DayId)? ActiveSessionKey =>
        Tutorial.IsActive || _completedHistory is not null || _isLoading ? null
        : _isFreeWorkout && _freeDraftPlanId is { } freePlanId ? (freePlanId, null)
        : _workout is { } workout ? (workout.TrainingPlan.Id, workout.Day.Id)
        : null;

    private async Task SaveSessionIfChangedAsync()
    {
        if (ActiveSessionKey is not { } key)
            return;

        var exercises = _exercises.Where(x => x.Id >= 0 || OfflineIds.IsLocal(x.Id)).Select(x => x.ToResponse()).ToList();
        var json = System.Text.Json.JsonSerializer.Serialize(exercises);
        if (json == _savedSessionJson)
            return;

        _savedSessionJson = json;
        await WorkoutSession.SaveAsync(key.PlanId, key.DayId, exercises);
    }

    private void SaveSessionOnSuspend() => _ = InvokeAsync(SaveSessionIfChangedAsync);

    /// <summary>Возвращает подходы, отмеченные до перезапуска приложения.</summary>
    private async Task RestoreSessionAsync(int planId, int? dayId)
    {
        // Демо-тренировка обучения не продолжает ничего сохранённого.
        if (Tutorial.IsActive)
            return;

        var snapshot = await WorkoutSession.LoadAsync(planId, dayId);
        if (snapshot is null)
            return;

        var saved = snapshot.Exercises.ToDictionary(x => x.Id);
        foreach (var exercise in _exercises)
        {
            if (saved.TryGetValue(exercise.Id, out var source))
