        {
            SetNumber = source.SetNumber,
            Repetitions = source.Repetitions,
            Weight = source.Weight,
            Completed = source.Completed,
            IsWarmup = source.IsWarmup
        };

        public FreeWorkoutSetDraft ToFree() => new(
            SetNumber,
            Repetitions,
            Weight,
            Completed,
            IsWarmup);
    }
