                       type="number"
                       min="1"
                       max="20"
                       value="@_freeEditorDraft.Sets.Count"
                       @onchange="ChangeFreeSetsCount" />
            </label>

            <div class="free-set-editor-list">
                @foreach (var set in _freeEditorDraft.Sets)
                {
                    <fieldset>
                        <legend>Подход @set.SetNumber</legend>
                        <label>
                            <span>Вес, кг</span>
                            <input class="editor-control" type="number" min="0" max="2000" step="0.5" @bind="set.Weight" />
                        </label>
                        <label>
                            <span>Повторения</span>
                            <input class="editor-control" type="number" min="1" max="1000" @bind="set.Repetitions" />
                        </label>
                    </fieldset>
                }
            </div>

            <div class="editor-actions">
                <button class="edit-workout-button" type="button" @onclick="SaveFreeExerciseEdit">
                    @(_isCreatingFreeExercise ? "Добавить упражнение" : "Сохранить")
                </button>
            </div>
        </section>
    </div>
}

@if (_showFreeTemplatePrompt)
