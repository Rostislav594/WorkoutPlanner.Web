@page "/today"
@attribute [Authorize]
@implements IDisposable
@inject IJSRuntime JS
@using WorkoutPlanner.Api.Contracts
@using WorkoutPlanner.Domain
@inject IWorkoutApiClient ServerWorkoutClient
@inject IWorkoutLifecycleApiClient ServerLifecycleClient
@inject IExercisePhotoApiClient PhotoClient
@inject IMobilePhotoPicker PhotoPicker
@inject NavigationManager Navigation
@inject IAppText Text
@inject MobileBackNavigationService BackNavigation
@inject ActiveWorkoutSessionStore WorkoutSession
@inject MobileLifecycleService Lifecycle
@inject TimeProvider Clock
@inject TutorialHost Tutorial
@inject ExercisePicker ExerciseLibraryPicker

<section class="today-page" aria-busy="@_isLoading">
    <header class="today-header">
        <div class="today-heading">
            <h1 class="today-title">@Text["Nav_Today"]</h1>
            <p class="today-date">@DateTime.Today.ToString("dd MMMM, dddd")</p>
        </div>

        <div class="today-help"><HelpButton Label="@Text["Tutorial_Today_Open"]" Disabled="@(!CanStartTutorial)" OnActivate="StartTutorialAsync" /></div>

        <div class="today-header-actions">
            @if (!_isLoading && _workout is null && !_isFreeWorkout)
            {
                <button class="free-workout-button" data-tour="free-start" type="button" disabled="@_isBusy" @onclick="CreateFreeWorkoutAsync">
                    <span class="material-symbols-rounded" aria-hidden="true">bolt</span>
                    <span>@Text["Today_FreeWorkout"]</span>
                </button>
            }
            else if (!_isLoading)
            {
                @* Для тренировки из календаря показываем название шаблона, а не «Свободная тренировка». *@
                var planName = _isFreeWorkout ? null : _workout?.TrainingPlan.WorkoutName;
                <div class="workout-progress-indicator" data-tour="plan-name" style="--workout-progress: @ProgressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"
                     aria-label="@(planName is null ? Text.Format("Today_FreeProgressAria", ProgressPercent.ToString("0")) : Text.Format("Today_PlanProgressAria", planName, ProgressPercent.ToString("0")))">
                    <div class="workout-progress-indicator__content">
                        <span class="material-symbols-rounded" aria-hidden="true">@(planName is null ? "bolt" : "fitness_center")</span>
                        <span class="workout-progress-indicator__label">@(planName ?? Text["Today_FreeWorkout"])</span>
                    </div>
                </div>
            }
            @if (SupersetCandidates.Count >= 2)
            {
                <button class="secondary-button superset-button" data-tour="superset-create" type="button" aria-haspopup="dialog" disabled="@_isBusy" @onclick="OpenSupersetDialog">
                    <span class="material-symbols-rounded" aria-hidden="true">link</span>
                    @Text["WorkoutDetails_CreateSuperset"]
                </button>
            }
        </div>
    </header>

    @if (_errors.Count > 0)
    {
        <div class="today-error" role="alert">@string.Join(" ", _errors)</div>
    }

    @if (_isLoading)
    {
        <div class="page-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>@Text["WorkoutDetails_Loading"]</span>
        </div>
    }
    else if (_workout is null && !_isFreeWorkout)
    {
        <div class="no-workout-container">
            <div class="no-workout-copy">
                <h2>@Text["Today_NoWorkout"]</h2>
                @if (_errors.Count > 0)
                {
                    <div class="empty-actions">
                        <button class="secondary-button" type="button" @onclick="LoadAsync">@Text["Common_Retry"]</button>
                    </div>
                }
            </div>

            <div class="no-workout-visual" aria-hidden="true">
                <span class="material-symbols-rounded">event_busy</span>
            </div>
        </div>
    }
    else
    {
        @if (_exercises.Count == 0)
        {
            <div class="page-state">
                @(_isFreeWorkout
                    ? Text["Today_AddFirstExercise"]
                    : Text["Today_PlanHasNoExercises"])
            </div>
        }

        <div class="exercise-list">
            @foreach (var group in ExerciseGroups)
            {
                @if (group.IsSuperset)
                {
                    <article class="exercise-card superset-exercise-card edit-hold-target"
                             data-superset-id="@group.Exercises[0].SupersetGroupId"
                             tabindex="0"
                             aria-label="@Text.Format("WorkoutDetails_SupersetCardHint", string.Join(Text["Common_AndSeparator"], group.Exercises.Select(x => x.Name)))"
                             @onpointerdown="() => BeginSupersetHold(group)"
                             @onpointerup="CancelSupersetHold"
                             @onpointercancel="CancelSupersetHold"
                             @onpointerleave="CancelSupersetHold"
                             @oncontextmenu="() => ShowSupersetActions(group)"
                             @oncontextmenu:preventDefault="true"
                             @onkeydown="eventArgs => HandleSupersetKeyDown(eventArgs, group)">
                        <header class="superset-header">
                            <div class="superset-label-row">
                                <div class="superset-label"><span class="material-symbols-rounded" aria-hidden="true">link</span> @Text["Common_Superset"]</div>
                                <button class="superset-swap-button @SwapClass(group)"
                                        @key="@SwapKey(group)"
                                        type="button"
                                        disabled="@_isBusy"
                                        aria-disabled="@(_swappingSuperset ? "true" : "false")"
                                        title="@Text["Common_SupersetSwap"]"
                                        aria-label="@Text["Common_SupersetSwap"]"
                                        @onpointerdown:stopPropagation="true"
                                        @onkeydown:stopPropagation="true"
                                        @onclick="() => SwapSupersetAsync(group)">
                                    <span class="material-symbols-rounded" aria-hidden="true">swap_vert</span>
                                </button>
                            </div>
                            <div class="superset-names" aria-label="@string.Join(" / ", group.Exercises.Select(DisplayNameOf))">
                                @for (var exerciseIndex = 0; exerciseIndex < group.Exercises.Count; exerciseIndex++)
                                {
                                    var exercise = group.Exercises[exerciseIndex];
                                    if (exerciseIndex > 0)
                                    {
                                        <span class="superset-name-separator" aria-hidden="true">/</span>
                                    }
                                    <span class="superset-name @(exerciseIndex == 0 ? "superset-tone-a" : "superset-tone-b")" @key="@($"name-{exercise.Id}")" data-flip-key="@($"name-{exercise.Id}")">@DisplayNameOf(exercise)</span>
                                }
                            </div>
                        </header>

                        <div class="superset-card-body">
                            <div class="superset-rounds">
                                @foreach (var roundNumber in GetSupersetRoundNumbers(group))
                                {
                                    <section class="superset-round" aria-label="@Text.Format("History_Round", roundNumber)">
                                        @for (var exerciseIndex = 0; exerciseIndex < group.Exercises.Count; exerciseIndex++)
                                        {
                                            var exercise = group.Exercises[exerciseIndex];
                                            var set = exercise.Sets.FirstOrDefault(candidate => candidate.SetNumber == roundNumber);
                                            if (set is null)
                                                continue;

                                            <fieldset class="set-row superset-set-row @(exerciseIndex == 0 ? "superset-tone-a" : "superset-tone-b")" data-tour="@($"sset-{exercise.Id}-{set.SetNumber}")" @key="@($"set-{exercise.Id}-{set.SetNumber}")" data-flip-key="@($"set-{exercise.Id}-{set.SetNumber}")" aria-label="@Text.Format("Today_ExerciseSetLabel", exercise.Name, set.SetNumber)" @onpointerdown:stopPropagation="true">
                                                <legend class="visually-hidden">@Text.Format("Today_ExerciseSetLabel", exercise.Name, set.SetNumber)</legend>

                                                <button class="set-number @(set.IsWarmup ? "warmup" : "working")"
                                                        type="button"
                                                        title="@(set.IsWarmup ? Text["WorkoutDetails_ToggleWarmupTitle"] : Text["WorkoutDetails_ToggleWorkingTitle"])"
                                                        aria-label="@(set.IsWarmup ? Text.Format("WorkoutDetails_ToggleWarmupSupersetLabel", exercise.Name, set.SetNumber) : Text.Format("WorkoutDetails_ToggleWorkingSupersetLabel", exercise.Name, set.SetNumber))"
                                                        aria-pressed="@set.IsWarmup"
                                                        @onclick="() => ToggleSetKind(set)">@set.SetNumber</button>

                                                <label class="set-value-control">
                                                    <span>@Text["Common_Kg"]</span>
                                                    <input class="set-input" type="number" min="0" max="2000" step="0.5" @bind="set.Weight" />
                                                </label>

                                                <label class="set-value-control">
                                                    <span>@Text["Common_RepsShort"]</span>
                                                    <input class="set-input" type="number" min="1" max="1000" @bind="set.Repetitions" />
                                                </label>

                                                <label class="complete-control" title="@Text["Today_MarkSetDone"]">
                                                    <input type="checkbox" checked="@set.Completed" @onchange="args => SetSupersetCompletedAsync(group, set, args)" />
                                                    <svg class="complete-checkmark" viewBox="0 0 24 24" aria-hidden="true">
                                                        <path d="M6.5 12.5 10.2 16 17.8 8.4" />
                                                    </svg>
                                                    <span class="visually-hidden">@Text.Format("Today_ExerciseSetCompleted", exercise.Name, set.SetNumber)</span>
                                                </label>
                                            </fieldset>
                                        }
                                    </section>

                                    @if (HasFollowingSupersetRound(group, roundNumber))
                                    {
                                         <button class="rest-timer-box superset-rest-timer" data-tour="@($"rest-{roundNumber}")" type="button" @onpointerdown:stopPropagation="true" @onclick="() => OpenRestTimer(group.Exercises[0].Id, roundNumber, RestTimerKind.BetweenSets)">
                                            <span class="rest-timer-icon @(GetRestTimer(group.Exercises[0].Id, roundNumber, RestTimerKind.BetweenSets).StartAnimationVersion > 0 ? "rest-timer-icon--started" : null)" @key="GetRestTimer(group.Exercises[0].Id, roundNumber, RestTimerKind.BetweenSets).StartAnimationVersion" aria-hidden="true">
                                                <span class="material-symbols-rounded rest-timer-icon__glyph">timer</span>
                                                <svg class="rest-timer-icon__rays" viewBox="0 0 30 16" fill="none" aria-hidden="true"><path d="M6 13 2 7M15 10V3M24 13l4-6" /></svg>
                                            </span>
                                            <span class="rest-timer-copy">
                                                <small>@Text["Today_RestAfterPair"]</small>
                                                <strong>@GetRestTimerLabel(group.Exercises[0].Id, roundNumber, RestTimerKind.BetweenSets)</strong>
                                            </span>
                                            <span class="material-symbols-rounded rest-timer-edit" aria-hidden="true">edit</span>
                                        </button>
                                    }
                                }
                            </div>

                        </div>

                        <footer class="exercise-footer superset-footer">
                            <ExerciseEffortRating Value="@GetSupersetStatus(group)" Disabled="@_isBusy"
                                                  ValueChanged="value => SetSupersetStatus(group, value)"
                                                  Label="@Text["Today_SelectSupersetRating"]" />
                            @if (HasFollowingGroup(group))
                            {
                                <button class="rest-timer-box rest-timer-box--exercise" data-tour="rest-next" type="button" @onpointerdown:stopPropagation="true" @onclick="() => OpenRestTimer(group.Exercises[0].Id, 0, RestTimerKind.BetweenExercises)">
                                    <span class="rest-timer-icon @(GetRestTimer(group.Exercises[0].Id, 0, RestTimerKind.BetweenExercises).StartAnimationVersion > 0 ? "rest-timer-icon--started" : null)" @key="GetRestTimer(group.Exercises[0].Id, 0, RestTimerKind.BetweenExercises).StartAnimationVersion" aria-hidden="true">
                                        <span class="material-symbols-rounded rest-timer-icon__glyph">timer</span>
                                        <svg class="rest-timer-icon__rays" viewBox="0 0 30 16" fill="none" aria-hidden="true"><path d="M6 13 2 7M15 10V3M24 13l4-6" /></svg>
                                    </span>
                                    <span class="rest-timer-copy">
                                        <small>@Text["Today_RestBetweenExercises"]</small>
                                        <strong>@GetRestTimerLabel(group.Exercises[0].Id, 0, RestTimerKind.BetweenExercises)</strong>
                                    </span>
                                    <span class="material-symbols-rounded rest-timer-edit" aria-hidden="true">edit</span>
                                </button>
                            }
                        </footer>
                    </article>
                }
                else
                {
                @foreach (var exercise in group.Exercises)
                {
                <article class="exercise-card" data-tour-exercise="@exercise.Id">
                    <header class="exercise-header edit-hold-target"
                            tabindex="0"
                            aria-label="@Text.Format("Today_ExerciseCardHint", exercise.Name)"
                            @onclick="() => HandleExerciseClick(exercise.Id)"
                            @onpointerdown="() => BeginExerciseHold(exercise.Id)"
                            @onpointerup="CancelExerciseHold"
                            @onpointercancel="CancelExerciseHold"
                            @onpointerleave="CancelExerciseHold"
                            @oncontextmenu="() => ShowEditWorkoutAction(exercise.Id)"
                            @oncontextmenu:preventDefault="true"
                            @onkeydown="eventArgs => HandleExerciseKeyDown(eventArgs, exercise.Id)">
                        <div class="exercise-heading-copy">
                            <h2>@DisplayNameOf(exercise)</h2>
                            @if (exercise.IsConfigured)
                            {
                            <div class="set-kind-summary" aria-label="@Text["Today_SetKinds"]">
                                @if (exercise.Sets.Any(x => x.IsWarmup))
                                {
                                    <span class="set-kind-label warmup">
                                        @Text.Format("Today_WarmupCount", exercise.Sets.Count(x => x.IsWarmup))
                                    </span>
                                }
                                @if (exercise.Sets.Any(x => !x.IsWarmup))
                                {
                                    <span class="set-kind-label working">
                                        @Text.Format("Today_WorkingCount", exercise.Sets.Count(x => !x.IsWarmup))
                                    </span>
                                }
                            </div>
                            }
                        </div>
                    </header>

                    @if (!exercise.IsConfigured)
                    {
                        <div class="free-exercise-placeholder edit-hold-target"
                             tabindex="0"
                             role="button"
                             aria-label="@Text["Today_NewExerciseCardHint"]"
                             @onclick="() => HandleExerciseClick(exercise.Id)"
                             @onpointerdown="() => BeginExerciseHold(exercise.Id)"
                             @onpointerup="CancelExerciseHold"
                             @onpointercancel="CancelExerciseHold"
                             @onpointerleave="CancelExerciseHold"
                             @oncontextmenu="() => ShowEditWorkoutAction(exercise.Id)"
                             @oncontextmenu:preventDefault="true"
                             @onkeydown="eventArgs => HandleExerciseKeyDown(eventArgs, exercise.Id)">
                             <span>@Text["Today_TapCardHint"]</span>
                        </div>
                    }
                    else
                    {
                    <div class="exercise-card-body">
                        <div class="sets-block">
                            @foreach (var set in exercise.Sets)
                            {
                                <fieldset class="set-row" data-tour="@($"set-{set.SetNumber}")" aria-label="@Text.Format("Common_SetNumber", set.SetNumber)">
                                    <legend class="visually-hidden">@Text.Format("Common_SetNumber", set.SetNumber)</legend>

                                    <button class="set-number @(set.IsWarmup ? "warmup" : "working")"
                                            type="button"
                                            title="@(set.IsWarmup ? Text["WorkoutDetails_ToggleWarmupTitle"] : Text["WorkoutDetails_ToggleWorkingTitle"])"
                                            aria-label="@(set.IsWarmup ? Text.Format("WorkoutDetails_ToggleWarmupLabel", set.SetNumber) : Text.Format("WorkoutDetails_ToggleWorkingLabel", set.SetNumber))"
                                            aria-pressed="@set.IsWarmup"
                                            @onclick="() => ToggleSetKind(set)">@set.SetNumber</button>

                                    <label class="set-value-control" data-tour="set-weight">
                                        <span>@Text["Common_Kg"]</span>
                                        <input class="set-input" type="number" min="0" max="2000" step="0.5" @bind="set.Weight" />
                                    </label>

                                    <label class="set-value-control" data-tour="set-reps">
                                        <span>@Text["Common_RepsShort"]</span>
                                        <input class="set-input" type="number" min="1" max="1000" @bind="set.Repetitions" />
                                    </label>

                                    <label class="complete-control" title="@Text["Today_MarkSetDone"]">
                                        <input type="checkbox" checked="@set.Completed" @onchange="args => SetCompletedAsync(exercise, set, args)" />
                                        <svg class="complete-checkmark" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M6.5 12.5 10.2 16 17.8 8.4" />
                                        </svg>
                                        <span class="visually-hidden">@Text["Common_SetCompleted"]</span>
                                    </label>
                                </fieldset>
                                @if (HasFollowingSet(exercise, set))
                                {
                                    <button class="rest-timer-box" data-tour="@($"rest-{set.SetNumber}")" type="button" @onclick="() => OpenRestTimer(exercise.Id, set.SetNumber, RestTimerKind.BetweenSets)">
                                        <span class="rest-timer-icon @(GetRestTimer(exercise.Id, set.SetNumber, RestTimerKind.BetweenSets).StartAnimationVersion > 0 ? "rest-timer-icon--started" : null)" @key="GetRestTimer(exercise.Id, set.SetNumber, RestTimerKind.BetweenSets).StartAnimationVersion" aria-hidden="true">
                                            <span class="material-symbols-rounded rest-timer-icon__glyph">timer</span>
                                            <svg class="rest-timer-icon__rays" viewBox="0 0 30 16" fill="none" aria-hidden="true"><path d="M6 13 2 7M15 10V3M24 13l4-6" /></svg>
                                        </span>
                                        <span class="rest-timer-copy">
                                            <small>@Text["Today_RestBetweenSets"]</small>
                                            <strong>@GetRestTimerLabel(exercise.Id, set.SetNumber, RestTimerKind.BetweenSets)</strong>
                                        </span>
                                        <span class="material-symbols-rounded rest-timer-edit" aria-hidden="true">edit</span>
                                    </button>
                                }
                            }
                        </div>

                    </div>

                    <footer class="exercise-footer">
                        <ExerciseEffortRating @bind-Value="exercise.Status" Disabled="@_isBusy"
                                              Label="@Text["Today_SelectExerciseRating"]" />
                        @if (HasFollowingExercise(exercise))
                        {
                            <button class="rest-timer-box rest-timer-box--exercise" data-tour="rest-next" type="button" @onclick="() => OpenRestTimer(exercise.Id, 0, RestTimerKind.BetweenExercises)">
                                <span class="rest-timer-icon @(GetRestTimer(exercise.Id, 0, RestTimerKind.BetweenExercises).StartAnimationVersion > 0 ? "rest-timer-icon--started" : null)" @key="GetRestTimer(exercise.Id, 0, RestTimerKind.BetweenExercises).StartAnimationVersion" aria-hidden="true">
                                    <span class="material-symbols-rounded rest-timer-icon__glyph">timer</span>
                                    <svg class="rest-timer-icon__rays" viewBox="0 0 30 16" fill="none" aria-hidden="true"><path d="M6 13 2 7M15 10V3M24 13l4-6" /></svg>
                                </span>
                                <span class="rest-timer-copy">
                                    <small>@Text["Today_RestBetweenExercises"]</small>
                                    <strong>@GetRestTimerLabel(exercise.Id, 0, RestTimerKind.BetweenExercises)</strong>
                                </span>
                                <span class="material-symbols-rounded rest-timer-edit" aria-hidden="true">edit</span>
                            </button>
                        }
                    </footer>
                    }

                </article>
                }
                }
            }
        </div>

        @if (_isFreeWorkout)
        {
            <div class="free-exercise-action">
                <button class="compact-create-button add-free-exercise-button"
                        data-tour="add-exercise"
                        type="button"
                        disabled="@_isBusy"
                        @onclick="BeginFreeExerciseCreateAsync">
                    <span class="material-symbols-rounded" aria-hidden="true">add</span>
                    @Text["WorkoutDetails_AddExercise"]
                </button>
            </div>
        }

        @if (HasFinishableExercise)
        {
            <button class="finish-button finish-button--hold"
                    data-tour="finish"
                    type="button"
                    disabled="@_isBusy"
                    aria-label="@(_isBusy ? Text["Today_SavingWorkoutAria"] : Text.Format("Today_HoldToFinishAria", FinishHoldDuration.TotalSeconds))"
                    @onpointerdown="BeginFinishHoldAsync"
                    @onpointerup="CancelFinishHold"
                    @onpointercancel="CancelFinishHold"
                    @onpointerleave="CancelFinishHold"
                    @onkeydown="HandleFinishKeyDown"
                    @onkeyup="HandleFinishKeyUp"
                    @oncontextmenu:preventDefault="true">
                <span class="finish-button-label">@(_isBusy ? Text["Today_SavingWorkout"] : Text["Today_FinishWorkout"])</span>
                @if (!_isBusy)
                {
                    <span class="finish-button-hold-hint" aria-hidden="true">
                        <span class="material-symbols-rounded" aria-hidden="true">touch_app</span>
                        <span>@Text.Format("Today_FinishHoldDuration", FinishHoldDuration.TotalSeconds)</span>
                    </span>
                }
            </button>
        }
    }
</section>

@if (_isFinishAnimationActive)
{
    <div class="finish-hold-overlay @(Tutorial.IsActive ? "finish-hold-overlay--fast" : null)" aria-hidden="true">
        <div class="finish-hold-animation">
            <svg class="finish-hold-symbol" viewBox="0 0 120 120" focusable="false">
                <defs>
                    <radialGradient id="finish-ring-gradient" gradientUnits="userSpaceOnUse" cx="60" cy="60" r="58">
                        <stop offset="90%" stop-color="#4fc46b" />
                        <stop offset="100%" stop-color="#265e33" />
                    </radialGradient>
                    <mask id="finish-outer-glow-mask" maskUnits="userSpaceOnUse" x="-30" y="-30" width="180" height="180">
                        <rect x="-30" y="-30" width="180" height="180" fill="white" />
                        <circle cx="60" cy="60" r="54.5" fill="black" />
                    </mask>
                </defs>
                <circle class="finish-hold-glow" cx="60" cy="60" r="52" stroke="url(#finish-ring-gradient)" mask="url(#finish-outer-glow-mask)" />
                <circle class="finish-hold-progress" cx="60" cy="60" r="52" stroke="url(#finish-ring-gradient)" />
                <path class="finish-hold-check" d="M36 61 L54 80 L84 34" />
            </svg>
        </div>
    </div>
    <span class="visually-hidden" role="status">@Text["Today_HoldUntilAnimation"]</span>
}

@if (_selectedRestTimer is not null)
{
    <div class="modal-overlay" @onclick="CloseRestTimerAsync">
        <section class="modal-window rest-timer-dialog" role="dialog" aria-modal="true" aria-labelledby="rest-timer-title" aria-describedby="rest-timer-hint" @onclick:stopPropagation="true">
            <div class="editor-heading">
                <div>
                    <span>@Text["Today_RestTimer"]</span>
                    <h2 id="rest-timer-title">@(_selectedRestTimer.Kind == RestTimerKind.BetweenSets ? Text["Today_BetweenSets"] : Text["Today_BetweenExercises"])</h2>
                </div>
                <button class="quick-action-close editor-close" type="button" aria-label="@Text["Common_Close"]" @onclick="CloseRestTimerAsync">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>
            <label class="editor-field" data-tour="rest-seconds">
                <span>@Text["Today_RestSeconds"]</span>
                <input class="editor-control" type="number" inputmode="numeric" min="@RestTimerDefaults.MinSeconds" max="@RestTimerDefaults.MaxSeconds" @bind="_restDraftSeconds" />
            </label>
            <p id="rest-timer-hint" class="rest-timer-dialog-hint">@RestTimerHint(_selectedRestTimer)</p>
            <div class="editor-actions rest-timer-actions">
                <button class="edit-workout-button" type="button" disabled="@_selectedRestTimer.IsQueued" @onclick="StartSelectedRestTimerAsync">@(_selectedRestTimer.IsRunning ? Text["Today_Restart"] : _selectedRestTimer.IsQueued ? Text["Today_Queued"] : Text["Today_Start"])</button>
                @if (_selectedRestTimer.IsRunning)
                {
                    <button class="secondary-button" type="button" @onclick="PauseSelectedRestTimer">@Text["Today_Pause"]</button>
                }
                <button class="secondary-button" data-tour="rest-done" type="button" @onclick="CloseRestTimerAsync">@Text["Common_Done"]</button>
            </div>
        </section>
    </div>
}

@if (_photoExercise is not null)
{
    <div class="modal-overlay" @onclick="ClosePhoto">
        <section class="modal-window photo-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="today-photo-title"
                 @onclick:stopPropagation="true">
            <div class="editor-heading">
                <div>
                    <span>@Text["WorkoutDetails_PhotoTitle"]</span>
                    <h2 id="today-photo-title">@_photoExercise.Name</h2>
                </div>
                <button class="quick-action-close editor-close"
                        type="button"
                        aria-label="@Text["Common_Close"]"
                        disabled="@(_photoBusy || IsOffline)"
                        @onclick="ClosePhoto">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>

            @if (_photoErrors.Count > 0)
            {
                <div class="editor-error" role="alert">@string.Join(" ", _photoErrors)</div>
            }

            @if (_photoBusy)
            {
                <div class="photo-state" role="status">
                    <span class="loading-spinner" aria-hidden="true"></span>
                    <span>@Text["WorkoutDetails_PhotoProcessing"]</span>
                </div>
            }
            else if (_photoDataUri is not null)
            {
                <img class="exercise-photo" src="@_photoDataUri" alt="@Text.Format("WorkoutDetails_PhotoAlt", _photoExercise.Name)" />
            }
            else
            {
                <div class="empty-photo">
                    <span class="material-symbols-rounded" aria-hidden="true">photo_camera</span>
                    <span>@Text["WorkoutDetails_NoPhoto"]</span>
                </div>
            }

            <p class="photo-hint">@Text["WorkoutDetails_PhotoHint"]</p>

            @if (IsOffline)
