@page "/today"
@attribute [Authorize]
@implements IDisposable
@using WorkoutPlanner.Api.Contracts
@inject IWorkoutApiClient WorkoutClient
@inject IWorkoutLifecycleApiClient LifecycleClient
@inject IExercisePhotoApiClient PhotoClient
@inject IProfileApiClient ProfileClient
@inject IMobilePhotoPicker PhotoPicker
@inject NavigationManager Navigation
@inject MobileBackNavigationService BackNavigation
@inject FreeWorkoutDraftStore FreeWorkoutDraftStore

<section class="today-page" aria-busy="@_isLoading">
    <header class="today-header">
        <div class="today-heading">
            <h1 class="today-title">Сегодня</h1>
            <p class="today-date">@DateTime.Today.ToString("dd MMMM, dddd")</p>
        </div>

        <div class="today-help"><HelpButton Topic="HelpContentCatalog.Today" /></div>

        <div class="today-header-actions">
            @if (!_isLoading && _workout is null && !_isFreeWorkout)
            {
                <button class="free-workout-button" type="button" disabled="@_isBusy" @onclick="CreateFreeWorkoutAsync">
                    <span class="material-symbols-rounded" aria-hidden="true">bolt</span>
                    <span>Свободная тренировка</span>
                </button>
            }
            else if (!_isLoading)
            {
                <div class="workout-progress-indicator" style="--workout-progress: @ProgressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%" aria-label="Свободная тренировка. Выполнено @ProgressPercent.ToString("0") процентов тренировки">
                    <div class="workout-progress-indicator__content">
                        <span class="material-symbols-rounded" aria-hidden="true">bolt</span>
                        <span>Свободная тренировка</span>
                    </div>
                </div>
            }
            @if (SupersetCandidates.Count >= 2)
            {
                <button class="secondary-button superset-button" type="button" aria-haspopup="dialog" disabled="@_isBusy" @onclick="OpenSupersetDialog">
                    <span class="material-symbols-rounded" aria-hidden="true">link</span>
                    Создать суперсет
                </button>
            }
        </div>

        @if (!_isFreeWorkout && _workout is not null)
        {
            <div class="workout-chip">
                <span class="material-symbols-rounded" aria-hidden="true">fitness_center</span>
                <span>@_workout.TrainingPlan.WorkoutName</span>
            </div>
        }
    </header>

    @if (_errors.Count > 0)
    {
        <div class="today-error" role="alert">@string.Join(" ", _errors)</div>
    }

    @if (_isLoading)
    {
        <div class="page-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Загружаем тренировку…</span>
        </div>
    }
    else if (_workout is null && !_isFreeWorkout)
    {
        <div class="no-workout-container">
            <div class="no-workout-copy">
                <h2>На сегодня запланированной тренировки нет</h2>
                @if (_errors.Count > 0)
                {
                    <div class="empty-actions">
                        <button class="secondary-button" type="button" @onclick="LoadAsync">Повторить</button>
                    </div>
                }
            </div>

            <div class="no-workout-visual" aria-hidden="true">
                <span class="material-symbols-rounded">event_busy</span>
            </div>
        </div>
    }
    else
    {
        @if (_exercises.Count == 0)
        {
            <div class="page-state">
                @(_isFreeWorkout
                    ? "Добавьте первое упражнение."
                    : "В назначенном плане пока нет упражнений.")
            </div>
        }

        <div class="exercise-list">
            @foreach (var group in ExerciseGroups)
            {
                @if (group.IsSuperset)
                {
                    <article class="exercise-card superset-exercise-card edit-hold-target"
                             tabindex="0"
                             aria-label="Суперсет @string.Join(" и ", group.Exercises.Select(x => x.Name)). Удерживайте карточку, чтобы открыть меню суперсета."
                             @onpointerdown="() => BeginSupersetHold(group)"
                             @onpointerup="CancelSupersetHold"
                             @onpointercancel="CancelSupersetHold"
                             @onpointerleave="CancelSupersetHold"
                             @oncontextmenu="() => ShowSupersetActions(group)"
                             @oncontextmenu:preventDefault="true"
                             @onkeydown="eventArgs => HandleSupersetKeyDown(eventArgs, group)">
                        <header class="superset-header">
                            <div class="superset-label"><span class="material-symbols-rounded" aria-hidden="true">link</span> Суперсет</div>
                            <div class="superset-names" aria-label="@string.Join(" / ", group.Exercises.Select(x => x.DisplayName))">
                                @for (var exerciseIndex = 0; exerciseIndex < group.Exercises.Count; exerciseIndex++)
                                {
                                    var exercise = group.Exercises[exerciseIndex];
                                    if (exerciseIndex > 0)
                                    {
                                        <span class="superset-name-separator" aria-hidden="true">/</span>
                                    }
                                    <span class="superset-name @(exerciseIndex == 0 ? "superset-tone-a" : "superset-tone-b")">@exercise.DisplayName</span>
                                }
                            </div>
                        </header>

                        <div class="superset-card-body">
                            <div class="superset-rounds">
                                @foreach (var roundNumber in GetSupersetRoundNumbers(group))
                                {
                                    <section class="superset-round" aria-label="Круг @roundNumber">
                                        @for (var exerciseIndex = 0; exerciseIndex < group.Exercises.Count; exerciseIndex++)
                                        {
                                            var exercise = group.Exercises[exerciseIndex];
                                            var set = exercise.Sets.FirstOrDefault(candidate => candidate.SetNumber == roundNumber);
                                            if (set is null)
                                                continue;

                                            <fieldset class="set-row superset-set-row @(exerciseIndex == 0 ? "superset-tone-a" : "superset-tone-b")" aria-label="@exercise.Name, подход @set.SetNumber" @onpointerdown:stopPropagation="true">
                                                <legend class="visually-hidden">@exercise.Name, подход @set.SetNumber</legend>

                                                <button class="set-number @(set.IsWarmup ? "warmup" : "working")"
                                                        type="button"
                                                        title="@(set.IsWarmup ? "Разминочный подход. Нажмите, чтобы сделать рабочим" : "Рабочий подход. Нажмите, чтобы сделать разминочным")"
                                                        aria-label="@(set.IsWarmup ? $"{exercise.Name}, подход {set.SetNumber}: разминочный. Сделать рабочим" : $"{exercise.Name}, подход {set.SetNumber}: рабочий. Сделать разминочным")"
                                                        aria-pressed="@set.IsWarmup"
                                                        @onclick="() => ToggleSetKind(set)">@set.SetNumber</button>

                                                <label class="set-value-control">
                                                    <span>кг</span>
                                                    <input class="set-input" type="number" min="0" max="2000" step="0.5" @bind="set.Weight" />
                                                </label>

                                                <label class="set-value-control">
                                                    <span>повт.</span>
                                                    <input class="set-input" type="number" min="1" max="1000" @bind="set.Repetitions" />
                                                </label>

                                                <label class="complete-control" title="Отметить подход выполненным">
                                                    <input type="checkbox" checked="@set.Completed" @onchange="args => SetSupersetCompletedAsync(group, set, args)" />
                                                    <svg class="complete-checkmark" viewBox="0 0 24 24" aria-hidden="true">
                                                        <path d="M6.5 12.5 10.2 16 17.8 8.4" />
                                                    </svg>
                                                    <span class="visually-hidden">@exercise.Name, подход @set.SetNumber выполнен</span>
                                                </label>
                                            </fieldset>
                                        }
                                    </section>

                                    @if (HasFollowingSupersetRound(group, roundNumber))
                                    {
                                         <button class="rest-timer-box superset-rest-timer" type="button" @onpointerdown:stopPropagation="true" @onclick="() => OpenRestTimer(group.Exercises[0].Id, roundNumber, RestTimerKind.BetweenSets)">
                                            <span class="material-symbols-rounded" aria-hidden="true">timer</span>
                                            <span>
                                                <small>Отдых после пары подходов</small>
                                                <strong>@GetRestTimerLabel(group.Exercises[0].Id, roundNumber, RestTimerKind.BetweenSets)</strong>
                                            </span>
                                            <span class="material-symbols-rounded rest-timer-edit" aria-hidden="true">edit</span>
                                        </button>
                                    }
                                }
                            </div>

                        </div>

                        <footer class="exercise-footer superset-footer">
                            <label class="status-control">
                                <span>Оценка суперсета</span>
                                <SystemChoiceField class="status-select"
                                                   Title="Оценка суперсета"
                                                   Options="RatingOptions"
                                                   Value="@GetSupersetStatus(group)"
                                                   ValueChanged="value => SetSupersetStatus(group, value)"
                                                   AriaLabel="Выбрать оценку суперсета" />
                            </label>
                            @if (HasFollowingGroup(group))
                            {
                                <button class="rest-timer-box rest-timer-box--exercise" type="button" @onpointerdown:stopPropagation="true" @onclick="() => OpenRestTimer(group.Exercises[0].Id, 0, RestTimerKind.BetweenExercises)">
                                    <span class="material-symbols-rounded" aria-hidden="true">timer</span>
                                    <span>
                                        <small>Отдых между упражнениями</small>
                                        <strong>@GetRestTimerLabel(group.Exercises[0].Id, 0, RestTimerKind.BetweenExercises)</strong>
                                    </span>
                                    <span class="material-symbols-rounded rest-timer-edit" aria-hidden="true">edit</span>
                                </button>
                            }
                        </footer>
                    </article>
                }
                else
                {
                @foreach (var exercise in group.Exercises)
                {
                <article class="exercise-card">
                    <header class="exercise-header edit-hold-target"
                            tabindex="0"
                            aria-label="@($"Упражнение {exercise.Name}. Удерживайте заголовок, чтобы открыть меню тренировки.")"
                            @onclick="() => HandleExerciseClick(exercise.Id)"
                            @onpointerdown="() => BeginExerciseHold(exercise.Id)"
                            @onpointerup="CancelExerciseHold"
                            @onpointercancel="CancelExerciseHold"
                            @onpointerleave="CancelExerciseHold"
                            @oncontextmenu="() => ShowEditWorkoutAction(exercise.Id)"
                            @oncontextmenu:preventDefault="true"
                            @onkeydown="eventArgs => HandleExerciseKeyDown(eventArgs, exercise.Id)">
                        <div class="exercise-heading-copy">
                            <h2>@exercise.DisplayName</h2>
                            @if (exercise.IsConfigured)
                            {
                            <div class="set-kind-summary" aria-label="Типы подходов">
                                @if (exercise.Sets.Any(x => x.IsWarmup))
                                {
                                    <span class="set-kind-label warmup">
                                        Разминочные: @exercise.Sets.Count(x => x.IsWarmup)
                                    </span>
                                }
                                @if (exercise.Sets.Any(x => !x.IsWarmup))
                                {
                                    <span class="set-kind-label working">
                                        Рабочие: @exercise.Sets.Count(x => !x.IsWarmup)
                                    </span>
                                }
                            </div>
                            }
                        </div>
                    </header>

                    @if (!exercise.IsConfigured)
                    {
                        <div class="free-exercise-placeholder edit-hold-target"
                             tabindex="0"
                             role="button"
                             aria-label="Настроить новое упражнение. Нажмите, чтобы открыть меню тренировки."
                             @onclick="() => HandleExerciseClick(exercise.Id)"
                             @onpointerdown="() => BeginExerciseHold(exercise.Id)"
                             @onpointerup="CancelExerciseHold"
                             @onpointercancel="CancelExerciseHold"
                             @onpointerleave="CancelExerciseHold"
                             @oncontextmenu="() => ShowEditWorkoutAction(exercise.Id)"
                             @oncontextmenu:preventDefault="true"
                             @onkeydown="eventArgs => HandleExerciseKeyDown(eventArgs, exercise.Id)">
                             <span>Нажмите на карточку и выберите «Изменить тренировку»</span>
                        </div>
                    }
                    else
                    {
                    <div class="exercise-card-body">
                        <div class="sets-block">
                            @foreach (var set in exercise.Sets)
                            {
                                <fieldset class="set-row" aria-label="Подход @set.SetNumber">
                                    <legend class="visually-hidden">Подход @set.SetNumber</legend>

                                    <button class="set-number @(set.IsWarmup ? "warmup" : "working")"
                                            type="button"
                                            title="@(set.IsWarmup ? "Разминочный подход. Нажмите, чтобы сделать рабочим" : "Рабочий подход. Нажмите, чтобы сделать разминочным")"
                                            aria-label="@(set.IsWarmup ? $"Подход {set.SetNumber}: разминочный. Сделать рабочим" : $"Подход {set.SetNumber}: рабочий. Сделать разминочным")"
                                            aria-pressed="@set.IsWarmup"
                                            @onclick="() => ToggleSetKind(set)">@set.SetNumber</button>

                                    <label class="set-value-control">
                                        <span>кг</span>
                                        <input class="set-input" type="number" min="0" max="2000" step="0.5" @bind="set.Weight" />
                                    </label>

                                    <label class="set-value-control">
                                        <span>повт.</span>
                                        <input class="set-input" type="number" min="1" max="1000" @bind="set.Repetitions" />
                                    </label>

                                    <label class="complete-control" title="Отметить подход выполненным">
                                        <input type="checkbox" checked="@set.Completed" @onchange="args => SetCompletedAsync(exercise, set, args)" />
                                        <svg class="complete-checkmark" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M6.5 12.5 10.2 16 17.8 8.4" />
                                        </svg>
                                        <span class="visually-hidden">Выполнен</span>
                                    </label>
                                </fieldset>
                                @if (HasFollowingSet(exercise, set))
                                {
                                    <button class="rest-timer-box" type="button" @onclick="() => OpenRestTimer(exercise.Id, set.SetNumber, RestTimerKind.BetweenSets)">
                                        <span class="material-symbols-rounded" aria-hidden="true">timer</span>
                                        <span>
                                            <small>Отдых между подходами</small>
                                            <strong>@GetRestTimerLabel(exercise.Id, set.SetNumber, RestTimerKind.BetweenSets)</strong>
                                        </span>
                                        <span class="material-symbols-rounded rest-timer-edit" aria-hidden="true">edit</span>
                                    </button>
                                }
                            }
                        </div>

                    </div>

                    <footer class="exercise-footer">
                        <label class="status-control">
                            <span>Оценка упражнения</span>
                            <SystemChoiceField class="status-select"
                                               Title="Оценка упражнения"
                                               Options="RatingOptions"
                                               @bind-Value="exercise.Status"
                                               AriaLabel="Выбрать оценку упражнения" />
                        </label>
                        @if (HasFollowingExercise(exercise))
                        {
                            <button class="rest-timer-box rest-timer-box--exercise" type="button" @onclick="() => OpenRestTimer(exercise.Id, 0, RestTimerKind.BetweenExercises)">
                                <span class="material-symbols-rounded" aria-hidden="true">timer</span>
                                <span>
                                    <small>Отдых между упражнениями</small>
                                    <strong>@GetRestTimerLabel(exercise.Id, 0, RestTimerKind.BetweenExercises)</strong>
                                </span>
                                <span class="material-symbols-rounded rest-timer-edit" aria-hidden="true">edit</span>
                            </button>
                        }
                    </footer>
                    }

                </article>
                }
                }
            }
        </div>

        @if (_isFreeWorkout)
        {
            <div class="free-exercise-action">
                <button class="compact-create-button add-free-exercise-button"
                        type="button"
                        disabled="@_isBusy"
                        @onclick="BeginFreeExerciseCreateAsync">
                    <span class="material-symbols-rounded" aria-hidden="true">add</span>
                    Добавить упражнение
                </button>
            </div>
        }

        @if (HasFinishableExercise)
        {
            <button class="finish-button finish-button--hold @(_isFinishFillActive ? "is-filling" : null)"
                    type="button"
                    disabled="@_isBusy"
                    aria-label="@(_isBusy ? "Сохраняем тренировку" : "Удерживайте, чтобы завершить тренировку")"
                    @onpointerdown="BeginFinishHoldAsync"
                    @onpointerup="CancelFinishHold"
                    @onpointercancel="CancelFinishHold"
                    @onpointerleave="CancelFinishHold"
                    @onkeydown="HandleFinishKeyDown"
                    @onkeyup="HandleFinishKeyUp"
                    @oncontextmenu:preventDefault="true">
                <span class="finish-button-label">@(_isBusy ? "Сохраняем тренировку…" : "Завершить тренировку")</span>
            </button>
        }
    }
</section>

@if (_selectedRestTimer is not null)
{
    <div class="modal-overlay" @onclick="CloseRestTimer">
        <section class="modal-window rest-timer-dialog" role="dialog" aria-modal="true" aria-labelledby="rest-timer-title" @onclick:stopPropagation="true">
            <div class="editor-heading">
                <div>
                    <span>Таймер отдыха</span>
                    <h2 id="rest-timer-title">@(_selectedRestTimer.Kind == RestTimerKind.BetweenSets ? "Между подходами" : "Между упражнениями")</h2>
                </div>
                <button class="quick-action-close editor-close" type="button" aria-label="Закрыть" @onclick="CloseRestTimer">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>
            <label class="editor-field">
                <span>Время отдыха, сек.</span>
                <input class="editor-control" type="number" min="5" max="3600" @bind="_selectedRestTimer.DurationSeconds" />
            </label>
            <p class="rest-timer-dialog-hint">Это значение изменит только данный таймер. Общие значения настраиваются в профиле.</p>
            <div class="editor-actions rest-timer-actions">
                <button class="edit-workout-button" type="button" disabled="@_selectedRestTimer.IsQueued" @onclick="StartSelectedRestTimer">@(_selectedRestTimer.IsRunning ? "Перезапустить" : _selectedRestTimer.IsQueued ? "В очереди" : "Запустить")</button>
                @if (_selectedRestTimer.IsRunning)
                {
                    <button class="secondary-button" type="button" @onclick="PauseSelectedRestTimer">Пауза</button>
                }
                <button class="secondary-button" type="button" @onclick="CloseRestTimer">Готово</button>
            </div>
        </section>
    </div>
}

@if (_photoExercise is not null)
{
    <div class="modal-overlay" @onclick="ClosePhoto">
        <section class="modal-window photo-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="today-photo-title"
                 @onclick:stopPropagation="true">
            <div class="editor-heading">
                <div>
                    <span>Фотография упражнения</span>
                    <h2 id="today-photo-title">@_photoExercise.Name</h2>
                </div>
                <button class="quick-action-close editor-close"
                        type="button"
                        aria-label="Закрыть"
                        disabled="@_photoBusy"
                        @onclick="ClosePhoto">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>

            @if (_photoErrors.Count > 0)
            {
                <div class="editor-error" role="alert">@string.Join(" ", _photoErrors)</div>
            }

            @if (_photoBusy)
            {
                <div class="photo-state" role="status">
                    <span class="loading-spinner" aria-hidden="true"></span>
                    <span>Обрабатываем фотографию…</span>
                </div>
            }
            else if (_photoDataUri is not null)
            {
                <img class="exercise-photo" src="@_photoDataUri" alt="Фото упражнения @_photoExercise.Name" />
            }
            else
            {
                <div class="empty-photo">
                    <span class="material-symbols-rounded" aria-hidden="true">photo_camera</span>
                    <span>У этого упражнения пока нет фотографии.</span>
                </div>
            }

            <p class="photo-hint">JPG, PNG или WebP, не более 5 МБ.</p>

            <div class="photo-actions">
                <button class="primary-button" type="button" disabled="@_photoBusy" @onclick="() => PickPhotoAsync(MobilePhotoSource.Library)">
                    <span class="material-symbols-rounded" aria-hidden="true">photo_library</span>
                    Выбрать фото
                </button>
                <button class="secondary-button" type="button" disabled="@_photoBusy" @onclick="() => PickPhotoAsync(MobilePhotoSource.Camera)">
                    <span class="material-symbols-rounded" aria-hidden="true">photo_camera</span>
                    Сделать снимок
                </button>

                @if (_photoExercise.HasPhoto)
                {
                    @if (_confirmPhotoDelete)
                    {
                        <button class="secondary-button" type="button" disabled="@_photoBusy" @onclick="() => _confirmPhotoDelete = false">Отмена удаления</button>
                        <button class="danger-button" type="button" disabled="@_photoBusy" @onclick="DeletePhotoAsync">Удалить точно</button>
                    }
                    else
                    {
                        <button class="danger-button" type="button" disabled="@_photoBusy" @onclick="() => _confirmPhotoDelete = true">Удалить фото</button>
                    }
                }

            </div>
        </section>
    </div>
}

@if (EditActionExercise is { } editActionExercise && (_workout is not null || _isFreeWorkout))
{
    <div class="modal-overlay quick-action-overlay"
         tabindex="-1"
         @onkeydown="HandleEditActionKeyDown"
         @onclick="CloseEditWorkoutAction">
        <section class="modal-window edit-workout-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="edit-workout-action-title"
                 aria-describedby="edit-workout-action-description"
                 @onclick:stopPropagation="true">
            <button class="quick-action-close"
                    type="button"
                    autofocus
                    aria-label="Закрыть меню"
                    @onclick="CloseEditWorkoutAction">
                <span class="material-symbols-rounded" aria-hidden="true">close</span>
            </button>
            <span class="edit-workout-icon material-symbols-rounded" aria-hidden="true">edit</span>
            <h2 id="edit-workout-action-title">@editActionExercise.DisplayName</h2>
            <p id="edit-workout-action-description">
                Вес, повторения и типы подходов настраиваются в редакторе тренировки.
            </p>
            <div class="edit-workout-actions">
                @if (editActionExercise.IsConfigured)
                {
                    <button class="secondary-button photo-menu-button" type="button" @onclick="() => OpenPhotoFromExerciseMenuAsync(editActionExercise)">
                        <span class="material-symbols-rounded" aria-hidden="true">@(editActionExercise.HasPhoto ? "image" : "add_a_photo")</span>
                        <span>@(editActionExercise.HasPhoto ? "Открыть фото" : "Добавить фото")</span>
                    </button>
                }
                @if (_isFreeWorkout)
                {
                    <button class="edit-workout-button" type="button" disabled="@_isBusy" @onclick="BeginFreeExerciseEditAsync">
                        @(editActionExercise.IsConfigured ? "Изменить тренировку" : "Назначить тренировку")
                    </button>
                    <button class="remove-free-exercise-button" type="button" @onclick="RemoveFreeExercise">
                        Удалить карточку
                    </button>
                }
                else if (_workout is not null)
                {
                    <a class="edit-workout-button"
                       href="@($"/workouts/{_workout.TrainingPlan.Id}")">
                        Изменить тренировку
                    </a>
                }
            </div>
        </section>
    </div>
}

@if (_showFreeExerciseEditor && _freeEditorDraft is not null)
{
    <div class="modal-overlay" @onclick="CloseFreeExerciseEditor">
        <section class="modal-window free-exercise-editor"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="free-exercise-editor-title"
                 @onclick:stopPropagation="true">
            <div class="editor-heading">
                <div>
                    <span>Свободная тренировка</span>
                    <h2 id="free-exercise-editor-title">@(_isCreatingFreeExercise ? "Новое упражнение" : "Параметры упражнения")</h2>
                </div>
                <button class="quick-action-close editor-close"
                        type="button"
                        aria-label="Закрыть редактор"
                        @onclick="CloseFreeExerciseEditor">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </div>

            @if (_freeEditorErrors.Count > 0)
            {
                <div class="editor-error" role="alert">@string.Join(" ", _freeEditorErrors)</div>
            }

            <label class="editor-field">
                <span>Упражнение</span>
                <SystemChoiceField class="editor-control"
                                   Title="Выберите упражнение"
                                   Options="ExerciseDefinitionOptions"
                                   Value="@(_freeEditorDraft.ExerciseDefinitionId?.ToString() ?? string.Empty)"
                                   ValueChanged="SetFreeExerciseDefinition"
                                   Placeholder="Выберите упражнение"
                                   AriaLabel="Выбрать упражнение из библиотеки" />
