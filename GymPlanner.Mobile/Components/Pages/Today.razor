    private Task CompleteFreeWithoutTemplateAsync() =>
        SaveFreeWorkoutAsync(saveAsTemplate: false, templateName: null);

    private async Task CompleteFreeWithTemplateAsync()
    {
        _templateErrors.Clear();
        if (string.IsNullOrWhiteSpace(_templateName))
        {
            _templateErrors.Add("Введите название шаблона.");
            return;
        }

        await SaveFreeWorkoutAsync(
            saveAsTemplate: true,
            templateName: _templateName.Trim());
    }

    private async Task SaveFreeWorkoutAsync(
        bool saveAsTemplate,
        string? templateName)
    {
        if (_isBusy || !_isFreeWorkout)
            return;

        _isBusy = true;
        _errors.Clear();
        _templateErrors.Clear();
        try
        {
            var result = await LifecycleClient.CompleteFreeWorkoutAsync(
                new CompleteFreeWorkoutRequest(
                    saveAsTemplate,
                    templateName,
                    _exercises.Select(x => x.ToRequest()).ToArray()),
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _templateErrors.AddRange(result.Errors);
                return;
            }

            _showFreeTemplatePrompt = false;
            _showTemplateNamePrompt = false;
            BackNavigation.SetBackInterceptor(null);
            _completedHistory = result.Value!.History;
            _completionMessage = saveAsTemplate
                ? $"Тренировка сохранена в истории, а шаблон «{templateName}» добавлен вместе с графиками."
                : "Свободная тренировка сохранена только в истории — без календаря, шаблонов и графиков.";
            _isFreeWorkout = false;
            _exercises.Clear();
            FreeWorkoutDraftStore.Clear();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OpenSupersetDialog()
    {
        _supersetSelection.Clear();
        _showSupersetDialog = true;
    }

    private void CloseSupersetDialog()
    {
        if (_isBusy) return;
        _showSupersetDialog = false;
        _supersetSelection.Clear();
    }

    private void ToggleSupersetExercise(int id)
    {
        if (_exercises.FirstOrDefault(exercise => exercise.Id == id)?.SupersetGroupId is not null)
            return;

        if (!_supersetSelection.Remove(id) && _supersetSelection.Count < 2)
            _supersetSelection.Add(id);
    }

    private async Task CreateSupersetAsync()
    {
        if (_isBusy || _supersetSelection.Count != 2 ||
            _supersetSelection.Any(id => _exercises.FirstOrDefault(exercise => exercise.Id == id)?.SupersetGroupId is not null))
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            var groupId = (_exercises.Max(x => x.SupersetGroupId) ?? 0) + 1;
            if (_isFreeWorkout)
            {
                foreach (var exercise in _exercises.Where(x => _supersetSelection.Contains(x.Id)))
                    exercise.SupersetGroupId = groupId;

                _showSupersetDialog = false;
                _supersetSelection.Clear();
                PersistFreeWorkout();
                return;
            }

            foreach (var exercise in _exercises.Where(x => _supersetSelection.Contains(x.Id)))
            {
                exercise.SupersetGroupId = groupId;
                var result = await WorkoutClient.UpdateExerciseAsync(exercise.Id, exercise.ToRequest(), _disposeCts.Token);
                if (!result.Succeeded)
                {
                    _errors.AddRange(result.Errors);
                    return;
                }
                exercise.UpdateFrom(result.Value!);
            }

            _showSupersetDialog = false;
            _supersetSelection.Clear();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SeparateSupersetAsync(ExerciseGroup group)
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            if (_isFreeWorkout)
            {
                foreach (var exercise in group.Exercises)
                    exercise.SupersetGroupId = null;
            }
            else
            {
                foreach (var exercise in group.Exercises)
                {
                    exercise.SupersetGroupId = null;
                    var result = await WorkoutClient.UpdateExerciseAsync(exercise.Id, exercise.ToRequest(), _disposeCts.Token);
                    if (!result.Succeeded)
                    {
                        _errors.AddRange(result.Errors);
                        return;
                    }

                    exercise.UpdateFrom(result.Value!);
                }
            }

            CloseSupersetActions(force: true);
            if (_isFreeWorkout)
                PersistFreeWorkout();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteSupersetAsync(ExerciseGroup group)
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            if (!_isFreeWorkout)
            {
                foreach (var exercise in group.Exercises)
                {
                    var result = await WorkoutClient.DeleteExerciseAsync(exercise.Id, _disposeCts.Token);
                    if (!result.Succeeded)
                    {
                        _errors.AddRange(result.Errors);
                        return;
                    }
                }
            }

            var ids = group.Exercises.Select(exercise => exercise.Id).ToHashSet();
            _exercises.RemoveAll(exercise => ids.Contains(exercise.Id));
            if (_isFreeWorkout)
                PersistFreeWorkout();
            CloseSupersetActions(force: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private bool Validate(ExerciseDraft exercise)
    {
        if (!exercise.IsConfigured)
        {
            _errors.Add("Настройте все добавленные упражнения.");
            return false;
        }

        if (exercise.Sets.Any(x =>
                !double.IsFinite(x.Weight) ||
                x.Weight is < 0 or > 2000 ||
                x.Repetitions is < 1 or > 1000))
        {
            _errors.Add($"Проверьте вес и повторения: {exercise.Name}.");
            return false;
        }

        return true;
    }

    private async Task CloseCompletion()
    {
        _completedHistory = null;
        _completionMessage = string.Empty;
        await LoadAsync();
    }

    public void Dispose()
    {
        PersistFreeWorkout();
        CancelExerciseHold();
        CancelFinishHold();
        CancelSupersetHold();
        BackNavigation.SetBackInterceptor(null);
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private void PersistFreeWorkout()
    {
        if (!_isFreeWorkout)
            return;

        if (_exercises.Count == 0)
        {
            _isFreeWorkout = false;
            FreeWorkoutDraftStore.Clear();
            return;
        }

        FreeWorkoutDraftStore.Save(new FreeWorkoutDraft(
            true,
            _exercises.Select(exercise => exercise.ToFree()).ToList()));
    }

    private enum RestTimerKind { BetweenSets, BetweenExercises }

    private sealed class RestTimerState
    {
        public RestTimerKind Kind { get; init; }
        public int DurationSeconds { get; set; }
        public int RemainingSeconds { get; set; }
        public bool IsRunning { get; set; }
        public bool IsQueued { get; set; }
        public bool IsCompleted { get; set; }
        public DateTimeOffset? EndsAtUtc { get; set; }
    }

    private sealed class ExerciseDraft
    {
        public int Id { get; init; }
        public string Name { get; set; } = string.Empty;
        public int TrainingPlanId { get; init; }
        public int? ExerciseDefinitionId { get; set; }
        public string Status { get; set; } = "NotCompleted";
        public bool HasPhoto { get; set; }
        public int? SupersetGroupId { get; set; }
        public List<SetDraft> Sets { get; } = [];
        public bool IsConfigured => Id >= 0 ||
            (ExerciseDefinitionId is not null &&
             !string.IsNullOrWhiteSpace(Name) &&
             Sets.Count > 0);
        public string DisplayName => IsConfigured ? Name : "Новое упражнение";

        public static ExerciseDraft CreateFree(int id)
        {
            var draft = new ExerciseDraft { Id = id };
            draft.ResizeSets(3);
            return draft;
        }

        public static ExerciseDraft From(ExerciseApiResponse source)
        {
            var draft = new ExerciseDraft
            {
                Id = source.Id,
                Name = source.Name,
                TrainingPlanId = source.TrainingPlanId,
                ExerciseDefinitionId = source.ExerciseDefinitionId,
                Status = source.Status,
                HasPhoto = source.HasPhoto,
                SupersetGroupId = source.SupersetGroupId
            };
            draft.Sets.AddRange(source.Sets
                .OrderBy(x => x.SetNumber)
                .Select(SetDraft.From));
            return draft;
        }

        public static ExerciseDraft FromFree(FreeWorkoutExerciseDraft source)
        {
            var draft = new ExerciseDraft
            {
                Id = source.Id,
                Name = source.Name,
                ExerciseDefinitionId = source.ExerciseDefinitionId,
                Status = source.Status,
                SupersetGroupId = source.SupersetGroupId
            };
            draft.Sets.AddRange(source.Sets.Select(SetDraft.FromFree));
            return draft;
        }

        public FreeWorkoutExerciseDraft ToFree() => new(
            Id,
            Name,
            ExerciseDefinitionId,
            Status,
            SupersetGroupId,
            Sets.Select(set => set.ToFree()).ToList());

        public SaveExerciseRequest ToRequest() => new(
            Name,
            Sets.Count,
            Status,
            ExerciseDefinitionId,
            Sets.Select(x => new SaveExerciseSetRequest(
                x.SetNumber,
                x.Repetitions,
                x.Weight,
                x.Completed,
                x.IsWarmup)).ToArray(),
            SupersetGroupId);

        public ExerciseDraft Clone()
        {
            var clone = new ExerciseDraft
            {
                Id = Id,
                Name = Name,
                TrainingPlanId = TrainingPlanId,
                ExerciseDefinitionId = ExerciseDefinitionId,
                Status = Status,
                HasPhoto = HasPhoto,
                SupersetGroupId = SupersetGroupId
            };
            clone.Sets.AddRange(Sets.Select(x => x.Clone()));
            return clone;
        }

        public void ResizeSets(int count)
        {
            while (Sets.Count < count)
            {
                Sets.Add(new SetDraft
                {
                    SetNumber = Sets.Count + 1,
                    Repetitions = 8
                });
            }

            while (Sets.Count > count)
                Sets.RemoveAt(Sets.Count - 1);

            for (var index = 0; index < Sets.Count; index++)
                Sets[index].SetNumber = index + 1;
        }

        public void UpdateFrom(ExerciseApiResponse source)
        {
            Status = source.Status;
            HasPhoto = source.HasPhoto;
            SupersetGroupId = source.SupersetGroupId;
            Sets.Clear();
            Sets.AddRange(source.Sets
                .OrderBy(x => x.SetNumber)
                .Select(SetDraft.From));
        }
    }

    private sealed record ExerciseGroup(bool IsSuperset, IReadOnlyList<ExerciseDraft> Exercises);

