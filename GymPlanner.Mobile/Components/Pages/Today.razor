    private async Task LoadAsync()
    {
        _isLoading = true;
        CloseEditWorkoutAction();
        _errors.Clear();
        _photoThumbnails.Clear();
        // Длительности таймеров берутся из загруженного шаблона заново.
        _selectedRestTimer = null;
        _restTimers.Clear();
        _queuedRestTimers.Clear();
        try
        {
            // Черновик спрашивается у сервера, а не читается из памяти телефона:
            // тренировку мог продолжать кто угодно из двух устройств, и правда
            // о ней теперь одна — серверная.
            var draftResult = await LifecycleClient.GetFreeWorkoutDraftAsync(
                _disposeCts.Token);
            if (draftResult.Succeeded && draftResult.Value is { } draft)
            {
                var draftPlan = await WorkoutClient.GetPlanAsync(
                    draft.TrainingPlanId,
                    _disposeCts.Token);
                if (draftPlan.Succeeded && draftPlan.Value is { } plan)
                {
                    _isFreeWorkout = true;
                    _freeDraftPlanId = draft.TrainingPlanId;
                    _workout = null;
                    _restBetweenExercisesSeconds = plan.RestBetweenExercisesSeconds;
                    _exercises.Clear();
                    _exercises.AddRange(plan.Exercises.Select(ExerciseDraft.From));
                    await RestoreSessionAsync(draft.TrainingPlanId, null);
                    return;
                }
            }

            _isFreeWorkout = false;
            _freeDraftPlanId = null;

            var result = await LifecycleClient.StartTodayWorkoutAsync(
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                _workout = null;
                _exercises.Clear();
                return;
            }

            _workout = result.Value;
            _exercises.Clear();
            if (_workout is not null)
            {
                _restBetweenExercisesSeconds = _workout.TrainingPlan.RestBetweenExercisesSeconds;
                _exercises.AddRange(_workout.TrainingPlan.Exercises
                    .Select(ExerciseDraft.From));
                await RestoreSessionAsync(_workout.TrainingPlan.Id, _workout.Day.Id);
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CompleteAsync()
    {
        if (_isBusy || !HasFinishableExercise)
            return;

        _errors.Clear();
        if (_exercises.Any(x => !Validate(x)))
            return;

        if (_isFreeWorkout)
        {
            _showFreeTemplatePrompt = true;
            SetBackInterceptor(RequestCloseFreeTemplatePrompt);
            return;
        }

        if (_workout is null)
            return;

        _isBusy = true;
        try
        {
            // Итоги и отметка о завершении уходят одним запросом: сервер сохранит
            // их вместе или не сохранит вовсе. Без связи запрос ждёт в очереди.
            var request = new CompleteScheduledWorkoutRequest(
                Clock.GetLocalNow().DateTime,
                _exercises
                    .Select(exercise => new CompletedExerciseRequest(
                        exercise.Id,
                        exercise.Status,
                        exercise.ToRequest().Sets!))
                    .ToArray());
            var completionResult = await LifecycleClient.CompleteScheduledWorkoutAsync(
                _workout.Day.Id,
                request,
                _disposeCts.Token);
            if (!completionResult.Succeeded)
            {
                _errors.AddRange(completionResult.Errors);
                return;
            }

            _completedHistory = completionResult.Value;
            _completionMessage = OfflineIds.IsLocal(_completedHistory!.Id)
                ? Text["Today_SavedOffline"]
                : Text["Today_ResultsSaved"];
            OfferNextSessionChoices();
            await ForgetSessionAsync();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CreateFreeWorkoutAsync()
    {
        if (_isBusy || _isFreeWorkout)
            return;

        _isBusy = true;
