        _photoBusy = true;
        _photoErrors.Clear();
        try
        {
            if (_photoExercise.Id > 0)
            {
                var result = await PhotoClient.DeleteAsync(
                    _photoExercise.Id,
                    _disposeCts.Token);
                if (!result.Succeeded)
