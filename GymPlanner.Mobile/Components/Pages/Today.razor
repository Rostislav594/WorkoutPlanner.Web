                    <button class="edit-workout-button" type="button" disabled="@_isBusy" @onclick="() => SeparateSupersetAsync(supersetActionGroup)">Разъединить супер-сет</button>
                    <button class="remove-free-exercise-button" type="button" disabled="@_isBusy" @onclick="RequestSupersetDelete">Удалить супер-сет</button>
                </div>
            }
        </section>
    </div>
}

@code {
    private static readonly IReadOnlyList<SystemChoiceOption> RatingOptions =
    [
        new("NotCompleted", "Не оценено"),
        new("Easy", "Легко"),
        new("Medium", "Средне"),
        new("Hard", "Тяжело"),
        new("Max", "Предел")
    ];

    private readonly List<ExerciseDraft> _exercises = [];
    private readonly List<ExerciseDefinitionApiResponse> _exerciseDefinitions = [];
    private readonly List<string> _errors = [];
    private readonly List<string> _freeEditorErrors = [];
    private readonly List<string> _templateErrors = [];
    private readonly List<string> _photoErrors = [];
    private readonly Dictionary<int, string> _photoThumbnails = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private TodayWorkoutApiResponse? _workout;
    private WorkoutHistoryApiResponse? _completedHistory;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _isFreeWorkout;
    private bool _showFreeExerciseEditor;
    private bool _showFreeTemplatePrompt;
    private bool _showTemplateNamePrompt;
    private bool _showSupersetDialog;
    private bool _photoBusy;
    private bool _confirmPhotoDelete;
    private bool _isCreatingFreeExercise;
    private bool _isFinishHoldActive;
    private bool _isFinishFillActive;
    private int _nextFreeExerciseId = -1;
    private int? _editActionExerciseId;
    private int? _freeEditorExerciseId;
    private ExerciseGroup? _supersetActionGroup;
    private CancellationTokenSource? _supersetHoldCts;
    private bool _supersetDeleteConfirmation;
    private ExerciseDraft? _freeEditorDraft;
    private ExerciseDraft? _photoExercise;
    private string _templateName = string.Empty;
    private string _completionMessage = string.Empty;
    private string? _photoDataUri;
    private CancellationTokenSource? _exerciseHoldCts;
    private CancellationTokenSource? _finishHoldCts;
    private readonly HashSet<int> _supersetSelection = [];
    private readonly Dictionary<string, RestTimerState> _restTimers = [];
    private readonly List<RestTimerState> _queuedRestTimers = [];
    private RestTimerState? _selectedRestTimer;
    private int _restBetweenSetsSeconds = 90;
    private int _restBetweenExercisesSeconds = 120;

    private IReadOnlyList<SystemChoiceOption> ExerciseDefinitionOptions =>
        _exerciseDefinitions
            .Select(definition => new SystemChoiceOption(definition.Id.ToString(), definition.Name))
            .ToList();

    private IReadOnlyList<ExerciseGroup> ExerciseGroups => _exercises
        .GroupBy(x => x.SupersetGroupId is { } groupId ? $"s:{groupId}" : $"e:{x.Id}")
        .Select(x => new ExerciseGroup(x.First().SupersetGroupId is not null && x.Count() > 1, x.ToList()))
        .ToList();

    private IReadOnlyList<ExerciseDraft> SupersetCandidates =>
        _exercises.Where(exercise => exercise.SupersetGroupId is null).ToList();

    private int TotalSets => _exercises
        .Where(x => x.IsConfigured)
        .Sum(x => x.Sets.Count);
    private int CompletedSets => _exercises
        .Where(x => x.IsConfigured)
        .Sum(x => x.Sets.Count(set => set.Completed));
    private double ProgressPercent => TotalSets == 0
        ? 0
        : CompletedSets * 100d / TotalSets;
    private ExerciseDraft? EditActionExercise => _editActionExerciseId is { } id
        ? _exercises.FirstOrDefault(x => x.Id == id)
        : null;
    private bool HasFinishableExercise => _exercises.Any(exercise => exercise.IsConfigured);

    protected override async Task OnInitializedAsync()
    {
        _ = RunRestTimerLoopAsync();
        await LoadAsync();
    }

    private async Task BeginExerciseHold(int exerciseId)
    {
        CancelExerciseHold();
        _exerciseHoldCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);

        try
        {
            await Task.Delay(550, _exerciseHoldCts.Token);
            ShowEditWorkoutAction(exerciseId);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelExerciseHold()
    {
        _exerciseHoldCts?.Cancel();
        _exerciseHoldCts?.Dispose();
        _exerciseHoldCts = null;
    }

    private void HandleExerciseClick(int exerciseId)
    {
        if (_isFreeWorkout)
            ShowEditWorkoutAction(exerciseId);
    }

    private async Task BeginSupersetHold(ExerciseGroup group)
    {
        CancelSupersetHold();
        _supersetHoldCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);

        try
        {
            await Task.Delay(550, _supersetHoldCts.Token);
            ShowSupersetActions(group);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelSupersetHold()
    {
        _supersetHoldCts?.Cancel();
        _supersetHoldCts?.Dispose();
        _supersetHoldCts = null;
    }

    private void ShowSupersetActions(ExerciseGroup group)
    {
        CancelSupersetHold();
        _supersetActionGroup = group;
        _supersetDeleteConfirmation = false;
        BackNavigation.SetBackInterceptor(RequestCloseSupersetActions);
    }

    private void CloseSupersetActions(bool force = false)
    {
        if (_isBusy && !force)
            return;

        CancelSupersetHold();
        _supersetActionGroup = null;
        _supersetDeleteConfirmation = false;
        BackNavigation.SetBackInterceptor(null);
    }

    private void RequestCloseSupersetActions() =>
        _ = InvokeAsync(() => CloseSupersetActions());

    private void HandleSupersetKeyDown(KeyboardEventArgs eventArgs, ExerciseGroup group)
    {
        if (eventArgs.Key is "Enter" or " ")
            ShowSupersetActions(group);
        else if (eventArgs.Key == "Escape")
            CloseSupersetActions(force: true);
    }

    private void RequestSupersetDelete() => _supersetDeleteConfirmation = true;

    private void CancelSupersetDelete() => _supersetDeleteConfirmation = false;

    private void ShowEditWorkoutAction(int exerciseId)
    {
        CancelExerciseHold();
        if (_exercises.Any(x => x.Id == exerciseId))
        {
            _editActionExerciseId = exerciseId;
            BackNavigation.SetBackInterceptor(RequestCloseEditWorkoutAction);
        }
    }

    private void CloseEditWorkoutAction()
    {
        CancelExerciseHold();
        _editActionExerciseId = null;
        BackNavigation.SetBackInterceptor(null);
    }

    private void RequestCloseEditWorkoutAction() =>
        _ = InvokeAsync(CloseEditWorkoutAction);

    private async Task OpenPhotoFromExerciseMenuAsync(ExerciseDraft exercise)
    {
        CloseEditWorkoutAction();
        await OpenPhotoAsync(exercise);
    }

    private async Task BeginFinishHoldAsync()
    {
        if (_isBusy || !HasFinishableExercise || _isFinishHoldActive)
            return;

        CancelFinishHold();
        var holdCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        _finishHoldCts = holdCts;
        _isFinishHoldActive = true;

        try
        {
            await Task.Delay(100, holdCts.Token);
            _isFinishFillActive = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1900, holdCts.Token);
            if (!holdCts.IsCancellationRequested)
                await CompleteAsync();
        }
        catch (OperationCanceledException) when (holdCts.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_finishHoldCts, holdCts))
            {
                _finishHoldCts = null;
                _isFinishHoldActive = false;
                _isFinishFillActive = false;
                holdCts.Dispose();
            }
        }
    }

    private void CancelFinishHold()
    {
        _finishHoldCts?.Cancel();
        _finishHoldCts?.Dispose();
        _finishHoldCts = null;
        _isFinishHoldActive = false;
        _isFinishFillActive = false;
    }

    private Task HandleFinishKeyDown(KeyboardEventArgs args) =>
        args.Key is "Enter" or " " ? BeginFinishHoldAsync() : Task.CompletedTask;

    private void HandleFinishKeyUp(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
            CancelFinishHold();
    }

    private async Task OpenPhotoFromSupersetMenuAsync(ExerciseDraft exercise)
    {
        CloseSupersetActions(force: true);
        await OpenPhotoAsync(exercise);
    }

    private async Task BeginFreeExerciseEditAsync()
    {
        if (_isBusy || !_isFreeWorkout || EditActionExercise is not { } exercise)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            if (!await EnsureExerciseDefinitionsAsync())
                return;

            _freeEditorExerciseId = exercise.Id;
            _freeEditorDraft = exercise.Clone();
            _freeEditorErrors.Clear();
            _isCreatingFreeExercise = false;
            CloseEditWorkoutAction();
            _showFreeExerciseEditor = true;
            BackNavigation.SetBackInterceptor(RequestCloseFreeExerciseEditor);
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task BeginFreeExerciseCreateAsync()
    {
        if (_isBusy || !_isFreeWorkout)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            if (!await EnsureExerciseDefinitionsAsync())
                return;

            OpenNewFreeExerciseEditor();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OpenNewFreeExerciseEditor()
    {
        _freeEditorExerciseId = null;
        _freeEditorDraft = ExerciseDraft.CreateFree(_nextFreeExerciseId);
        _freeEditorErrors.Clear();
        _isCreatingFreeExercise = true;
        _showFreeExerciseEditor = true;
        BackNavigation.SetBackInterceptor(RequestCloseFreeExerciseEditor);
    }

    private void CloseFreeExerciseEditor()
    {
        var discardEmptyWorkout = _isCreatingFreeExercise && _exercises.Count == 0;
        _showFreeExerciseEditor = false;
        _freeEditorExerciseId = null;
        _freeEditorDraft = null;
        _freeEditorErrors.Clear();
        _isCreatingFreeExercise = false;
        BackNavigation.SetBackInterceptor(null);

        if (discardEmptyWorkout)
        {
            _isFreeWorkout = false;
            FreeWorkoutDraftStore.Clear();
        }
    }

    private void RequestCloseFreeExerciseEditor() =>
        _ = InvokeAsync(CloseFreeExerciseEditor);

    private void ApplyFreeExerciseDefinition()
    {
        if (_freeEditorDraft?.ExerciseDefinitionId is not { } id)
            return;

        var definition = _exerciseDefinitions.FirstOrDefault(x => x.Id == id);
        if (definition is not null)
            _freeEditorDraft.Name = definition.Name;
    }

    private void SetFreeExerciseDefinition(string value)
    {
        if (_freeEditorDraft is null || !int.TryParse(value, out var definitionId))
            return;

        _freeEditorDraft.ExerciseDefinitionId = definitionId;
        ApplyFreeExerciseDefinition();
    }

    private void ChangeFreeSetsCount(ChangeEventArgs eventArgs)
    {
        if (_freeEditorDraft is null ||
            !int.TryParse(eventArgs.Value?.ToString(), out var count))
        {
            return;
        }

        _freeEditorDraft.ResizeSets(Math.Clamp(count, 1, 20));
    }

    private void SaveFreeExerciseEdit()
    {
        if (_freeEditorDraft is null)
            return;

        _freeEditorErrors.Clear();
        if (!_freeEditorDraft.IsConfigured)
            _freeEditorErrors.Add("Выберите упражнение из библиотеки.");
        if (_freeEditorDraft.Sets.Any(x =>
                !double.IsFinite(x.Weight) ||
                x.Weight is < 0 or > 2000 ||
                x.Repetitions is < 1 or > 1000))
        {
            _freeEditorErrors.Add("Проверьте вес и повторения каждого подхода.");
        }

        if (_freeEditorErrors.Count > 0)
            return;

        if (_isCreatingFreeExercise)
        {
            _exercises.Add(_freeEditorDraft.Clone());
            _nextFreeExerciseId--;
        }
        else
        {
            if (_freeEditorExerciseId is not { } exerciseId)
                return;

            var index = _exercises.FindIndex(x => x.Id == exerciseId);
            if (index < 0)
                return;

            _exercises[index] = _freeEditorDraft.Clone();
        }

        PersistFreeWorkout();
        CloseFreeExerciseEditor();
    }

    private void HandleExerciseKeyDown(KeyboardEventArgs eventArgs, int exerciseId)
    {
        if (eventArgs.Key is "Enter" or " ")
            ShowEditWorkoutAction(exerciseId);
        else if (eventArgs.Key == "Escape")
            CloseEditWorkoutAction();
    }

    private void HandleEditActionKeyDown(KeyboardEventArgs eventArgs)
    {
        if (eventArgs.Key == "Escape")
            CloseEditWorkoutAction();
    }

    private async Task LoadPhotoThumbnailsAsync(IEnumerable<ExerciseDraft> exercises)
    {
        var downloads = exercises
            .Where(x => x.Id > 0 && x.HasPhoto)
            .Select(async exercise =>
                (exercise.Id, Result: await PhotoClient.DownloadAsync(
                    exercise.Id,
                    _disposeCts.Token)));

        foreach (var download in await Task.WhenAll(downloads))
        {
            if (download.Result.Succeeded && download.Result.Value is { } photo)
                _photoThumbnails[download.Id] = ToDataUri(photo);
        }
    }

    private async Task OpenPhotoAsync(ExerciseDraft exercise)
    {
        if (!exercise.IsConfigured)
            return;

        CancelExerciseHold();
        _photoExercise = exercise;
        _photoDataUri = _photoThumbnails.GetValueOrDefault(exercise.Id);
        _confirmPhotoDelete = false;
        _photoErrors.Clear();
        BackNavigation.SetBackInterceptor(RequestClosePhoto);
        if (exercise.Id <= 0 || !exercise.HasPhoto || _photoDataUri is not null)
            return;

        _photoBusy = true;
        try
        {
            var result = await PhotoClient.DownloadAsync(
                exercise.Id,
                _disposeCts.Token);
            if (!result.Succeeded)
                _photoErrors.AddRange(result.Errors);
            else if (result.Value is { } photo)
            {
                _photoDataUri = ToDataUri(photo);
                _photoThumbnails[exercise.Id] = _photoDataUri;
            }
            else
            {
                exercise.HasPhoto = false;
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _photoBusy = false;
        }
    }

    private void ClosePhoto()
    {
        if (_photoBusy)
            return;

        _photoExercise = null;
        _photoDataUri = null;
        _photoErrors.Clear();
        _confirmPhotoDelete = false;
        BackNavigation.SetBackInterceptor(null);
    }

    private void RequestClosePhoto() => _ = InvokeAsync(ClosePhoto);

    private async Task PickPhotoAsync(MobilePhotoSource source)
    {
        if (_photoBusy || _photoExercise is null)
            return;

        _photoBusy = true;
        _photoErrors.Clear();
        _confirmPhotoDelete = false;
        try
        {
            var picked = await PhotoPicker.PickAsync(source);
            if (picked.Cancelled)
                return;
            if (!picked.Succeeded)
            {
                _photoErrors.AddRange(picked.Errors);
                return;
            }

            var photo = picked.Photo!;
            if (_photoExercise.Id > 0)
            {
                var result = await PhotoClient.UploadAsync(
                    _photoExercise.Id,
                    photo,
                    _disposeCts.Token);
                if (!result.Succeeded)
                {
                    _photoErrors.AddRange(result.Errors);
                    return;
                }
            }

            _photoDataUri = $"data:{photo.ContentType};base64,{Convert.ToBase64String(photo.Content)}";
            _photoThumbnails[_photoExercise.Id] = _photoDataUri;
            _photoExercise.HasPhoto = true;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _photoBusy = false;
        }
    }

    private async Task DeletePhotoAsync()
    {
        if (_photoBusy || _photoExercise is null)
            return;

        _photoBusy = true;
        _photoErrors.Clear();
        try
        {
            if (_photoExercise.Id > 0)
            {
                var result = await PhotoClient.DeleteAsync(
                    _photoExercise.Id,
                    _disposeCts.Token);
                if (!result.Succeeded)
                {
                    _photoErrors.AddRange(result.Errors);
                    return;
                }
            }

            _photoThumbnails.Remove(_photoExercise.Id);
            _photoDataUri = null;
            _confirmPhotoDelete = false;
            _photoExercise.HasPhoto = false;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _photoBusy = false;
        }
    }

    private static string ToDataUri(ExercisePhotoContent photo) =>
        $"data:{photo.ContentType};base64,{Convert.ToBase64String(photo.Content)}";

    private async Task LoadAsync()
    {
        _isLoading = true;
        CloseEditWorkoutAction();
        _errors.Clear();
        _photoThumbnails.Clear();
        try
        {
            var profileResult = await ProfileClient.GetAsync(_disposeCts.Token);
            if (profileResult.Succeeded && profileResult.Value is { } profile)
            {
                _restBetweenSetsSeconds = profile.RestBetweenSetsSeconds;
                _restBetweenExercisesSeconds = profile.RestBetweenExercisesSeconds;
            }

            var savedDraft = FreeWorkoutDraftStore.Load();
            if (savedDraft is { IsActive: true } && savedDraft.Exercises.Count > 0)
            {
                _isFreeWorkout = true;
                _workout = null;
                _exercises.Clear();
                _exercises.AddRange(savedDraft.Exercises.Select(ExerciseDraft.FromFree));
                _nextFreeExerciseId = _exercises.Count == 0
                    ? -1
                    : _exercises.Min(exercise => exercise.Id) - 1;
                return;
            }

            if (savedDraft is { IsActive: true })
                FreeWorkoutDraftStore.Clear();

            _isFreeWorkout = false;

            var result = await LifecycleClient.StartTodayWorkoutAsync(
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                _workout = null;
                _exercises.Clear();
                return;
            }

            _workout = result.Value;
            _exercises.Clear();
            if (_workout is not null)
            {
                _exercises.AddRange(_workout.TrainingPlan.Exercises
                    .Select(ExerciseDraft.From));
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CompleteAsync()
    {
        if (_isBusy || !HasFinishableExercise)
            return;

        _errors.Clear();
        if (_exercises.Any(x => !Validate(x)))
            return;

        if (_isFreeWorkout)
        {
            _showFreeTemplatePrompt = true;
            BackNavigation.SetBackInterceptor(RequestCloseFreeTemplatePrompt);
            return;
        }

        if (_workout is null)
            return;

        _isBusy = true;
        try
        {
            foreach (var exercise in _exercises)
            {
                var saveResult = await WorkoutClient.UpdateExerciseAsync(
                    exercise.Id,
                    exercise.ToRequest(),
                    _disposeCts.Token);
                if (!saveResult.Succeeded)
                {
                    _errors.AddRange(saveResult.Errors);
                    return;
                }
                exercise.UpdateFrom(saveResult.Value!);
            }

            var completionResult = await LifecycleClient.CompleteTodayWorkoutAsync(
                _disposeCts.Token);
            if (!completionResult.Succeeded)
            {
                _errors.AddRange(completionResult.Errors);
                return;
            }

            _completedHistory = completionResult.Value;
            _completionMessage = "Результаты тренировки сохранены в истории и графиках прогресса.";
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CreateFreeWorkoutAsync()
    {
        if (_isBusy || _isFreeWorkout)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            if (!await EnsureExerciseDefinitionsAsync())
                return;

            _isFreeWorkout = true;
            _exercises.Clear();
            OpenNewFreeExerciseEditor();
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<bool> EnsureExerciseDefinitionsAsync()
    {
        if (_exerciseDefinitions.Count > 0)
            return true;

        var definitionsResult = await WorkoutClient
            .GetExerciseDefinitionsAsync(_disposeCts.Token);
        if (!definitionsResult.Succeeded)
        {
            _errors.AddRange(definitionsResult.Errors);
            return false;
        }

        _exerciseDefinitions.AddRange(definitionsResult.Value!);
        return _exerciseDefinitions.Count > 0;
    }

    private static void ToggleSetKind(SetDraft set) =>
        set.IsWarmup = !set.IsWarmup;

    private async Task SetCompletedAsync(ExerciseDraft exercise, SetDraft set, ChangeEventArgs args)
    {
        var completed = args.Value is bool value && value;
        set.Completed = completed;
        if (!completed)
        {
            if (HasFollowingSet(exercise, set))
                ResetRestTimer(GetRestTimer(exercise.Id, set.SetNumber, RestTimerKind.BetweenSets));
            else if (HasFollowingExercise(exercise))
                ResetRestTimer(GetRestTimer(exercise.Id, 0, RestTimerKind.BetweenExercises));
        }
        else if (HasFollowingSet(exercise, set))
        {
            RequestStartRestTimer(GetRestTimer(exercise.Id, set.SetNumber, RestTimerKind.BetweenSets));
        }
        else if (completed && HasFollowingExercise(exercise))
        {
            RequestStartRestTimer(GetRestTimer(exercise.Id, 0, RestTimerKind.BetweenExercises));
        }

        await Task.CompletedTask;
    }

    private async Task SetSupersetCompletedAsync(ExerciseGroup group, SetDraft set, ChangeEventArgs args)
    {
        var completed = args.Value is bool value && value;
        set.Completed = completed;
        if (!completed)
        {
            ResetRestTimer(GetRestTimer(group.Exercises[0].Id, set.SetNumber, RestTimerKind.BetweenSets));
            ResetRestTimer(GetRestTimer(group.Exercises[0].Id, 0, RestTimerKind.BetweenExercises));
            await Task.CompletedTask;
            return;
        }

        if (!IsSupersetRoundCompleted(group, set.SetNumber))
        {
            await Task.CompletedTask;
            return;
        }

        if (HasFollowingSupersetRound(group, set.SetNumber))
        {
            RequestStartRestTimer(GetRestTimer(group.Exercises[0].Id, set.SetNumber, RestTimerKind.BetweenSets));
        }
        else if (HasFollowingGroup(group))
        {
            RequestStartRestTimer(GetRestTimer(group.Exercises[0].Id, 0, RestTimerKind.BetweenExercises));
        }

        await Task.CompletedTask;
    }

    private static IReadOnlyList<int> GetSupersetRoundNumbers(ExerciseGroup group) =>
        group.Exercises
            .SelectMany(exercise => exercise.Sets)
            .Select(set => set.SetNumber)
            .Distinct()
            .OrderBy(setNumber => setNumber)
            .ToList();

    private static bool HasFollowingSupersetRound(ExerciseGroup group, int setNumber) =>
        group.Exercises.SelectMany(exercise => exercise.Sets).Any(set => set.SetNumber > setNumber);

    private static bool IsSupersetRoundCompleted(ExerciseGroup group, int setNumber)
    {
        var roundSets = group.Exercises
            .Select(exercise => exercise.Sets.FirstOrDefault(set => set.SetNumber == setNumber))
            .Where(set => set is not null)
            .ToList();

        return roundSets.Count == group.Exercises.Count && roundSets.All(set => set!.Completed);
    }

    private bool HasFollowingGroup(ExerciseGroup group) =>
        group.Exercises.Count > 0 && _exercises.IndexOf(group.Exercises[^1]) < _exercises.Count - 1;

    private static string GetSupersetStatus(ExerciseGroup group)
    {
        var status = group.Exercises[0].Status;
        return group.Exercises.All(exercise => exercise.Status == status) ? status : "NotCompleted";
    }

    private static void SetSupersetStatus(ExerciseGroup group, string status)
    {
        foreach (var exercise in group.Exercises)
            exercise.Status = status;
    }

    private bool HasFollowingSet(ExerciseDraft exercise, SetDraft set) =>
        exercise.Sets.Any(candidate => candidate.SetNumber > set.SetNumber);

    private bool HasFollowingExercise(ExerciseDraft exercise) =>
        _exercises.IndexOf(exercise) < _exercises.Count - 1;

    private void OpenRestTimer(int exerciseId, int setNumber, RestTimerKind kind)
    {
        _selectedRestTimer = GetRestTimer(exerciseId, setNumber, kind);
    }

    private void CloseRestTimer() => _selectedRestTimer = null;

    private RestTimerState GetRestTimer(int exerciseId, int setNumber, RestTimerKind kind)
    {
        var key = $"{exerciseId}:{setNumber}:{kind}";
        if (_restTimers.TryGetValue(key, out var timer))
            return timer;

        timer = new RestTimerState
        {
            Kind = kind,
            DurationSeconds = kind == RestTimerKind.BetweenSets ? _restBetweenSetsSeconds : _restBetweenExercisesSeconds,
            RemainingSeconds = kind == RestTimerKind.BetweenSets ? _restBetweenSetsSeconds : _restBetweenExercisesSeconds
        };
        _restTimers.Add(key, timer);
        return timer;
    }

    private string GetRestTimerLabel(int exerciseId, int setNumber, RestTimerKind kind)
    {
        var timer = GetRestTimer(exerciseId, setNumber, kind);
        if (timer.IsCompleted)
            return "✓";
        return timer.IsRunning
            ? $"Осталось {FormatDuration(timer.RemainingSeconds)}"
            : timer.IsQueued
                ? "После текущего таймера"
                : FormatDuration(timer.DurationSeconds);
    }

    private void StartSelectedRestTimer()
    {
        if (_selectedRestTimer is null) return;
        _selectedRestTimer.DurationSeconds = Math.Clamp(_selectedRestTimer.DurationSeconds, 5, 3600);
        if (_selectedRestTimer.IsRunning)
            StartRestTimer(_selectedRestTimer);
        else
            RequestStartRestTimer(_selectedRestTimer);
        CloseRestTimer();
    }

    private void RequestStartRestTimer(RestTimerState timer)
    {
        if (timer.IsRunning || timer.IsQueued)
            return;

        if (_restTimers.Values.Any(candidate => candidate.IsRunning))
        {
            timer.IsQueued = true;
            _queuedRestTimers.Add(timer);
            return;
        }

        StartRestTimer(timer);
    }

    private static void StartRestTimer(RestTimerState timer)
    {
        timer.IsQueued = false;
        timer.IsCompleted = false;
        timer.RemainingSeconds = timer.DurationSeconds;
        timer.EndsAtUtc = DateTimeOffset.UtcNow.AddSeconds(timer.RemainingSeconds);
        timer.IsRunning = true;
    }

    private void ResetRestTimer(RestTimerState timer)
    {
        var wasRunning = timer.IsRunning;
        _queuedRestTimers.Remove(timer);
        timer.IsQueued = false;
        timer.IsRunning = false;
        timer.EndsAtUtc = null;
        timer.RemainingSeconds = timer.DurationSeconds;
        timer.IsCompleted = false;
        if (wasRunning)
            StartNextQueuedRestTimer();
    }

    private void PauseSelectedRestTimer()
    {
        if (_selectedRestTimer is null) return;
        UpdateRestTimer(_selectedRestTimer);
        _selectedRestTimer.IsRunning = false;
    }

    private async Task RunRestTimerLoopAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(_disposeCts.Token))
            {
                foreach (var restTimer in _restTimers.Values)
                    UpdateRestTimer(restTimer);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested) { }
    }

    private void UpdateRestTimer(RestTimerState timer)
    {
        if (!timer.IsRunning || timer.EndsAtUtc is null) return;
        timer.RemainingSeconds = Math.Max(0, (int)Math.Ceiling((timer.EndsAtUtc.Value - DateTimeOffset.UtcNow).TotalSeconds));
        if (timer.RemainingSeconds == 0)
        {
            timer.IsRunning = false;
            timer.EndsAtUtc = null;
            timer.IsCompleted = true;
            StartNextQueuedRestTimer();
        }
    }

    private void StartNextQueuedRestTimer()
    {
        while (_queuedRestTimers.Count > 0)
        {
            var nextTimer = _queuedRestTimers[0];
            _queuedRestTimers.RemoveAt(0);
            nextTimer.IsQueued = false;
            if (!nextTimer.IsRunning)
            {
                StartRestTimer(nextTimer);
                return;
            }
        }
    }

    private static string FormatDuration(int seconds) => $"{seconds / 60}:{seconds % 60:D2}";

