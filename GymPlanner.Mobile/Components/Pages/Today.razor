    private string? SwapClass(ExerciseGroup group) =>
        group.Exercises[0].SupersetGroupId == _swappedSupersetId ? "is-swapped" : null;

    // Новый ключ пересоздаёт кнопку, и иконка снова делает полуоборот.
    private string SwapKey(ExerciseGroup group) =>
        group.Exercises[0].SupersetGroupId == _swappedSupersetId
            ? $"swap-{_supersetSwapVersion}"
            : "swap-0";

    private async Task SeparateSupersetAsync(ExerciseGroup group)
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            foreach (var exercise in group.Exercises)
            {
                exercise.SupersetGroupId = null;
                var result = await WorkoutClient.UpdateExerciseAsync(exercise.Id, exercise.ToRequest(), _disposeCts.Token);
                if (!result.Succeeded)
                {
                    _errors.AddRange(result.Errors);
                    return;
                }

                exercise.UpdateFrom(result.Value!);
            }

            CloseSupersetActions(force: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteSupersetAsync(ExerciseGroup group)
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            foreach (var exercise in group.Exercises)
            {
                var result = await WorkoutClient.DeleteExerciseAsync(exercise.Id, _disposeCts.Token);
                if (!result.Succeeded)
                {
                    _errors.AddRange(result.Errors);
                    return;
                }
            }

            var ids = group.Exercises.Select(exercise => exercise.Id).ToHashSet();
            _exercises.RemoveAll(exercise => ids.Contains(exercise.Id));
            CloseSupersetActions(force: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private bool Validate(ExerciseDraft exercise)
    {
        if (!exercise.IsConfigured)
        {
            _errors.Add(Text["Today_ConfigureAllExercises"]);
            return false;
        }

        if (exercise.Sets.Any(x =>
                !double.IsFinite(x.Weight) ||
                x.Weight is < 0 or > 2000 ||
                x.Repetitions is < 1 or > 1000))
        {
            _errors.Add(Text.Format("Today_CheckWeightAndReps", exercise.Name));
            return false;
        }

        return true;
    }

    private async Task CloseCompletion()
    {
        if (_isBusy || !await SaveNextSessionTargetsAsync())
            return;

        // Пока сохранялось, человек мог уйти со страницы: перечитывать её незачем.
        if (_disposeCts.IsCancellationRequested)
            return;

        _completedHistory = null;
        _completionMessage = string.Empty;
        _nextSessionChoices.Clear();
        await LoadAsync();
    }

    // Сервер уже перенёс сегодняшние подходы в шаблон, так что цель — это они
    // же плюс шаг. Обучение показывает окно итогов без этого блока.
    private void OfferNextSessionChoices()
    {
        _nextSessionChoices.Clear();
        _nextSessionErrors.Clear();
        if (Tutorial.IsActive)
            return;

        _nextSessionChoices.AddRange(_exercises
            .Where(x => x.IsConfigured && x.Sets.Any(set => !set.IsWarmup))
            .Select(x => new NextSessionChoice(x.Clone())));
    }

    private async Task<bool> SaveNextSessionTargetsAsync()
    {
        _nextSessionErrors.Clear();
        var pending = _nextSessionChoices
            .Where(x => x.ChangesTemplate && !x.IsSaved)
            .ToList();
        if (pending.Count == 0)
            return true;

        // Неверная прибавка уже подсвечена у своего поля: окно остаётся открытым.
        if (pending.Any(x => x.AddsWeight && !x.HasValidWeightStep))
            return false;

        _isBusy = true;
        try
        {
            foreach (var choice in pending)
            {
                // Без связи правка ждёт в очереди следом за завершением тренировки.
                // Уход со страницы не отменяет сохранение: иначе цели оставшихся
                // упражнений молча потерялись бы.
                var result = await WorkoutClient.UpdateExerciseAsync(
                    choice.Exercise.Id,
                    WithNextSessionTarget(choice).ToRequest(),
                    CancellationToken.None);
                if (!result.Succeeded)
                {
                    _nextSessionErrors.AddRange(result.Errors);
                    return false;
                }

                // Повторное «Готово» после ошибки не добавит шаг второй раз.
                choice.IsSaved = true;
            }

            return true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static ExerciseDraft WithNextSessionTarget(NextSessionChoice choice)
    {
        var target = choice.Exercise.Clone();
        foreach (var set in target.Sets)
        {
            // Повтор получают только отмеченные подходы.
            var next = NextSessionTargets.Apply(
                new SetPerformance(set.Weight, set.Repetitions),
                set.IsWarmup,
                choice.AddsWeight ? choice.WeightStep : null,
                choice.AddsRepetition && choice.RepetitionSets.Contains(set.SetNumber));
            set.Weight = next.Weight;
            set.Repetitions = next.Repetitions;
        }

        return target;
    }

    // На кнопке веса — введённая прибавка, пока поле не очищено и не ошибочно.
    private string NextSessionWeightLabelOf(NextSessionChoice choice) => Text.Format(
        "Today_NextTimeAddWeight",
        choice.HasValidWeightStep ? choice.WeightStep!.Value : NextSessionTargets.DefaultWeightStep);

    public void Dispose()
    {
        CancelExerciseHold();
        CancelFinishHold();
        CancelSupersetHold();
        Lifecycle.Suspended -= SaveSessionOnSuspend;
        Tutorial.Stopping -= OnTutorialStopping;
        Tutorial.Stopped -= OnTutorialStopped;
        // Проходка по шаблону уводит со страницы, а «Назад» остаётся за обучением.
        if (!Tutorial.IsActive)
            BackNavigation.SetBackInterceptor(null);
        _disposeCts.Cancel();
        _disposeCts.Dispose();
        _ = _swapAnimation.DisposeAsync().AsTask();
    }

    private enum RestTimerKind { BetweenSets, BetweenExercises }

    private sealed class RestTimerState
    {
        public RestTimerKind Kind { get; init; }
        /// <summary>Упражнение, после подходов которого идёт отдых; у суперсета — первое в группе.</summary>
        public int ExerciseId { get; init; }
        /// <summary>Подход (у суперсета — круг), после которого идёт отдых; 0 — отдых между упражнениями.</summary>
        public int SetNumber { get; init; }
        public int DurationSeconds { get; set; }
        public int RemainingSeconds { get; set; }
        public bool IsRunning { get; set; }
        public bool IsQueued { get; set; }
        public bool IsCompleted { get; set; }
        public int StartAnimationVersion { get; set; }
        public DateTimeOffset? EndsAtUtc { get; set; }
        /// <summary>Во сколько раз отсчёт быстрее настоящего: больше 1 только в обучении.</summary>
        public double TimeScale { get; set; } = 1;
    }

    private sealed class ExerciseDraft
    {
        public int Id { get; init; }
        public string Name { get; set; } = string.Empty;
        public int TrainingPlanId { get; init; }
        public int? ExerciseDefinitionId { get; set; }
        public string Status { get; set; } = "NotCompleted";
        public bool HasPhoto { get; set; }
        public int? SupersetGroupId { get; set; }
        /// <summary>Отдых между подходами из шаблона; у суперсета — между кругами.</summary>
        public int RestBetweenSetsSeconds { get; set; } = RestTimerDefaults.BetweenSetsSeconds;
        /// <summary>Отдых после упражнения из шаблона; null — отдых между упражнениями шаблона.</summary>
        public int? RestAfterExerciseSeconds { get; set; }
        public List<SetDraft> Sets { get; } = [];
        public bool IsConfigured => Id >= 0 ||
            (ExerciseDefinitionId is not null &&
             !string.IsNullOrWhiteSpace(Name) &&
             Sets.Count > 0);

        public static ExerciseDraft CreateFree(int id)
        {
            var draft = new ExerciseDraft { Id = id };
            draft.ResizeSets(3);
            return draft;
        }

        public static ExerciseDraft From(ExerciseApiResponse source)
        {
            var draft = new ExerciseDraft
            {
                Id = source.Id,
                Name = source.Name,
                TrainingPlanId = source.TrainingPlanId,
                ExerciseDefinitionId = source.ExerciseDefinitionId,
                Status = source.Status,
                HasPhoto = source.HasPhoto,
                SupersetGroupId = source.SupersetGroupId,
                RestBetweenSetsSeconds = source.RestBetweenSetsSeconds,
                RestAfterExerciseSeconds = source.RestAfterExerciseSeconds
            };
            draft.Sets.AddRange(source.Sets
                .OrderBy(x => x.SetNumber)
                .Select(SetDraft.From));
            return draft;
        }

        public SaveExerciseRequest ToRequest() => new(
            Name,
            Sets.Count,
            Status,
            ExerciseDefinitionId,
            Sets.Select(x => new SaveExerciseSetRequest(
                x.SetNumber,
                x.Repetitions,
                x.Weight,
                x.Completed,
                x.IsWarmup,
                x.RestAfterSeconds)).ToArray(),
            SupersetGroupId,
            RestBetweenSetsSeconds,
            RestAfterExerciseSeconds);

        public ExerciseApiResponse ToResponse() => new(
            Id,
            Name,
            Sets.Count,
            Status,
            TrainingPlanId,
            ExerciseDefinitionId,
            HasPhoto,
            Sets.Select(x => new ExerciseSetApiResponse(
                x.SetNumber,
                x.Repetitions,
                x.Weight,
                x.Completed,
                x.IsWarmup,
                x.RestAfterSeconds)).ToList(),
            SupersetGroupId,
            RestBetweenSetsSeconds,
            RestAfterExerciseSeconds);

        public ExerciseDraft Clone()
        {
            var clone = new ExerciseDraft
            {
                Id = Id,
                Name = Name,
                TrainingPlanId = TrainingPlanId,
                ExerciseDefinitionId = ExerciseDefinitionId,
                Status = Status,
                HasPhoto = HasPhoto,
                SupersetGroupId = SupersetGroupId,
                RestBetweenSetsSeconds = RestBetweenSetsSeconds,
                RestAfterExerciseSeconds = RestAfterExerciseSeconds
            };
            clone.Sets.AddRange(Sets.Select(x => x.Clone()));
            return clone;
        }

        public void ResizeSets(int count)
        {
            while (Sets.Count < count)
            {
                Sets.Add(new SetDraft
                {
                    SetNumber = Sets.Count + 1,
                    Repetitions = 8
                });
            }

            while (Sets.Count > count)
                Sets.RemoveAt(Sets.Count - 1);

            for (var index = 0; index < Sets.Count; index++)
                Sets[index].SetNumber = index + 1;
        }

        // Таймер отсюда не берётся: снимок сессии, сохранённый прежней сборкой,
        // не знает его и подставил бы значение по умолчанию вместо шаблонного.
        public void UpdateFrom(ExerciseApiResponse source)
        {
            Status = source.Status;
            HasPhoto = source.HasPhoto;
            SupersetGroupId = source.SupersetGroupId;
            var restAfter = Sets.ToDictionary(x => x.SetNumber, x => x.RestAfterSeconds);
            Sets.Clear();
            Sets.AddRange(source.Sets
                .OrderBy(x => x.SetNumber)
                .Select(SetDraft.From));
            foreach (var set in Sets)
                set.RestAfterSeconds ??= restAfter.GetValueOrDefault(set.SetNumber);
        }
    }

    private sealed record ExerciseGroup(bool IsSuperset, IReadOnlyList<ExerciseDraft> Exercises);

    /// <summary>Выбор в окне итогов: что поменять в упражнении к следующему разу.</summary>
    private sealed class NextSessionChoice(ExerciseDraft exercise)
    {
        /// <summary>Упражнение таким, каким его записало завершение тренировки.</summary>
        public ExerciseDraft Exercise { get; } = exercise;
        public bool AddsWeight { get; set; }
        public bool AddsRepetition { get; set; }
        /// <summary>Прибавка веса; null, пока поле очищено.</summary>
        public double? WeightStep { get; set; } = NextSessionTargets.DefaultWeightStep;
        /// <summary>Рабочие подходы, которым добавляется повтор; сначала все.</summary>
        public HashSet<int> RepetitionSets { get; } = exercise.Sets
            .Where(x => !x.IsWarmup)
            .Select(x => x.SetNumber)
            .ToHashSet();
        public bool IsSaved { get; set; }

        public bool HasValidWeightStep =>
            WeightStep is { } weightStep && NextSessionTargets.IsValidWeightStep(weightStep);

        /// <summary>Есть ли что записать в шаблон.</summary>
        public bool ChangesTemplate => AddsWeight || AddsRepetition && RepetitionSets.Count > 0;

        public bool ChangesNothing => !AddsWeight && !AddsRepetition;

        public void KeepAsIs()
        {
            AddsWeight = false;
            AddsRepetition = false;
        }

        public void ToggleRepetitionSet(int setNumber)
        {
            if (!RepetitionSets.Remove(setNumber))
                RepetitionSets.Add(setNumber);
        }
    }

    private sealed class SetDraft
    {
        public int SetNumber { get; set; }
        public int Repetitions { get; set; }
        public double Weight { get; set; }
        public bool Completed { get; set; }
        public bool IsWarmup { get; set; }
        /// <summary>Отдых после подхода из шаблона; null — отдых упражнения.</summary>
        public int? RestAfterSeconds { get; set; }

        public SetDraft Clone() => new()
        {
            SetNumber = SetNumber,
            Repetitions = Repetitions,
            Weight = Weight,
            Completed = Completed,
            IsWarmup = IsWarmup,
            RestAfterSeconds = RestAfterSeconds
        };

        public static SetDraft From(ExerciseSetApiResponse source) => new()
        {
            SetNumber = source.SetNumber,
            Repetitions = source.Repetitions,
            Weight = source.Weight,
            Completed = source.Completed,
            IsWarmup = source.IsWarmup,
            RestAfterSeconds = source.RestAfterSeconds
        };
    }
}
