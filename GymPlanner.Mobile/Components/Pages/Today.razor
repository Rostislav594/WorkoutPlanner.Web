    private async Task BeginFinishHoldAsync()
    {
        if (_isBusy || !HasFinishableExercise || _isFinishHoldActive)
            return;

        CancelFinishHold();
        var holdCts = CancellationTokenSource.CreateLinkedTokenSource(_disposeCts.Token);
        _finishHoldCts = holdCts;
        _isFinishHoldActive = true;

        try
        {
            await Task.Delay(FinishHoldFeedbackDelay, holdCts.Token);
            _isFinishAnimationActive = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(ActiveFinishHoldDuration - FinishHoldFeedbackDelay, holdCts.Token);
            if (!holdCts.IsCancellationRequested)
                await CompleteAsync();
        }
        catch (OperationCanceledException) when (holdCts.IsCancellationRequested)
        {
        }
        finally
        {
            if (ReferenceEquals(_finishHoldCts, holdCts))
            {
                _finishHoldCts = null;
                _isFinishHoldActive = false;
                _isFinishAnimationActive = false;
                holdCts.Dispose();
            }
        }
    }

    private void CancelFinishHold()
    {
        _finishHoldCts?.Cancel();
        _finishHoldCts?.Dispose();
        _finishHoldCts = null;
        _isFinishHoldActive = false;
        _isFinishAnimationActive = false;
    }

