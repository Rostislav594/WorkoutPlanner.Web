    private async Task SaveFreeWorkoutAsync(
        bool saveAsTemplate,
        string? templateName)
    {
        if (_isBusy || !_isFreeWorkout)
            return;

        _isBusy = true;
        _errors.Clear();
        _templateErrors.Clear();
        try
        {
            var result = await LifecycleClient.CompleteFreeWorkoutAsync(
                new CompleteFreeWorkoutRequest(
                    saveAsTemplate,
                    templateName,
                    _exercises.Select(x => x.ToRequest()).ToArray(),
                    Clock.GetLocalNow().DateTime,
                    _restBetweenExercisesSeconds,
                    // Черновик, начатый без связи, сервер не знает.
                    _freeDraftPlanId is { } draftId && !OfflineIds.IsLocal(draftId) ? draftId : null),
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                // Черновик уже закрыт — часами или прошлым нажатием: тренировка
                // есть в истории, и показывать её идущей больше нельзя.
                if (result.Errors.Contains(ApiErrorMessages.Get(ApiErrorCodes.WorkoutAlreadyCompleted)))
                {
                    _showFreeTemplatePrompt = false;
                    _showTemplateNamePrompt = false;
                    SetBackInterceptor(null);
                    await ForgetSessionAsync();
                    await LoadAsync();
                    _errors.AddRange(result.Errors);
                    return;
                }

                _templateErrors.AddRange(result.Errors);
                return;
            }

            _showFreeTemplatePrompt = false;
            _showTemplateNamePrompt = false;
            SetBackInterceptor(null);
            _completedHistory = result.Value!.History;
            _completionMessage = OfflineIds.IsLocal(_completedHistory.Id)
                ? Text["Today_SavedOffline"]
                : saveAsTemplate
                    ? Text.Format("Today_SavedWithTemplate", templateName ?? string.Empty)
                    : Text["Today_SavedHistoryOnly"];
            await ForgetSessionAsync();
            _isFreeWorkout = false;
            _exercises.Clear();
            // Черновик на сервере удаляется вместе с записью в историю, одной
            // транзакцией, поэтому отдельного запроса здесь не нужно.
            _freeDraftPlanId = null;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

