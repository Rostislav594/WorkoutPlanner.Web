    private async Task SaveFreeExerciseEdit()
    {
        if (_freeEditorDraft is null)
            return;

        _freeEditorErrors.Clear();
        if (!_freeEditorDraft.IsConfigured)
            _freeEditorErrors.Add(Text["WorkoutDetails_PickLibraryExerciseError"]);
        if (_freeEditorDraft.Sets.Any(x =>
                !double.IsFinite(x.Weight) ||
                x.Weight is < 0 or > 2000 ||
                x.Repetitions is < 1 or > 1000))
        {
            _freeEditorErrors.Add(Text["WorkoutDetails_CheckSetsError"]);
        }

        if (_freeEditorErrors.Count > 0)
            return;

        if (_freeDraftPlanId is not { } planId)
        {
            _freeEditorErrors.Add(Text["Today_FreeWorkoutNotStarted"]);
            return;
        }

        // Упражнение уходит на сервер сразу, а не в конце тренировки: только так
        // его увидят часы, и только так у подходов появляются настоящие
        // идентификаторы, по которым часы смогут их закрывать.
        if (_isCreatingFreeExercise)
        {
            var created = await WorkoutClient.CreateExerciseAsync(
                planId,
                _freeEditorDraft.ToRequest(),
                _disposeCts.Token);
            if (!created.Succeeded || created.Value is not { } createdExercise)
            {
                _freeEditorErrors.AddRange(created.Errors);
                return;
            }

            _exercises.Add(ExerciseDraft.From(createdExercise));
        }
        else
        {
            if (_freeEditorExerciseId is not { } exerciseId)
                return;

            var index = _exercises.FindIndex(x => x.Id == exerciseId);
            if (index < 0)
                return;

            var updated = await WorkoutClient.UpdateExerciseAsync(
                exerciseId,
                _freeEditorDraft.ToRequest(),
                _disposeCts.Token);
            if (!updated.Succeeded || updated.Value is not { } updatedExercise)
            {
                _freeEditorErrors.AddRange(updated.Errors);
                return;
            }

            _exercises[index] = ExerciseDraft.From(updatedExercise);
        }

        CloseFreeExerciseEditor();
    }

