@page "/profile/setup"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject IProfileApiClient ProfileClient
@inject NavigationManager Navigation
@inject IAppText Text

<section class="profile-setup-page" aria-busy="@_isLoading">
    <div class="profile-setup-panel">
        @if (_isLoading)
        {
            <div class="profile-setup-state" role="status">
                <span class="loading-spinner" aria-hidden="true"></span>
                <span>@Text["ProfileSetup_Checking"]</span>
            </div>
        }
        else if (_loadErrors.Count > 0)
        {
            <div class="profile-setup-state load-error">
                <div class="auth-error" role="alert">@string.Join(" ", _loadErrors)</div>
                <button class="profile-secondary-action" type="button" @onclick="LoadAsync">@Text["Common_Retry"]</button>
            </div>
        }
        else
        {
            <header class="profile-heading">
                <p class="profile-kicker">@Text["ProfileSetup_Kicker"]</p>
                <h1>@Text["ProfileSetup_Title"]</h1>
                <p>@Text["ProfileSetup_Subtitle"]</p>
            </header>

            @if (_operationErrors.Count > 0)
            {
                <div class="auth-error operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
            }

            <EditForm Model="_input" OnValidSubmit="SaveProfileAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                <div class="profile-form-grid">
                    <div class="field">
                        <label for="setup-first-name">@Text["Common_FirstName"]</label>
                        <InputText id="setup-first-name" class="auth-input" @bind-Value="_input.FirstName" autocomplete="given-name" />
                        <LocalizedValidationMessage For="@(() => _input.FirstName)" />
                    </div>

                    <div class="field">
                        <label for="setup-last-name">@Text["Common_LastName"]</label>
                        <InputText id="setup-last-name" class="auth-input" @bind-Value="_input.LastName" autocomplete="family-name" />
                        <LocalizedValidationMessage For="@(() => _input.LastName)" />
                    </div>

                    <div class="field">
                        <label for="setup-birth-date">@Text["Common_BirthDate"]</label>
                        <InputText id="setup-birth-date"
                                   class="auth-input"
                                   @bind-Value="_input.BirthDateText"
                                   inputmode="numeric"
                                   autocomplete="bday"
                                   placeholder="@Text["Common_BirthDatePlaceholder"]" />
                        <LocalizedValidationMessage For="@(() => _input.BirthDateText)" />
                    </div>

                    <div class="field">
                        <label for="setup-gender">@Text["Common_Gender"]</label>
                        <SystemChoiceField id="setup-gender"
                                           class="auth-input"
                                           Title="@Text["Common_Gender"]"
                                           Options="GenderOptions"
                                           @bind-Value="_input.Gender"
                                           AriaLabel="@Text["ProfileSetup_SelectGender"]" />
                        <LocalizedValidationMessage For="@(() => _input.Gender)" />
                    </div>
                </div>

                <button class="profile-primary-action" type="submit" disabled="@_isSaving">
                    @(_isSaving ? Text["Common_Saving"] : Text["ProfileSetup_Save"])
                </button>
            </EditForm>
        }
    </div>
</section>

@code {
    // Значение остаётся русским: оно уходит на сервер и хранится в профиле.
    // Переводится только подпись, которую видит пользователь.
    private IReadOnlyList<SystemChoiceOption> GenderOptions =>
    [
        new("Мужской", Text["Gender_Male"]),
        new("Женский", Text["Gender_Female"]),
        new("Не указывать", Text["Gender_Unspecified"])
    ];

    private readonly ProfileInput _input = new();
    private readonly List<string> _loadErrors = [];
    private readonly List<string> _operationErrors = [];
    private bool _isLoading = true;
    private bool _isSaving;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadErrors.Clear();

        var result = await ProfileClient.GetAsync();
        if (!result.Succeeded)
        {
            _loadErrors.AddRange(result.Errors);
        }
        else if (result.Value!.HasProfile)
        {
            Navigation.NavigateTo("/profile", replace: true);
        }

        _isLoading = false;
    }

    private async Task SaveProfileAsync()
    {
        if (_isSaving)
            return;

        _operationErrors.Clear();
        if (!DateTime.TryParseExact(
                _input.BirthDateText.Trim(),
                ["dd.MM.yyyy", "d.M.yyyy", "yyyy-MM-dd"],
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var birthDate))
        {
            _operationErrors.Add(Text["Validation_BirthDateFormat"]);
            return;
        }

        if (birthDate.Date > DateTime.Today || birthDate.Year < 1900)
        {
            _operationErrors.Add(Text["Validation_BirthDateInvalid"]);
            return;
        }

        _isSaving = true;
        try
        {
            var result = await ProfileClient.SaveAsync(new(
                _input.FirstName,
                _input.LastName,
                birthDate,
                _input.Gender));

            if (!result.Succeeded)
            {
                _operationErrors.AddRange(result.Errors);
                return;
            }

            Navigation.NavigateTo("/firstlaunch", replace: true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed class ProfileInput
    {
        // В атрибутах лежат ключи ресурсов: их печатает LocalizedValidationMessage.
        [Required(ErrorMessage = "Validation_FirstNameRequired")]
        [MaxLength(80, ErrorMessage = "Validation_FirstNameTooLong")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Validation_LastNameRequired")]
        [MaxLength(80, ErrorMessage = "Validation_LastNameTooLong")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Validation_BirthDateRequired")]
        public string BirthDateText { get; set; } = string.Empty;

        [Required(ErrorMessage = "Validation_GenderRequired")]
        public string Gender { get; set; } = string.Empty;
    }
}
