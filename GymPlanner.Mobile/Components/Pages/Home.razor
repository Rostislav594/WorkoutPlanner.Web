@page "/"
@attribute [Authorize]

<section class="home-container" aria-label="Главная">
    <div class="home-layout">
        <InboxPopover />
        <nav class="desktop-shortcuts" aria-label="Инструменты">
            <a class="shortcut-tile" href="calendar">
                <span class="material-symbols-rounded shortcut-icon" aria-hidden="true">calendar_month</span>
                <span class="shortcut-title">Календарь</span>
            </a>
            <a class="shortcut-tile" href="notebook">
                <span class="material-symbols-rounded shortcut-icon" aria-hidden="true">note_stack</span>
                <span class="shortcut-title">Блокнот</span>
            </a>
        </nav>
        <div class="home-identity">
            <img src="_content/WorkoutPlanner.UI/images/logo.png"
                 class="home-logo"
                 alt="GymPlanner" />
        </div>
    </div>
</section>
