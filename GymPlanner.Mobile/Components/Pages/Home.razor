@page "/"
@attribute [Authorize]
@inject IAppText Text

<section class="home-container" aria-label="@Text["Nav_Home"]">
    <div class="home-layout">
        <InboxPopover />
        <nav class="desktop-shortcuts" aria-label="@Text["Home_Tools"]">
            <a class="shortcut-tile" href="calendar">
                <span class="material-symbols-rounded shortcut-icon" aria-hidden="true">calendar_month</span>
                <span class="shortcut-title">@Text["Home_Calendar"]</span>
            </a>
            <a class="shortcut-tile" href="notebook">
                <span class="material-symbols-rounded shortcut-icon" aria-hidden="true">note_stack</span>
                <span class="shortcut-title">@Text["Home_Notebook"]</span>
            </a>
        </nav>
        <div class="home-identity">
            <img src="_content/WorkoutPlanner.UI/images/logo.png?v=classic-home"
                 class="home-logo"
                 alt="GymPlanner" />
        </div>
    </div>
</section>
