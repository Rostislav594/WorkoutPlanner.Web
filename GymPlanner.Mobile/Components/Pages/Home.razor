@page "/"
@page "/today"
@attribute [Authorize]
@implements IDisposable
@using WorkoutPlanner.Api.Contracts
@inject IWorkoutApiClient WorkoutClient
@inject IWorkoutLifecycleApiClient LifecycleClient

<section class="today-page">
    <header>
        <p>@DateTime.Today.ToString("dd MMMM")</p>
        <h1>Сегодня</h1>
    </header>

    @if (_errors.Count > 0)
    {
        <div class="auth-error" role="alert">@string.Join(" ", _errors)</div>
    }

    @if (_isLoading)
    {
        <div class="state" role="status">Загружаем тренировку…</div>
    }
    else if (_workout is null)
    {
        <div class="empty-state">
            <h2>На сегодня тренировка не назначена</h2>
            <p>Выберите тренировочный план в календаре.</p>
            <a href="/calendar">Открыть календарь</a>
            @if (_errors.Count > 0)
            {
                <button class="secondary" type="button" @onclick="LoadAsync">Повторить</button>
            }
        </div>
    }
    else
    {
        <div class="workout-heading">
            <div>
                <p>Тренировка</p>
                <h2>@_workout.TrainingPlan.WorkoutName</h2>
            </div>
            <span>@CompletedSets из @TotalSets подходов</span>
        </div>

        <div class="progress-track" aria-label="Выполнено @ProgressPercent.ToString("0") процентов">
            <span style="width: @ProgressPercent%"></span>
        </div>

        @if (_exercises.Count == 0)
        {
            <div class="state">В назначенном плане пока нет упражнений.</div>
        }

        <div class="exercise-list">
            @foreach (var exercise in _exercises)
            {
                <article class="exercise-card">
                    <div class="exercise-title">
                        <h3>@exercise.Name</h3>
                        @if (exercise.IsSaved)
                        {
                            <span class="saved-label" role="status">Сохранено</span>
                        }
                    </div>

                    <div class="set-list">
                        @foreach (var set in exercise.Sets)
                        {
                            <fieldset class="set-row">
                                <legend>Подход @set.SetNumber</legend>
                                <label class="complete-control">
                                    <input type="checkbox" @bind="set.Completed" />
                                    Выполнен
                                </label>
                                <label>
                                    Вес, кг
                                    <input class="auth-input" type="number" min="0" max="2000" step="0.5" @bind="set.Weight" />
                                </label>
                                <label>
                                    Повторения
                                    <input class="auth-input" type="number" min="1" max="1000" @bind="set.Repetitions" />
                                </label>
                            </fieldset>
                        }
                    </div>

                    <label class="status-control">
                        Оценка упражнения
                        <select class="auth-input" @bind="exercise.Status">
                            <option value="NotCompleted">Не оценено</option>
                            <option value="Easy">Легко</option>
                            <option value="Medium">Средне</option>
                            <option value="Hard">Тяжело</option>
                            <option value="Max">Предел</option>
                        </select>
                    </label>

                    <button class="secondary save-exercise" type="button" disabled="@_isBusy" @onclick="() => SaveExerciseAsync(exercise)">
                        Сохранить значения
                    </button>
                </article>
            }
        </div>

        <button class="finish-button" type="button" disabled="@(_isBusy || _exercises.Count == 0)" @onclick="CompleteAsync">
            @(_isBusy ? "Сохраняем тренировку…" : "Завершить тренировку")
        </button>
    }
</section>

@if (_completedHistory is not null)
{
    <div class="dialog-backdrop">
        <section class="completion-dialog" role="dialog" aria-modal="true" aria-labelledby="completion-title">
            <span class="completion-icon" aria-hidden="true">✓</span>
            <h2 id="completion-title">Тренировка завершена</h2>
            <p>@_completedHistory.WorkoutName сохранена в истории вместе с фактическими значениями подходов.</p>
            <button class="primary" type="button" @onclick="CloseCompletion">Готово</button>
        </section>
    </div>
}

@code {
    private readonly List<ExerciseDraft> _exercises = [];
    private readonly List<string> _errors = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private TodayWorkoutApiResponse? _workout;
    private WorkoutHistoryApiResponse? _completedHistory;
    private bool _isLoading = true;
    private bool _isBusy;

    private int TotalSets => _exercises.Sum(x => x.Sets.Count);
    private int CompletedSets => _exercises.Sum(x => x.Sets.Count(set => set.Completed));
    private double ProgressPercent => TotalSets == 0
        ? 0
        : CompletedSets * 100d / TotalSets;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errors.Clear();
        try
        {
            var result = await LifecycleClient.StartTodayWorkoutAsync(
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                _workout = null;
                _exercises.Clear();
                return;
            }

            _workout = result.Value;
            _exercises.Clear();
            if (_workout is not null)
            {
                _exercises.AddRange(_workout.TrainingPlan.Exercises
                    .Select(ExerciseDraft.From));
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveExerciseAsync(ExerciseDraft exercise)
    {
        if (_isBusy)
            return;

        _errors.Clear();
        if (!Validate(exercise))
            return;

        _isBusy = true;
        exercise.IsSaved = false;
        try
        {
            var result = await WorkoutClient.UpdateExerciseAsync(
                exercise.Id,
                exercise.ToRequest(),
                _disposeCts.Token);
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                return;
            }

            exercise.UpdateFrom(result.Value!);
            exercise.IsSaved = true;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task CompleteAsync()
    {
        if (_isBusy || _workout is null)
            return;

        _errors.Clear();
        if (_exercises.Any(x => x.Status == "NotCompleted"))
        {
            _errors.Add("Оцените каждое упражнение перед завершением тренировки.");
            return;
        }

        if (_exercises.Any(x => !Validate(x)))
            return;

        _isBusy = true;
        try
        {
            foreach (var exercise in _exercises)
            {
                var saveResult = await WorkoutClient.UpdateExerciseAsync(
                    exercise.Id,
                    exercise.ToRequest(),
                    _disposeCts.Token);
                if (!saveResult.Succeeded)
                {
                    _errors.AddRange(saveResult.Errors);
                    return;
                }
                exercise.UpdateFrom(saveResult.Value!);
            }

            var completionResult = await LifecycleClient.CompleteTodayWorkoutAsync(
                _disposeCts.Token);
            if (!completionResult.Succeeded)
            {
                _errors.AddRange(completionResult.Errors);
                return;
            }

            _completedHistory = completionResult.Value;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private bool Validate(ExerciseDraft exercise)
    {
        if (exercise.Sets.Any(x =>
                !double.IsFinite(x.Weight) ||
                x.Weight is < 0 or > 2000 ||
                x.Repetitions is < 1 or > 1000))
        {
            _errors.Add($"Проверьте вес и повторения: {exercise.Name}.");
            return false;
        }

        return true;
    }

    private void CloseCompletion()
    {
        _completedHistory = null;
        _workout = null;
        _exercises.Clear();
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }

    private sealed class ExerciseDraft
    {
        public int Id { get; init; }
        public string Name { get; init; } = string.Empty;
        public int TrainingPlanId { get; init; }
        public int? ExerciseDefinitionId { get; init; }
        public string Status { get; set; } = "NotCompleted";
        public bool IsSaved { get; set; }
        public List<SetDraft> Sets { get; } = [];

        public static ExerciseDraft From(ExerciseApiResponse source)
        {
            var draft = new ExerciseDraft
            {
                Id = source.Id,
                Name = source.Name,
                TrainingPlanId = source.TrainingPlanId,
                ExerciseDefinitionId = source.ExerciseDefinitionId,
                Status = source.Status
            };
            draft.Sets.AddRange(source.Sets
                .OrderBy(x => x.SetNumber)
                .Select(SetDraft.From));
            return draft;
        }

        public SaveExerciseRequest ToRequest() => new(
            Name,
            Sets.Count,
            Status,
            ExerciseDefinitionId,
            Sets.Select(x => new SaveExerciseSetRequest(
                x.SetNumber,
                x.Repetitions,
                x.Weight,
                x.Completed)).ToArray());

        public void UpdateFrom(ExerciseApiResponse source)
        {
            Status = source.Status;
            Sets.Clear();
            Sets.AddRange(source.Sets
                .OrderBy(x => x.SetNumber)
                .Select(SetDraft.From));
        }
    }

    private sealed class SetDraft
    {
        public int SetNumber { get; init; }
        public int Repetitions { get; set; }
        public double Weight { get; set; }
        public bool Completed { get; set; }

        public static SetDraft From(ExerciseSetApiResponse source) => new()
        {
            SetNumber = source.SetNumber,
            Repetitions = source.Repetitions,
            Weight = source.Weight,
            Completed = source.Completed
        };
    }
}
