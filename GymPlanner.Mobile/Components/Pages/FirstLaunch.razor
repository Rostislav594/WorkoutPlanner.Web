@page "/firstlaunch"
@attribute [Authorize]
@implements IDisposable
@inject IWelcomeGuideApiClient WelcomeGuideClient
@inject NavigationManager Navigation

<FinalWelcome IsBusy="_isBusy" ErrorMessage="@_error" OnCompleted="CompleteAsync" />

@code {
    private readonly CancellationTokenSource _disposeCts = new();
    private bool _isBusy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await WelcomeGuideClient.GetStateAsync(_disposeCts.Token);
            if (state.Succeeded && state.Value is { IsCompleted: true })
                Navigation.NavigateTo("/", replace: true);
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
    }

    private async Task CompleteAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _error = null;
        try
        {
            var result = await WelcomeGuideClient.CompleteAsync(_disposeCts.Token);
            if (!result.Succeeded)
                _error = string.Join(" ", result.Errors);
            else
                Navigation.NavigateTo("/", replace: true);
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }
}
