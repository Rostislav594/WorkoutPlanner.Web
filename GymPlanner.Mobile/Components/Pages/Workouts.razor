@page "/workouts"
@attribute [Authorize]
@using WorkoutPlanner.Api.Contracts
@inject IWorkoutApiClient WorkoutClient

<section class="workouts-page" aria-busy="@_isLoading">
    <header class="workouts-header">
        <h1>Шаблоны тренировок</h1>
    </header>

    @if (_errors.Count > 0)
    {
        <div class="workout-form-error" role="alert">@string.Join(" ", _errors)</div>
    }

    @if (_isLoading)
    {
        <div class="workouts-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Загружаем шаблоны…</span>
        </div>
    }
    else if (_plans.Count == 0)
    {
    }
    else
    {
        <div class="workout-grid">
            @foreach (var plan in _plans)
            {
                <article class="workout-card @(_menuPlanId == plan.Id ? "menu-open" : null)">
                    <a class="workout-card-link"
                       href="@($"/workouts/{plan.Id}")"
                       aria-label="Открыть шаблон @plan.WorkoutName">
                        <span class="workout-name">@plan.WorkoutName</span>
                        <span class="workout-description">Упражнений: @plan.Exercises.Count</span>
                    </a>

                    <button class="card-menu-button workout-card-menu"
                            type="button"
                            title="Настройки"
                            aria-label="Настройки шаблона @plan.WorkoutName"
                            aria-haspopup="menu"
                            aria-controls="@($"workout-menu-{plan.Id}")"
                            aria-expanded="@(_menuPlanId == plan.Id)"
                            @onclick="() => ToggleMenu(plan.Id)">
                        <span class="material-symbols-rounded" aria-hidden="true">more_vert</span>
                    </button>

                    @if (_menuPlanId == plan.Id)
                    {
                        <div id="@($"workout-menu-{plan.Id}")"
                             class="context-menu workout-template-menu"
                             role="menu"
                             aria-label="Действия с шаблоном @plan.WorkoutName">
                            <button class="context-item"
                                    type="button"
                                    role="menuitem"
                                    @onclick="() => BeginEdit(plan)">
                                Изменить название
                            </button>
                            <button class="context-item danger-context-item"
                                    type="button"
                                    role="menuitem"
                                    @onclick="() => ConfirmDelete(plan)">
                                Удалить шаблон
                            </button>
                        </div>
                    }
                </article>
            }
        </div>
    }

    <footer class="workouts-footer @(_plans.Count == 0 && !_isLoading ? "workouts-footer-empty" : null)">
        <button class="add-template-button"
                type="button"
                aria-haspopup="dialog"
                disabled="@_isBusy"
                @onclick="OpenCreateDialog">
            <span aria-hidden="true">+</span>
            Добавить шаблон
        </button>
    </footer>
</section>

@if (_menuPlanId is not null)
{
    <div class="context-menu-overlay" @onclick="CloseMenu"></div>
}

@if (_isCreateOpen || _editingId is not null)
{
    <div class="modal-overlay" @onclick="ClosePlanDialog">
        <section class="modal-window"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="plan-dialog-title"
                 @onclick:stopPropagation="true">
            <div class="modal-heading">
                <h2 id="plan-dialog-title">@(_isCreateOpen ? "Новый шаблон" : "Название шаблона")</h2>
                <button class="icon-close-button"
                        type="button"
                        aria-label="Закрыть"
                        disabled="@_isBusy"
                        @onclick="ClosePlanDialog">×</button>
            </div>

            <div class="modal-body">
                <label for="plan-name">Название</label>
                @if (_isCreateOpen)
                {
                    <input id="plan-name"
                           class="form-control"
                           maxlength="120"
                           autofocus
                           @bind="_newName"
                           @bind:event="oninput"
                           autocomplete="off" />
                }
                else
                {
                    <input id="plan-name"
                           class="form-control"
                           maxlength="120"
                           autofocus
                           @bind="_editName"
                           @bind:event="oninput"
                           autocomplete="off" />
                }

                @if (_errors.Count > 0)
                {
                    <div class="edit-error" role="alert">@string.Join(" ", _errors)</div>
                }
            </div>

            <div class="template-dialog-buttons modal-footer">
                @if (_isCreateOpen)
                {
                    <button class="dialog-button primary-button"
                            type="button"
                            disabled="@(_isBusy || string.IsNullOrWhiteSpace(_newName))"
                            @onclick="CreateAsync">
                        @(_isBusy ? "Сохраняем…" : "Сохранить")
                    </button>
                }
                else if (_editingId is int editingId)
                {
                    <button class="dialog-button primary-button"
                            type="button"
                            disabled="@(_isBusy || string.IsNullOrWhiteSpace(_editName))"
                            @onclick="() => RenameAsync(editingId)">
                        @(_isBusy ? "Сохраняем…" : "Сохранить")
                    </button>
                }

                <button class="dialog-button secondary-button"
                        type="button"
                        disabled="@_isBusy"
                        @onclick="ClosePlanDialog">
                    Отмена
                </button>
            </div>
        </section>
    </div>
}

@if (_deleteTarget is not null)
{
    <div class="modal-overlay" @onclick="CloseDeleteDialog">
        <section class="modal-window"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="delete-dialog-title"
                 aria-describedby="delete-dialog-description"
                 @onclick:stopPropagation="true">
            <div class="modal-heading">
                <h2 id="delete-dialog-title">Удалить шаблон?</h2>
                <button class="icon-close-button"
                        type="button"
                        aria-label="Закрыть"
                        disabled="@_isBusy"
                        @onclick="CloseDeleteDialog">×</button>
            </div>
            <div class="modal-body">
                <p id="delete-dialog-description">
                    Будет удалён шаблон <strong>@_deleteTarget.WorkoutName</strong>,
                    его упражнения, назначения в календаре и прогресс.
                </p>
                @if (_errors.Count > 0)
                {
                    <div class="edit-error" role="alert">@string.Join(" ", _errors)</div>
                }
            </div>
            <div class="template-dialog-buttons modal-footer">
                <button class="dialog-button secondary-button"
                        type="button"
                        disabled="@_isBusy"
                        @onclick="CloseDeleteDialog">
                    Отмена
                </button>
                <button class="dialog-button danger-button"
                        type="button"
                        disabled="@_isBusy"
                        @onclick="DeleteAsync">
                    @(_isBusy ? "Удаляем…" : "Удалить")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private readonly List<TrainingPlanApiResponse> _plans = [];
    private readonly List<string> _errors = [];
    private bool _isLoading = true, _isBusy, _isCreateOpen;
    private string _newName = string.Empty, _editName = string.Empty;
    private int? _editingId, _menuPlanId;
    private TrainingPlanApiResponse? _deleteTarget;
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true; _errors.Clear();
        var result = await WorkoutClient.GetPlansAsync();
        if (!result.Succeeded) _errors.AddRange(result.Errors);
        else { _plans.Clear(); _plans.AddRange(result.Value!); }
        _isLoading = false;
    }

    private async Task CreateAsync()
    {
        if (_isBusy || string.IsNullOrWhiteSpace(_newName)) return;
        await RunAsync(() => WorkoutClient.CreatePlanAsync(new(_newName.Trim())), plan => { _plans.Add(plan); _newName = string.Empty; _isCreateOpen = false; });
    }

    private async Task RenameAsync(int id)
    {
        if (_isBusy || string.IsNullOrWhiteSpace(_editName)) return;
        await RunAsync(() => WorkoutClient.RenamePlanAsync(id, new(_editName.Trim())), plan => { Replace(plan); CancelEdit(); });
    }

    private async Task DeleteAsync()
    {
        if (_isBusy || _deleteTarget is null) return;
        _isBusy = true; _errors.Clear();
        var id = _deleteTarget.Id;
        try { var result = await WorkoutClient.DeletePlanAsync(id); if (!result.Succeeded) _errors.AddRange(result.Errors); else { _plans.RemoveAll(x => x.Id == id); _deleteTarget = null; } }
        finally { _isBusy = false; }
    }

    private async Task RunAsync(Func<Task<ApiResult<TrainingPlanApiResponse>>> call, Action<TrainingPlanApiResponse> success)
    {
        _isBusy = true; _errors.Clear();
        try { var result = await call(); if (!result.Succeeded) _errors.AddRange(result.Errors); else success(result.Value!); }
        finally { _isBusy = false; }
    }

    private void Replace(TrainingPlanApiResponse plan) { var index = _plans.FindIndex(x => x.Id == plan.Id); if (index >= 0) _plans[index] = plan; }
    private void OpenCreateDialog() { _errors.Clear(); _newName = string.Empty; _isCreateOpen = true; CloseMenu(); }
    private void BeginEdit(TrainingPlanApiResponse plan) { _errors.Clear(); _editingId = plan.Id; _editName = plan.WorkoutName; CloseMenu(); }
    private void CancelEdit() { _editingId = null; _editName = string.Empty; }
    private void ConfirmDelete(TrainingPlanApiResponse plan) { _deleteTarget = plan; CloseMenu(); }
    private void ToggleMenu(int id) => _menuPlanId = _menuPlanId == id ? null : id;
    private void CloseMenu() => _menuPlanId = null;
    private void ClosePlanDialog() { if (_isBusy) return; _isCreateOpen = false; _newName = string.Empty; CancelEdit(); _errors.Clear(); }
    private void CloseDeleteDialog() { if (_isBusy) return; _deleteTarget = null; }
}
