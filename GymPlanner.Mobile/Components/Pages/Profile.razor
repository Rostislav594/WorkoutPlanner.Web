@page "/profile"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using WorkoutPlanner.Api.Contracts
@inject IProfileApiClient ProfileClient
@inject MobileAuthenticationService Authentication
@inject NavigationManager Navigation

<section class="profile-page" aria-busy="@_isLoading">
    @if (_isLoading)
    {
        <div class="profile-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Загружаем профиль…</span>
        </div>
    }
    else if (_loadErrors.Count > 0)
    {
        <div class="load-error">
            <div class="auth-error" role="alert">@string.Join(" ", _loadErrors)</div>
            <button class="profile-secondary-action" type="button" @onclick="LoadAsync">Повторить</button>
        </div>
    }
    else
    {
        <div class="profile-shell">
            <main class="profile-main">
                @if (_tab == ProfileTab.Details)
                {
                    <section class="profile-panel">
                        <header class="profile-heading">
                            <p class="profile-kicker">Профиль пользователя</p>
                            <h1>@(_profile?.HasProfile == true ? FullName : "Настройка профиля")</h1>
                            <p>@(_profile?.Email ?? Authentication.CurrentEmail)</p>
                        </header>

                        @if (!string.IsNullOrWhiteSpace(_message))
                        {
                            <div class="profile-success" role="status">@_message</div>
                        }
                        @if (_operationErrors.Count > 0)
                        {
                            <div class="auth-error operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
                        }

                        <EditForm Model="_profileInput" OnValidSubmit="SaveProfileAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="validation-summary" />

                            <div class="profile-form-grid">
                                <div class="field">
                                    <label for="profile-email">Email</label>
                                    <input id="profile-email" class="auth-input" value="@(_profile?.Email ?? Authentication.CurrentEmail)" readonly />
                                </div>
                                <div class="field">
                                    <label for="profile-first-name">Имя</label>
                                    <InputText id="profile-first-name" class="auth-input" @bind-Value="_profileInput.FirstName" autocomplete="given-name" />
                                    <ValidationMessage For="@(() => _profileInput.FirstName)" />
                                </div>
                                <div class="field">
                                    <label for="profile-last-name">Фамилия</label>
                                    <InputText id="profile-last-name" class="auth-input" @bind-Value="_profileInput.LastName" autocomplete="family-name" />
                                    <ValidationMessage For="@(() => _profileInput.LastName)" />
                                </div>
                                <div class="field">
                                    <label for="profile-birth-date">Дата рождения</label>
                                    <InputDate id="profile-birth-date" class="auth-input" @bind-Value="_profileInput.BirthDate" />
                                    <ValidationMessage For="@(() => _profileInput.BirthDate)" />
                                </div>
                                <div class="field">
                                    <label for="profile-gender">Пол</label>
                                    <InputSelect id="profile-gender" class="auth-input" @bind-Value="_profileInput.Gender">
                                        <option value="">Выберите</option>
                                        <option value="Мужской">Мужской</option>
                                        <option value="Женский">Женский</option>
                                        <option value="Не указывать">Не указывать</option>
                                    </InputSelect>
                                    <ValidationMessage For="@(() => _profileInput.Gender)" />
                                </div>
                            </div>

                            <button class="profile-primary-action" type="submit" disabled="@_isSaving">
                                @(_isSaving ? "Сохраняем…" : "Сохранить изменения")
                            </button>
                        </EditForm>

                        <hr class="profile-divider" />

                        <div class="profile-danger-zone">

                            <button class="profile-danger-action" type="button" @onclick="() => _confirmDeletion = true">Удалить аккаунт</button>
                        </div>
                    </section>
                }
                else if (_tab == ProfileTab.Security)
                {
                    <section class="profile-panel profile-actions-panel">
                        <header class="profile-heading">
                            <p class="profile-kicker">Безопасность</p>
                            <h1>Настройки безопасности</h1>
                        </header>

                        @if (_operationErrors.Count > 0)
                        {
                            <div class="auth-error operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
                        }

                        <div class="settings-section">
                            <h2>Смена пароля</h2>
                            <EditForm Model="_passwordInput" OnValidSubmit="ChangePasswordAsync">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="validation-summary" />

                                <div class="profile-form-grid password-grid">
                                    <div class="field">
                                        <label for="current-password">Текущий пароль</label>
                                        <InputText id="current-password" class="auth-input" type="password" @bind-Value="_passwordInput.CurrentPassword" autocomplete="current-password" />
                                    </div>
                                    <div class="field">
                                        <label for="new-password">Новый пароль</label>
                                        <InputText id="new-password" class="auth-input" type="password" @bind-Value="_passwordInput.NewPassword" autocomplete="new-password" />
                                    </div>
                                    <div class="field">
                                        <label for="confirm-password">Подтверждение нового пароля</label>
                                        <InputText id="confirm-password" class="auth-input" type="password" @bind-Value="_passwordInput.ConfirmPassword" autocomplete="new-password" />
                                    </div>
                                </div>

                                <button class="profile-secondary-action password-submit" type="submit" disabled="@_isSecurityBusy">
                                    @(_isSecurityBusy ? "Выполняем…" : "Изменить пароль")
                                </button>
                            </EditForm>
                        </div>
                    </section>
                }
                else
                {
                    <section class="profile-panel">
                        <header class="profile-heading">
                            <p class="profile-kicker">Обучение</p>
                            <h1>Настройки тренировок</h1>
                            <p>Интерактивное знакомство с планами, календарём, историей и прогрессом.</p>
                        </header>

                        <div class="training-card">
                            <span class="training-icon material-symbols-rounded" aria-hidden="true">school</span>
                            <div>
                                <h2>Знакомство с GymPlanner</h2>
                                <p>Пройдите мобильную экскурсию повторно или продолжите с сохранённого шага.</p>
                            </div>
                            <a class="profile-secondary-action" href="/onboarding">Открыть обучение</a>
                        </div>
                    </section>
                }
            </main>

            <aside class="profile-sidebar" aria-label="Разделы профиля">
                <button class="@TabClass(ProfileTab.Details)" type="button" @onclick="() => SelectTab(ProfileTab.Details)">
                    <span class="material-symbols-rounded" aria-hidden="true">person</span>
                    <span>Профиль</span>
                </button>
                <button class="@TabClass(ProfileTab.Security)" type="button" @onclick="() => SelectTab(ProfileTab.Security)">
                    <span class="material-symbols-rounded" aria-hidden="true">shield</span>
                    <span>Настройки безопасности</span>
                </button>
                <button class="@TabClass(ProfileTab.Training)" type="button" @onclick="() => SelectTab(ProfileTab.Training)">
                    <span class="material-symbols-rounded" aria-hidden="true">fitness_center</span>
                    <span>Настройки тренировок</span>
                </button>
            </aside>
        </div>
    }
</section>

@if (_confirmDeletion)
{
    <div class="modal-overlay" @onclick="CloseDeleteDialog">
        <section class="modal-window delete-modal"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="delete-account-title"
                 @onclick:stopPropagation="true">
            <span class="delete-icon material-symbols-rounded" aria-hidden="true">warning</span>
            <h2 id="delete-account-title">Удаление аккаунта</h2>
            <p>Вы действительно хотите удалить аккаунт?</p>
            <p class="warning-copy">Будут удалены профиль, планы, история тренировок, прогресс, фотографии и все пользовательские данные.</p>

            @if (_operationErrors.Count > 0)
            {
                <div class="auth-error operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
            }

            <div class="dialog-actions">
                <button class="profile-secondary-action" type="button" disabled="@_isSecurityBusy" @onclick="CloseDeleteDialog">Отмена</button>
                <button class="profile-danger-action" type="button" disabled="@_isSecurityBusy" @onclick="DeleteAccountAsync">
                    @(_isSecurityBusy ? "Удаляем…" : "Удалить навсегда")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private readonly ProfileInput _profileInput = new();
    private readonly PasswordInput _passwordInput = new();
    private readonly List<string> _loadErrors = [];
    private readonly List<string> _operationErrors = [];
    private ProfileResponse? _profile;
    private ProfileTab _tab;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSecurityBusy;
    private bool _confirmDeletion;
    private string? _message;
    private string FullName => $"{_profileInput.FirstName} {_profileInput.LastName}".Trim();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadErrors.Clear();
        var result = await ProfileClient.GetAsync();
        if (!result.Succeeded)
            _loadErrors.AddRange(result.Errors);
        else
        {
            _profile = result.Value;
            _profileInput.FirstName = _profile!.FirstName;
            _profileInput.LastName = _profile.LastName;
            _profileInput.BirthDate = _profile.BirthDate;
            _profileInput.Gender = _profile.Gender;
        }
        _isLoading = false;
    }

    private async Task SaveProfileAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        ClearOperationState();
        try
        {
            var result = await ProfileClient.SaveAsync(new(
                _profileInput.FirstName, _profileInput.LastName,
                _profileInput.BirthDate, _profileInput.Gender));
            if (!result.Succeeded) _operationErrors.AddRange(result.Errors);
            else { _profile = result.Value; _message = "Профиль сохранён."; }
        }
        finally { _isSaving = false; }
    }

    private async Task ChangePasswordAsync()
    {
        if (_isSecurityBusy) return;
        _isSecurityBusy = true;
        ClearOperationState();
        try
        {
            var result = await ProfileClient.ChangePasswordAsync(new(
                _passwordInput.CurrentPassword, _passwordInput.NewPassword));
            if (!result.Succeeded) { _operationErrors.AddRange(result.Errors); return; }
            await Authentication.ClearAsync();
            Navigation.NavigateTo("/account/login", replace: true);
        }
        finally { _isSecurityBusy = false; }
    }

    private async Task DeleteAccountAsync() => await EndAccountSessionAsync(ProfileClient.DeleteAccountAsync);

    private async Task EndAccountSessionAsync(Func<CancellationToken, Task<ApiResult>> action)
    {
        if (_isSecurityBusy) return;
        _isSecurityBusy = true;
        ClearOperationState();
        try
        {
            var result = await action(CancellationToken.None);
            if (!result.Succeeded) { _operationErrors.AddRange(result.Errors); return; }
            await Authentication.ClearAsync();
            Navigation.NavigateTo("/account/login", replace: true);
        }
        finally { _isSecurityBusy = false; }
    }

    private void SelectTab(ProfileTab tab)
    {
        _tab = tab;
        _confirmDeletion = false;
        ClearOperationState();
    }

    private void CloseDeleteDialog()
    {
        if (_isSecurityBusy) return;
        _confirmDeletion = false;
        _operationErrors.Clear();
    }

    private void ClearOperationState() { _operationErrors.Clear(); _message = null; }
    private string TabClass(ProfileTab tab) => $"profile-tab {(_tab == tab ? "active" : string.Empty)}";

    private sealed class ProfileInput
    {
        [Required, MaxLength(80)] public string FirstName { get; set; } = string.Empty;
        [Required, MaxLength(80)] public string LastName { get; set; } = string.Empty;
        [Required] public DateTime? BirthDate { get; set; }
        [Required] public string Gender { get; set; } = string.Empty;
    }

    private sealed class PasswordInput
    {
        [Required] public string CurrentPassword { get; set; } = string.Empty;
        [Required, MinLength(6)] public string NewPassword { get; set; } = string.Empty;
        [Compare(nameof(NewPassword), ErrorMessage = "Пароли не совпадают.")] public string ConfirmPassword { get; set; } = string.Empty;
    }

    private enum ProfileTab { Details, Security, Training }
}
