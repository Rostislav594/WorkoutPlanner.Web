@page "/profile"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Logging
@using WorkoutPlanner.Api.Contracts
@inject IProfileApiClient ProfileClient
@inject ISupportApiClient SupportClient
@inject IMobilePhotoPicker PhotoPicker
@inject MobileAuthenticationService Authentication
@inject NavigationManager Navigation
@inject ILogger<Profile> Logger
@inject IAppText Text

<section class="profile-page" aria-busy="@_isLoading" aria-label="@Text["Profile_Title"]">
    @if (_isLoading)
    {
        <div class="profile-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>@Text["Profile_Loading"]</span>
        </div>
    }
    else if (_loadErrors.Count > 0)
    {
        <div class="load-error">
            <div class="auth-error" role="alert">@string.Join(" ", _loadErrors)</div>
            <button class="profile-secondary-action" type="button" @onclick="LoadAsync">@Text["Common_Retry"]</button>
        </div>
    }
    else
    {
        <header class="profile-title-row page-title-row">
            <h1 id="profile-title">@Text["Profile_Title"]</h1>
            <HelpButton Topic="HelpContentCatalog.Profile" />
        </header>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div class="profile-success" role="status">@_message</div>
        }
        @if (_operationErrors.Count > 0 && _dialog == ProfileDialog.None && !_confirmDeletion)
        {
            <div class="auth-error operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
        }

        <article class="profile-identity-card">
            <div class="profile-avatar" aria-label="@Text["Profile_Avatar"]">@ProfileInitials</div>
            <div class="profile-identity-copy">
                <h2>@DisplayName</h2>
                <p>@DisplayEmail</p>
            </div>
        </article>

        <div class="profile-sections">
            @foreach (var section in ProfileSections)
            {
                <section class="settings-section" aria-label="@section.Title">
                    <div class="settings-group">
                        @foreach (var item in section.Items)
                        {
                            @if (IsAvailable(item))
                            {
                            <a class="@RowClass(item)" href="@item.Route">
                                <span class="settings-icon material-symbols-rounded" aria-hidden="true">@item.Icon</span>
                                <span class="settings-label">@item.Label</span>
                                @if (!string.IsNullOrWhiteSpace(item.Value))
                                {
                                    <span class="@ValueClass(item)">@item.Value</span>
                                }
                                @if (item.ShowChevron)
                                {
                                    <span class="settings-chevron material-symbols-rounded" aria-hidden="true">chevron_right</span>
                                }
                            </a>
                            }
                            else
                            {
                                <div class="@RowClass(item)" aria-label="@Text.Format("Profile_SectionNotReady", item.Label)">
                                    <span class="settings-icon material-symbols-rounded" aria-hidden="true">@item.Icon</span>
                                    <span class="settings-label">@item.Label</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Value))
                                    {
                                        <span class="@ValueClass(item)">@item.Value</span>
                                    }
                                    @if (item.ShowChevron)
                                    {
                                        <span class="settings-chevron material-symbols-rounded" aria-hidden="true">chevron_right</span>
                                    }
                                </div>
                            }
                        }
                    </div>
                </section>
            }
        </div>
    }
</section>

@if (_dialog == ProfileDialog.EditProfile)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <section class="modal-window profile-dialog" role="dialog" aria-modal="true" aria-labelledby="edit-profile-title" @onclick:stopPropagation="true">
            <header class="dialog-header">
                <div>
                    <p class="profile-eyebrow">@Text["ProfileSection_PersonalData"]</p>
                    <h2 id="edit-profile-title">@Text["Profile_EditTitle"]</h2>
                </div>
                <button class="dialog-close" type="button" aria-label="@Text["Common_Close"]" disabled="@_isSaving" @onclick="CloseDialog">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </header>

            @if (_operationErrors.Count > 0)
            {
                <div class="auth-error operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
            }

            <EditForm Model="_profileInput" OnValidSubmit="SaveProfileAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />
                <div class="profile-form-grid">
                    <div class="field">
                        <label for="profile-email">Email</label>
                        <input id="profile-email" class="auth-input" value="@DisplayEmail" readonly />
                    </div>
                    <div class="field">
                        <label for="profile-first-name">@Text["Common_FirstName"]</label>
                        <InputText id="profile-first-name" class="auth-input" @bind-Value="_profileInput.FirstName" autocomplete="given-name" />
                        <ValidationMessage For="@(() => _profileInput.FirstName)" />
                    </div>
                    <div class="field">
                        <label for="profile-last-name">@Text["Common_LastName"]</label>
                        <InputText id="profile-last-name" class="auth-input" @bind-Value="_profileInput.LastName" autocomplete="family-name" />
                        <ValidationMessage For="@(() => _profileInput.LastName)" />
                    </div>
                    <div class="field">
                        <label for="profile-birth-date">@Text["Common_BirthDate"]</label>
                        <InputDate id="profile-birth-date" class="auth-input" @bind-Value="_profileInput.BirthDate" />
                        <ValidationMessage For="@(() => _profileInput.BirthDate)" />
                    </div>
                    <div class="field">
                        <label for="profile-gender">@Text["Common_Gender"]</label>
                        <SystemChoiceField id="profile-gender"
                                           class="auth-input"
                                           Title="@Text["Common_Gender"]"
                                           Options="GenderOptions"
                                           @bind-Value="_profileInput.Gender"
                                           AriaLabel="@Text["ProfileSetup_SelectGender"]" />
                        <ValidationMessage For="@(() => _profileInput.Gender)" />
                    </div>
                </div>
                <button class="profile-primary-action" type="submit" disabled="@_isSaving">
                    @(_isSaving ? Text["Common_Saving"] : Text["Profile_SaveChanges"])
                </button>
            </EditForm>
        </section>
    </div>
}

@if (_dialog == ProfileDialog.ChangePassword)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <section class="modal-window profile-dialog" role="dialog" aria-modal="true" aria-labelledby="change-password-title" @onclick:stopPropagation="true">
            <header class="dialog-header">
                <div>
                    <p class="profile-eyebrow">@Text["ProfileSection_Security"]</p>
                    <h2 id="change-password-title">@Text["ProfileItem_ChangePassword"]</h2>
                </div>
                <button class="dialog-close" type="button" aria-label="@Text["Common_Close"]" disabled="@_isSecurityBusy" @onclick="CloseDialog">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </header>

            @if (_operationErrors.Count > 0)
            {
                <div class="auth-error operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
            }

            <EditForm Model="_passwordInput" OnValidSubmit="ChangePasswordAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />
                <div class="profile-form-grid">
                    <div class="field">
                        <label for="current-password">@Text["Profile_CurrentPassword"]</label>
                        <InputText id="current-password" class="auth-input" type="password" @bind-Value="_passwordInput.CurrentPassword" autocomplete="current-password" />
                    </div>
                    <div class="field">
                        <label for="new-password">@Text["Profile_NewPassword"]</label>
                        <InputText id="new-password" class="auth-input" type="password" @bind-Value="_passwordInput.NewPassword" autocomplete="new-password" />
                    </div>
                    <div class="field">
                        <label for="confirm-password">@Text["Profile_ConfirmNewPassword"]</label>
                        <InputText id="confirm-password" class="auth-input" type="password" @bind-Value="_passwordInput.ConfirmPassword" autocomplete="new-password" />
                    </div>
                </div>
                <button class="profile-primary-action" type="submit" disabled="@_isSecurityBusy">
                    @(_isSecurityBusy ? Text["Profile_PasswordBusy"] : Text["ProfileItem_ChangePassword"])
                </button>
            </EditForm>
        </section>
    </div>
}

@if (_dialog == ProfileDialog.RestTimers)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <section class="modal-window profile-dialog" role="dialog" aria-modal="true" aria-labelledby="rest-timers-title" @onclick:stopPropagation="true">
            <header class="dialog-header">
                <div>
                    <p class="profile-eyebrow">@Text["Nav_Workouts"]</p>
                    <h2 id="rest-timers-title">@Text["ProfileItem_RestTimers"]</h2>
                </div>
                <button class="dialog-close" type="button" aria-label="@Text["Common_Close"]" disabled="@_isSaving" @onclick="CloseDialog">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </header>
            <p class="timer-settings-hint">@Text["Profile_RestTimersHint"]</p>
            @if (_operationErrors.Count > 0)
            {
                <div class="auth-error operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
            }
            <div class="profile-form-grid">
                <label class="field" for="rest-between-sets">
                    <span>@Text["Profile_RestBetweenSets"]</span>
                    <input id="rest-between-sets" class="auth-input" type="number" min="5" max="3600" @bind="_restBetweenSetsSeconds" />
                </label>
                <label class="field" for="rest-between-exercises">
                    <span>@Text["Profile_RestBetweenExercises"]</span>
                    <input id="rest-between-exercises" class="auth-input" type="number" min="5" max="3600" @bind="_restBetweenExercisesSeconds" />
                </label>
            </div>
            <button class="profile-primary-action" type="button" disabled="@_isSaving" @onclick="SaveRestTimersAsync">
                @(_isSaving ? Text["Common_Saving"] : Text["Profile_ApplyToAllTimers"])
            </button>
        </section>
    </div>
}

@if (_dialog == ProfileDialog.ReportProblem)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <section class="modal-window profile-dialog support-dialog" role="dialog" aria-modal="true" aria-labelledby="report-problem-title" @onclick:stopPropagation="true">
            <header class="dialog-header">
                <div>
                    <p class="profile-eyebrow">@Text["Profile_SupportEyebrow"]</p>
                    <h2 id="report-problem-title">@Text["ProfileItem_ReportProblem"]</h2>
                </div>
                <button class="dialog-close" type="button" aria-label="@Text["Common_Close"]" disabled="@_isSupportBusy" @onclick="CloseDialog">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </header>

            @if (_supportErrors.Count > 0)
            {
                <div class="auth-error operation-error" role="alert">@string.Join(" ", _supportErrors)</div>
            }

            <div class="support-field">
                <label for="support-message">@Text["Profile_SupportQuestion"]</label>
                <textarea id="support-message"
                          maxlength="2000"
                          placeholder="@Text["Profile_SupportPlaceholder"]"
                          aria-describedby="support-message-hint support-privacy-note"
                          @bind="_supportMessage"
                          @bind:event="oninput"></textarea>
                <div class="support-field-meta">
                    <span id="support-message-hint">@Text["Profile_SupportHint"]</span>
                    <span>@_supportMessage.Length / 2000</span>
                </div>
            </div>

            @if (_supportScreenshot is null)
            {
                <button class="support-attachment-button" type="button" disabled="@_isSupportBusy" @onclick="PickSupportScreenshotAsync">
                    <span class="material-symbols-rounded" aria-hidden="true">add_photo_alternate</span>
                    <span>@Text["Profile_AddScreenshot"]</span>
                    <small>@Text["Profile_ScreenshotFormats"]</small>
                </button>
            }
            else
            {
                <div class="support-attachment-preview">
                    <img src="@SupportScreenshotDataUri" alt="@Text["Profile_ScreenshotAlt"]" />
                    <div>
                        <strong>@Text["Profile_ScreenshotAttached"]</strong>
                        <span>@_supportScreenshot.FileName</span>
                    </div>
                    <button type="button" aria-label="@Text["Profile_RemoveScreenshot"]" disabled="@_isSupportBusy" @onclick="RemoveSupportScreenshot">
                        <span class="material-symbols-rounded" aria-hidden="true">delete</span>
                    </button>
                </div>
            }

            <p id="support-privacy-note" class="support-privacy-note">
                <span class="material-symbols-rounded" aria-hidden="true">shield</span>
                <span>@Text["Profile_NoSecrets"]</span>
            </p>

            <div class="support-dialog-actions">
                <button class="profile-primary-action support-submit" type="button" disabled="@(_isSupportBusy || _supportMessage.Trim().Length < 10)" @onclick="SubmitSupportTicketAsync">
                    @if (_isSupportBusy)
                    {
                        <span class="loading-spinner loading-spinner--small" aria-hidden="true"></span>
                        <span>@Text["Profile_Sending"]</span>
                    }
                    else
                    {
                        <span class="material-symbols-rounded" aria-hidden="true">send</span>
                        <span>@Text["Profile_Send"]</span>
                    }
                </button>
            </div>
        </section>
    </div>
}

@if (_confirmDeletion)
{
    <div class="modal-overlay" @onclick="CloseDeleteDialog">
        <section class="modal-window delete-modal" role="alertdialog" aria-modal="true" aria-labelledby="delete-account-title" aria-describedby="delete-account-description" @onclick:stopPropagation="true">
            <span class="delete-icon material-symbols-rounded" aria-hidden="true">warning</span>
            <h2 id="delete-account-title">@Text["Profile_DeleteAccountTitle"]</h2>
            <p id="delete-account-description">@Text["Profile_DeleteAccountQuestion"]</p>
            <p class="warning-copy">@Text["Profile_DeleteAccountWarning"]</p>
            @if (_operationErrors.Count > 0)
            {
                <div class="auth-error operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
            }
            <div class="dialog-actions">
                <button class="profile-secondary-action" type="button" disabled="@_isSecurityBusy" @onclick="CloseDeleteDialog">@Text["Common_Cancel"]</button>
                <button class="profile-danger-action" type="button" disabled="@_isSecurityBusy" @onclick="DeleteAccountAsync">
                    @(_isSecurityBusy ? Text["Common_Deleting"] : Text["Profile_DeleteForever"])
                </button>
            </div>
        </section>
    </div>
}

@code {
    // Значение остаётся русским: оно уходит на сервер и хранится в профиле.
    // Переводится только подпись, которую видит пользователь.
    private IReadOnlyList<SystemChoiceOption> GenderOptions =>
    [
        new("Мужской", Text["Gender_Male"]),
        new("Женский", Text["Gender_Female"]),
        new("Не указывать", Text["Gender_Unspecified"])
    ];

    private IReadOnlyList<ProfileSection> ProfileSections =>
    [
        new("personal-data", Text["ProfileSection_PersonalData"], [new("badge", Text["ProfileItem_PersonalInformation"], "/profile/personal-information")]),
        new("training", Text["Nav_Workouts"], [new("timer", Text["ProfileItem_RestTimers"], "/profile/rest-timers")]),
        new("devices", Text["ProfileSection_Devices"], [new("watch", Text["ProfileItem_Watch"], "/profile/devices")]),
        new("application", Text["ProfileSection_Application"], [new("notifications", Text["ProfileItem_Notifications"], "/profile/notifications"), new("language", Text["Profile_Language_Title"], "/profile/language")]),
        new("data", Text["ProfileSection_Data"], [new("database", Text["ProfileItem_MyData"], "/profile/my-data")]),
        new("security", Text["ProfileSection_Security"], [new("password", Text["ProfileItem_ChangePassword"], "/profile/change-password")]),
        new("support", Text["ProfileSection_Support"], [new("bug_report", Text["ProfileItem_ReportProblem"], "/profile/report-problem"), new("lightbulb", Text["Profile_SuggestIdea_Title"], "/profile/suggest-idea")]),
        new("about", Text["ProfileSection_About"], [new("privacy_tip", Text["ProfileItem_Privacy"], "/profile/privacy"), new("tag", Text["ProfileItem_Version"], "/profile/about", ShowChevron: false), new("logout", Text["ProfileItem_Logout"], "/profile/logout", IsStandalone: true)]),
        new("danger-zone", Text["ProfileSection_DangerZone"], [new("delete_forever", Text["ProfileItem_DeleteAccount"], "/profile/delete-account", ShowChevron: false, IsDanger: true)])
    ];

    private readonly ProfileInput _profileInput = new();
    private readonly PasswordInput _passwordInput = new();
    private readonly List<string> _loadErrors = [];
    private readonly List<string> _operationErrors = [];
    private readonly List<string> _supportErrors = [];
    private ProfileResponse? _profile;
    private PickedPhoto? _supportScreenshot;
    private ProfileDialog _dialog;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSecurityBusy;
    private bool _isSupportBusy;
    private bool _confirmDeletion;
    private string? _message;
    private string _supportMessage = string.Empty;
    private int _restBetweenSetsSeconds = 90;
    private int _restBetweenExercisesSeconds = 120;
    private string FullName => $"{_profileInput.FirstName} {_profileInput.LastName}".Trim();
    private string DisplayName => string.IsNullOrWhiteSpace(FullName) ? Text["Profile_DefaultName"] : FullName;
    private string DisplayEmail => _profile?.Email ?? Authentication.CurrentEmail ?? string.Empty;
    private string? SupportScreenshotDataUri => _supportScreenshot is null
        ? null
        : $"data:{_supportScreenshot.ContentType};base64,{Convert.ToBase64String(_supportScreenshot.Content)}";
    private string ProfileInitials
    {
        get
        {
            var initials = new[] { _profileInput.FirstName, _profileInput.LastName }
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => char.ToUpperInvariant(value.Trim()[0]));
            var result = string.Concat(initials);
            return string.IsNullOrWhiteSpace(result) ? "GP" : result;
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadErrors.Clear();
        var result = await ProfileClient.GetAsync();
        if (!result.Succeeded)
            _loadErrors.AddRange(result.Errors);
        else
        {
            _profile = result.Value;
            _profileInput.FirstName = _profile!.FirstName;
            _profileInput.LastName = _profile.LastName;
            _profileInput.BirthDate = _profile.BirthDate;
            _profileInput.Gender = _profile.Gender;
            _restBetweenSetsSeconds = _profile.RestBetweenSetsSeconds;
            _restBetweenExercisesSeconds = _profile.RestBetweenExercisesSeconds;
        }
        _isLoading = false;
    }

    private async Task SaveProfileAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        ClearOperationState();
        try
        {
            var result = await ProfileClient.SaveAsync(new(_profileInput.FirstName, _profileInput.LastName, _profileInput.BirthDate, _profileInput.Gender));
            if (!result.Succeeded)
                _operationErrors.AddRange(result.Errors);
            else
            {
                _profile = result.Value;
                _message = Text["Profile_Saved"];
                _dialog = ProfileDialog.None;
            }
        }
        finally { _isSaving = false; }
    }

    private async Task ChangePasswordAsync()
    {
        if (_isSecurityBusy) return;
        _isSecurityBusy = true;
        ClearOperationState();
        try
        {
            var result = await ProfileClient.ChangePasswordAsync(new(_passwordInput.CurrentPassword, _passwordInput.NewPassword));
            if (!result.Succeeded) { _operationErrors.AddRange(result.Errors); return; }
            await Authentication.ClearAsync();
            Navigation.NavigateTo("/account/login", replace: true);
        }
        finally { _isSecurityBusy = false; }
    }

    private async Task SaveRestTimersAsync()
    {
        if (_isSaving) return;
        if (_restBetweenSetsSeconds is < 5 or > 3600 || _restBetweenExercisesSeconds is < 5 or > 3600)
        {
            _operationErrors.Clear();
            _operationErrors.Add(Text["Profile_RestTimerRange"]);
            return;
        }

        _isSaving = true;
        ClearOperationState();
        try
        {
            var result = await ProfileClient.SaveRestTimerSettingsAsync(new(_restBetweenSetsSeconds, _restBetweenExercisesSeconds));
            if (!result.Succeeded)
            {
                _operationErrors.AddRange(result.Errors);
                return;
            }

            _restBetweenSetsSeconds = result.Value!.RestBetweenSetsSeconds;
            _restBetweenExercisesSeconds = result.Value.RestBetweenExercisesSeconds;
            if (_profile is not null)
                _profile = _profile with { RestBetweenSetsSeconds = _restBetweenSetsSeconds, RestBetweenExercisesSeconds = _restBetweenExercisesSeconds };
            _message = Text["Profile_RestTimersApplied"];
            _dialog = ProfileDialog.None;
        }
        finally { _isSaving = false; }
    }

    private async Task HandleActionAsync(ProfileAction action)
    {
        ClearOperationState();
        switch (action)
        {
            case ProfileAction.ChangePassword:
                _dialog = ProfileDialog.ChangePassword;
                break;
            case ProfileAction.RestTimers:
                _dialog = ProfileDialog.RestTimers;
                break;
            case ProfileAction.ReportProblem:
                _supportErrors.Clear();
                _dialog = ProfileDialog.ReportProblem;
                break;
            case ProfileAction.Logout:
                await LogoutAsync();
                break;
            case ProfileAction.DeleteAccount:
                _confirmDeletion = true;
                break;
        }
    }

    private async Task LogoutAsync()
    {
        if (_isSecurityBusy) return;
        _isSecurityBusy = true;
        try
        {
            var result = await Authentication.LogoutAsync();
            if (!result.Succeeded) { _operationErrors.AddRange(result.Errors); return; }
            Navigation.NavigateTo("/account/login", replace: true);
        }
        finally { _isSecurityBusy = false; }
    }

    private async Task PickSupportScreenshotAsync()
    {
        if (_isSupportBusy) return;
        _supportErrors.Clear();
        var result = await PhotoPicker.PickAsync(MobilePhotoSource.Library);
        if (result.Succeeded)
            _supportScreenshot = result.Photo;
        else if (!result.Cancelled)
            _supportErrors.AddRange(result.Errors);
    }

    private void RemoveSupportScreenshot()
    {
        if (_isSupportBusy) return;
        _supportScreenshot = null;
    }

    private async Task SubmitSupportTicketAsync()
    {
        if (_isSupportBusy) return;
        _supportErrors.Clear();
        var message = _supportMessage.Trim();
        if (message.Length < 10)
        {
            _supportErrors.Add(Text["Profile_SupportTooShort"]);
            return;
        }

        _isSupportBusy = true;
        try
        {
            var result = await SupportClient.CreateAsync(
                message,
                _supportScreenshot,
                GetSupportDeviceContext());
            if (!result.Succeeded)
            {
                _supportErrors.AddRange(result.Errors);
                return;
            }

            var ticketNumber = result.Value!.TicketNumber;
            ResetSupportDraft();
            _dialog = ProfileDialog.None;
            _message = Text.Format("Profile_SupportSent", ticketNumber);
        }
        finally
        {
            _isSupportBusy = false;
        }
    }

    private SupportDeviceContext GetSupportDeviceContext()
    {
        try
        {
            var deviceModel = string.Join(
                " ",
                new[] { DeviceInfo.Current.Manufacturer, DeviceInfo.Current.Model }
                    .Where(value => !string.IsNullOrWhiteSpace(value)));
            return new SupportDeviceContext(
                AppInfo.Current.VersionString,
                DeviceInfo.Current.Platform.ToString(),
                DeviceInfo.Current.VersionString,
                deviceModel);
        }
        catch (Exception exception)
        {
            Logger.LogDebug(
                exception,
                "Device context is unavailable for a support ticket.");
            return new SupportDeviceContext(null, null, null, null);
        }
    }

    private async Task DeleteAccountAsync() => await EndAccountSessionAsync(ProfileClient.DeleteAccountAsync);

    private async Task EndAccountSessionAsync(Func<CancellationToken, Task<ApiResult>> action)
    {
        if (_isSecurityBusy) return;
        _isSecurityBusy = true;
        ClearOperationState();
        try
        {
            var result = await action(CancellationToken.None);
            if (!result.Succeeded) { _operationErrors.AddRange(result.Errors); return; }
            await Authentication.ClearAsync();
            Navigation.NavigateTo("/account/login", replace: true);
        }
        finally { _isSecurityBusy = false; }
    }

    private void OpenEditDialog()
    {
        ClearOperationState();
        _dialog = ProfileDialog.EditProfile;
    }

    private void CloseDialog()
    {
        if (_isSaving || _isSecurityBusy || _isSupportBusy) return;
        if (_dialog == ProfileDialog.ReportProblem)
            ResetSupportDraft();
        _dialog = ProfileDialog.None;
        _operationErrors.Clear();
    }

    private void ResetSupportDraft()
    {
        _supportMessage = string.Empty;
        _supportScreenshot = null;
        _supportErrors.Clear();
    }

    private void CloseDeleteDialog()
    {
        if (_isSecurityBusy) return;
        _confirmDeletion = false;
        _operationErrors.Clear();
    }

    private void ClearOperationState() { _operationErrors.Clear(); _message = null; }
    private static string RowClass(ProfileItem item) => $"settings-row{(item.IsDanger ? " settings-row--danger" : string.Empty)}{(item.IsStandalone ? " settings-row--standalone" : string.Empty)}";
    private static string ValueClass(ProfileItem item) => item.IsStatus ? "settings-value settings-value--status" : "settings-value";
    private static bool IsAvailable(ProfileItem item) => item.Route is
        "/profile/personal-information" or
        "/profile/devices" or
        "/profile/my-data" or
        "/profile/rest-timers" or
        "/profile/change-password" or
        "/profile/report-problem" or
        "/profile/suggest-idea" or
        "/profile/language" or
        "/profile/logout" or
        "/profile/delete-account";

    private sealed class ProfileInput
    {
        [Required, MaxLength(80)] public string FirstName { get; set; } = string.Empty;
        [Required, MaxLength(80)] public string LastName { get; set; } = string.Empty;
        [Required] public DateTime? BirthDate { get; set; }
        [Required] public string Gender { get; set; } = string.Empty;
    }

    private sealed class PasswordInput
    {
        [Required] public string CurrentPassword { get; set; } = string.Empty;
        [Required, MinLength(6)] public string NewPassword { get; set; } = string.Empty;
        [Compare(nameof(NewPassword), ErrorMessage = "Validation_PasswordsDoNotMatch")] public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed record ProfileSection(string Id, string Title, IReadOnlyList<ProfileItem> Items);
    private sealed record ProfileItem(string Icon, string Label, string Route, string? Value = null, bool ShowChevron = true, ProfileAction? Action = null, bool IsStatus = false, bool IsStandalone = false, bool IsDanger = false, bool IsAvailable = true);
    private enum ProfileAction { ChangePassword, RestTimers, ReportProblem, Logout, DeleteAccount }
    private enum ProfileDialog { None, EditProfile, ChangePassword, RestTimers, ReportProblem }
}
