@page "/progress/workouts"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using GymPlanner.Mobile.Orientation
@using WorkoutPlanner.Api.Contracts
@inject IWorkoutApiClient WorkoutClient
@inject IProgressApiClient ProgressClient
@inject IScreenOrientationService OrientationService
@inject IAppText Text
@inject NavigationManager Navigation

<section class="progress-workouts-page" aria-labelledby="progress-workouts-title" aria-busy="@_isLoading">
    <div class="page-heading">
        <a class="back-button" href="/progress" aria-label="@Text["Progress_BackToSections"]">
            <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
        </a>
        <h1 id="progress-workouts-title">@Text["ProgressWorkouts_Title"]</h1>
        <HelpButton Topic="HelpContentCatalog.ProgressWorkouts" />
    </div>

    @if (_errors.Count > 0)
    {
        <div class="error-state" role="alert">
            <span class="material-symbols-rounded" aria-hidden="true">error</span>
            <span>@string.Join(" ", _errors)</span>
        </div>
    }

    @if (_isLoading)
    {
        <div class="loading-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>@Text["Progress_LoadingWorkouts"]</span>
        </div>
    }
    else if (_plans.Count == 0)
    {
        <div class="empty-state">
            <span class="material-symbols-rounded" aria-hidden="true">analytics</span>
            <h2>@Text["ProgressWorkouts_EmptyTitle"]</h2>
            <p>@Text["ProgressWorkouts_EmptyBody"]</p>
            <a class="primary-action" href="/workouts">@Text["Progress_OpenWorkouts"]</a>
        </div>
    }
    else
    {
        <div class="progress-workouts">
            @foreach (var plan in _plans)
            {
                <article class="progress-card-wrapper">
                    <div class="progress-card">
                        <button class="progress-card-main" type="button" @onclick="() => OpenProgressAsync(plan)">
                            <span class="progress-card-icon material-symbols-rounded" aria-hidden="true">event_note</span>
                            <span class="progress-card-title">@plan.WorkoutName</span>
                            <span class="material-symbols-rounded card-chevron" aria-hidden="true">chevron_right</span>
                        </button>
                        <button class="card-menu-button"
                                type="button"
                                aria-label="@Text.Format("ProgressWorkouts_ClearHistory", plan.WorkoutName)"
                                @onclick:stopPropagation="true"
                                @onclick="() => AskToClear(plan)">
                            <span class="material-symbols-rounded" aria-hidden="true">more_vert</span>
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (_selectedPlan is not null)
{
    <div class="modal-overlay" @onclick="CloseProgress">
        <section class="modal-window progress-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="workout-progress-title"
                 @onclick:stopPropagation="true">
            <header class="modal-heading">
                <div>
                    <h2 id="workout-progress-title">@_selectedPlan.WorkoutName</h2>
                </div>
                <button class="modal-close" type="button" aria-label="@Text["Common_Close"]" disabled="@_isLoadingProgress" @onclick="CloseProgress">
                    <span class="material-symbols-rounded" aria-hidden="true">close</span>
                </button>
            </header>

            @if (_progressErrors.Count > 0)
            {
                <div class="error-state compact" role="alert">@string.Join(" ", _progressErrors)</div>
            }

            @if (_isLoadingProgress)
            {
                <div class="loading-state compact" role="status">
                    <span class="loading-spinner" aria-hidden="true"></span>
                    <span>@Text["Progress_Loading"]</span>
                </div>
            }
            else if (_selectedProgress is not null && _selectedProgress.Chart.Count > 0)
            {
                <div class="chart-page-content chart-page-content--staged">
                    <ProgressLineChart Title="@Text["Progress_ChartTitle"]"
                                       Points="_selectedProgress.Chart"
                                       StagedReveal="true"
                                       CompactPresentation="true"
                                       PointSelected="OpenHistoryForPoint" />

                    <div class="progress-summary">
                        <article class="summary-card">
                            <span class="card-icon growth-icon @TrendClass" aria-hidden="true">
                                <span class="material-symbols-rounded">moving</span>
                            </span>
                            <div class="card-content">
                                <span class="card-title">@Text["Progress_Growth"]</span>
                                <strong class="card-value @TrendClass">@SignedPercent(LastTrend)</strong>
                                <span class="card-subtitle">@Text["Progress_GrowthSubtitle"]</span>
                            </div>
                        </article>

                        <article class="summary-card">
                            <span class="card-icon best-icon" aria-hidden="true">
                                <span class="material-symbols-rounded">workspace_premium</span>
                            </span>
                            <div class="card-content">
                                <span class="card-title">@Text["Progress_Best"]</span>
                                <strong class="card-value purple">@SignedPercent(BestGrowth)</strong>
                                <span class="card-subtitle">@Text["Progress_BestSubtitle"]</span>
                            </div>
                        </article>

                        <article class="summary-card">
                            <span class="card-icon workout-icon" aria-hidden="true">
                                <span class="material-symbols-rounded">event_repeat</span>
                            </span>
                            <div class="card-content">
                                <span class="card-title">@Text["Progress_WorkoutsCount"]</span>
                                <strong class="card-value blue">@_selectedProgress.Snapshots.Count</strong>
                                <span class="card-subtitle">@Text["Progress_WorkoutsTotalSubtitle"]</span>
                            </div>
                        </article>
                    </div>
                </div>
            }
            else if (!_isLoadingProgress)
            {
                <div class="modal-empty">
                    <span class="material-symbols-rounded" aria-hidden="true">query_stats</span>
                    <h3>@Text["Progress_NoRecordsTitle"]</h3>
                    <p>@Text["ProgressWorkouts_NoRecordsBody"]</p>
                </div>
            }

        </section>
    </div>
}

@if (_clearPlan is not null)
{
    <div class="modal-overlay top-layer" @onclick="CloseClearDialog">
        <section class="modal-window confirm-modal"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="clear-workout-progress-title"
                 @onclick:stopPropagation="true">
            <h2 id="clear-workout-progress-title">@Text["ProgressWorkouts_ClearTitle"]</h2>
            <p>@Text["ProgressWorkouts_ClearBodyPrefix"] <strong>«@_clearPlan.WorkoutName»</strong>.</p>
            <p class="warning-copy">@Text["Progress_ClearWarning"]</p>

            @if (_dialogErrors.Count > 0)
            {
                <div class="error-state compact" role="alert">@string.Join(" ", _dialogErrors)</div>
            }

            <div class="dialog-buttons">
                <button class="secondary-action" type="button" disabled="@_isBusy" @onclick="CloseClearDialog">@Text["Common_Cancel"]</button>
                <button class="danger-action" type="button" disabled="@_isBusy" @onclick="ClearProgressAsync">
                    @(_isBusy ? Text["Common_Deleting"] : Text["Common_Delete"])
                </button>
            </div>
        </section>
    </div>
}

@if (_showToast)
{
    <div class="toast-success" role="status">
        <span class="material-symbols-rounded" aria-hidden="true">check_circle</span>
        @Text["ProgressWorkouts_Cleared"]
    </div>
}

@code {
    // Проценты и числа форматируем в культуре выбранного языка.
    private CultureInfo UiCulture => CultureInfo.GetCultureInfo(Text.Language);
    private readonly List<TrainingPlanApiResponse> _plans = [];
    private readonly List<string> _errors = [];
    private readonly List<string> _progressErrors = [];
    private readonly List<string> _dialogErrors = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private TrainingPlanApiResponse? _selectedPlan;
    private WorkoutProgressApiResponse? _selectedProgress;
    private TrainingPlanApiResponse? _clearPlan;
    private bool _isLoading = true;
    private bool _isLoadingProgress;
    private bool _isBusy;
    private bool _showToast;
    private decimal LastTrend => _selectedProgress?.Chart is { Count: >= 2 } chart
        ? Math.Round(chart[^1].Percent - chart[^2].Percent, 2)
        : 0;

    private decimal BestGrowth => _selectedProgress?.Chart.Count > 0
        ? _selectedProgress.Chart.Max(point => point.Percent)
        : 0;

    private string TrendClass => LastTrend switch
    {
        > 0 => "green",
        < 0 => "red",
        _ => "neutral"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await WorkoutClient.GetPlansAsync(_disposeCts.Token);
            if (!result.Succeeded)
                _errors.AddRange(result.Errors);
            else
                _plans.AddRange(result.Value!);
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenProgressAsync(TrainingPlanApiResponse plan)
    {
        if (_isLoadingProgress)
            return;

        _selectedPlan = plan;
        OrientationService.LockLandscape();
        _selectedProgress = null;
        _progressErrors.Clear();
        _isLoadingProgress = true;
        try
        {
            var result = await ProgressClient.GetWorkoutProgressAsync(plan.Id, _disposeCts.Token);
            if (!result.Succeeded)
                _progressErrors.AddRange(result.Errors);
            else
                _selectedProgress = result.Value;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isLoadingProgress = false;
        }
    }

    private void CloseProgress()
    {
        if (_isLoadingProgress)
            return;

        _selectedPlan = null;
        OrientationService.RestoreAutomaticOrientation();
        _selectedProgress = null;
        _progressErrors.Clear();
    }

    private void AskToClear(TrainingPlanApiResponse plan)
    {
        _clearPlan = plan;
        _dialogErrors.Clear();
    }

    private void CloseClearDialog()
    {
        if (_isBusy)
            return;

        _clearPlan = null;
        _dialogErrors.Clear();
    }

    private async Task ClearProgressAsync()
    {
        if (_isBusy || _clearPlan is null)
            return;

        _isBusy = true;
        _dialogErrors.Clear();
        try
        {
            var planId = _clearPlan.Id;
            var result = await ProgressClient.ClearWorkoutProgressAsync(planId, _disposeCts.Token);
            if (!result.Succeeded)
            {
                _dialogErrors.AddRange(result.Errors);
                return;
            }

            if (_selectedPlan?.Id == planId)
                CloseProgress();

            _clearPlan = null;
            _showToast = true;
            await Task.Delay(2500, _disposeCts.Token);
            _showToast = false;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string SignedPercent(decimal value) =>
        $"{(value > 0 ? "+" : string.Empty)}{value.ToString("0.##", UiCulture)}%";

    private void OpenHistoryForPoint(ProgressChartPointApiResponse point)
    {
        if (_selectedProgress is null)
            return;

        OrientationService.RestoreAutomaticOrientation();
        var workout = Uri.EscapeDataString(_selectedProgress.WorkoutName);
        var date = Uri.EscapeDataString(point.Date.ToString("O", CultureInfo.InvariantCulture));
        Navigation.NavigateTo($"/history?workout={workout}&date={date}");
    }

    public void Dispose()
    {
        OrientationService.RestoreAutomaticOrientation();
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }
}
