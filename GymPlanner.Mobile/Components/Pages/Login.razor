@page "/account/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@inject MobileAuthenticationService Authentication
@inject NavigationManager Navigation
@inject IAppText Text

<section class="auth-card" aria-labelledby="login-title">
    <h1 id="login-title" class="auth-title">@Text["Login_Title"]</h1>

    @if (_errors.Count > 0)
    {
        <div class="auth-error" role="alert">
            @foreach (var error in _errors)
            {
                <div>@error</div>
            }
        </div>
    }

    <EditForm class="auth-form" Model="_input" OnValidSubmit="LoginAsync">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label for="login-email">Email</label>
            <div class="auth-input-shell">
                <span class="auth-field-icon material-symbols-rounded" aria-hidden="true">mail</span>
                <InputText id="login-email"
                           class="auth-input"
                           @bind-Value="_input.Email"
                           autocomplete="username"
                           inputmode="email"
                           placeholder="@Text["Auth_EmailPlaceholder"]" />
            </div>
            <LocalizedValidationMessage For="@(() => _input.Email)" />
        </div>

        <div class="auth-field">
            <label for="login-password">@Text["Common_Password"]</label>
            <div class="auth-input-shell auth-input-shell--password">
                <span class="auth-field-icon material-symbols-rounded" aria-hidden="true">lock</span>
                <InputText id="login-password"
                           class="auth-input"
                           type="@(_showPassword ? "text" : "password")"
                           @bind-Value="_input.Password"
                           autocomplete="current-password"
                           placeholder="@Text["Auth_PasswordPlaceholder"]" />
                <button class="auth-visibility-toggle"
                        type="button"
                        aria-label="@Text[_showPassword ? "Common_HidePassword" : "Common_ShowPassword"]"
                        aria-pressed="@(_showPassword ? "true" : "false")"
                        @onclick="TogglePasswordVisibility">
                    <span class="material-symbols-rounded" aria-hidden="true">@(_showPassword ? "visibility_off" : "visibility")</span>
                </button>
            </div>
            <LocalizedValidationMessage For="@(() => _input.Password)" />
        </div>

        <button class="auth-submit" type="submit" disabled="@_isBusy">
            @(_isBusy ? Text["Login_SubmitBusy"] : Text["Login_Submit"])
        </button>
    </EditForm>

    <p class="auth-footer">@Text["Login_NoAccount"] <a href="/account/register">@Text["Login_CreateAccount"]</a></p>
</section>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private readonly LoginInput _input = new();
    private readonly List<string> _errors = [];
    private bool _isBusy;
    private bool _showPassword;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task LoginAsync()
    {
        if (_isBusy)
            return;

        _isBusy = true;
        _errors.Clear();
        try
        {
            var result = await Authentication.LoginAsync(
                _input.Email,
                _input.Password,
                GetDeviceName());
            if (!result.Succeeded)
            {
                _errors.AddRange(result.Errors);
                return;
            }

            Navigation.NavigateTo(GetSafeReturnUrl(), replace: true);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string GetSafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl) ||
            ReturnUrl.StartsWith("//", StringComparison.Ordinal) ||
            ReturnUrl.Contains('\\'))
        {
            return "/";
        }

        return ReturnUrl.StartsWith('/') ? ReturnUrl : $"/{ReturnUrl}";
    }

    private static string GetDeviceName() =>
        $"{DeviceInfo.Current.Platform} {DeviceInfo.Current.Model}";

    private sealed class LoginInput
    {
        // В атрибутах лежат ключи ресурсов: их печатает LocalizedValidationMessage.
        [Required(ErrorMessage = "Validation_EmailRequired")]
        [EmailAddress(ErrorMessage = "Validation_EmailInvalid")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Validation_PasswordRequired")]
        public string Password { get; set; } = string.Empty;
    }
}
