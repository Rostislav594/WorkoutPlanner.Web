@page "/workouts/{Id:int}"
@attribute [Authorize]
@using WorkoutPlanner.Api.Contracts
@inject IWorkoutApiClient WorkoutClient
@inject IExercisePhotoApiClient PhotoClient
@inject IMobilePhotoPicker PhotoPicker

<section class="workout-details-page" aria-busy="@_loading">
    <a class="back-link" href="/workouts">
        <span class="material-symbols-rounded" aria-hidden="true">arrow_back</span>
        К шаблонам
    </a>

    <header class="workout-header">
        <div class="workout-title-card">
            <h1>@(_plan?.WorkoutName ?? "Тренировка")</h1>
            <div class="title-line"></div>
        </div>
    </header>

    @if (_loading)
    {
        <div class="page-state" role="status">
            <span class="loading-spinner" aria-hidden="true"></span>
            <span>Загружаем тренировку…</span>
        </div>
    }
    else if (_loadErrors.Count > 0)
    {
        <div class="page-state page-state-error" role="alert">
            <strong>Не удалось загрузить тренировку</strong>
            <span>@string.Join(" ", _loadErrors)</span>
            <button class="secondary-button state-action" type="button" @onclick="LoadAsync">Повторить</button>
        </div>
    }
    else if (_plan is null)
    {
        <div class="page-state">
            <strong>Тренировка не найдена</strong>
            <span>Вернитесь к списку и выберите другой шаблон.</span>
        </div>
    }
    else
    {
        <div class="workout-toolbar">
            <button class="primary-button add-exercise-button" type="button" aria-haspopup="dialog" disabled="@_busy" @onclick="BeginCreate">
                <span aria-hidden="true">＋</span>
                Добавить упражнение
            </button>
        </div>

        @if (_operationErrors.Count > 0)
        {
            <div class="operation-error" role="alert">@string.Join(" ", _operationErrors)</div>
        }

        @if (_plan.Exercises.Count == 0)
        {
            <div class="empty-exercises">
                <span class="material-symbols-rounded" aria-hidden="true">fitness_center</span>
                <h2>Нет упражнений</h2>
            </div>
        }
        else
        {
            <div class="exercise-list">
                @foreach (var exercise in _plan.Exercises)
                {
                    <article class="exercise-card">
                        <header class="exercise-card-header">
                            <div>
                                <h2>@exercise.Name</h2>
                                <span>@exercise.Sets.Count подходов</span>
                            </div>
                            <button class="card-menu-button"
                                    type="button"
                                    aria-label="Настроить упражнение @exercise.Name"
                                    aria-haspopup="dialog"
                                    @onclick="() => OpenActions(exercise)">
                                <span class="material-symbols-rounded" aria-hidden="true">more_horiz</span>
                            </button>
                        </header>

                        <div class="exercise-card-body">
                            <div class="exercise-sets" aria-label="Подходы упражнения @exercise.Name">
                                @foreach (var set in exercise.Sets.OrderBy(x => x.SetNumber))
                                {
                                    <div class="exercise-set-row">
                                        <button class="set-number @(set.IsWarmup ? "warmup" : "working")"
                                                type="button"
                                                disabled="@_busy"
                                                title="@(set.IsWarmup ? "Разминочный подход. Нажмите, чтобы сделать рабочим" : "Рабочий подход. Нажмите, чтобы сделать разминочным")"
                                                aria-label="@(set.IsWarmup ? $"Подход {set.SetNumber}: разминочный. Сделать рабочим" : $"Подход {set.SetNumber}: рабочий. Сделать разминочным")"
                                                aria-pressed="@set.IsWarmup"
                                                @onclick="() => ToggleSetKindAsync(exercise, set)">@set.SetNumber</button>
                                        <span class="set-name">@(set.IsWarmup ? "Разминочный подход" : "Рабочий подход")</span>
                                        <span class="set-value">@set.Weight кг × @set.Repetitions</span>
                                    </div>
                                }
                            </div>

                            <div class="exercise-photo-panel">
                                <button class="exercise-photo-button"
                                        type="button"
                                        aria-haspopup="dialog"
                                        aria-label="@(exercise.HasPhoto ? $"Открыть фото упражнения {exercise.Name}" : $"Добавить фото упражнения {exercise.Name}")"
                                        @onclick="() => OpenPhotoAsync(exercise)">
                                    @if (_photoThumbnails.TryGetValue(exercise.Id, out var thumbnail))
                                    {
                                        <img class="exercise-photo-thumb" src="@thumbnail" alt="Фото упражнения @exercise.Name" />
                                    }
                                    else
                                    {
                                        <span class="exercise-photo-placeholder">
                                            <span class="material-symbols-rounded" aria-hidden="true">
                                                @(exercise.HasPhoto ? "image" : "photo_camera")
                                            </span>
                                        </span>
                                    }
                                </button>
                                <button class="photo-open-button"
                                        type="button"
                                        aria-haspopup="dialog"
                                        aria-label="@(exercise.HasPhoto ? $"Открыть фото упражнения {exercise.Name}" : $"Добавить фото упражнения {exercise.Name}")"
                                        @onclick="() => OpenPhotoAsync(exercise)">
                                    <span class="material-symbols-rounded" aria-hidden="true">photo_camera</span>
                                    <span>@(exercise.HasPhoto ? "Открыть фото" : "Добавить фото")</span>
                                </button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    }
</section>

@if (_actionExercise is not null)
{
    <div class="modal-overlay" @onclick="CloseActions">
        <section class="modal-window action-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="exercise-actions-title"
                 @onclick:stopPropagation="true">
            <div class="modal-heading">
                <div>
                    <span>Управление упражнением</span>
                    <h2 id="exercise-actions-title">@_actionExercise.Name</h2>
                </div>
                <button class="icon-close-button" type="button" aria-label="Закрыть" autofocus @onclick="CloseActions">×</button>
            </div>

            @if (_deleteExerciseId == _actionExercise.Id)
            {
                <div class="modal-body delete-confirmation">
                    <p>Удалить упражнение и все его подходы из шаблона?</p>
                </div>
                <div class="modal-actions modal-footer">
                    <button class="secondary-button" type="button" disabled="@_busy" @onclick="CancelDelete">Отмена</button>
                    <button class="danger-button" type="button" disabled="@_busy" @onclick="() => DeleteAsync(_actionExercise.Id)">
                        @(_busy ? "Удаляем…" : "Удалить")
                    </button>
                </div>
            }
            else
            {
                <div class="modal-body">
                    <div class="exercise-action-list">
                        <button class="modal-action-button" type="button" @onclick="() => BeginEdit(_actionExercise)">
                            <span class="material-symbols-rounded" aria-hidden="true">edit</span>
                            <span>Изменить параметры</span>
                        </button>
                        <button class="modal-action-button danger-action" type="button" @onclick="() => RequestDelete(_actionExercise.Id)">
                            <span class="material-symbols-rounded" aria-hidden="true">delete</span>
                            <span>Удалить упражнение</span>
                        </button>
                        <button class="modal-action-button cancel-action" type="button" @onclick="CloseActions">
                            <span class="material-symbols-rounded" aria-hidden="true">close</span>
                            <span>Отмена</span>
                        </button>
                    </div>
                </div>
            }
        </section>
    </div>
}

@if (_showEditor)
{
    <div class="modal-overlay" @onclick="CloseEditor">
        <section class="modal-window form-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="exercise-editor-title"
                 @onclick:stopPropagation="true">
            <div class="modal-heading">
                <div>
                    <span>@(_editingId is null ? "Новый элемент шаблона" : "Параметры шаблона")</span>
                    <h2 id="exercise-editor-title">@(_editingId is null ? "Новое упражнение" : "Редактирование упражнения")</h2>
                </div>
                <button class="icon-close-button" type="button" aria-label="Закрыть" disabled="@_busy" @onclick="CloseEditor">×</button>
            </div>

            <div class="modal-body">
                @if (_editorErrors.Count > 0)
                {
                    <div class="edit-error" role="alert">@string.Join(" ", _editorErrors)</div>
                }

                <div class="form-field">
                    <label for="definition">Упражнение из библиотеки</label>
                    <select id="definition" class="form-control" autofocus @bind="_draft.DefinitionId" @bind:after="ApplyDefinition">
                        <option value="">-- Не выбрано --</option>
                        @foreach (var item in _definitions)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label for="sets-count">Количество подходов</label>
                    <input id="sets-count"
                           class="form-control"
                           type="number"
                           min="1"
                           max="20"
                           value="@_draft.SetsCount"
                           @onchange="ChangeSetsCount" />
                </div>

                <div class="set-editor-list">
                    @foreach (var set in _draft.Sets)
                    {
                        <fieldset>
                            <legend>Подход @set.SetNumber</legend>
                            <label>
                                <span>Вес, кг</span>
                                <input class="form-control" type="number" min="0" max="2000" step="0.5" @bind="set.Weight" />
                            </label>
                            <label>
                                <span>Повторения</span>
                                <input class="form-control" type="number" min="1" max="1000" @bind="set.Repetitions" />
                            </label>
                        </fieldset>
                    }
                </div>
            </div>

            <div class="modal-actions modal-footer">
                <button class="primary-button" type="button" disabled="@_busy" @onclick="SaveAsync">
                    @(_busy ? "Сохраняем…" : "Сохранить")
                </button>
                <button class="secondary-button" type="button" disabled="@_busy" @onclick="CloseEditor">Отмена</button>
            </div>
        </section>
    </div>
}

@if (_photoExercise is not null)
{
    <div class="modal-overlay" @onclick="ClosePhoto">
        <section class="modal-window photo-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="photo-editor-title"
                 @onclick:stopPropagation="true">
            <div class="modal-heading">
                <div>
                    <span>Фотография упражнения</span>
                    <h2 id="photo-editor-title">@_photoExercise.Name</h2>
                </div>
                <button class="icon-close-button" type="button" aria-label="Закрыть" autofocus disabled="@_photoBusy" @onclick="ClosePhoto">×</button>
            </div>

            <div class="modal-body">
                @if (_photoErrors.Count > 0)
                {
                    <div class="edit-error" role="alert">@string.Join(" ", _photoErrors)</div>
                }

                @if (_photoBusy)
                {
                    <div class="photo-state" role="status">
                        <span class="loading-spinner" aria-hidden="true"></span>
                        <span>Обрабатываем фотографию…</span>
                    </div>
                }
                else if (_photoDataUri is not null)
                {
                    <img class="exercise-photo" src="@_photoDataUri" alt="Фото упражнения @_photoExercise.Name" />
                }
                else
                {
                    <div class="empty-photo">
                        <span class="material-symbols-rounded" aria-hidden="true">photo_camera</span>
                        <span>У этого упражнения пока нет фотографии.</span>
                    </div>
                }

                <p class="photo-hint">JPG, PNG или WebP, не более 5 МБ.</p>

                <div class="photo-actions">
                    <button class="primary-button" type="button" disabled="@_photoBusy" @onclick="() => PickPhotoAsync(MobilePhotoSource.Library)">
                        <span class="material-symbols-rounded" aria-hidden="true">photo_library</span>
                        Выбрать фото
                    </button>
                    <button class="secondary-button" type="button" disabled="@_photoBusy" @onclick="() => PickPhotoAsync(MobilePhotoSource.Camera)">
                        <span class="material-symbols-rounded" aria-hidden="true">photo_camera</span>
                        Сделать снимок
                    </button>

                    @if (_photoExercise.HasPhoto)
                    {
                        @if (_confirmPhotoDelete)
                        {
                            <button class="secondary-button" type="button" disabled="@_photoBusy" @onclick="() => _confirmPhotoDelete = false">Отмена удаления</button>
                            <button class="danger-button" type="button" disabled="@_photoBusy" @onclick="DeletePhotoAsync">Удалить точно</button>
                        }
                        else
                        {
                            <button class="danger-button" type="button" disabled="@_photoBusy" @onclick="() => _confirmPhotoDelete = true">Удалить фото</button>
                        }
                    }

                    <button class="secondary-button" type="button" disabled="@_photoBusy" @onclick="ClosePhoto">Закрыть</button>
                </div>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private TrainingPlanApiResponse? _plan;
    private readonly List<ExerciseDefinitionApiResponse> _definitions = [];
    private readonly List<string> _loadErrors = [], _operationErrors = [], _editorErrors = [];
    private readonly List<string> _photoErrors = [];
    private readonly Dictionary<int, string> _photoThumbnails = [];
    private ExerciseDraft _draft = ExerciseDraft.Create();
    private bool _loading = true, _busy, _showEditor;
    private bool _photoBusy, _confirmPhotoDelete;
    private int? _editingId, _deleteExerciseId;
    private ExerciseApiResponse? _actionExercise, _photoExercise;
    private string? _photoDataUri;
    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true; _loadErrors.Clear(); _operationErrors.Clear(); _photoThumbnails.Clear();
        var planTask = WorkoutClient.GetPlanAsync(Id); var definitionsTask = WorkoutClient.GetExerciseDefinitionsAsync();
        await Task.WhenAll(planTask, definitionsTask);
        if (!planTask.Result.Succeeded) _loadErrors.AddRange(planTask.Result.Errors); else _plan = planTask.Result.Value;
        if (!definitionsTask.Result.Succeeded) _loadErrors.AddRange(definitionsTask.Result.Errors); else { _definitions.Clear(); _definitions.AddRange(definitionsTask.Result.Value!); }
        if (_plan is not null) await LoadPhotoThumbnailsAsync(_plan.Exercises);
        _loading = false;
    }

    private async Task LoadPhotoThumbnailsAsync(IEnumerable<ExerciseApiResponse> exercises)
    {
        var downloads = exercises
            .Where(x => x.HasPhoto)
            .Select(async exercise =>
                (exercise.Id, Result: await PhotoClient.DownloadAsync(exercise.Id)));

        foreach (var download in await Task.WhenAll(downloads))
        {
            if (download.Result.Succeeded && download.Result.Value is { } photo)
                _photoThumbnails[download.Id] = ToDataUri(photo);
        }
    }

    private void BeginCreate() { _editingId = null; _draft = ExerciseDraft.Create(); _editorErrors.Clear(); _showEditor = true; }
    private void BeginEdit(ExerciseApiResponse exercise) { _actionExercise = null; _editingId = exercise.Id; _draft = ExerciseDraft.From(exercise); _editorErrors.Clear(); _showEditor = true; }
    private void CloseEditor() { if (_busy) return; _showEditor = false; _editingId = null; }
    private void OpenActions(ExerciseApiResponse exercise) { _actionExercise = exercise; _deleteExerciseId = null; }
    private void CloseActions() { if (_busy) return; _actionExercise = null; _deleteExerciseId = null; }
    private void RequestDelete(int id) => _deleteExerciseId = id;
    private void CancelDelete() => _deleteExerciseId = null;

    private async Task OpenPhotoAsync(ExerciseApiResponse exercise)
    {
        _photoExercise = exercise;
        _photoDataUri = _photoThumbnails.GetValueOrDefault(exercise.Id);
        _confirmPhotoDelete = false;
        _photoErrors.Clear();
        if (!exercise.HasPhoto || _photoDataUri is not null)
            return;

        _photoBusy = true;
        try
        {
            var result = await PhotoClient.DownloadAsync(exercise.Id);
            if (!result.Succeeded) _photoErrors.AddRange(result.Errors);
            else if (result.Value is { } photo) { _photoDataUri = ToDataUri(photo); _photoThumbnails[exercise.Id] = _photoDataUri; }
            else SetPhotoAvailability(false);
        }
        finally { _photoBusy = false; }
    }

    private void ClosePhoto()
    {
        if (_photoBusy) return;
        _photoExercise = null; _photoDataUri = null; _photoErrors.Clear(); _confirmPhotoDelete = false;
    }

    private async Task PickPhotoAsync(MobilePhotoSource source)
    {
        if (_photoBusy || _photoExercise is null) return;
        _photoBusy = true; _photoErrors.Clear(); _confirmPhotoDelete = false;
        try
        {
            var picked = await PhotoPicker.PickAsync(source);
            if (picked.Cancelled) return;
            if (!picked.Succeeded) { _photoErrors.AddRange(picked.Errors); return; }
            var result = await PhotoClient.UploadAsync(_photoExercise.Id, picked.Photo!);
            if (!result.Succeeded) { _photoErrors.AddRange(result.Errors); return; }
            _photoDataUri = $"data:{picked.Photo!.ContentType};base64,{Convert.ToBase64String(picked.Photo.Content)}";
            _photoThumbnails[_photoExercise.Id] = _photoDataUri;
            SetPhotoAvailability(true);
        }
        finally { _photoBusy = false; }
    }

    private async Task DeletePhotoAsync()
    {
        if (_photoBusy || _photoExercise is null) return;
        _photoBusy = true; _photoErrors.Clear();
        try
        {
            var result = await PhotoClient.DeleteAsync(_photoExercise.Id);
            if (!result.Succeeded) { _photoErrors.AddRange(result.Errors); return; }
            _photoThumbnails.Remove(_photoExercise.Id);
            _photoDataUri = null; _confirmPhotoDelete = false; SetPhotoAvailability(false);
        }
        finally { _photoBusy = false; }
    }

    private void SetPhotoAvailability(bool hasPhoto)
    {
        if (_photoExercise is null) return;
        _photoExercise = _photoExercise with { HasPhoto = hasPhoto };
        ReplaceExercise(_photoExercise);
    }

    private static string ToDataUri(ExercisePhotoContent photo) =>
        $"data:{photo.ContentType};base64,{Convert.ToBase64String(photo.Content)}";

    private void ApplyDefinition() { var definition = _definitions.FirstOrDefault(x => x.Id == _draft.DefinitionId); if (definition is not null) _draft.Name = definition.Name; }
    private void ChangeSetsCount(ChangeEventArgs args) { if (!int.TryParse(args.Value?.ToString(), out var count)) return; _draft.Resize(Math.Clamp(count, 1, 20)); }

    private async Task SaveAsync()
    {
        if (_busy) return; _editorErrors.Clear();
        if (_draft.DefinitionId is null || string.IsNullOrWhiteSpace(_draft.Name)) { _editorErrors.Add("Выберите упражнение из библиотеки."); return; }
        if (_draft.Sets.Any(x => !double.IsFinite(x.Weight) || x.Weight is < 0 or > 2000 || x.Repetitions is < 1 or > 1000)) { _editorErrors.Add("Проверьте вес и повторения каждого подхода."); return; }
        _busy = true;
        try
        {
            var request = new SaveExerciseRequest(_draft.Name.Trim(), _draft.SetsCount, _draft.Status, _draft.DefinitionId, _draft.Sets.Select(x => new SaveExerciseSetRequest(x.SetNumber, x.Repetitions, x.Weight, x.Completed, x.IsWarmup)).ToArray(), _draft.SupersetGroupId);
            var result = _editingId is { } id ? await WorkoutClient.UpdateExerciseAsync(id, request) : await WorkoutClient.CreateExerciseAsync(Id, request);
            if (!result.Succeeded) { _editorErrors.AddRange(result.Errors); return; }
            ReplaceExercise(result.Value!); _showEditor = false; _editingId = null;
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(int id)
    {
        if (_busy) return; _busy = true; _operationErrors.Clear();
        try
        {
            var result = await WorkoutClient.DeleteExerciseAsync(id);
            if (!result.Succeeded) _operationErrors.AddRange(result.Errors);
            else { _plan = _plan! with { Exercises = _plan.Exercises.Where(x => x.Id != id).ToArray() }; _photoThumbnails.Remove(id); _actionExercise = null; _deleteExerciseId = null; }
        }
        finally { _busy = false; }
    }

    private async Task ToggleSetKindAsync(
        ExerciseApiResponse exercise,
        ExerciseSetApiResponse selectedSet)
    {
        if (_busy)
            return;

        _busy = true;
        _operationErrors.Clear();
        try
        {
            var sets = exercise.Sets
                .OrderBy(x => x.SetNumber)
                .Select(set => new SaveExerciseSetRequest(
                    set.SetNumber,
                    set.Repetitions,
                    set.Weight,
                    set.Completed,
                    set.SetNumber == selectedSet.SetNumber
                        ? !set.IsWarmup
                        : set.IsWarmup))
                .ToArray();
            var request = new SaveExerciseRequest(
                exercise.Name,
                exercise.SetsCount,
                exercise.Status,
                exercise.ExerciseDefinitionId,
                sets,
                exercise.SupersetGroupId);
            var result = await WorkoutClient.UpdateExerciseAsync(
                exercise.Id,
                request);
            if (!result.Succeeded)
            {
                _operationErrors.AddRange(result.Errors);
                return;
            }

            ReplaceExercise(result.Value!);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ReplaceExercise(ExerciseApiResponse exercise)
    {
        var items = _plan!.Exercises.ToList(); var index = items.FindIndex(x => x.Id == exercise.Id); if (index < 0) items.Add(exercise); else items[index] = exercise; _plan = _plan with { Exercises = items };
    }

    private sealed class ExerciseDraft
    {
        public string Name { get; set; } = string.Empty; public string Status { get; set; } = "NotCompleted"; public int? DefinitionId { get; set; } public int? SupersetGroupId { get; set; } public int SetsCount => Sets.Count; public List<SetDraft> Sets { get; } = [];
        public static ExerciseDraft Create() { var value = new ExerciseDraft(); value.Resize(3); return value; }
        public static ExerciseDraft From(ExerciseApiResponse exercise) { var value = new ExerciseDraft { Name = exercise.Name, Status = exercise.Status, DefinitionId = exercise.ExerciseDefinitionId, SupersetGroupId = exercise.SupersetGroupId }; value.Sets.AddRange(exercise.Sets.OrderBy(x => x.SetNumber).Select(x => new SetDraft(x.SetNumber, x.Repetitions, x.Weight, x.Completed, x.IsWarmup))); return value; }
        public void Resize(int count) { while (Sets.Count < count) Sets.Add(new(Sets.Count + 1, 8, 0, false, false)); while (Sets.Count > count) Sets.RemoveAt(Sets.Count - 1); for (var i = 0; i < Sets.Count; i++) Sets[i].SetNumber = i + 1; }
    }

    private sealed class SetDraft(int setNumber, int repetitions, double weight, bool completed, bool isWarmup)
    {
        public int SetNumber { get; set; } = setNumber; public int Repetitions { get; set; } = repetitions; public double Weight { get; set; } = weight; public bool Completed { get; set; } = completed; public bool IsWarmup { get; set; } = isWarmup;
    }
}
