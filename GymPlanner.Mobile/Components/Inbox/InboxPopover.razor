@implements IDisposable
@inject IInboxApiClient InboxApi
@inject InboxNotificationState InboxState
@inject NavigationManager Navigation
@inject IAppText Text

<div class="inbox-popover">
    <button class="inbox-trigger"
            type="button"
            aria-label="@Text["Inbox_Open"]"
            aria-expanded="@_isOpen"
            @onclick="ToggleAsync">
        <span class="material-symbols-rounded" aria-hidden="true">notifications</span>
        @if (InboxState.UnreadCount > 0)
        {
            <span class="inbox-trigger__badge" aria-label="@GetUnreadLabel()">@GetUnreadBadge()</span>
        }
    </button>

    @if (_isOpen)
    {
        <div class="inbox-scrim" aria-hidden="true" @onclick="Close"></div>
        <section class="inbox-menu" aria-label="@Text["Inbox_Center"]"
                 @onclick:stopPropagation="true"
                 @onpointerdown="BeginClearHistoryHold"
                 @onpointerup="CancelClearHistoryHold"
                 @onpointercancel="CancelClearHistoryHold"
                 @onpointerleave="CancelClearHistoryHold">
            <header class="inbox-menu__header">
                <p class="inbox-menu__clear-hint">@Text["Inbox_ClearHint"]</p>
                <div class="inbox-menu__header-actions">
                    @if (_messages.Any(x => x.ReadAtUtc is null))
                    {
                        <button class="inbox-menu__mark-all" type="button" @onclick="MarkAllReadAsync">@Text["Inbox_MarkAllRead"]</button>
                    }
                </div>
            </header>

            @if (_isLoading)
            {
                <div class="inbox-menu__state" role="status">@Text["Common_Loading"]</div>
            }
            else if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="inbox-menu__state inbox-menu__state--error" role="alert">
                    <span>@_error</span>
                    <button type="button" @onclick="LoadAsync">@Text["Common_Retry"]</button>
                </div>
            }
            else if (_messages.Count == 0)
            {
                <div class="inbox-menu__state">
                    <span class="material-symbols-rounded" aria-hidden="true">notifications_none</span>
                    <span>@Text["Inbox_Empty"]</span>
                </div>
            }
            else
            {
                <div class="inbox-menu__list" role="list">
                    @foreach (var message in _messages)
                    {
                        <div class="inbox-menu__item @(message.ReadAtUtc is null ? "inbox-menu__item--unread" : null)" role="listitem">
                            <button class="inbox-menu__item-open" type="button" @onclick="() => OpenMessageAsync(message)">
                                <span class="material-symbols-rounded" aria-hidden="true">@GetIcon(message.Type)</span>
                                <span>@Text[InboxMessageTypes.KeyFor(message.Type)]</span>
                                @if (message.ReadAtUtc is null)
                                {
                                    <span class="inbox-menu__dot" aria-label="@Text["Inbox_UnreadDot"]"></span>
                                }
                            </button>
                            <button class="inbox-menu__delete" type="button" aria-label="@Text["Inbox_DeleteMessage"]" title="@Text["Inbox_DeleteMessage"]" @onpointerdown:stopPropagation="true" @onclick="() => DeleteMessageAsync(message)">
                                <span class="material-symbols-rounded" aria-hidden="true">delete</span>
                            </button>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@if (_showClearHistoryConfirmation)
{
    <div class="inbox-clear-overlay" @onclick="CancelClearHistory">
        <section class="inbox-clear-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="inbox-clear-title"
                 aria-describedby="inbox-clear-description"
                 @onclick:stopPropagation="true">
            <span class="material-symbols-rounded inbox-clear-dialog__icon" aria-hidden="true">delete_sweep</span>
            <h2 id="inbox-clear-title">@Text["Inbox_ClearTitle"]</h2>
            <p id="inbox-clear-description">@Text["Inbox_ClearDescription"]</p>
            @if (!string.IsNullOrWhiteSpace(_clearHistoryError))
            {
                <p class="inbox-clear-dialog__error" role="alert">@_clearHistoryError</p>
            }
            <div class="inbox-clear-dialog__actions">
                <button class="inbox-clear-dialog__cancel" type="button" disabled="@_isClearingHistory" @onclick="CancelClearHistory">@Text["Common_Cancel"]</button>
                <button class="inbox-clear-dialog__confirm" type="button" disabled="@_isClearingHistory" @onclick="DeleteAllAsync">
                    @(_isClearingHistory ? Text["Inbox_Clearing"] : Text["Inbox_Clear"])
                </button>
            </div>
        </section>
    </div>
}

@code {
    private List<InboxMessageResponse> _messages = [];
    private bool _isOpen;
    private bool _isLoading;
    private string? _error;
    private CancellationTokenSource? _clearHistoryHoldCts;
    private bool _showClearHistoryConfirmation;
    private bool _isClearingHistory;
    private string? _clearHistoryError;

    protected override async Task OnInitializedAsync()
    {
        InboxState.Changed += OnInboxChanged;
        await InboxState.RefreshAsync();
    }

    private async Task ToggleAsync()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        var result = await InboxApi.GetMessagesAsync();
        if (result.Value is null)
            _error = result.Errors.FirstOrDefault() ?? Text["Inbox_LoadFailed"];
        else
        {
            _messages = result.Value.Messages.ToList();
            InboxState.SetUnreadCount(result.Value.UnreadCount);
        }
        _isLoading = false;
    }

    private async Task OpenMessageAsync(InboxMessageResponse message)
    {
        if (message.ReadAtUtc is null)
        {
            var result = message.IsPublication
                ? await InboxApi.MarkPublicationReadAsync(message.Id)
                : await InboxApi.MarkReadAsync(message.Id);
            if (result.Value is not null)
            {
                var readAt = DateTime.UtcNow;
                _messages = _messages.Select(x => x.Id == message.Id ? x with { ReadAtUtc = readAt } : x).ToList();
                InboxState.SetUnreadCount(result.Value.UnreadCount);
            }
        }

        var kind = message.IsPublication ? "publication" : "message";
        Navigation.NavigateTo($"/notifications/{kind}/{message.Id}");
    }

    private async Task MarkAllReadAsync()
    {
        var result = await InboxApi.MarkAllReadAsync();
        if (result.Value is null)
            return;

        var readAt = DateTime.UtcNow;
        _messages = _messages.Select(x => x.ReadAtUtc is null ? x with { ReadAtUtc = readAt } : x).ToList();
        InboxState.SetUnreadCount(result.Value.UnreadCount);
    }

    private async Task BeginClearHistoryHold()
    {
        if (_messages.Count == 0 || _showClearHistoryConfirmation)
            return;

        CancelClearHistoryHold();
        _clearHistoryHoldCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(550, _clearHistoryHoldCts.Token);
            _clearHistoryError = null;
            _showClearHistoryConfirmation = true;
        }
        catch (OperationCanceledException) { }
    }

    private void CancelClearHistory()
    {
        if (_isClearingHistory)
            return;

        _showClearHistoryConfirmation = false;
        _clearHistoryError = null;
    }

    private void CancelClearHistoryHold()
    {
        _clearHistoryHoldCts?.Cancel();
        _clearHistoryHoldCts?.Dispose();
        _clearHistoryHoldCts = null;
    }

    private async Task DeleteMessageAsync(InboxMessageResponse message)
    {
        var result = message.IsPublication
            ? await InboxApi.DeletePublicationAsync(message.Id)
            : await InboxApi.DeleteMessageAsync(message.Id);
        if (result.Value is null)
        {
            _error = result.Errors.FirstOrDefault() ?? Text["Inbox_DeleteFailed"];
            return;
        }
        _messages.RemoveAll(x => x.Id == message.Id && x.IsPublication == message.IsPublication);
        InboxState.SetUnreadCount(result.Value.UnreadCount);
    }

    private async Task DeleteAllAsync()
    {
        if (_isClearingHistory)
            return;

        _isClearingHistory = true;
        _clearHistoryError = null;
        var result = await InboxApi.DeleteAllAsync();
        if (result.Value is null)
        {
            _clearHistoryError = result.Errors.FirstOrDefault() ?? Text["Inbox_ClearFailed"];
            _isClearingHistory = false;
            return;
        }
        _messages.Clear();
        InboxState.SetUnreadCount(result.Value.UnreadCount);
        _showClearHistoryConfirmation = false;
        _isClearingHistory = false;
    }

    private void Close() => _isOpen = false;
    private void OnInboxChanged() => _ = InvokeAsync(StateHasChanged);

    private string GetUnreadBadge() => InboxState.UnreadCount > 99 ? "99+" : InboxState.UnreadCount.ToString();
    private string GetUnreadLabel() => Text.Plural("Inbox_UnreadCount", InboxState.UnreadCount);
    private static string GetIcon(string type) => type switch { "SupportReply" => "support_agent", "News" => "campaign", "Update" => "new_releases", _ => "info" };
    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("dd.MM.yyyy, HH:mm");

    public void Dispose()
    {
        CancelClearHistoryHold();
        InboxState.Changed -= OnInboxChanged;
    }
}
